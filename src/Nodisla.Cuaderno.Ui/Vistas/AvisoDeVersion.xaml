<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AvisoDeVersion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}"
             Focusable="False">

    <!--
        AVISO DE VERSIÓN NUEVA.

        Una barra fina que se enciende sola cuando GitHub tiene una versión más nueva. No abre
        ventanas ni toma el foco: se queda ahí hasta que el operador la mira. DataContext:
        VistaModeloActualizaciones. Al cargarse lanza la comprobación del arranque (en segundo
        plano, como mucho una vez al día).
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
    </UserControl.Resources>

    <Border Visibility="{Binding AvisoVisible, Converter={StaticResource BooleanoAVisible}}"
            Background="{DynamicResource FondoPanel}"
            BorderBrush="{DynamicResource Acento}"
            BorderThickness="0,0,0,2"
            Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="&#x2B06;" Foreground="{DynamicResource Acento}" FontWeight="Bold"
                           Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TituloDelAviso}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button Content="{loc:Texto Principal.Version.Descargar}"
                        Command="{Binding DescargarEInstalarCommand}"
                        Style="{StaticResource BotonPrincipal}"
                        Margin="0,2,6,2"
                        AutomationProperties.Name="{loc:Texto Principal.Version.DescargarNombre}" />
                <Button Content="{loc:Texto Principal.Version.VerEnGithub}"
                        Command="{Binding VerEnGitHubCommand}"
                        Margin="0,2,6,2"
                        AutomationProperties.Name="{loc:Texto Principal.Version.VerEnGithubNombre}" />
                <Button Content="{loc:Texto Principal.Version.CancelarDescarga}"
                        Command="{Binding CancelarDescargaCommand}"
                        Visibility="{Binding Descargando, Converter={StaticResource BooleanoAVisible}}"
                        Margin="0,2,6,2"
                        AutomationProperties.Name="{loc:Texto Principal.Version.CancelarDescargaNombre}" />
            </WrapPanel>

            <Button Grid.Column="1"
                    Content="&#x2715;"
                    Command="{Binding DescartarCommand}"
                    ToolTip="{loc:Texto Principal.Version.OcultarConsejo}"
                    Padding="6,1"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{loc:Texto Principal.Version.OcultarNombre}" />

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                         Minimum="0" Maximum="1" Value="{Binding Progreso, Mode=OneWay}"
                         Height="4" Margin="0,4,0,0"
                         Visibility="{Binding Descargando, Converter={StaticResource BooleanoAVisible}}"
                         AutomationProperties.Name="{loc:Texto Principal.Version.Progreso}" />

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                <TextBlock Text="{Binding Estado}" Style="{StaticResource TextoTenueEstilo}" Margin="0,2,0,0" />
                <Expander Header="{loc:Texto Principal.Version.Novedades}" Foreground="{DynamicResource Texto}" Margin="0,2,0,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Notas, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Texto}"
                                 AutomationProperties.Name="{loc:Texto Principal.Version.Notas}" />
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
