<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeEntrada"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        Entrada de contactos.

        Está pensada para teclear deprisa durante un pileup: Intro registra, Escape limpia y
        nada obliga a soltar el teclado. La primera fila —indicativo, banda, modo, frecuencia e
        informes— no se oculta nunca; la segunda se pliega entera con F7.

        Cuando el equipo está conectado, la frecuencia, la banda y el modo los pone el dial, y
        se dice con todas las letras. Registrar veinte contactos en la frecuencia equivocada
        porque se creía que el programa seguía al dial es el error más caro de este cuaderno.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:AnchoEnLetras x:Key="AnchoEnLetras" />
    </UserControl.Resources>

    <Grid>
        <Grid.InputBindings>
            <KeyBinding Key="Return" Command="{Binding Entrada.GuardarCommand}" />
        </Grid.InputBindings>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Content="{Binding TextoDeDatosAmpliados}"
                    Command="{Binding AlternarDatosAmpliadosCommand}"
                    Padding="10,3"
                    ToolTip="{loc:Texto Libro.Entrada.DatosAmpliados.Ayuda}" />
            <StackPanel>
                <TextBlock Text="{Binding Entrada.TituloDelPanel}" Style="{StaticResource TituloDeSeccion}" />
                <TextBlock Text="{Binding Entrada.OrigenDeLaSintonia}"
                           Style="{StaticResource TextoTenueEstilo}"
                           FontStyle="Italic"
                           Margin="0,-6,0,6" />
            </StackPanel>
        </DockPanel>

        <!-- Fila imprescindible: con esto solo ya se puede registrar un contacto. -->
        <WrapPanel Grid.Row="1">
            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=10}">
                <TextBlock Text="{loc:Texto Comun.Indicativo}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox x:Name="CampoIndicativo"
                         Style="{StaticResource CampoDeIndicativo}"
                         Text="{Binding Entrada.Indicativo, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:Texto Libro.Entrada.Indicativo.Accesible}"
                         AutomationProperties.HelpText="{loc:Texto Libro.Entrada.Indicativo.AyudaAccesible}"
                         ToolTip="{loc:Texto Libro.Entrada.Indicativo.Ayuda}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=6}">
                <TextBlock Text="{loc:Texto Comun.Banda}" Style="{StaticResource EtiquetaDeCampo}" />
                <ComboBox ItemsSource="{Binding Entrada.Bandas}" SelectedItem="{Binding Entrada.Banda}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=7}">
                <TextBlock Text="{loc:Texto Comun.Modo}" Style="{StaticResource EtiquetaDeCampo}" />
                <ComboBox ItemsSource="{Binding Entrada.Modos}" SelectedItem="{Binding Entrada.Modo}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=9}">
                <TextBlock Text="{loc:Texto Libro.Entrada.Frecuencia}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.Frecuencia, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Texto Libro.Entrada.Frecuencia.Ayuda}" />
            </StackPanel>

            <!--
                Un informe son tres caracteres —«59», «599», «-07»—, no media pantalla. Los dos
                van juntos en un bloque con un titulo comun y flechas entre ellos: enviado a la
                izquierda, recibido a la derecha, como se dicen en antena.
            -->
            <StackPanel Style="{StaticResource BloqueDeCampo}">
                <TextBlock Text="{loc:Texto Libro.Entrada.Informes}" Style="{StaticResource EtiquetaDeCampo}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Entrada.InformeEnviado, UpdateSourceTrigger=PropertyChanged}"
                             Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=4}"
                             TextAlignment="Center"
                             AutomationProperties.Name="{loc:Texto Libro.Entrada.InformeEnviado}"
                             ToolTip="{loc:Texto Libro.Entrada.InformeEnviado.Ayuda}" />
                    <TextBlock Text="▸" Margin="4,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextoTenue}" />
                    <TextBox Text="{Binding Entrada.InformeRecibido, UpdateSourceTrigger=PropertyChanged}"
                             Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=4}"
                             TextAlignment="Center"
                             AutomationProperties.Name="{loc:Texto Libro.Entrada.InformeRecibido}"
                             ToolTip="{loc:Texto Libro.Entrada.InformeRecibido.Ayuda}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{Binding Entrada.TextoDelBotonGuardar}"
                        Command="{Binding Entrada.GuardarCommand}"
                        Style="{StaticResource BotonPrincipal}"
                        Margin="0,0,8,0" />
                <Button Content="{loc:Texto Libro.Entrada.Limpiar}" Command="{Binding Entrada.LimpiarCommand}" />
                <!-- Al modificar un contacto del cuaderno (F2): su tarjeta QSL, para verla o mandarla. -->
                <Button Content="{loc:Texto Libro.VerEnviarQsl}" Click="AlVerEnviarQsl" Margin="8,0,0,0"
                        Visibility="{Binding Entrada.EnEdicion, Converter={StaticResource BooleanoAVisible}}"
                        AutomationProperties.Name="{loc:Texto Libro.Entrada.VerEnviarQsl.Accesible}" />
            </StackPanel>
        </WrapPanel>

        <!-- Segunda fila: se pliega entera con F7. -->
        <WrapPanel Grid.Row="2"
                   Visibility="{Binding DatosAmpliadosVisibles, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=9}">
                <TextBlock Text="{loc:Texto Libro.Entrada.FechaUtc}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.FechaUtc, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Texto Libro.Entrada.FechaUtc.Ayuda}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=8}">
                <TextBlock Text="{loc:Texto Libro.Entrada.HoraUtc}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.HoraUtc, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}" VerticalAlignment="Bottom">
                <CheckBox Content="{loc:Texto Libro.Entrada.HoraAutomatica}" IsChecked="{Binding Entrada.HoraAutomatica}"
                          ToolTip="{loc:Texto Libro.Entrada.HoraAutomatica.Ayuda}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}" VerticalAlignment="Bottom">
                <Button Content="{loc:Texto Libro.Entrada.Ahora}" Command="{Binding Entrada.PonerHoraActualCommand}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=12}">
                <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.Nombre, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=13}">
                <TextBlock Text="QTH" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.Qth, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=9}">
                <TextBlock Text="{loc:Texto Libro.Localizador}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.Localizador, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" />
            </StackPanel>

            <StackPanel Style="{StaticResource BloqueDeCampo}"
                        Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=20}">
                <TextBlock Text="{loc:Texto Comun.Comentario}" Style="{StaticResource EtiquetaDeCampo}" />
                <TextBox Text="{Binding Entrada.Comentario, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Lo que dice la ficha de QRZ.com del indicativo: discreto, sin robar sitio. -->
            <TextBlock Text="{Binding Entrada.ResumenDeFicha}"
                       ToolTip="{loc:Texto Libro.Entrada.Ficha.Ayuda}"
                       Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4"
                       AutomationProperties.Name="{loc:Texto Libro.Entrada.Ficha.Accesible}" />

            <!-- Audio de la recepción adjunto («Guardar lo último» de la fonía). -->
            <StackPanel Style="{StaticResource BloqueDeCampo}" VerticalAlignment="Bottom"
                        Visibility="{Binding Entrada.TieneAudio, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{loc:Texto Libro.Entrada.Audio}" Style="{StaticResource EtiquetaDeCampo}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Entrada.AudioAdjunto}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource TextoTenueEstilo}" />
                    <Button Content="{loc:Texto Libro.Entrada.Audio.Escuchar}" Padding="8,1" Margin="0,0,4,0"
                            Command="{Binding Entrada.EscucharAudioCommand}"
                            ToolTip="{loc:Texto Libro.Entrada.Audio.Escuchar.Ayuda}" />
                    <Button Content="{loc:Texto Libro.Entrada.Audio.Quitar}" Padding="8,1"
                            Command="{Binding Entrada.QuitarAudioCommand}"
                            ToolTip="{loc:Texto Libro.Entrada.Audio.Quitar.Ayuda}" />
                </StackPanel>
            </StackPanel>
        </WrapPanel>

        <!-- Aviso de «trabajado antes» -->
        <Border Grid.Row="3"
                Margin="0,4,0,0"
                Padding="12,8"
                CornerRadius="4"
                Background="{DynamicResource AvisoFondo}"
                BorderBrush="{DynamicResource AvisoBorde}"
                BorderThickness="1"
                Visibility="{Binding Entrada.HayTrabajadoAntes, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel>
                <TextBlock Text="{Binding Entrada.AvisoTrabajadoAntes}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           ToolTip="{Binding Entrada.AvisoTrabajadoAntes}"
                           Foreground="{DynamicResource AvisoTexto}" />
                <ItemsControl ItemsSource="{Binding Entrada.ContactosPrevios}"
                              Margin="0,6,0,0"
                              Visibility="{Binding ContactosPreviosVisibles, Converter={StaticResource BooleanoAVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,4"
                                    Padding="8,3"
                                    CornerRadius="3"
                                    Background="{DynamicResource FondoPanel}"
                                    BorderBrush="{DynamicResource AvisoBorde}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{DynamicResource Texto}">
                                    <Run Text="{Binding Fecha, Mode=OneWay}" />
                                    <Run Text="{Binding Hora, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding Banda, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding Modo, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="·" />
                                    <Run Text="{Binding InformeEnviado, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding InformeRecibido, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Resultado de la última operación -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="12,8" CornerRadius="4" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Entrada.Tono}" Value="Correcto">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Entrada.Tono}" Value="Aviso">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{DynamicResource AvisoFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AvisoBorde}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Entrada.Tono}" Value="Error">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Entrada.Mensaje}" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="None">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entrada.Tono}" Value="Correcto">
                                <Setter Property="Foreground" Value="{DynamicResource CorrectoTexto}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Entrada.Tono}" Value="Aviso">
                                <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Entrada.Tono}" Value="Error">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
