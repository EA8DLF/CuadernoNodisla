<Window x:Class="Nodisla.Cuaderno.Ui.Vistas.VentanaDeEnvioDeQsl"
        Icon="/Nodisla.Cuaderno.Ui;component/Recursos/CuadernoNodisla.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
        Title="{loc:Texto Qsl.Envio.Titulo}"
        Width="1180" Height="700" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource FondoVentana}"
        Foreground="{DynamicResource Texto}">

    <!--
        VER Y ENVIAR LA QSL DE LOS CONTACTOS ELEGIDOS.

        Una fila por estación (sus contactos van juntos en el mismo correo, una tarjeta por
        contacto). La dirección sale del contacto o de su ficha de QRZ; si no publica, se
        escribe a mano o se salta. Al mandar, el contacto queda con QSL_SENT=Y, fecha de hoy y
        vía E (electrónica).
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" MinWidth="420" />
            <ColumnDefinition Width="1*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Destinatarios ══ -->
        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Texto Qsl.Envio.Destinatarios}" Style="{StaticResource TituloDeSeccion}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding DesdeTexto}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding Destinatarios}" SelectedItem="{Binding Elegido}"
                      HorizontalScrollBarVisibility="Auto" VerticalAlignment="Top"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="{loc:Texto Qsl.Envio.DestinatariosNombre}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{loc:Texto Qsl.Envio.Enviar}" Binding="{Binding Enviar, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Texto Comun.Indicativo}" Binding="{Binding Indicativo}" IsReadOnly="True" Width="Auto" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="{loc:Texto Qsl.Envio.Contactos}" Binding="{Binding ContactosTexto}" IsReadOnly="True" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Texto Qsl.Editor.Correo}" Binding="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="170" />
                    <DataGridTextColumn Header="{loc:Texto Qsl.Envio.De}" Binding="{Binding OrigenTexto}" IsReadOnly="True" Width="Auto" />
                    <DataGridTextColumn Header="{loc:Texto Qsl.Envio.Estado}" Binding="{Binding Estado}" IsReadOnly="True" Width="*" MinWidth="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ══ Tarjeta y correo ══ -->
        <DockPanel Grid.Column="1" Grid.Row="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="{loc:Texto Qsl.Editor.Plantilla}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Disenos}" SelectedItem="{Binding Diseno}"
                          AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.PlantillaDeTarjeta}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nombre}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <Border DockPanel.Dock="Top" Background="{DynamicResource FondoCampo}" Padding="6" Height="250">
                <Image Source="{Binding VistaPrevia}" Stretch="Uniform" AutomationProperties.Name="{loc:Texto Qsl.Envio.VistaPrevia}" />
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{loc:Texto Qsl.Editor.Asunto}" FontWeight="SemiBold" Margin="0,8,0,2" />
            <TextBox DockPanel.Dock="Top" Text="{Binding Asunto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Envio.AsuntoNombre}" />
            <TextBlock DockPanel.Dock="Top" Text="{loc:Texto Qsl.Envio.Texto, Valor={Binding Tag, RelativeSource={RelativeSource Self}}}" FontWeight="SemiBold" Margin="0,6,0,2" />
            <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" MinLines="9" MaxLines="14"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{loc:Texto Qsl.Envio.TextoNombre}" />
        </DockPanel>

        <!-- ══ Botones ══ -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Texto Comun.Cerrar}" IsCancel="True" Padding="14,4" Margin="6,0,0,0" Click="AlCerrar"
                    AutomationProperties.Name="{loc:Texto Qsl.Envio.CerrarNombre}" />
            <Button DockPanel.Dock="Right" Content="PDF…" Command="{Binding GuardarPdfCommand}" Padding="10,4" Margin="6,0,0,0"
                    AutomationProperties.Name="{loc:Texto Qsl.Envio.PdfNombre}" />
            <Button DockPanel.Dock="Right" Content="{loc:Texto Qsl.Envio.GuardarImagenes}" Command="{Binding GuardarImagenesCommand}" Padding="10,4" Margin="6,0,0,0"
                    AutomationProperties.Name="{loc:Texto Qsl.Envio.GuardarImagenesNombre}" />
            <Button DockPanel.Dock="Right" Content="{loc:Texto Qsl.Envio.Parar}" Command="{Binding CancelarCommand}" Padding="10,4" Margin="6,0,0,0"
                    Visibility="{Binding Ocupado, Converter={StaticResource BooleanoAVisible}}"
                    AutomationProperties.Name="{loc:Texto Qsl.Envio.PararNombre}" />
            <Button DockPanel.Dock="Right" Content="{loc:Texto Qsl.Envio.EnviarPorCorreo}" Command="{Binding EnviarCommand}" Style="{StaticResource BotonPrincipal}"
                    Padding="14,4" Margin="6,0,0,0"
                    AutomationProperties.Name="{loc:Texto Qsl.Envio.EnviarNombre}" />
            <TextBlock Text="{Binding Aviso}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
        </DockPanel>
    </Grid>
</Window>
