<frontales:FrontalDibujado x:Class="Nodisla.Cuaderno.Ui.Vistas.Frontales.FrontalFtdx101"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:frontales="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Frontales"
             xmlns:puertos="clr-namespace:Nodisla.Cuaderno.Aplicacion.Puertos;assembly=Nodisla.Cuaderno.Aplicacion">

    <!--
        EL FRONTAL DEL YAESU FTDX101D / FTDX101MP (docs/18-frontales.md). Cuerpo de
        435 × 145 mm, proporción 3:1, en el lienzo común de 1040 × 335.

          · Izquierda: POWER, MOX, VOX, TUNE, KEYER, BK-IN y las tomas PHONES y MIC; después
            los cuatro mandos dobles: AF/RF-SQL de MAIN y de SUB, MIC/SPEED y PROC/PITCH.
          · Centro: la pantalla táctil de 7" (VisorDeVfos con el analizador) y, debajo,
            NB · DNR · NOTCH · DNF · CONT · APF · NAR.
          · Derecha: MODE · BAND · A/B · SPLIT y CLAR · TX CLAR · V/M · QMB; el dial MAIN con su
            anillo MPVD; el dial SUB (VFO-B) y SHIFT/WIDTH; FINE · LOCK · ZIN.

        Los mandos del receptor SUB no tienen orden propia en el programa: salen apagados.
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="PiezasDeLosFrontales.xaml" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Canvas Width="1040" Height="335">
            <Border Canvas.Left="0" Canvas.Top="0" Width="1040" Height="335" CornerRadius="12"
                    Background="{StaticResource Cuerpo}" BorderBrush="{StaticResource CuerpoBorde}" BorderThickness="1.5" />

            <!-- ══ Columna izquierda ══ -->
            <Button Canvas.Left="10" Canvas.Top="12" Width="62" Height="28" Style="{StaticResource TeclaDelFrontal}"
                    Click="AlEncender" IsEnabled="{Binding PuedeEncenderOApagar}"
                    ToolTip="POWER — Enciende o apaga la radio (apagar pide confirmación)">
                <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" /><Run Text=" POWER" FontSize="9" /></TextBlock>
            </Button>
            <Border Canvas.Left="33" Canvas.Top="45" Width="16" Height="5" Style="{StaticResource PilotoEncendido}" />
            <Button Canvas.Left="10" Canvas.Top="56" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MOX"
                    Command="{Binding MoxCommand}" Tag="{Binding EnMox}"
                    ToolTip="MOX — TRANSMITE (pide confirmación y va por el vigilante del PTT); otro clic lo quita." />
            <Button Canvas.Left="10" Canvas.Top="88" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="VOX"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Vox}"
                    Tag="{Binding Pilotos[Vox].Encendido}" ToolTip="VOX — Paso a transmisión por voz" />
            <Button Canvas.Left="10" Canvas.Top="120" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="TUNE"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Sintonizador}"
                    Tag="{Binding Pilotos[Sintonizador].Encendido}"
                    ToolTip="TUNE — Clic: acoplador en línea o fuera (no emite). Clic derecho: sintonizar, EMITE PORTADORA (pide confirmación, corte a los 10 s).">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding SintonizarAcopladorCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="10" Canvas.Top="152" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="BK-IN"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.BreakIn}"
                    Tag="{Binding Pilotos[BreakIn].Encendido}" ToolTip="BK-IN — Break-in en telegrafía" />
            <TextBlock Canvas.Left="6" Canvas.Top="190" Width="70" Text="PHONES" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="22" Canvas.Top="204" Width="38" Height="38" ToolTip="PHONES — Toma de auriculares">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3" Fill="#FF15171A" />
                <Ellipse Margin="13" Fill="#FF020203" />
            </Grid>
            <TextBlock Canvas.Left="6" Canvas.Top="252" Width="70" Text="MIC" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="16" Canvas.Top="266" Width="50" Height="50" ToolTip="MIC — Conector de micrófono">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="4" Fill="#FF0D0F11" />
                <Ellipse Margin="14" Fill="#FF050607" />
            </Grid>

            <!-- ══ Los cuatro mandos dobles ══ -->
            <TextBlock Canvas.Left="80" Canvas.Top="10" Width="86" Text="AF/RF·SQL" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <TextBlock Canvas.Left="80" Canvas.Top="22" Width="86" Text="MAIN" Style="{StaticResource Serigrafiado}" FontSize="9" Foreground="#FF6CA8FF" />
            <vistas:MandoGiratorio Canvas.Left="86" Canvas.Top="36" Width="74" Height="74"
                                   Rotulo="AF/RF-SQL MAIN" Explicacion="Ganancia de RF (anillo) y volumen (centro) del receptor principal"
                                   Mando="{Binding MandoDeGananciaRf}" MandoInterior="{Binding MandoDeVolumen}" />
            <TextBlock Canvas.Left="168" Canvas.Top="10" Width="86" Text="AF/RF·SQL" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <TextBlock Canvas.Left="168" Canvas.Top="22" Width="86" Text="SUB" Style="{StaticResource Serigrafiado}" FontSize="9" Foreground="#FFF2A93B" />
            <vistas:MandoGiratorio Canvas.Left="174" Canvas.Top="36" Width="74" Height="74"
                                   Rotulo="AF/RF-SQL SUB" IsEnabled="False" Explicacion="Receptor SUB: sin orden propia en el programa (apagado)" />
            <TextBlock Canvas.Left="80" Canvas.Top="122" Width="86" Text="MIC/SPEED" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="86" Canvas.Top="136" Width="74" Height="74"
                                   Rotulo="MIC/SPEED" Explicacion="Ganancia de micrófono (anillo) y velocidad del manipulador (centro)"
                                   Mando="{Binding Frontal[GananciaMicrofono]}" MandoInterior="{Binding Frontal[VelocidadKeyer]}" />
            <TextBlock Canvas.Left="168" Canvas.Top="122" Width="86" Text="PROC/PITCH" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="174" Canvas.Top="136" Width="74" Height="74"
                                   Rotulo="PROC/PITCH" Explicacion="Procesador de voz (anillo) y tono de telegrafía (centro)"
                                   Mando="{Binding Frontal[Compresor]}" MandoInterior="{Binding Frontal[TonoCw]}" />
            <Button Canvas.Left="86" Canvas.Top="228" Width="50" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="ATT"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Atenuador}"
                    ToolTip="{Binding Pilotos[Atenuador].ValorTexto}" />
            <Button Canvas.Left="142" Canvas.Top="228" Width="50" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="IPO"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Preamplificador}"
                    ToolTip="{Binding Pilotos[Preamplificador].ValorTexto}" />
            <Button Canvas.Left="198" Canvas.Top="228" Width="50" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="AGC"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Agc}"
                    ToolTip="{Binding Pilotos[Agc].ValorTexto}" />
            <Button Canvas.Left="86" Canvas.Top="260" Width="78" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="R.FLT"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroDeTejado}"
                    ToolTip="{Binding Pilotos[FiltroDeTejado].ValorTexto}" />
            <Button Canvas.Left="170" Canvas.Top="260" Width="78" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="ANT"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Antena}"
                    ToolTip="{Binding Pilotos[Antena].ValorTexto}" />
            <TextBlock Canvas.Left="86" Canvas.Top="300" Style="{StaticResource SinProbar}" />

            <!-- ══ La pantalla de 7" ══ -->
            <TextBlock Canvas.Left="266" Canvas.Top="5" Text="YAESU" Foreground="#FFB08A45" FontFamily="Arial Black, Arial"
                       FontSize="15" FontStyle="Italic" FontWeight="Black" />
            <TextBlock Canvas.Left="440" Canvas.Top="8" Text="HF/50MHz TRANSCEIVER" Foreground="#FF7E868F" FontFamily="Arial"
                       FontSize="9" FontWeight="Bold" FontStyle="Italic" />
            <TextBlock Canvas.Left="608" Canvas.Top="4" Text="FTDX101" Foreground="{StaticResource Dorado}" FontFamily="Arial"
                       FontSize="16" FontStyle="Italic" FontWeight="Bold" />
            <Border Canvas.Left="258" Canvas.Top="26" Width="446" Height="256" CornerRadius="6"
                    Background="#FF08090A" BorderBrush="#FF3A3F46" BorderThickness="1.2" />
            <Viewbox Canvas.Left="266" Canvas.Top="32" Width="430" Height="244" Stretch="Fill">
                <vistas:VisorDeVfos Width="430" Height="244"
                                    RotuloDelAnalizador="{Binding DataContext.Analizador.RotuloEnPantalla, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AnchoDelAnalizadorHz="{Binding DataContext.Analizador.SpanHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                    InicioFijoDelAnalizadorHz="{Binding DataContext.Analizador.InicioFijoHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AnalizadorAmpliado="{Binding DataContext.Analizador.Ampliado, RelativeSource={RelativeSource AncestorType=Window}}">
                    <vistas:VisorDeVfos.ContenidoDelAnalizador>
                        <vistas:AnalizadorDelEquipo DataContext="{Binding DataContext.Analizador, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </vistas:VisorDeVfos.ContenidoDelAnalizador>
                </vistas:VisorDeVfos>
            </Viewbox>

            <Button Canvas.Left="260" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="NB"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SupresorDeRuido}"
                    Tag="{Binding Pilotos[SupresorDeRuido].Encendido}" ToolTip="NB — Supresor de ruido de impulsos" />
            <Button Canvas.Left="324" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="DNR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.ReductorDeRuido}"
                    Tag="{Binding Pilotos[ReductorDeRuido].Encendido}" ToolTip="DNR — Reductor de ruido digital" />
            <Button Canvas.Left="388" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="NOTCH"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.MuescaManual}"
                    Tag="{Binding Pilotos[MuescaManual].Encendido}" ToolTip="NOTCH — Muesca manual de FI" />
            <Button Canvas.Left="452" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="DNF"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.MuescaAutomatica}"
                    Tag="{Binding Pilotos[MuescaAutomatica].Encendido}" ToolTip="DNF — Muesca automática digital" />
            <Button Canvas.Left="516" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="CONT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Contorno}"
                    Tag="{Binding Pilotos[Contorno].Encendido}" ToolTip="CONT — Contorno" />
            <Button Canvas.Left="580" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="APF"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Apf}"
                    Tag="{Binding Pilotos[Apf].Encendido}" ToolTip="APF — Filtro de pico de audio (CW)" />
            <Button Canvas.Left="644" Canvas.Top="294" Width="58" Height="28" Style="{StaticResource TeclaDelFrontal}" Content="NAR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroEstrecho}"
                    Tag="{Binding Pilotos[FiltroEstrecho].Encendido}" ToolTip="NAR — Filtro estrecho" />

            <!-- ══ Bloque de la derecha ══ -->
            <Border Canvas.Left="712" Canvas.Top="6" Width="322" Height="323" CornerRadius="10"
                    BorderThickness="1.2" BorderBrush="#FF3A4047" Background="#08FFFFFF" />
            <Button Canvas.Left="720" Canvas.Top="14" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MODE"
                    Command="{Binding SiguienteModoCommand}" ToolTip="MODE — Pasa al modo siguiente" />
            <Button Canvas.Left="786" Canvas.Top="14" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="BAND"
                    Command="{Binding SiguienteBandaCommand}" ToolTip="BAND — Banda siguiente" />
            <Button Canvas.Left="852" Canvas.Top="14" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="A/B"
                    Command="{Binding ActivarVfoCommand}" CommandParameter="{Binding Secundario}"
                    ToolTip="A/B — Pasa a operar con el otro VFO. Clic derecho: A=B (pide confirmación).">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding IgualarVfosCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="918" Canvas.Top="14" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="SPLIT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Split}"
                    Tag="{Binding Pilotos[Split].Encendido}" ToolTip="SPLIT — Trabajo en dos frecuencias" />
            <TextBlock Canvas.Left="982" Canvas.Top="12" Width="48" Text="TX" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Border Canvas.Left="998" Canvas.Top="28" Width="16" Height="8" Style="{StaticResource PilotoTx}" />

            <Button Canvas.Left="720" Canvas.Top="46" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="CLAR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Rit}"
                    Tag="{Binding Pilotos[Rit].Encendido}" MouseWheel="AlGirarSobreClar"
                    ToolTip="CLAR — Clarificador de recepción. Rueda encima: desplazamiento. Clic derecho: a cero.">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.BorrarClarificador}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="786" Canvas.Top="46" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="TX CLAR"
                    FontSize="9" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Xit}"
                    Tag="{Binding Pilotos[Xit].Encendido}" ToolTip="TX CLAR — Clarificador de transmisión (XIT)" />
            <Button Canvas.Left="852" Canvas.Top="46" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="V/M"
                    Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.VfoOMemoria}"
                    Tag="{Binding EnMemoria}" ToolTip="V/M — Alterna entre VFO y memorias" />
            <Button Canvas.Left="918" Canvas.Top="46" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="QMB"
                    Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.RecuperarMemoriaRapida}"
                    ToolTip="QMB — Recupera la memoria rápida. Clic derecho: guarda (pide confirmación).">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.GuardarMemoriaRapida}" />
                </Button.InputBindings>
            </Button>

            <!-- Dial MAIN con su anillo MPVD -->
            <Grid Canvas.Left="718" Canvas.Top="84" Width="220" Height="220" Background="Transparent"
                  MouseWheel="AlGirarElAnillo" ToolTip="MPVD — Anillo multifunción: rueda encima, saltos de canal (STEP/MCH).">
                <Ellipse Stroke="#FF2A2E33" StrokeThickness="16" />
                <Ellipse Margin="2" Stroke="#FF0A0B0D" StrokeThickness="12" StrokeDashArray="0.25 0.35" Opacity="0.8" />
            </Grid>
            <frontales:DialDelFrontal Canvas.Left="740" Canvas.Top="106" Width="176" Height="176" />

            <!-- Dial SUB (VFO-B) y SHIFT/WIDTH -->
            <TextBlock Canvas.Left="944" Canvas.Top="82" Width="86" Text="SUB VFO" Style="{StaticResource Serigrafiado}" FontSize="10" Foreground="#FFF2A93B" />
            <vistas:MandoGiratorio Canvas.Left="950" Canvas.Top="96" Width="74" Height="74"
                                   Rotulo="SUB VFO" IsEnabled="False" Explicacion="Dial del VFO B: sin orden propia en el programa (apagado); use A/B y el dial MAIN" />
            <TextBlock Canvas.Left="944" Canvas.Top="178" Width="86" Text="SHIFT/WIDTH" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="950" Canvas.Top="192" Width="74" Height="74"
                                   Rotulo="SHIFT/WIDTH" Explicacion="Desplazamiento de FI (anillo) y ancho del filtro (centro)"
                                   Mando="{Binding Frontal[DesplazamientoFi]}" MandoInterior="{Binding MandoDeAnchoDeFiltro}" />

            <Button Canvas.Left="720" Canvas.Top="298" Width="44" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="FINE"
                    FontSize="10" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SintoniaFinaRapida}"
                    Tag="{Binding Pilotos[SintoniaFinaRapida].Encendido}" ToolTip="FINE — Sintonía fina" />
            <Button Canvas.Left="894" Canvas.Top="298" Width="44" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="LOCK"
                    FontSize="10" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Bloqueo}"
                    Tag="{Binding Pilotos[Bloqueo].Encendido}" ToolTip="LOCK — Bloqueo del dial" />
            <Button Canvas.Left="950" Canvas.Top="288" Width="74" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="ZIN/SPOT"
                    FontSize="10" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.AjusteACero}"
                    Tag="{Binding Pilotos[TonoDeReferenciaCw].Encendido}"
                    ToolTip="ZIN/SPOT — Clic: ajuste a cero. Clic derecho: tono de referencia (SPOT).">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.TonoDeReferenciaCw}" />
                </Button.InputBindings>
            </Button>
        </Canvas>
    </Viewbox>
</frontales:FrontalDibujado>
