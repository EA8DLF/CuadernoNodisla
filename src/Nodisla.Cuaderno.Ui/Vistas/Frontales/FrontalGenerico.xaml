<frontales:FrontalDibujado x:Class="Nodisla.Cuaderno.Ui.Vistas.Frontales.FrontalGenerico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:frontales="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Frontales"
             xmlns:puertos="clr-namespace:Nodisla.Cuaderno.Aplicacion.Puertos;assembly=Nodisla.Cuaderno.Aplicacion">

    <!--
        EL FRONTAL GENÉRICO, para cualquier modelo sin dibujo propio (docs/18-frontales.md):
        no imita ninguna radio, reúne lo que tienen todas.

          · Izquierda: POWER, PTT, TUNE, VOX, PHONES y MIC; AF GAIN, RF/SQL y MIC/POWER.
          · La pantalla: los dos VFO, el medidor de barra y el analizador si el modelo lo
            declara (CapacidadesDelModelo.Analizador); con doble recepción, los dos a la par.
          · Debajo: MODE · BAND · A/B · A=B · SPLIT · RIT · XIT y NB · NR · NOTCH · AGC · ATT ·
            PRE · NAR.
          · Derecha: el dial, FILTER (desplazamiento y ancho), RIT, LOCK · FINE · V/M.

        Arriba, el nombre del equipo tal como lo da el control. Lo que el equipo no declara sale
        apagado.
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="PiezasDeLosFrontales.xaml" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Canvas Width="1040" Height="335">
            <Border Canvas.Left="0" Canvas.Top="0" Width="1040" Height="335" CornerRadius="12"
                    Background="{StaticResource Cuerpo}" BorderBrush="{StaticResource CuerpoBorde}" BorderThickness="1.5" />

            <!-- ══ Columna izquierda ══ -->
            <Button Canvas.Left="12" Canvas.Top="14" Width="70" Height="28" Style="{StaticResource TeclaDelFrontal}"
                    Click="AlEncender" IsEnabled="{Binding PuedeEncenderOApagar}"
                    ToolTip="{loc:Texto Cabina.Frontal.PowerGenerico}">
                <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" /><Run Text=" POWER" FontSize="10" /></TextBlock>
            </Button>
            <Border Canvas.Left="39" Canvas.Top="47" Width="16" Height="5" Style="{StaticResource PilotoEncendido}" />
            <Button Canvas.Left="12" Canvas.Top="60" Width="70" Height="40" Style="{StaticResource TeclaDelFrontal}"
                    Command="{Binding MoxCommand}" Tag="{Binding EnMox}"
                    ToolTip="{loc:Texto Cabina.Frontal.Ptt}">
                <StackPanel>
                    <TextBlock Text="PTT" HorizontalAlignment="Center" />
                    <Border Width="30" Height="5" Margin="0,3,0,0" Style="{StaticResource PilotoTx}" />
                </StackPanel>
            </Button>
            <Button Canvas.Left="12" Canvas.Top="108" Width="70" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="TUNE"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Sintonizador}"
                    Tag="{Binding Pilotos[Sintonizador].Encendido}"
                    ToolTip="{loc:Texto Cabina.Frontal.Tune}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding SintonizarAcopladorCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="12" Canvas.Top="140" Width="70" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="VOX"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Vox}"
                    Tag="{Binding Pilotos[Vox].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Vox}" />
            <TextBlock Canvas.Left="10" Canvas.Top="182" Width="74" Text="PHONES" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="28" Canvas.Top="196" Width="38" Height="38" ToolTip="{loc:Texto Cabina.Frontal.Phones}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3" Fill="#FF15171A" />
                <Ellipse Margin="13" Fill="#FF020203" />
            </Grid>
            <TextBlock Canvas.Left="10" Canvas.Top="248" Width="74" Text="MIC" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="22" Canvas.Top="262" Width="50" Height="50" ToolTip="{loc:Texto Cabina.Frontal.Mic}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="4" Fill="#FF0D0F11" />
                <Ellipse Margin="14" Fill="#FF050607" />
            </Grid>

            <!-- ══ Mandos AF · RF/SQL · MIC/POWER ══ -->
            <TextBlock Canvas.Left="92" Canvas.Top="10" Width="92" Text="AF GAIN" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="102" Canvas.Top="24" Width="72" Height="72"
                                   Rotulo="AF GAIN" Explicacion="{loc:Texto Cabina.Explica.Volumen}" Mando="{Binding MandoDeVolumen}" />
            <TextBlock Canvas.Left="92" Canvas.Top="112" Width="92" Text="RF GAIN/SQL" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="102" Canvas.Top="126" Width="72" Height="72"
                                   Rotulo="RF GAIN/SQL" Explicacion="{loc:Texto Cabina.Explica.RfSilenciador}"
                                   Mando="{Binding MandoDeGananciaRf}" MandoInterior="{Binding Frontal[Silenciador]}" />
            <TextBlock Canvas.Left="92" Canvas.Top="214" Width="92" Text="MIC/POWER" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="102" Canvas.Top="228" Width="72" Height="72"
                                   Rotulo="MIC/POWER" Explicacion="{loc:Texto Cabina.Explica.PotenciaMicro}"
                                   Mando="{Binding MandoDePotencia}" MandoInterior="{Binding Frontal[GananciaMicrofono]}" />

            <!-- ══ La pantalla ══ -->
            <TextBlock Canvas.Left="200" Canvas.Top="4" Text="{Binding NombreDelEquipo}" Style="{StaticResource Marca}" FontSize="14" />
            <TextBlock Canvas.Left="420" Canvas.Top="6" Style="{StaticResource SinProbar}" />
            <Border Canvas.Left="194" Canvas.Top="24" Width="452" Height="238" CornerRadius="5" Background="#FF050607"
                    BorderBrush="#FF3A3F46" BorderThickness="1.5" Padding="3">
                <frontales:PantallaIcom ConAnalizador="{Binding ConAnalizador, RelativeSource={RelativeSource AncestorType=frontales:FrontalDibujado}}"
                                        DosReceptores="{Binding DosReceptores, RelativeSource={RelativeSource AncestorType=frontales:FrontalDibujado}}" />
            </Border>

            <!-- ══ Teclas comunes ══ -->
            <Button Canvas.Left="194" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MODE"
                    Command="{Binding SiguienteModoCommand}" ToolTip="{loc:Texto Cabina.Frontal.Mode}" />
            <Button Canvas.Left="259" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="BAND"
                    Command="{Binding SiguienteBandaCommand}" ToolTip="{loc:Texto Cabina.Frontal.Band}" />
            <Button Canvas.Left="324" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="A/B"
                    Command="{Binding ActivarVfoCommand}" CommandParameter="{Binding Secundario}"
                    ToolTip="{loc:Texto Cabina.Frontal.ABSolo}" />
            <Button Canvas.Left="389" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="A=B"
                    Command="{Binding IgualarVfosCommand}" ToolTip="{loc:Texto Cabina.Frontal.AIgualB}" />
            <Button Canvas.Left="454" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="SPLIT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Split}"
                    Tag="{Binding Pilotos[Split].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Split}" />
            <Button Canvas.Left="519" Canvas.Top="270" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="RIT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Rit}"
                    Tag="{Binding Pilotos[Rit].Encendido}" MouseWheel="AlGirarSobreClar"
                    ToolTip="{loc:Texto Cabina.Frontal.Rit}" />
            <Button Canvas.Left="584" Canvas.Top="270" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="XIT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Xit}"
                    Tag="{Binding Pilotos[Xit].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Xit}" />

            <Button Canvas.Left="194" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NB"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SupresorDeRuido}"
                    Tag="{Binding Pilotos[SupresorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nb}" />
            <Button Canvas.Left="259" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.ReductorDeRuido}"
                    Tag="{Binding Pilotos[ReductorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nr}" />
            <Button Canvas.Left="324" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NOTCH"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.MuescaAutomatica}"
                    Tag="{Binding Pilotos[MuescaAutomatica].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Notch}" />
            <Button Canvas.Left="389" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="AGC"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Agc}"
                    ToolTip="{Binding Pilotos[Agc].ValorTexto}" />
            <Button Canvas.Left="454" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="ATT"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Atenuador}"
                    ToolTip="{Binding Pilotos[Atenuador].ValorTexto}" />
            <Button Canvas.Left="519" Canvas.Top="302" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="PRE"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Preamplificador}"
                    ToolTip="{Binding Pilotos[Preamplificador].ValorTexto}" />
            <Button Canvas.Left="584" Canvas.Top="302" Width="62" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NAR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroEstrecho}"
                    Tag="{Binding Pilotos[FiltroEstrecho].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nar}" />

            <!-- ══ Derecha: dial, filtro y RIT ══ -->
            <Border Canvas.Left="658" Canvas.Top="6" Width="376" Height="323" CornerRadius="10"
                    BorderThickness="1.2" BorderBrush="#FF3A4047" Background="#08FFFFFF" />
            <frontales:DialDelFrontal Canvas.Left="676" Canvas.Top="30" Width="240" Height="240" />
            <TextBlock Canvas.Left="930" Canvas.Top="16" Width="96" Text="FILTER" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="942" Canvas.Top="30" Width="72" Height="72"
                                   Rotulo="FILTER" Explicacion="{loc:Texto Cabina.Explica.ShiftWidth}"
                                   Mando="{Binding Frontal[DesplazamientoFi]}" MandoInterior="{Binding MandoDeAnchoDeFiltro}" />
            <TextBlock Canvas.Left="930" Canvas.Top="118" Width="96" Text="RIT" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="942" Canvas.Top="132" Width="72" Height="72"
                                   Rotulo="RIT" Explicacion="{loc:Texto Cabina.Explica.Rit}" Mando="{Binding Frontal[DesplazamientoRit]}" />
            <TextBlock Canvas.Left="930" Canvas.Top="220" Width="96" Text="STEP/MCH" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="954" Canvas.Top="234" Width="48" Height="48"
                                   Rotulo="STEP/MCH" Explicacion="{loc:Texto Cabina.Explica.Step}"
                                   GiroLibre="True" Girado="AlGirarLosPasos" />
            <Button Canvas.Left="676" Canvas.Top="292" Width="70" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="LOCK"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Bloqueo}"
                    Tag="{Binding Pilotos[Bloqueo].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Lock}" />
            <Button Canvas.Left="760" Canvas.Top="292" Width="70" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="FINE"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SintoniaFinaRapida}"
                    Tag="{Binding Pilotos[SintoniaFinaRapida].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.FineGenerico}" />
            <Button Canvas.Left="844" Canvas.Top="292" Width="70" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="V/M"
                    Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.VfoOMemoria}"
                    Tag="{Binding EnMemoria}" ToolTip="{loc:Texto Cabina.Frontal.VM}" />
        </Canvas>
    </Viewbox>
</frontales:FrontalDibujado>
