<frontales:FrontalDibujado x:Class="Nodisla.Cuaderno.Ui.Vistas.Frontales.FrontalFt891"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:frontales="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Frontales"
             xmlns:puertos="clr-namespace:Nodisla.Cuaderno.Aplicacion.Puertos;assembly=Nodisla.Cuaderno.Aplicacion">

    <!--
        EL FRONTAL DEL YAESU FT-891 (docs/18-frontales.md). Cuerpo de 155 × 52 mm, proporción
        3:1, en el lienzo común de 1040 × 335.

          · Izquierda: POWER, la toma PHONES y el conector MIC (modular).
          · El LCD ámbar de cristal líquido con cifras oscuras: medidor de barra S/PO, modo,
            la frecuencia en siete segmentos, el otro VFO y los indicadores. NO tiene
            analizador de espectro.
          · Debajo del LCD: BAND · MODE · A/B · SPLIT · CLAR · NB · DNR · NAR.
          · Derecha: AF/RF-SQL, MULTI (potencia) y SHIFT/WIDTH, y el dial; LOCK · FAST · TUNE.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PiezasDeLosFrontales.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TintaLcd" Color="#FF1C1407" />
            <Style x:Key="IndicadorLcd" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TintaLcd}" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Opacity" Value="0.14" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Canvas Width="1040" Height="335">
            <Border Canvas.Left="20" Canvas.Top="0" Width="1000" Height="335" CornerRadius="14"
                    Background="{StaticResource Cuerpo}" BorderBrush="{StaticResource CuerpoBorde}" BorderThickness="1.5" />

            <!-- ══ Izquierda ══ -->
            <Button Canvas.Left="34" Canvas.Top="20" Width="56" Height="30" Style="{StaticResource TeclaDelFrontal}"
                    Click="AlEncender" IsEnabled="{Binding PuedeEncenderOApagar}"
                    ToolTip="{loc:Texto Cabina.Frontal.Power}">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="14" />
            </Button>
            <Border Canvas.Left="54" Canvas.Top="56" Width="16" Height="5" Style="{StaticResource PilotoEncendido}" />
            <TextBlock Canvas.Left="28" Canvas.Top="120" Width="68" Text="PHONES" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="42" Canvas.Top="136" Width="40" Height="40" ToolTip="{loc:Texto Cabina.Frontal.Phones}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3" Fill="#FF15171A" />
                <Ellipse Margin="13" Fill="#FF020203" />
            </Grid>
            <TextBlock Canvas.Left="28" Canvas.Top="214" Width="68" Text="MIC" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Border Canvas.Left="40" Canvas.Top="232" Width="44" Height="40" CornerRadius="3" Background="{StaticResource Hueco}"
                    BorderBrush="#FF3A4047" BorderThickness="1" ToolTip="{loc:Texto Cabina.Frontal.MicModular}">
                <Border Margin="8,10" Background="#FF020203" CornerRadius="1" />
            </Border>

            <!-- ══ El LCD ══ -->
            <TextBlock Canvas.Left="116" Canvas.Top="4" Text="YAESU" Foreground="#FFB08A45" FontFamily="Arial Black, Arial"
                       FontSize="13" FontStyle="Italic" FontWeight="Black" />
            <TextBlock Canvas.Left="484" Canvas.Top="3" Text="FT-891" Foreground="{StaticResource Dorado}" FontFamily="Arial"
                       FontSize="14" FontStyle="Italic" FontWeight="Bold" />
            <Border Canvas.Left="108" Canvas.Top="24" Width="450" Height="220" CornerRadius="6"
                    Background="#FF08090A" BorderBrush="#FF3A3F46" BorderThickness="1.2" Padding="8"
                    AutomationProperties.Name="{loc:Texto Cabina.Frontal.PantallaDelEquipo}">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FFF2A24A" />
                            <GradientStop Offset="1" Color="#FFD9812A" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,6,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <frontales:MedidorDeBarra NivelDeSenal="{Binding NivelDeSenal}" NivelDePotencia="{Binding NivelDePotencia}"
                                                  Transmitiendo="{Binding Transmitiendo}" Tinta="{StaticResource TintaLcd}"
                                                  TintaFuerte="#FF5A0E00" ToolTip="{Binding MedidorS}"
                                                  AutomationProperties.Name="{loc:Texto Cabina.Frontal.MedidorDeSenal}" />
                        <TextBlock Grid.Column="1" Text="{Binding Principal.Modo}" Foreground="{StaticResource TintaLcd}"
                                   FontFamily="Arial" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="8,0,10,0">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Principal.Etiqueta}" Foreground="{StaticResource TintaLcd}" FontFamily="Arial"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="TX" FontFamily="Arial" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TintaLcd}"
                                       Visibility="{Binding Transmitiendo, Converter={StaticResource BooleanoAVisible}}" />
                        </StackPanel>
                        <Viewbox HorizontalAlignment="Right" StretchDirection="DownOnly">
                            <vistas:CifrasDeSieteSegmentos Texto="{Binding Principal.FrecuenciaDelVisor}" AltoDeCifra="62"
                                                           Relleno="{StaticResource TintaLcd}" />
                        </Viewbox>
                    </DockPanel>

                    <DockPanel Grid.Row="2" Margin="8,0,8,0">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TintaLcd}" FontFamily="Arial" FontSize="12" FontWeight="Bold">
                            <Run Text="{Binding TextoDeRit, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Principal.AnchoDeFiltro, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource TintaLcd}" FontFamily="Arial" FontSize="12" FontWeight="Bold">
                            <Run Text="{Binding Secundario.Etiqueta, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Secundario.FrecuenciaDelVisor, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,8,0">
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="SPLIT" Tag="{Binding Split}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="NB" Tag="{Binding Pilotos[SupresorDeRuido].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="DNR" Tag="{Binding Pilotos[ReductorDeRuido].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="DNF" Tag="{Binding Pilotos[MuescaAutomatica].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="NAR" Tag="{Binding Pilotos[FiltroEstrecho].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="VOX" Tag="{Binding Pilotos[Vox].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Text="LOCK" Tag="{Binding Pilotos[Bloqueo].Encendido}" />
                        <TextBlock Style="{StaticResource IndicadorLcd}" Opacity="1">
                            <Run Text="AGC-" /><Run Text="{Binding Agc, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Teclas de debajo del LCD ══ -->
            <Button Canvas.Left="108" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="BAND"
                    FontSize="11" Command="{Binding SiguienteBandaCommand}" ToolTip="{loc:Texto Cabina.Frontal.Band}" />
            <Button Canvas.Left="165" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="MODE"
                    FontSize="11" Command="{Binding SiguienteModoCommand}" ToolTip="{loc:Texto Cabina.Frontal.Mode}" />
            <Button Canvas.Left="222" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="A/B"
                    Command="{Binding ActivarVfoCommand}" CommandParameter="{Binding Secundario}"
                    ToolTip="{loc:Texto Cabina.Frontal.AB}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding IgualarVfosCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="279" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="SPLIT"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Split}"
                    Tag="{Binding Pilotos[Split].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Split}" />
            <Button Canvas.Left="336" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="CLAR"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Rit}"
                    Tag="{Binding Pilotos[Rit].Encendido}" MouseWheel="AlGirarSobreClar"
                    ToolTip="{loc:Texto Cabina.Frontal.Clar}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.BorrarClarificador}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="393" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="NB"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SupresorDeRuido}"
                    Tag="{Binding Pilotos[SupresorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nb}" />
            <Button Canvas.Left="450" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="DNR"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.ReductorDeRuido}"
                    Tag="{Binding Pilotos[ReductorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Dnr}" />
            <Button Canvas.Left="507" Canvas.Top="258" Width="52" Height="30" Style="{StaticResource TeclaDelFrontal}" Content="NAR"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroEstrecho}"
                    Tag="{Binding Pilotos[FiltroEstrecho].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nar}" />
            <Button Canvas.Left="108" Canvas.Top="296" Width="52" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="ATT"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Atenuador}"
                    ToolTip="{Binding Pilotos[Atenuador].ValorTexto}" />
            <Button Canvas.Left="165" Canvas.Top="296" Width="52" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="IPO"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Preamplificador}"
                    ToolTip="{Binding Pilotos[Preamplificador].ValorTexto}" />
            <Button Canvas.Left="222" Canvas.Top="296" Width="52" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="AGC"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Agc}"
                    ToolTip="{Binding Pilotos[Agc].ValorTexto}" />
            <Button Canvas.Left="279" Canvas.Top="296" Width="52" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="VOX"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Vox}"
                    Tag="{Binding Pilotos[Vox].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Vox}" />
            <Button Canvas.Left="336" Canvas.Top="296" Width="52" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MOX"
                    FontSize="11" Command="{Binding MoxCommand}" Tag="{Binding EnMox}"
                    ToolTip="{loc:Texto Cabina.Frontal.Mox}" />
            <TextBlock Canvas.Left="400" Canvas.Top="302" Style="{StaticResource SinProbar}" FontSize="9" />

            <!-- ══ Derecha: mandos y dial ══ -->
            <TextBlock Canvas.Left="574" Canvas.Top="14" Width="90" Text="AF/RF·SQL" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="582" Canvas.Top="30" Width="74" Height="74"
                                   Rotulo="AF/RF-SQL" Explicacion="{loc:Texto Cabina.Explica.RfVolumen}"
                                   Mando="{Binding MandoDeGananciaRf}" MandoInterior="{Binding MandoDeVolumen}" />
            <TextBlock Canvas.Left="574" Canvas.Top="118" Width="90" Text="MULTI" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="582" Canvas.Top="134" Width="74" Height="74"
                                   Rotulo="MULTI" Explicacion="{loc:Texto Cabina.Explica.MultiPotencia}" Mando="{Binding MandoDePotencia}" />
            <TextBlock Canvas.Left="574" Canvas.Top="222" Width="90" Text="SHIFT/WIDTH" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="590" Canvas.Top="238" Width="60" Height="60"
                                   Rotulo="SHIFT/WIDTH" Explicacion="{loc:Texto Cabina.Explica.ShiftWidth}"
                                   Mando="{Binding Frontal[DesplazamientoFi]}" MandoInterior="{Binding MandoDeAnchoDeFiltro}" />

            <frontales:DialDelFrontal Canvas.Left="690" Canvas.Top="30" Width="250" Height="250" />
            <TextBlock Canvas.Left="950" Canvas.Top="30" Width="60" Text="TX" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Border Canvas.Left="970" Canvas.Top="46" Width="18" Height="8" Style="{StaticResource PilotoTx}" />

            <Button Canvas.Left="690" Canvas.Top="296" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="LOCK"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Bloqueo}"
                    Tag="{Binding Pilotos[Bloqueo].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Lock}" />
            <Button Canvas.Left="786" Canvas.Top="296" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="FAST"
                    FontSize="11" Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SintoniaFinaRapida}"
                    Tag="{Binding Pilotos[SintoniaFinaRapida].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Fast}" />
            <Button Canvas.Left="882" Canvas.Top="296" Width="60" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="TUNE"
                    FontSize="11" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Sintonizador}"
                    Tag="{Binding Pilotos[Sintonizador].Encendido}"
                    ToolTip="{loc:Texto Cabina.Frontal.TuneFt891}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding SintonizarAcopladorCommand}" />
                </Button.InputBindings>
            </Button>
        </Canvas>
    </Viewbox>
</frontales:FrontalDibujado>
