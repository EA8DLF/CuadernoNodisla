<frontales:FrontalDibujado x:Class="Nodisla.Cuaderno.Ui.Vistas.Frontales.FrontalFt991"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:frontales="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Frontales"
             xmlns:puertos="clr-namespace:Nodisla.Cuaderno.Aplicacion.Puertos;assembly=Nodisla.Cuaderno.Aplicacion">

    <!--
        EL FRONTAL DEL YAESU FT-991 / FT-991A (docs/18-frontales.md). Cuerpo de 229 × 115 mm,
        proporción 2:1: en el lienzo común de 1040 × 335 va centrado, 670 de ancho.

          · Izquierda: POWER, MOX, VOX, TUNE y las tomas PHONES y MIC.
          · La pantalla táctil de 3,5" (VisorDeVfos con el analizador) y, debajo, tres filas de
            teclas: MODE · BAND · A/B · V/M · SPLIT / NB · DNR · DNF · NAR · ATT · IPO /
            AGC · CLAR · FINE · ZIN.
          · Derecha: AF GAIN · RF/SQL y MULTI arriba; el dial grande; LOCK y QMB.
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="PiezasDeLosFrontales.xaml" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Canvas Width="1040" Height="335">
            <Border Canvas.Left="185" Canvas.Top="0" Width="670" Height="335" CornerRadius="12"
                    Background="{StaticResource Cuerpo}" BorderBrush="{StaticResource CuerpoBorde}" BorderThickness="1.5" />

            <!-- ══ Columna izquierda ══ -->
            <Button Canvas.Left="195" Canvas.Top="14" Width="56" Height="26" Style="{StaticResource TeclaDelFrontal}"
                    Click="AlEncender" IsEnabled="{Binding PuedeEncenderOApagar}"
                    ToolTip="{loc:Texto Cabina.Frontal.Power}">
                <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" /><Run Text=" PWR" FontSize="10" /></TextBlock>
            </Button>
            <Border Canvas.Left="215" Canvas.Top="45" Width="16" Height="5" Style="{StaticResource PilotoEncendido}" />
            <Button Canvas.Left="195" Canvas.Top="58" Width="56" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MOX"
                    Command="{Binding MoxCommand}" Tag="{Binding EnMox}"
                    ToolTip="{loc:Texto Cabina.Frontal.Mox}" />
            <Button Canvas.Left="195" Canvas.Top="90" Width="56" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="VOX"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Vox}"
                    Tag="{Binding Pilotos[Vox].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Vox}" />
            <Button Canvas.Left="195" Canvas.Top="122" Width="56" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="TUNE"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Sintonizador}"
                    Tag="{Binding Pilotos[Sintonizador].Encendido}"
                    ToolTip="{loc:Texto Cabina.Frontal.Tune}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding SintonizarAcopladorCommand}" />
                </Button.InputBindings>
            </Button>
            <TextBlock Canvas.Left="191" Canvas.Top="178" Width="64" Text="PHONES" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="205" Canvas.Top="192" Width="36" Height="36" ToolTip="{loc:Texto Cabina.Frontal.Phones}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3" Fill="#FF15171A" />
                <Ellipse Margin="12" Fill="#FF020203" />
            </Grid>
            <TextBlock Canvas.Left="191" Canvas.Top="244" Width="64" Text="MIC" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Grid Canvas.Left="200" Canvas.Top="258" Width="46" Height="46" ToolTip="{loc:Texto Cabina.Frontal.Mic}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="4" Fill="#FF0D0F11" />
                <Ellipse Margin="13" Fill="#FF050607" />
            </Grid>

            <!-- ══ La pantalla de 3,5" ══ -->
            <TextBlock Canvas.Left="266" Canvas.Top="3" Text="YAESU" Foreground="#FFB08A45" FontFamily="Arial Black, Arial"
                       FontSize="13" FontStyle="Italic" FontWeight="Black" />
            <TextBlock Canvas.Left="498" Canvas.Top="2" Text="FT-991A" Foreground="{StaticResource Dorado}" FontFamily="Arial"
                       FontSize="14" FontStyle="Italic" FontWeight="Bold" />
            <Border Canvas.Left="262" Canvas.Top="22" Width="316" Height="186" CornerRadius="5"
                    Background="#FF08090A" BorderBrush="#FF3A3F46" BorderThickness="1.2" />
            <Viewbox Canvas.Left="268" Canvas.Top="27" Width="304" Height="176" Stretch="Fill">
                <vistas:VisorDeVfos Width="430" Height="244"
                                    RotuloDelAnalizador="{Binding DataContext.Analizador.RotuloEnPantalla, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AnchoDelAnalizadorHz="{Binding DataContext.Analizador.SpanHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                    InicioFijoDelAnalizadorHz="{Binding DataContext.Analizador.InicioFijoHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AnalizadorAmpliado="{Binding DataContext.Analizador.Ampliado, RelativeSource={RelativeSource AncestorType=Window}}">
                    <vistas:VisorDeVfos.ContenidoDelAnalizador>
                        <vistas:AnalizadorDelEquipo DataContext="{Binding DataContext.Analizador, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </vistas:VisorDeVfos.ContenidoDelAnalizador>
                </vistas:VisorDeVfos>
            </Viewbox>

            <!-- ══ Las tres filas de teclas de debajo ══ -->
            <Button Canvas.Left="262" Canvas.Top="218" Width="58" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="MODE"
                    Command="{Binding SiguienteModoCommand}" ToolTip="{loc:Texto Cabina.Frontal.Mode}" />
            <Button Canvas.Left="326" Canvas.Top="218" Width="58" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="BAND"
                    Command="{Binding SiguienteBandaCommand}" ToolTip="{loc:Texto Cabina.Frontal.Band}" />
            <Button Canvas.Left="390" Canvas.Top="218" Width="58" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="A/B"
                    Command="{Binding ActivarVfoCommand}" CommandParameter="{Binding Secundario}"
                    ToolTip="{loc:Texto Cabina.Frontal.AB}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding IgualarVfosCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="454" Canvas.Top="218" Width="58" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="V/M"
                    Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.VfoOMemoria}"
                    Tag="{Binding EnMemoria}" ToolTip="{loc:Texto Cabina.Frontal.VM}" />
            <Button Canvas.Left="518" Canvas.Top="218" Width="58" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="SPLIT"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Split}"
                    Tag="{Binding Pilotos[Split].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Split}" />

            <Button Canvas.Left="262" Canvas.Top="252" Width="48" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NB"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SupresorDeRuido}"
                    Tag="{Binding Pilotos[SupresorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nb}" />
            <Button Canvas.Left="315" Canvas.Top="252" Width="48" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="DNR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.ReductorDeRuido}"
                    Tag="{Binding Pilotos[ReductorDeRuido].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Dnr}" />
            <Button Canvas.Left="368" Canvas.Top="252" Width="48" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="DNF"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.MuescaAutomatica}"
                    Tag="{Binding Pilotos[MuescaAutomatica].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Dnf}" />
            <Button Canvas.Left="421" Canvas.Top="252" Width="48" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="NAR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroEstrecho}"
                    Tag="{Binding Pilotos[FiltroEstrecho].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Nar}" />
            <Button Canvas.Left="474" Canvas.Top="252" Width="48" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="ATT"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Atenuador}"
                    ToolTip="{Binding Pilotos[Atenuador].ValorTexto}" />
            <Button Canvas.Left="527" Canvas.Top="252" Width="49" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="IPO"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Preamplificador}"
                    ToolTip="{Binding Pilotos[Preamplificador].ValorTexto}" />

            <Button Canvas.Left="262" Canvas.Top="286" Width="74" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="AGC"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Agc}"
                    ToolTip="{Binding Pilotos[Agc].ValorTexto}" />
            <Button Canvas.Left="342" Canvas.Top="286" Width="74" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="CLAR"
                    Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Rit}"
                    Tag="{Binding Pilotos[Rit].Encendido}" MouseWheel="AlGirarSobreClar"
                    ToolTip="{loc:Texto Cabina.Frontal.Clar}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.BorrarClarificador}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="422" Canvas.Top="286" Width="74" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="FAST"
                    Command="{Binding SiguientePosicionCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.SintoniaFinaRapida}"
                    Tag="{Binding Pilotos[SintoniaFinaRapida].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Fast}" />
            <Button Canvas.Left="502" Canvas.Top="286" Width="74" Height="26" Style="{StaticResource TeclaDelFrontal}" Content="ZIN/SPOT"
                    FontSize="10" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.AjusteACero}"
                    Tag="{Binding Pilotos[TonoDeReferenciaCw].Encendido}"
                    ToolTip="{loc:Texto Cabina.Frontal.ZinSpot}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.TonoDeReferenciaCw}" />
                </Button.InputBindings>
            </Button>

            <!-- ══ Derecha: mandos y dial ══ -->
            <TextBlock Canvas.Left="590" Canvas.Top="6" Width="80" Text="AF/RF·SQL" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="598" Canvas.Top="20" Width="64" Height="64"
                                   Rotulo="AF/RF-SQL" Explicacion="{loc:Texto Cabina.Explica.RfVolumen}"
                                   Mando="{Binding MandoDeGananciaRf}" MandoInterior="{Binding MandoDeVolumen}" />
            <TextBlock Canvas.Left="680" Canvas.Top="6" Width="80" Text="SHIFT/WIDTH" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="688" Canvas.Top="20" Width="64" Height="64"
                                   Rotulo="SHIFT/WIDTH" Explicacion="{loc:Texto Cabina.Explica.ShiftWidth}"
                                   Mando="{Binding Frontal[DesplazamientoFi]}" MandoInterior="{Binding MandoDeAnchoDeFiltro}" />
            <TextBlock Canvas.Left="770" Canvas.Top="6" Width="80" Text="MULTI" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <vistas:MandoGiratorio Canvas.Left="778" Canvas.Top="20" Width="64" Height="64"
                                   Rotulo="MULTI" Explicacion="{loc:Texto Cabina.Explica.MultiPotencia}" Mando="{Binding MandoDePotencia}" />

            <frontales:DialDelFrontal Canvas.Left="622" Canvas.Top="104" Width="196" Height="196" />

            <Button Canvas.Left="596" Canvas.Top="300" Width="52" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="LOCK"
                    FontSize="10" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.Bloqueo}"
                    Tag="{Binding Pilotos[Bloqueo].Encendido}" ToolTip="{loc:Texto Cabina.Frontal.Lock}" />
            <Button Canvas.Left="792" Canvas.Top="300" Width="52" Height="24" Style="{StaticResource TeclaDelFrontal}" Content="QMB"
                    FontSize="10" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.RecuperarMemoriaRapida}"
                    ToolTip="{loc:Texto Cabina.Frontal.Qmb}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.GuardarMemoriaRapida}" />
                </Button.InputBindings>
            </Button>
            <TextBlock Canvas.Left="800" Canvas.Top="96" Width="44" Text="TX" Style="{StaticResource Serigrafiado}" FontSize="10" />
            <Border Canvas.Left="814" Canvas.Top="110" Width="16" Height="8" Style="{StaticResource PilotoTx}" />

            <TextBlock Canvas.Left="660" Canvas.Top="318" Style="{StaticResource SinProbar}" FontSize="9" />
        </Canvas>
    </Viewbox>
</frontales:FrontalDibujado>
