<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.Frontales.DialDelFrontal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Focusable="True"
             Background="Transparent"
             MouseWheel="AlGirar"
             PreviewKeyDown="AlTeclear"
             AutomationProperties.Name="{loc:Texto Cabina.Frontal.DialPrincipal}"
             ToolTip="{loc:Texto Cabina.Frontal.DialPrincipalAyuda}">

    <!--
        El dial grande, el mismo dibujo que el del FT-710 (canto estriado, aro de metal, cara
        negra de espejo y la hendidura para el dedo), en 222 × 222 dentro de un Viewbox: mide lo
        que le dé el frontal. La rueda y las flechas mueven el dial del equipo por la misma orden
        que el FT-710 (VistaModeloEquipo.GirarDialAsync).
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="PiezasDeLosFrontales.xaml" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="222" Height="222">
            <Ellipse Fill="#90000000" Margin="3,6,-3,-6" />
            <Ellipse Fill="#FF0B0C0E" />
            <Ellipse Margin="3" Stroke="{StaticResource CantoMetalico}" StrokeThickness="26" Opacity="0.8" />
            <Ellipse Margin="3" Stroke="#FF08090A" StrokeThickness="26" StrokeDashArray="0.07 0.07" Opacity="0.75" />
            <Ellipse Margin="10" Stroke="#FF08090A" StrokeThickness="12" StrokeDashArray="0.14 0.14" StrokeDashOffset="0.07" Opacity="0.6" />
            <Ellipse Margin="29" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3.5" />
            <Ellipse Margin="32">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.32,0.24" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Offset="0" Color="#FF4C535B" />
                        <GradientStop Offset="0.3" Color="#FF1A1D21" />
                        <GradientStop Offset="1" Color="#FF040506" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Margin="40" Stretch="Fill" Opacity="0.35" Width="60" Height="80"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M 30,0 C 10,10 0,40 8,80 C 12,40 20,20 60,5 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#90FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Ellipse Width="52" Height="52" Margin="72,56,0,0" Stroke="#FF020304" StrokeThickness="1.5">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.62,0.75" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Offset="0" Color="#FF30353B" />
                        <GradientStop Offset="1" Color="#FF030405" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Viewbox>
</UserControl>
