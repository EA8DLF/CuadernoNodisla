<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDelEquipo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesCat}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        CAT / EQUIPO.

        Aquí se elige POR DÓNDE se habla con la radio. Estaba escrito en el código y venía en
        «Ninguna», así que el botón Conectar del panel del equipo no abría nada: ese era el
        fallo entero.

        PROBAR NO TRANSMITE. Abre, lee identificación, frecuencia y modo, y cierra. Ni una sola
        orden que ponga el equipo en antena ni que le mueva los VFO.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

        <Style x:Key="Fila" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- En otros idiomas el rótulo puede no caber en una línea: se parte, no se corta. -->
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <!-- Pastilla con la vía que hay puesta AHORA, que no es la que se está tecleando. -->
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="8,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FondoCampo}"
                    BorderBrush="{DynamicResource Borde}"
                    BorderThickness="1">
                <TextBlock Text="{Binding ViaPuesta}" FontSize="10" />
            </Border>

            <TextBlock Text="{loc:Texto Ajustes.Equipo.Titulo}" Style="{StaticResource TituloDeSeccion}" />
        </DockPanel>

        <TextBlock Text="{loc:Texto Ajustes.Equipo.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- ══ El parte de la prueba, con su pastilla de color ══ -->
        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding HayParte, Converter={StaticResource BooleanoAVisible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resultado}" Value="Correcto">
                            <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Resultado}" Value="Fallido">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" />
        </Border>

        <!-- ══ Vía de control ══ -->
        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Ajustes.Equipo.Via}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Vias}"
                      SelectedItem="{Binding Via}"
                      AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Via.Accesible}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Text="{Binding Via.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <!-- ══ Lo del CAT nativo ══ -->
        <StackPanel Visibility="{Binding EsCatNativo, Converter={StaticResource BooleanoAVisible}}">
            <!-- Fabricante y modelo (docs/16-modelos.md). En automático: Yaesu por ID; e ICOM por CI-V 19 00. -->
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Fabricante}" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Fabricantes}"
                          SelectedItem="{Binding Fabricante}"
                          DisplayMemberPath="Titulo"
                          AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Fabricante.Accesible}" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding SeElijeModelo, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Modelo}" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding ModelosDelFabricante}"
                          SelectedItem="{Binding Modelo}"
                          DisplayMemberPath="Titulo"
                          AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Modelo.Accesible}" />
            </DockPanel>

            <TextBlock Text="{Binding AvisoDelModelo}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6"
                       Visibility="{Binding SeElijeModelo, Converter={StaticResource BooleanoAVisible}}" />

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding EsIcom, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Civ}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding DireccionCiv, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" HorizontalAlignment="Left"
                         ToolTip="{loc:Texto Ajustes.Equipo.Civ.Ayuda}"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Civ.Accesible}" />
            </DockPanel>

            <CheckBox Content="{loc:Texto Ajustes.Equipo.Detectar}"
                      IsChecked="{Binding DetectarElPuerto}"
                      Margin="150,0,0,4"
                      ToolTip="{loc:Texto Ajustes.Equipo.Detectar.Ayuda}" />

            <TextBlock Text="{loc:Texto Ajustes.Equipo.Detectar.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6"
                       Visibility="{Binding DetectarElPuerto, Converter={StaticResource BooleanoAVisible}}" />

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding SeElijePuerto, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Puerto}" Style="{StaticResource Rotulo}" />
                <Button DockPanel.Dock="Right"
                        Content="{loc:Texto Ajustes.Equipo.VolverAMirar}"
                        Command="{Binding RefrescarPuertosCommand}"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        AutomationProperties.Name="{loc:Texto Ajustes.Equipo.VolverAMirar.Accesible}" />
                <ComboBox ItemsSource="{Binding Puertos}"
                          SelectedItem="{Binding Puerto}"
                          AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Puerto.Accesible}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParaElDesplegable}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Velocidad}" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Velocidades}"
                          SelectedItem="{Binding Velocidad}"
                          AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Velocidad.Accesible}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <TextBlock Text="{loc:Texto Ajustes.Equipo.Velocidad.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Lo de Hamlib ══ -->
        <StackPanel Visibility="{Binding EsRigctld, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Maquina}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding MaquinaDeRigctld, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Maquina.Accesible}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.PuertoTcp}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding PuertoDeRigctld, UpdateSourceTrigger=PropertyChanged}"
                         Width="90"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.PuertoTcp.Accesible}" />
            </DockPanel>
            <TextBlock Text="{loc:Texto Ajustes.Equipo.Rigctld.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Lo de OmniRig ══ -->
        <StackPanel Visibility="{Binding EsOmniRig, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.OmniRig}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding EquipoDeOmniRig, UpdateSourceTrigger=PropertyChanged}"
                         Width="60"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.OmniRig.Accesible}" />
            </DockPanel>
            <TextBlock Text="{loc:Texto Ajustes.Equipo.OmniRig.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Tiempos ══ -->
        <StackPanel Visibility="{Binding HayEquipo, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Sondeo}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding SondeoMs, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Sondeo.Accesible}" />
                <TextBlock Text="{loc:Texto Ajustes.Equipo.DeFabrica, Valor={Binding Source='500'}}"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.Espera}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding EsperaDeOrdenMs, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Espera.Accesible}" />
                <TextBlock Text="{loc:Texto Ajustes.Equipo.DeFabrica, Valor={Binding Source='350'}}"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <!-- ══ PTT ══ -->
            <TextBlock Text="PTT" Style="{StaticResource TituloDeSeccion}" Margin="0,6,0,2" />

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.SeSube}" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding ViasDePtt}"
                          SelectedItem="{Binding PttPor}"
                          AutomationProperties.Name="{loc:Texto Ajustes.Equipo.SeSube.Accesible}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <TextBlock Text="{Binding PttPor.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6" />

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.MaximoEnAntena}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding TiempoMaximoSegundos, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.MaximoEnAntena.Accesible}" />
                <TextBlock Text="{loc:Texto Ajustes.Equipo.MaximoEnAntena.DeFabrica}"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="{loc:Texto Ajustes.Equipo.SinLatido}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding TiempoSinLatidoSegundos, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="{loc:Texto Ajustes.Equipo.SinLatido.Accesible}" />
                <TextBlock Text="{loc:Texto Ajustes.Equipo.DeFabrica, Valor={Binding Source='15'}}"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <TextBlock Text="{loc:Texto Ajustes.Equipo.Vigilante}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Botones ══ -->
        <WrapPanel Margin="0,2,0,6">
            <Button Content="{loc:Texto Comun.Probar}"
                    Command="{Binding ProbarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="{loc:Texto Ajustes.Equipo.Probar.Ayuda}"
                    AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Probar.Accesible}" />
            <Button Content="{loc:Texto Ajustes.Equipo.Aplicar}"
                    Command="{Binding AplicarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="{loc:Texto Ajustes.Equipo.Aplicar.Ayuda}"
                    AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Aplicar.Accesible}" />
            <Button Content="{loc:Texto Ajustes.Descartar}"
                    Command="{Binding DescartarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    AutomationProperties.Name="{loc:Texto Ajustes.Equipo.Descartar.Accesible}" />
        </WrapPanel>

    </StackPanel>
</UserControl>
