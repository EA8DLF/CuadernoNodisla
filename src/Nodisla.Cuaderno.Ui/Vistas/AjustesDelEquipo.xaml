<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDelEquipo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesCat}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        CAT / EQUIPO.

        Aquí se elige POR DÓNDE se habla con la radio. Estaba escrito en el código y venía en
        «Ninguna», así que el botón Conectar del panel del equipo no abría nada: ese era el
        fallo entero.

        PROBAR NO TRANSMITE. Abre, lee identificación, frecuencia y modo, y cierra. Ni una sola
        orden que ponga el equipo en antena ni que le mueva los VFO.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

        <Style x:Key="Fila" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <!-- Pastilla con la vía que hay puesta AHORA, que no es la que se está tecleando. -->
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="8,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FondoCampo}"
                    BorderBrush="{DynamicResource Borde}"
                    BorderThickness="1">
                <TextBlock Text="{Binding ViaPuesta}" FontSize="10" />
            </Border>

            <TextBlock Text="CAT · control del equipo" Style="{StaticResource TituloDeSeccion}" />
        </DockPanel>

        <TextBlock Text="Por dónde habla el cuaderno con la radio. Mientras esto sea «Ninguna», el botón Conectar del panel del equipo no abre nada."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- ══ El parte de la prueba, con su pastilla de color ══ -->
        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding HayParte, Converter={StaticResource BooleanoAVisible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Resultado}" Value="Correcto">
                            <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Resultado}" Value="Fallido">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" />
        </Border>

        <!-- ══ Vía de control ══ -->
        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Vía de control" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Vias}"
                      SelectedItem="{Binding Via}"
                      AutomationProperties.Name="Vía de control del equipo">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Text="{Binding Via.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <!-- ══ Lo del CAT nativo ══ -->
        <StackPanel Visibility="{Binding EsCatNativo, Converter={StaticResource BooleanoAVisible}}">
            <!-- Fabricante y modelo (docs/16-modelos.md). En automático: Yaesu por ID; e ICOM por CI-V 19 00. -->
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Fabricante" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Fabricantes}"
                          SelectedItem="{Binding Fabricante}"
                          DisplayMemberPath="Titulo"
                          AutomationProperties.Name="Fabricante del equipo" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding SeElijeModelo, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="Modelo" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding ModelosDelFabricante}"
                          SelectedItem="{Binding Modelo}"
                          DisplayMemberPath="Titulo"
                          AutomationProperties.Name="Modelo del equipo" />
            </DockPanel>

            <TextBlock Text="{Binding AvisoDelModelo}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6"
                       Visibility="{Binding SeElijeModelo, Converter={StaticResource BooleanoAVisible}}" />

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding EsIcom, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="Dirección CI-V" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding DireccionCiv, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" HorizontalAlignment="Left"
                         ToolTip="En hexadecimal (94 para el IC-7300). Vacío = la de fábrica del modelo."
                         AutomationProperties.Name="Dirección CI-V en hexadecimal" />
            </DockPanel>

            <CheckBox Content="Detectar automáticamente por qué puerto está el equipo"
                      IsChecked="{Binding DetectarElPuerto}"
                      Margin="150,0,0,4"
                      ToolTip="Prueba primero por donde estaba y, si no contesta, recorre todos los puertos preguntando ID;" />

            <TextBlock Text="Se identifica por lo que contesta a ID;, nunca por el número de puerto: en esta máquina hay otro cacharro que también habla por serie."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6"
                       Visibility="{Binding DetectarElPuerto, Converter={StaticResource BooleanoAVisible}}" />

            <DockPanel Style="{StaticResource Fila}"
                       Visibility="{Binding SeElijePuerto, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="Puerto serie" Style="{StaticResource Rotulo}" />
                <Button DockPanel.Dock="Right"
                        Content="Volver a mirar"
                        Command="{Binding RefrescarPuertosCommand}"
                        Margin="6,0,0,0"
                        Padding="8,2"
                        AutomationProperties.Name="Volver a mirar qué puertos serie hay" />
                <ComboBox ItemsSource="{Binding Puertos}"
                          SelectedItem="{Binding Puerto}"
                          AutomationProperties.Name="Puerto serie del equipo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParaElDesplegable}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Velocidad" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Velocidades}"
                          SelectedItem="{Binding Velocidad}"
                          AutomationProperties.Name="Velocidad del puerto serie">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <TextBlock Text="La velocidad la manda el equipo, no el cable: está en su menú, en CAT RATE. De fábrica son 38400. Si no la sabe, deje puesta la detección automática: las prueba todas."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Lo de Hamlib ══ -->
        <StackPanel Visibility="{Binding EsRigctld, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Máquina" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding MaquinaDeRigctld, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Máquina donde escucha rigctld" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Puerto TCP" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding PuertoDeRigctld, UpdateSourceTrigger=PropertyChanged}"
                         Width="90"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="Puerto TCP de rigctld" />
            </DockPanel>
            <TextBlock Text="Hay que tener rigctld ya arrancado. Lo habitual es 127.0.0.1 en el puerto 4532."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Lo de OmniRig ══ -->
        <StackPanel Visibility="{Binding EsOmniRig, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Equipo de OmniRig" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding EquipoDeOmniRig, UpdateSourceTrigger=PropertyChanged}"
                         Width="60"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="Número de equipo de OmniRig" />
            </DockPanel>
            <TextBlock Text="OmniRig maneja dos equipos: el 1 y el 2. El que aquí se ponga es el que sigue el cuaderno."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Tiempos ══ -->
        <StackPanel Visibility="{Binding HayEquipo, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Sondeo (ms)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding SondeoMs, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="Intervalo de sondeo en milisegundos" />
                <TextBlock Text="de fábrica, 500"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Espera de orden (ms)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding EsperaDeOrdenMs, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="Espera de orden en milisegundos" />
                <TextBlock Text="de fábrica, 350"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <!-- ══ PTT ══ -->
            <TextBlock Text="PTT" Style="{StaticResource TituloDeSeccion}" Margin="0,6,0,2" />

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Se sube" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding ViasDePtt}"
                          SelectedItem="{Binding PttPor}"
                          AutomationProperties.Name="Por dónde se sube el PTT">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <TextBlock Text="{Binding PttPor.Explicacion}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,6" />

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Máximo en antena (s)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding TiempoMaximoSegundos, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="Tiempo máximo en antena, en segundos" />
                <TextBlock Text="de fábrica, 180 · tope duro, 600"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <DockPanel Style="{StaticResource Fila}">
                <TextBlock Text="Sin latido (s)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding TiempoSinLatidoSegundos, UpdateSourceTrigger=PropertyChanged}"
                         Width="70"
                         DockPanel.Dock="Left"
                         AutomationProperties.Name="Tiempo sin latido, en segundos" />
                <TextBlock Text="de fábrica, 15"
                           Style="{StaticResource TextoTenueEstilo}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>

            <TextBlock Text="El vigilante baja el PTT pase lo que pase: al agotarse el tiempo, si quien transmite deja de dar señales de vida, si salta un fallo y al cerrar el programa. Un PTT pegado quema la etapa final."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="150,0,0,8" />
        </StackPanel>

        <!-- ══ Botones ══ -->
        <WrapPanel Margin="0,2,0,6">
            <Button Content="Probar"
                    Command="{Binding ProbarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="Abre la conexión, lee identificación, frecuencia y modo, y cierra. No transmite."
                    AutomationProperties.Name="Probar la conexión con el equipo" />
            <Button Content="Aplicar"
                    Command="{Binding AplicarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="Guarda y cambia el control del equipo sin cerrar el cuaderno"
                    AutomationProperties.Name="Guardar y aplicar los ajustes del equipo" />
            <Button Content="Descartar"
                    Command="{Binding DescartarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    AutomationProperties.Name="Descartar los cambios y volver a lo guardado" />
        </WrapPanel>

    </StackPanel>
</UserControl>
