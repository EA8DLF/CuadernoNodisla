<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDeSubidas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        SUBIDA AUTOMÁTICA A LOTW, EQSL Y CLUB LOG, Y LA COLA.

        QRZ.com va encima, en su propio bloque (AjustesDeQrz), con la clave, la casilla y la
        prueba juntas. Aquí queda una casilla por cada uno de los demás servicios, con cuántos
        contactos tiene subidos y cuántos no, y la cola de todos con lo que falta por subir.
        Las cuentas de estos servicios (usuario y contraseña) están en su tarjeta, en «Cuentas
        y servicios».
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Subida automática a los demás servicios ── -->
        <TextBlock Text="{loc:Texto Ajustes.Subidas.Titulo}" Style="{StaticResource TituloDeSeccion}" Margin="0,6,0,4" />
        <TextBlock Text="{loc:Texto Ajustes.Subidas.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,2" />
        <TextBlock Text="{loc:Texto Ajustes.Subidas.CuentasEn}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,6" />

        <ItemsControl ItemsSource="{Binding ServiciosSinQrz}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Semaforo}" Value="Verde">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Semaforo}" Value="Ambar">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AvisoBorde}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Semaforo}" Value="Rojo">
                                        <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Activado}" FontWeight="Bold"
                                      AutomationProperties.Name="{Binding Nombre}">
                                <TextBlock Text="{loc:Texto Ajustes.Subidas.SubirA, Valor={Binding Nombre}}" />
                            </CheckBox>
                            <TextBlock Text="{Binding Estado}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Nota}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                            <vistas:AnterioresDeSubida />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,2,0,4">
            <Button DockPanel.Dock="Left"
                    Content="{loc:Texto Ajustes.Subidas.SubirAhora}"
                    Command="{Binding SubirAhoraCommand}"
                    AutomationProperties.Name="{loc:Texto Ajustes.Subidas.SubirAhora.Accesible}" />
            <TextBlock Text="{Binding Parte}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock Text="{loc:Texto Ajustes.Subidas.Cola}" Style="{StaticResource Rotulo}" Margin="0,10,0,1" />
        <TextBlock Text="{Binding ColaRecortada}"
                   Style="{StaticResource TextoTenueEstilo}"
                   Visibility="{Binding ColaRecortada, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Text="{loc:Texto Ajustes.Subidas.ColaVacia}"
                   Style="{StaticResource TextoTenueEstilo}"
                   Visibility="{Binding ColaVacia, Converter={StaticResource BooleanoAVisible}}" />
        <ItemsControl ItemsSource="{Binding Cola}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,1">
                        <Run Text="{Binding Servicio, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="·" />
                        <Run Text="{Binding Indicativo, Mode=OneWay}" />
                        <Run Text="{Binding Cuando, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Estado, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
