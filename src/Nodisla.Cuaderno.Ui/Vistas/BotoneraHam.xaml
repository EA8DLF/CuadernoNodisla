<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.BotoneraHam"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas">

    <!--
        PANEL «HAM», a la izquierda del frontal: Banda (como la tecla BAND: BS, la pila de banda
        del equipo), Modo y Memoria (M1…M6). Todo va al VFO activo y nada transmite.
        DataContext = VistaModeloEquipo.
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="EstilosDeLaBotonera.xaml" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelDeLaBotonera}" ToolTip="{Binding MotivoDeLaBotonera}" ToolTipService.ShowOnDisabled="True">
        <StackPanel>
            <DockPanel>
                <Button x:Name="BotonCambiar" DockPanel.Dock="Right" Content="CB ▸" Style="{StaticResource PestanaDeLaBotonera}"
                        Visibility="Collapsed" Click="AlPedirCambio" VerticalAlignment="Center"
                        ToolTip="{loc:Texto Cabina.Botonera.VerCbAyuda}"
                        AutomationProperties.Name="{loc:Texto Cabina.Botonera.VerCb}" />
                <TextBlock Text="HAM" Style="{StaticResource TituloDeLaBotonera}" />
            </DockPanel>

            <StackPanel Orientation="Horizontal">
                <!-- Banda: 3 columnas, como en la radio de izquierda a derecha y de arriba abajo. -->
                <StackPanel Width="132">
                    <TextBlock Text="{loc:Texto Comun.Banda}" Style="{StaticResource SubtituloDeLaBotonera}" />
                    <ItemsControl ItemsSource="{Binding TeclasDeBanda}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.TeclasDeBanda}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TeclaDeLaBotonera}"
                                        Command="{Binding DataContext.IrABandaCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraHam}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Width="132" Margin="8,0,0,0">
                    <TextBlock Text="{loc:Texto Comun.Modo}" Style="{StaticResource SubtituloDeLaBotonera}" />
                    <ItemsControl ItemsSource="{Binding TeclasDeModo}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.TeclasDeModo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TeclaDeLaBotonera}"
                                        Command="{Binding DataContext.PonerModoDeTeclaCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraHam}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Texto Cabina.Botonera.Memoria}" Style="{StaticResource SubtituloDeLaBotonera}" />
                    <ItemsControl ItemsSource="{Binding TeclasDeMemoria}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.Memorias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TeclaDeLaBotonera}"
                                        Command="{Binding DataContext.RecuperarMemoriaCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraHam}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
