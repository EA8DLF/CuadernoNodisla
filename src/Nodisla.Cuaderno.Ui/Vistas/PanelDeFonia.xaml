<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeFonia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             Foreground="{DynamicResource Texto}">

    <!--
        FONÍA POR EL PC.

        Una sola franja bajo el frontal, para no quitar sitio al contacto y al cluster:
        el PTT grande a la izquierda, el cartel de EN EL AIRE a su lado y luego los
        medidores y mandos. Los selectores de micro y altavoces se despliegan aparte.

        El PTT de aquí va SIEMPRE por el vigilante: el modelo se lo pide a la fonía y la
        fonía al vigilante. «SOLTAR PTT» de la barra corta también esto.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:MarcaDelEquipo x:Key="DelEquipo" />

        <DataTemplate x:Key="Dispositivo">
            <TextBlock>
                <Run Text="{Binding Nombre, Mode=OneWay}" />
                <Run Text="{Binding EsDelEquipo, Mode=OneWay, Converter={StaticResource DelEquipo}}" Foreground="{DynamicResource TextoTenue}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <WrapPanel x:Name="Fila" Orientation="Horizontal">

            <!-- Título y estado -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="92">
                <TextBlock Text="{loc:Texto Cabina.Fonia.Titulo}" Style="{StaticResource TituloDeSeccion}" Margin="0" />
                <TextBlock Text="SSB · AM · FM" Style="{StaticResource TextoTenueEstilo}" />
            </StackPanel>

            <!-- El PTT -->
            <Button x:Name="BotonPtt"
                    MinWidth="230"
                    Height="46"
                    FontSize="15"
                    Content="{Binding TextoDelPtt}"
                    IsEnabled="{Binding PuedeTransmitir}"
                    Focusable="False"
                    PreviewMouseLeftButtonDown="AlPulsarElPtt"
                    PreviewMouseLeftButtonUp="AlSoltarElPtt"
                    LostMouseCapture="AlPerderElRatonDelPtt"
                    ToolTip="{Binding MotivoDeNoPoder}"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="{loc:Texto Cabina.Fonia.PttNombre}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BotonQueTransmite}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ErrorBorde}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorTexto}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- EN EL AIRE -->
            <Border Margin="8,0,0,0"
                    Padding="10,2"
                    MinWidth="150"
                    CornerRadius="3"
                    BorderThickness="2"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource FondoResalte}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ErrorBorde}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorTexto}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:Texto Cabina.Fonia.EnRecepcion}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                        <Setter Property="Text" Value="{loc:Texto Cabina.Fonia.EnElAire}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontFamily="Consolas">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding TextoDelTope}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                        <Setter Property="Text" Value="{Binding TiempoEnElAire}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Micro: medidor y ganancia -->
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="150">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{loc:Texto Cabina.Fonia.Satura}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ErrorTexto}"
                               Visibility="{Binding MicroSatura, Converter={StaticResource BooleanoAVisible}}" />
                    <TextBlock Style="{StaticResource TextoTenueEstilo}">
                        <Run Text="{loc:Texto Cabina.Fonia.Micro}" />
                        <Run Text="{Binding Ajustes.GananciaTxDb, StringFormat={}{0:+0;-0;0} dB, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <ProgressBar Minimum="0" Maximum="1" Height="7" Value="{Binding NivelMicro, Mode=OneWay}"
                             AutomationProperties.Name="{loc:Texto Cabina.Fonia.NivelMicro}" />
                <Slider Minimum="-20" Maximum="20" SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding Ajustes.GananciaTxDb}"
                        ToolTip="{loc:Texto Cabina.Fonia.GananciaMicroAyuda}"
                        AutomationProperties.Name="{loc:Texto Cabina.Fonia.GananciaMicro}" />
            </StackPanel>

            <!-- Escucha: medidor, volumen y silencio -->
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="175">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="{loc:Texto Cabina.Fonia.Silencio}" IsChecked="{Binding Ajustes.SilencioRx}"
                              AutomationProperties.Name="{loc:Texto Cabina.Fonia.Silenciar}" />
                    <TextBlock Style="{StaticResource TextoTenueEstilo}">
                        <Run Text="{loc:Texto Cabina.Fonia.Escucha}" />
                        <Run Text="{Binding Ajustes.VolumenRx, StringFormat={}{0} %, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <ProgressBar Minimum="0" Maximum="1" Height="7" Value="{Binding NivelRx, Mode=OneWay}"
                             AutomationProperties.Name="{loc:Texto Cabina.Fonia.NivelEscucha}" />
                <Slider Minimum="0" Maximum="200" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                        Value="{Binding Ajustes.VolumenRx}"
                        ToolTip="{loc:Texto Cabina.Fonia.VolumenAyuda}"
                        AutomationProperties.Name="{loc:Texto Cabina.Fonia.Volumen}" />
            </StackPanel>

            <Button Margin="12,0,0,0"
                          Padding="10,4"
                          VerticalAlignment="Center"
                          Command="{Binding AlternarEscuchaCommand}"
                          ToolTip="{loc:Texto Cabina.Fonia.EscucharAyuda}"
                          AutomationProperties.Name="{loc:Texto Cabina.Fonia.EscucharNombre}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="{loc:Texto Cabina.Fonia.EscucharPorElPc}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Escuchando}" Value="True">
                                <Setter Property="Content" Value="{loc:Texto Cabina.Fonia.EscuchandoParar}" />
                                <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <ToggleButton x:Name="Desplegar"
                          Margin="6,0,0,0"
                          Padding="8,4"
                          VerticalAlignment="Center"
                          Content="{loc:Texto Cabina.Fonia.Dispositivos}"
                          AutomationProperties.Name="{loc:Texto Cabina.Fonia.ElegirDispositivos}" />
        </WrapPanel>

        <!-- Procesado de la escucha, mensajes de voz y grabador de la recepción -->
        <WrapPanel x:Name="Extras" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                <CheckBox Content="{loc:Texto Cabina.Fonia.Nr}" IsChecked="{Binding Ajustes.ReductorActivo}" VerticalAlignment="Center"
                          ToolTip="{loc:Texto Ajustes.Fonia.Reductor.Ayuda}" />
                <Slider Width="80" Margin="4,0,8,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Value="{Binding Ajustes.NivelDeReduccion}" IsEnabled="{Binding Ajustes.ReductorActivo}"
                        ToolTip="{loc:Texto Ajustes.Fonia.Reductor.Nivel}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Reductor.Nivel}" />
                <CheckBox Content="{loc:Texto Cabina.Fonia.Notch}" IsChecked="{Binding Ajustes.NotchActivo}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="{loc:Texto Ajustes.Fonia.Notch.Ayuda}" />
                <CheckBox Content="{loc:Texto Cabina.Fonia.Limitador}" IsChecked="{Binding Ajustes.LimitadorActivo}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="{loc:Texto Ajustes.Fonia.Limitador.Ayuda}" />
                <TextBlock Text="{Binding LatenciaDelProcesado}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{loc:Texto Cabina.Fonia.Latencia.Ayuda}" />
                <ToggleButton x:Name="DesplegarProcesado" Padding="8,2" VerticalAlignment="Center"
                              Content="{loc:Texto Cabina.Fonia.Procesado}"
                              AutomationProperties.Name="{loc:Texto Cabina.Fonia.Procesado.Accesible}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                <TextBlock Text="{loc:Texto Cabina.Fonia.Voz.Titulo}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ItemsControl ItemsSource="{Binding Mensajes.Mensajes}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Rotulo}" Padding="6,2" Margin="0,0,3,0" Focusable="False"
                                    Style="{StaticResource BotonQueTransmite}"
                                    IsEnabled="{Binding Grabado}"
                                    Command="{Binding DataContext.Mensajes.EmitirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Duracion}"
                                    ToolTipService.ShowOnDisabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Width="60" Height="7" Minimum="0" Maximum="1" Margin="4,0" VerticalAlignment="Center"
                             Value="{Binding AvanceDelMensaje, Mode=OneWay}"
                             Visibility="{Binding EnviandoMensaje, Converter={StaticResource BooleanoAVisible}}"
                             AutomationProperties.Name="{loc:Texto Cabina.Fonia.Voz.Avance}" />
                <Button Content="{loc:Texto Cabina.Fonia.Voz.Parar}" Padding="8,2" Margin="0,0,4,0" VerticalAlignment="Center"
                        Command="{Binding Mensajes.PararCommand}"
                        Visibility="{Binding EnviandoMensaje, Converter={StaticResource BooleanoAVisible}}" />
                <CheckBox Content="{loc:Texto Digital.Modem.PermitirTransmitir}" IsChecked="{Binding Mensajes.PermitirTransmitir}"
                          VerticalAlignment="Center" Margin="4,0,6,0"
                          ToolTip="{loc:Texto Cabina.Fonia.Voz.Pestillo.Ayuda}" />
                <ToggleButton x:Name="DesplegarMensajes" Padding="8,2" VerticalAlignment="Center"
                              Content="{loc:Texto Cabina.Fonia.Voz.Editar}"
                              AutomationProperties.Name="{loc:Texto Cabina.Fonia.Voz.Editar.Accesible}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                <Button Content="{Binding Grabacion.TextoDelBoton}" Padding="8,2" VerticalAlignment="Center"
                        Command="{Binding Grabacion.GuardarCommand}"
                        IsEnabled="{Binding Ajustes.GrabarRecepcion}"
                        ToolTip="{loc:Texto Cabina.Fonia.Grabador.Ayuda}" />
                <TextBlock Text="{Binding Grabacion.Grabado}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="6,0,8,0"
                           ToolTip="{loc:Texto Cabina.Fonia.Grabador.EnMemoria}" />
                <CheckBox Content="{loc:Texto Cabina.Fonia.Grabador.Adjuntar}" IsChecked="{Binding Ajustes.AdjuntarAlQso}" VerticalAlignment="Center"
                          ToolTip="{loc:Texto Ajustes.Fonia.Grabacion.Adjuntar.Ayuda}" />
            </StackPanel>
        </WrapPanel>

        <!-- Avisos -->
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource TextoTenueEstilo}"
                   Text="{Binding MotivoDeNoPoder}"
                   Visibility="{Binding MotivoDeNoPoder, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}" FontWeight="Bold"
                   Text="{Binding AvisoDeFuente}"
                   Visibility="{Binding AvisoDeFuente, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}" FontWeight="Bold"
                   Text="{Binding AvisoDeEscucha}"
                   Visibility="{Binding AvisoDeEscucha, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}"
                   Text="{Binding Ajustes.AvisoDeDispositivos}"
                   Visibility="{Binding Ajustes.AvisoDeDispositivos, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}"
                   Text="{Binding Aviso}"
                   Visibility="{Binding Aviso, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}"
                   Text="{Binding Mensajes.Aviso}"
                   Visibility="{Binding Mensajes.Aviso, Converter={StaticResource NoEsVacio}}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource TextoTenueEstilo}"
                   Text="{Binding Grabacion.Aviso}"
                   Visibility="{Binding Grabacion.Aviso, Converter={StaticResource NoEsVacio}}" />

        <!-- Procesado: en una ventanita, lo mismo que Configuración › Fonía -->
        <Popup x:Name="PopupProcesado" PlacementTarget="{Binding ElementName=DesplegarProcesado}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=DesplegarProcesado, Mode=TwoWay}">
            <Border Style="{StaticResource Tarjeta}" Padding="12,8" MaxWidth="640">
                <vistas:ProcesadoDeFonia DataContext="{Binding Ajustes}" />
            </Border>
        </Popup>

        <!-- Mensajes de voz: grabar, escuchar, nombrar y borrar, en local -->
        <Popup x:Name="PopupMensajes" PlacementTarget="{Binding ElementName=DesplegarMensajes}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=DesplegarMensajes, Mode=TwoWay}">
            <Border Style="{StaticResource Tarjeta}" Padding="12,8" MinWidth="520">
                <StackPanel x:Name="EditorDeMensajes">
                    <TextBlock Text="{loc:Texto Cabina.Fonia.Voz.Editar.Titulo}" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,6"
                               Text="{loc:Texto Cabina.Fonia.Voz.Editar.Explicacion}" />
                    <ItemsControl ItemsSource="{Binding Mensajes.Mensajes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Tecla}" Width="28" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="130" Margin="0,0,6,0" VerticalAlignment="Center"
                                             AutomationProperties.Name="{loc:Texto Cabina.Fonia.Voz.Nombre}" />
                                    <Button Padding="8,1" Margin="0,0,4,0" MinWidth="92"
                                            Command="{Binding DataContext.Mensajes.GrabarCommand, ElementName=EditorDeMensajes}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{loc:Texto Cabina.Fonia.Voz.Grabar}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GrabandoAhora}" Value="True">
                                                        <Setter Property="Content" Value="{loc:Texto Cabina.Fonia.Voz.TerminarGrabacion}" />
                                                        <Setter Property="Background" Value="{DynamicResource ErrorBorde}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Texto Cabina.Fonia.Voz.Escuchar}" Padding="8,1" Margin="0,0,4,0"
                                            IsEnabled="{Binding Grabado}"
                                            Command="{Binding DataContext.Mensajes.EscucharCommand, ElementName=EditorDeMensajes}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{loc:Texto Cabina.Fonia.Voz.Borrar}" Padding="8,1" Margin="0,0,8,0"
                                            IsEnabled="{Binding Grabado}"
                                            Command="{Binding DataContext.Mensajes.BorrarCommand, ElementName=EditorDeMensajes}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Duracion}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Minimum="0" Maximum="1" Height="6" Margin="0,4,0,0"
                                 Value="{Binding Mensajes.NivelDeGrabacion, Mode=OneWay}"
                                 Visibility="{Binding Mensajes.Grabando, Converter={StaticResource BooleanoAVisible}}"
                                 AutomationProperties.Name="{loc:Texto Cabina.Fonia.NivelMicro}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Solo en las capturas de la ayuda: las ventanitas no salen en el retrato, se ponen aqui. -->
        <StackPanel x:Name="EnLineaParaCaptura" Orientation="Horizontal" />

        <!-- Dispositivos: en una ventana emergente, para no quitar sitio a nadie -->
        <Popup PlacementTarget="{Binding ElementName=Desplegar}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=Desplegar, Mode=TwoWay}">
        <Border Style="{StaticResource Tarjeta}" Padding="10,8" MinWidth="520" MaxWidth="820">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Texto Cabina.Fonia.MicrofonoPc}" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,4"
                      ItemsSource="{Binding Ajustes.Entradas}" SelectedItem="{Binding Ajustes.Microfono}"
                      ItemTemplate="{StaticResource Dispositivo}"
                      AutomationProperties.Name="{loc:Texto Cabina.Fonia.MicrofonoPc}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Texto Cabina.Fonia.AltavocesPc}" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,12,4"
                      ItemsSource="{Binding Ajustes.Salidas}" SelectedItem="{Binding Ajustes.Altavoces}"
                      ItemTemplate="{StaticResource Dispositivo}"
                      AutomationProperties.Name="{loc:Texto Cabina.Fonia.AltavocesPc}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Texto Cabina.Fonia.EntradaEquipo}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                      ItemsSource="{Binding Ajustes.Entradas}" SelectedItem="{Binding Ajustes.EntradaDelEquipo}"
                      ItemTemplate="{StaticResource Dispositivo}"
                      AutomationProperties.Name="{loc:Texto Cabina.Fonia.EntradaEquipoNombre}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Texto Cabina.Fonia.SalidaEquipo}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,12,0"
                      ItemsSource="{Binding Ajustes.Salidas}" SelectedItem="{Binding Ajustes.SalidaAlEquipo}"
                      ItemTemplate="{StaticResource Dispositivo}"
                      AutomationProperties.Name="{loc:Texto Cabina.Fonia.SalidaEquipoNombre}" />

            <Button Grid.Row="0" Grid.Column="4" Content="{loc:Texto Cabina.Fonia.VolverABuscar}" Padding="8,1" Margin="0,0,0,4"
                    Command="{Binding Ajustes.RefrescarDispositivosCommand}" />
            <Button Grid.Row="1" Grid.Column="4" Content="{loc:Texto Cabina.Fonia.ComprobarRadio}" Padding="8,1"
                    Command="{Binding ComprobarFuenteCommand}"
                    ToolTip="{loc:Texto Cabina.Fonia.ComprobarRadioAyuda}" />
        </Grid>
        </Border>
        </Popup>
    </StackPanel>
</UserControl>
