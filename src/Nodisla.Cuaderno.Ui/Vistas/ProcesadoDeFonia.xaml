<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.ProcesadoDeFonia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        PROCESADO DE LA FONÍA: lo que se le hace a la escucha, al micrófono y la grabación.
        Espera como contexto VistaModeloAjustesFonia. Va en Configuración › Fonía y en la
        ventanita «Procesado» del panel de fonía: los dos sitios cambian lo mismo, en vivo.
    -->

    <StackPanel>
        <!-- Escucha -->
        <TextBlock Text="{loc:Texto Ajustes.Fonia.Escucha.Titulo}" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,6" MaxWidth="560" HorizontalAlignment="Left"
                   Text="{loc:Texto Ajustes.Fonia.Escucha.Explicacion}" />
        <WrapPanel>
            <CheckBox Content="{loc:Texto Ajustes.Fonia.Reductor}" IsChecked="{Binding ReductorActivo}" VerticalAlignment="Center" Margin="0,0,8,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.Reductor.Ayuda}" />
            <ComboBox MinWidth="190" Margin="0,0,12,6" ItemsSource="{Binding Reductores}" SelectedItem="{Binding Reductor}" DisplayMemberPath="Texto"
                      AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Reductor.Tipo}" />
            <StackPanel Width="170" Margin="0,0,12,6">
                <TextBlock>
                    <Run Text="{loc:Texto Ajustes.Fonia.Reductor.Nivel}" />
                    <Run Text="{Binding NivelDeReduccion, StringFormat={}{0} %, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding NivelDeReduccion}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Reductor.Nivel}" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <CheckBox Content="{loc:Texto Ajustes.Fonia.Notch}" IsChecked="{Binding NotchActivo}" VerticalAlignment="Center" Margin="0,0,16,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.Notch.Ayuda}" />
            <CheckBox Content="{loc:Texto Ajustes.Fonia.Limitador}" IsChecked="{Binding LimitadorActivo}" VerticalAlignment="Center" Margin="0,0,8,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.Limitador.Ayuda}" />
            <StackPanel Width="170" Margin="0,0,12,6">
                <TextBlock>
                    <Run Text="{loc:Texto Ajustes.Fonia.Techo}" />
                    <Run Text="{Binding TechoEscuchaDb, StringFormat={}{0:0} dBFS, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Slider Minimum="-20" Maximum="-1" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TechoEscuchaDb}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Techo.Escucha}" />
            </StackPanel>
        </WrapPanel>

        <!-- Micrófono -->
        <TextBlock Text="{loc:Texto Ajustes.Fonia.Micro.Titulo}" FontWeight="Bold" Margin="0,8,0,2" />
        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,6" MaxWidth="560" HorizontalAlignment="Left"
                   Text="{loc:Texto Ajustes.Fonia.Micro.Explicacion}" />
        <CheckBox Content="{loc:Texto Ajustes.Fonia.Micro.Procesar}" IsChecked="{Binding ProcesarMicro}" Margin="0,0,0,6" />
        <StackPanel IsEnabled="{Binding ProcesarMicro}">
            <WrapPanel>
                <CheckBox Content="{loc:Texto Ajustes.Fonia.Puerta}" IsChecked="{Binding PuertaActiva}" VerticalAlignment="Center" Margin="0,0,8,6"
                          ToolTip="{loc:Texto Ajustes.Fonia.Puerta.Ayuda}" />
                <StackPanel Width="210" Margin="0,0,16,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Puerta.Umbral}" />
                        <Run Text="{Binding UmbralPuertaDb, StringFormat={}{0:0} dBFS, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-80" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding UmbralPuertaDb}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Puerta.Umbral}" />
                </StackPanel>
                <TextBlock Text="{loc:Texto Ajustes.Fonia.CorteDeGraves}" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox MinWidth="110" Margin="0,0,0,6" ItemsSource="{Binding Cortes}" SelectedItem="{Binding CorteDeGraves}" DisplayMemberPath="Texto"
                          AutomationProperties.Name="{loc:Texto Ajustes.Fonia.CorteDeGraves}" />
            </WrapPanel>
            <WrapPanel>
                <StackPanel Width="140" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Graves}" />
                        <Run Text="{Binding GravesDb, StringFormat={}{0:+0;-0;0} dB, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-12" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GravesDb}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Graves}" />
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Medios}" />
                        <Run Text="{Binding MediosDb, StringFormat={}{0:+0;-0;0} dB, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-12" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MediosDb}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Medios}" />
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Agudos}" />
                        <Run Text="{Binding AgudosDb, StringFormat={}{0:+0;-0;0} dB, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-12" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AgudosDb}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Agudos}" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel>
                <CheckBox Content="{loc:Texto Ajustes.Fonia.Compresor}" IsChecked="{Binding CompresorActivo}" VerticalAlignment="Center" Margin="0,0,8,6"
                          ToolTip="{loc:Texto Ajustes.Fonia.Compresor.Ayuda}" />
                <StackPanel Width="150" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Compresor.Umbral}" />
                        <Run Text="{Binding UmbralCompresorDb, StringFormat={}{0:0} dBFS, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-40" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding UmbralCompresorDb}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Compresor.Umbral}" />
                </StackPanel>
                <StackPanel Width="120" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Compresor.Relacion}" />
                        <Run Text="{Binding RelacionCompresor, StringFormat={}{0:0.#}:1, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RelacionCompresor}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Compresor.Relacion}" />
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,12,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Fonia.Techo}" />
                        <Run Text="{Binding TechoMicroDb, StringFormat={}{0:0} dBFS, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-12" Maximum="-1" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TechoMicroDb}"
                            ToolTip="{loc:Texto Ajustes.Fonia.Techo.Micro.Ayuda}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Techo.Micro}" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- Grabación y mensajes -->
        <TextBlock Text="{loc:Texto Ajustes.Fonia.Grabacion.Titulo}" FontWeight="Bold" Margin="0,8,0,2" />
        <WrapPanel>
            <CheckBox Content="{loc:Texto Ajustes.Fonia.Grabacion.Grabar}" IsChecked="{Binding GrabarRecepcion}" VerticalAlignment="Center" Margin="0,0,8,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.Grabacion.Grabar.Ayuda}" />
            <StackPanel Width="150" Margin="0,0,16,6" IsEnabled="{Binding GrabarRecepcion}">
                <TextBlock>
                    <Run Text="{loc:Texto Ajustes.Fonia.Grabacion.Minutos}" />
                    <Run Text="{Binding MinutosDeGrabacion, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinutosDeGrabacion}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Fonia.Grabacion.Minutos}" />
            </StackPanel>
            <CheckBox Content="{loc:Texto Ajustes.Fonia.Grabacion.Adjuntar}" IsChecked="{Binding AdjuntarAlQso}" VerticalAlignment="Center" Margin="0,0,16,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.Grabacion.Adjuntar.Ayuda}" />
            <CheckBox Content="{loc:Texto Ajustes.Fonia.TeclasDeMensajes}" IsChecked="{Binding TeclasDeMensajes}" VerticalAlignment="Center" Margin="0,0,16,6"
                      ToolTip="{loc:Texto Ajustes.Fonia.TeclasDeMensajes.Ayuda}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
