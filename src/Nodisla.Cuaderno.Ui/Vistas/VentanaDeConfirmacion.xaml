<Window x:Class="Nodisla.Cuaderno.Ui.Vistas.VentanaDeConfirmacion"
        Icon="/Nodisla.Cuaderno.Ui;component/Recursos/CuadernoNodisla.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuaderno NODISLA"
        SizeToContent="Height"
        Width="540"
        MinWidth="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource FondoVentana}"
        Foreground="{DynamicResource Texto}"
        FontFamily="Segoe UI"
        FontSize="15">

    <Border Style="{StaticResource Tarjeta}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="TextoTitulo"
                       Style="{StaticResource TituloDeSeccion}"
                       FontSize="18" />

            <TextBlock x:Name="TextoDetalle"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       VerticalAlignment="Top"
                       Margin="0,0,0,18" />

            <CheckBox x:Name="CasillaNoVolverAPreguntar"
                      Content="No volver a preguntar"
                      Visibility="Collapsed"
                      Margin="0,0,0,14"
                      ToolTip="Se puede volver a activar en Configuración › Audio y digitales." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BotonCancelar"
                        Content="Cancelar"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="AlCancelar" />
                <Button x:Name="BotonAceptar"
                        Style="{StaticResource BotonPrincipal}"
                        IsDefault="True"
                        Click="AlAceptar" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
