<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.ConexionDelCluster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesCluster}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        CONEXIÓN AL CLUSTER.

        El nodo, el indicativo con el que se entra y el guion de arranque estaban escritos en el
        código del registro de servicios, sin contraseña y sin pantalla donde cambiarlos.

        LA CONTRASEÑA NO SE GUARDA AQUÍ: va al almacén cifrado con la protección de datos de la
        cuenta de Windows, y una vez escrita no se vuelve a enseñar. En el fichero de ajustes no
        aparece nunca.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />

        <Style x:Key="Fila" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <!-- Con qué indicativo se entra de verdad, sufijo incluido. -->
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="8,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FondoCampo}"
                    BorderBrush="{DynamicResource Borde}"
                    BorderThickness="1">
                <TextBlock Text="{Binding IndicativoDeAcceso}" FontSize="10" FontWeight="Bold" />
            </Border>

            <TextBlock Text="{loc:Texto Principal.ConexionCluster.Titulo}" Style="{StaticResource TituloDeSeccion}" />
        </DockPanel>

        <TextBlock Text="{loc:Texto Principal.ConexionCluster.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding HayParte, Converter={StaticResource BooleanoAVisible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fallo}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" />
        </Border>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.NodosConocidos}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Nodos}"
                      SelectedItem="{Binding Nodo}"
                      ToolTip="{loc:Texto Principal.ConexionCluster.NodosConocidosConsejo}"
                      AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.NodosConocidosNombre}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ParaElDesplegable}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Text="{Binding NotaDelNodo}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.NombreDelNodo}" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.Servidor}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Servidor, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.ServidorDelNodo}" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.Puerto}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Puerto, UpdateSourceTrigger=PropertyChanged}"
                     Width="70"
                     DockPanel.Dock="Left"
                     AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.PuertoDelNodo}" />
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.PuertoAyuda}"
                       Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Comun.Indicativo}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}"
                     Width="110"
                     DockPanel.Dock="Left"
                     CharacterCasing="Upper"
                     AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.IndicativoNombre}" />
            <TextBlock Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{loc:Texto Principal.ConexionCluster.IndicativoEnBlanco}" />
                <Run Text="{Binding IndicativoDelPerfil, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.Sufijo}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Sufijo, UpdateSourceTrigger=PropertyChanged}"
                     Width="50"
                     DockPanel.Dock="Left"
                     AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.SufijoNombre}" />
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.SufijoAyuda}"
                       Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- ══ La contraseña, al almacén cifrado ══ -->
        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="{loc:Texto Principal.ConexionCluster.Contrasena}" Style="{StaticResource Rotulo}" />
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="7,1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContrasenaGuardada}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EstadoDeLaContrasena}" FontSize="10" />
            </Border>

            <Button DockPanel.Dock="Right"
                    Content="{loc:Texto Comun.Borrar}"
                    Command="{Binding BorrarLaContrasenaCommand}"
                    Margin="5,0,0,0"
                    Padding="8,2"
                    AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.BorrarContrasena}" />
            <Button DockPanel.Dock="Right"
                    Content="{loc:Texto Comun.Guardar}"
                    Command="{Binding GuardarLaContrasenaCommand}"
                    Margin="5,0,0,0"
                    Padding="8,2"
                    AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.GuardarContrasena}" />
            <PasswordBox x:Name="CasillaDeLaContrasena"
                         PasswordChanged="AlEscribirLaContrasena"
                         Padding="6,3"
                         Background="{DynamicResource FondoCampo}"
                         Foreground="{DynamicResource Texto}"
                         BorderBrush="{DynamicResource Borde}"
                         BorderThickness="1"
                         AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.ContrasenaNombre}" />
        </DockPanel>

        <TextBlock Text="{loc:Texto Principal.ConexionCluster.ContrasenaAyuda}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <!-- ══ Guion de arranque ══ -->
        <TextBlock Text="{loc:Texto Principal.ConexionCluster.Ordenes}" Style="{StaticResource EtiquetaDeCampo}" />
        <TextBlock Text="{loc:Texto Principal.ConexionCluster.OrdenesAyuda}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,3" />
        <TextBox Text="{Binding GuionDeArranque, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 MinLines="3"
                 MaxLines="8"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Mono, Courier New"
                 Margin="0,0,0,8"
                 AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.OrdenesNombre}" />

        <CheckBox Content="{loc:Texto Principal.ConexionCluster.Reconectar}"
                  IsChecked="{Binding ReconectarSolo}"
                  Margin="0,0,0,6" />

        <Expander Header="{loc:Texto Principal.ConexionCluster.Tiempos}" Margin="0,0,0,8">
            <StackPanel Margin="0,4,0,0">
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="{loc:Texto Principal.ConexionCluster.EsperaConexion}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding EsperaDeConexionSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.EsperaConexionNombre}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="{loc:Texto Principal.ConexionCluster.PrimerReintento}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding PrimerReintentoSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.PrimerReintentoNombre}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="{loc:Texto Principal.ConexionCluster.ReintentoMaximo}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ReintentoMaximoSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.ReintentoMaximoNombre}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="{loc:Texto Principal.ConexionCluster.SilencioMaximo}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding SilencioMaximoMinutos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.SilencioMaximoNombre}" />
                </DockPanel>
                <TextBlock Text="{loc:Texto Principal.ConexionCluster.SilencioAyuda}"
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <WrapPanel Margin="0,0,0,6">
            <Button Content="{loc:Texto Principal.ConexionCluster.Aplicar}"
                    Command="{Binding AplicarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="{loc:Texto Principal.ConexionCluster.AplicarConsejo}"
                    AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.AplicarNombre}" />
            <Button Content="{loc:Texto Principal.ConexionCluster.Descartar}"
                    Command="{Binding DescartarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    AutomationProperties.Name="{loc:Texto Principal.ConexionCluster.DescartarNombre}" />
        </WrapPanel>

    </StackPanel>
</UserControl>
