<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.ConexionDelCluster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesCluster}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        CONEXIÓN AL CLUSTER.

        El nodo, el indicativo con el que se entra y el guion de arranque estaban escritos en el
        código del registro de servicios, sin contraseña y sin pantalla donde cambiarlos.

        LA CONTRASEÑA NO SE GUARDA AQUÍ: va al almacén cifrado con la protección de datos de la
        cuenta de Windows, y una vez escrita no se vuelve a enseñar. En el fichero de ajustes no
        aparece nunca.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />

        <Style x:Key="Fila" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <!-- Con qué indicativo se entra de verdad, sufijo incluido. -->
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="8,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FondoCampo}"
                    BorderBrush="{DynamicResource Borde}"
                    BorderThickness="1">
                <TextBlock Text="{Binding IndicativoDeAcceso}" FontSize="10" FontWeight="Bold" />
            </Border>

            <TextBlock Text="Cluster · conexión" Style="{StaticResource TituloDeSeccion}" />
        </DockPanel>

        <TextBlock Text="A qué nodo se entra y con qué indicativo. La mayoría de los nodos no pide contraseña: basta el indicativo."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding HayParte, Converter={StaticResource BooleanoAVisible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fallo}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" />
        </Border>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Nodos conocidos" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Nodos}"
                      SelectedItem="{Binding Nodo}"
                      ToolTip="Elegir uno rellena el servidor y el puerto; después puede cambiarlos"
                      AutomationProperties.Name="Nodos de cluster conocidos">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ParaElDesplegable}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Text="{Binding NotaDelNodo}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Nombre" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Nombre del nodo" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Servidor" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Servidor, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Servidor del nodo" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Puerto" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Puerto, UpdateSourceTrigger=PropertyChanged}"
                     Width="70"
                     DockPanel.Dock="Left"
                     AutomationProperties.Name="Puerto de Telnet del nodo" />
            <TextBlock Text="lo habitual es 7300; hay nodos en el 23 y en el 8000"
                       Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Indicativo" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}"
                     Width="110"
                     DockPanel.Dock="Left"
                     CharacterCasing="Upper"
                     AutomationProperties.Name="Indicativo con el que se entra al cluster" />
            <TextBlock Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis">
                <Run Text="en blanco, el del perfil activo:" />
                <Run Text="{Binding IndicativoDelPerfil, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
        </DockPanel>

        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Sufijo" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Sufijo, UpdateSourceTrigger=PropertyChanged}"
                     Width="50"
                     DockPanel.Dock="Left"
                     AutomationProperties.Name="Sufijo del indicativo" />
            <TextBlock Text="para tener dos sesiones abiertas: 1 se manda como «-1»"
                       Style="{StaticResource TextoTenueEstilo}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- ══ La contraseña, al almacén cifrado ══ -->
        <DockPanel Style="{StaticResource Fila}">
            <TextBlock Text="Contraseña" Style="{StaticResource Rotulo}" />
            <Border DockPanel.Dock="Right"
                    CornerRadius="8"
                    Padding="7,1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContrasenaGuardada}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EstadoDeLaContrasena}" FontSize="10" />
            </Border>

            <Button DockPanel.Dock="Right"
                    Content="Borrar"
                    Command="{Binding BorrarLaContrasenaCommand}"
                    Margin="5,0,0,0"
                    Padding="8,2"
                    AutomationProperties.Name="Borrar la contraseña guardada del cluster" />
            <Button DockPanel.Dock="Right"
                    Content="Guardar"
                    Command="{Binding GuardarLaContrasenaCommand}"
                    Margin="5,0,0,0"
                    Padding="8,2"
                    AutomationProperties.Name="Guardar cifrada la contraseña del cluster" />
            <PasswordBox x:Name="CasillaDeLaContrasena"
                         PasswordChanged="AlEscribirLaContrasena"
                         Padding="6,3"
                         Background="{DynamicResource FondoCampo}"
                         Foreground="{DynamicResource Texto}"
                         BorderBrush="{DynamicResource Borde}"
                         BorderThickness="1"
                         AutomationProperties.Name="Contraseña del nodo de cluster" />
        </DockPanel>

        <TextBlock Text="Se cifra con la protección de datos de su cuenta de Windows y no se vuelve a enseñar. En el fichero de ajustes no se escribe nunca."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="150,0,0,8" />

        <!-- ══ Guion de arranque ══ -->
        <TextBlock Text="Órdenes al conectar" Style="{StaticResource EtiquetaDeCampo}" />
        <TextBlock Text="Una por línea. &lt;CALLSIGN&gt; se cambia por el indicativo y &lt;PASSWORD&gt; por la contraseña; el resto se manda tal cual."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,3" />
        <TextBox Text="{Binding GuionDeArranque, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 MinLines="3"
                 MaxLines="8"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Mono, Courier New"
                 Margin="0,0,0,8"
                 AutomationProperties.Name="Órdenes que se mandan al conectar" />

        <CheckBox Content="Volver a conectar solo cuando se caiga el nodo"
                  IsChecked="{Binding ReconectarSolo}"
                  Margin="0,0,0,6" />

        <Expander Header="Tiempos" Margin="0,0,0,8">
            <StackPanel Margin="0,4,0,0">
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="Espera de conexión (s)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding EsperaDeConexionSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="Espera de conexión, en segundos" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="Primer reintento (s)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding PrimerReintentoSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="Espera antes del primer reintento, en segundos" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="Reintento máximo (s)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ReintentoMaximoSegundos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="Tope de la espera entre reintentos, en segundos" />
                </DockPanel>
                <DockPanel Style="{StaticResource Fila}">
                    <TextBlock Text="Silencio máximo (min)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding SilencioMaximoMinutos, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="Silencio máximo antes de dar la conexión por muerta, en minutos" />
                </DockPanel>
                <TextBlock Text="Un cluster vivo manda algo cada pocos minutos. Pasado el silencio máximo se da la conexión por muerta y se reintenta."
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <WrapPanel Margin="0,0,0,6">
            <Button Content="Aplicar"
                    Command="{Binding AplicarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    ToolTip="Guarda y cambia el nodo sin cerrar el cuaderno"
                    AutomationProperties.Name="Guardar y aplicar los ajustes del cluster" />
            <Button Content="Descartar"
                    Command="{Binding DescartarCommand}"
                    Margin="0,0,6,6"
                    Padding="12,3"
                    AutomationProperties.Name="Descartar los cambios del cluster" />
        </WrapPanel>

    </StackPanel>
</UserControl>
