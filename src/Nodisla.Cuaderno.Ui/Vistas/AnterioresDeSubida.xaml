<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AnterioresDeSubida"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}"
             Focusable="False">

    <!--
        CUÁNTO HAY SUBIDO A UN SERVICIO Y LOS CONTACTOS QUE YA ESTABAN EN EL CUADERNO.

        El contexto es una FilaDeServicioDeSubida. Va debajo de la casilla de cada servicio.

        La subida automática solo coge lo que se registra con la casilla ya marcada. Quien la
        marca con mil ochocientos contactos en el cuaderno ve «al día» y nada sube: aquí se le
        dice cuántos faltan y se le ofrece subirlos. La confirmación va en línea, sin ventana:
        no hace falta parar al operador para preguntarle una fecha.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
    </UserControl.Resources>

    <StackPanel>
        <!-- El recuento, siempre a la vista -->
        <TextBlock Text="{Binding RecuentoTexto}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   AutomationProperties.Name="{Binding RecuentoTexto}" />

        <!-- Hay contactos de antes: se ofrece subirlos -->
        <StackPanel Margin="0,8,0,0"
                    Visibility="{Binding HayAnterioresQueOfrecer, Converter={StaticResource BooleanoAVisible}}">
            <TextBlock Text="{Binding TextoDeAnteriores}" Style="{StaticResource TextoTenueEstilo}" />
            <Button Content="{loc:Texto Ajustes.Subidas.Anteriores.Boton}"
                    Command="{Binding PedirAnterioresCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,0"
                    Padding="10,2" />
        </StackPanel>

        <!-- La confirmación, en línea -->
        <Border Margin="0,8,0,0"
                Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource FondoCampo}"
                BorderBrush="{DynamicResource Borde}"
                BorderThickness="1"
                Visibility="{Binding PidiendoAnteriores, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel>
                <TextBlock Text="{Binding ResumenDeAnteriores}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Texto Ajustes.Subidas.Anteriores.Desde}"
                           Style="{StaticResource EtiquetaDeCampo}"
                           Margin="0,8,0,2" />
                <TextBox Text="{Binding DesdeTexto, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"
                         MinWidth="130"
                         Padding="6,3"
                         AutomationProperties.Name="{loc:Texto Ajustes.Subidas.Anteriores.Desde}" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="{Binding TextoDeConfirmar}"
                            Command="{Binding ConfirmarAnterioresCommand}"
                            Style="{StaticResource BotonPrincipal}"
                            Margin="0,0,6,0"
                            Padding="12,3" />
                    <Button Content="{loc:Texto Ajustes.Subidas.Anteriores.Descartar}"
                            Command="{Binding DescartarAnterioresCommand}"
                            IsCancel="True"
                            Padding="10,3" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- En marcha: por dónde va, y cómo pararla -->
        <StackPanel Margin="0,8,0,0"
                    Visibility="{Binding AnterioresEnMarcha, Converter={StaticResource BooleanoAVisible}}">
            <ProgressBar Value="{Binding Progreso, Mode=OneWay}"
                         Maximum="1"
                         Height="6"
                         Foreground="{DynamicResource Acento}"
                         Background="{DynamicResource FondoCampo}"
                         BorderBrush="{DynamicResource Borde}"
                         AutomationProperties.Name="{Binding ProgresoTexto}" />
            <DockPanel Margin="0,5,0,0">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Texto Ajustes.Subidas.Anteriores.Cancelar}"
                        Command="{Binding CancelarAnterioresCommand}"
                        Margin="8,0,0,0"
                        Padding="10,2"
                        VerticalAlignment="Top" />
                <TextBlock Text="{Binding ProgresoTexto}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <!-- Lo último que ha pasado: encolados, cancelada, terminada -->
        <TextBlock Text="{Binding ParteDeAnteriores}"
                   Style="{StaticResource TextoTenueEstilo}"
                   Margin="0,6,0,0"
                   Visibility="{Binding ParteDeAnteriores, Converter={StaticResource NoEsVacio}}" />
    </StackPanel>
</UserControl>
