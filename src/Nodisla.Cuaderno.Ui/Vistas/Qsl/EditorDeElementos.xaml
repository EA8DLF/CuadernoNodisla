<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:qsl="clr-namespace:Nodisla.Cuaderno.Ui.Qsl"
                    xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos">

    <!--
        LO COMÚN A LOS EDITORES DE QSL Y DE DIPLOMAS.

        El campo de texto elegido se edita igual en la tarjeta y en el diploma: es el mismo
        CampoEditable sobre el mismo CampoDeQsl, así que la plantilla vive aquí y los dos paneles
        la cargan. Las listas (tipografías, alineaciones) salen de CatalogosDelEditor, estáticas,
        para no depender de qué pantalla la muestra.
    -->

    <qsl:PincelDeColor x:Key="PincelDeColor" />

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muestra" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <DataTemplate DataType="{x:Type vistamodelos:CampoEditable}">
        <StackPanel>
            <TextBlock Text="Nombre" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre del campo" />

            <TextBlock Text="Texto (con variables)" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="2" MaxLines="5" VerticalContentAlignment="Top"
                     TextWrapping="Wrap" AutomationProperties.Name="Texto del campo" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="X mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding XMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,0,8,0"
                         AutomationProperties.Name="Posición horizontal en milímetros" />
                <TextBlock Grid.Column="2" Text="Y mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding YMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="Posición vertical en milímetros" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Ancho máximo (mm, 0 = sin límite) " VerticalAlignment="Center" />
                <TextBox Text="{Binding AnchoMaximoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         ToolTip="Lo que no quepa en ese ancho pasa a la línea siguiente: para párrafos."
                         AutomationProperties.Name="Ancho máximo del texto en milímetros" />
            </DockPanel>

            <TextBlock Text="Letra" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.Fuentes}" SelectedItem="{Binding Fuente}"
                      AutomationProperties.Name="Tipo de letra" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tamaño (pt) " VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TamanoPt, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="Tamaño de letra en puntos" />
                <WrapPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <CheckBox Content="Negrita" IsChecked="{Binding Negrita}" Margin="0,0,8,0" />
                    <CheckBox Content="Cursiva" IsChecked="{Binding Cursiva}" />
                </WrapPanel>
            </Grid>

            <TextBlock Text="Alineación respecto a X" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.Alineaciones}" SelectedItem="{Binding Alineacion}"
                      AutomationProperties.Name="Alineación del campo" />

            <TextBlock Text="Color del texto" Style="{StaticResource Rotulo}" />
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Muestra}"
                        Background="{Binding Color, Converter={StaticResource PincelDeColor}}" />
                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="#RRGGBB, #AARRGGBB (AA = opacidad) o un nombre en inglés: White, Navy…"
                         AutomationProperties.Name="Color del texto" />
            </DockPanel>

            <TextBlock Text="Recuadro detrás (vacío: sin recuadro)" Style="{StaticResource Rotulo}" />
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Muestra}"
                        Background="{Binding ColorDeRecuadro, Converter={StaticResource PincelDeColor}}" />
                <TextBox Text="{Binding ColorDeRecuadro, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Por ejemplo #E6FFFFFF: blanco casi opaco, para leer el texto sobre una foto"
                         AutomationProperties.Name="Color del recuadro" />
            </DockPanel>

            <CheckBox Content="Dato del contacto (QSL)" IsChecked="{Binding EsDelContacto}" Margin="0,8,0,0"
                      ToolTip="En la tarjeta QSL, los datos del contacto se quitan en el «Diseño para eQSL»: eQSL los pone por su cuenta."
                      AutomationProperties.Name="Es un dato del contacto" />
        </StackPanel>
    </DataTemplate>

    <!-- Logo, firma o adorno del diploma. -->
    <DataTemplate DataType="{x:Type vistamodelos:ImagenEditable}">
        <StackPanel>
            <TextBlock Text="Nombre" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de la imagen" />

            <TextBlock Text="Uso" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.UsosDeImagen}" SelectedItem="{Binding Uso}"
                      AutomationProperties.Name="Uso de la imagen" />

            <TextBlock Text="{Binding TextoDelFichero}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="X mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding XMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,0,8,0"
                         AutomationProperties.Name="Izquierda de la imagen en milímetros" />
                <TextBlock Grid.Column="2" Text="Y mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding YMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="Arriba de la imagen en milímetros" />
                <TextBlock Grid.Row="1" Text="Ancho " VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnchoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,8,0"
                         AutomationProperties.Name="Ancho de la imagen en milímetros" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Alto " VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AltoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,0,0"
                         AutomationProperties.Name="Alto de la imagen en milímetros" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Opacidad (0–1) " VerticalAlignment="Center" />
                <TextBox Text="{Binding Opacidad, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"
                         ToolTip="1 = opaca; 0,15 = sello de agua"
                         AutomationProperties.Name="Opacidad de la imagen" />
            </DockPanel>

            <CheckBox Content="Línea de firma debajo" IsChecked="{Binding LineaDeFirma}" Margin="0,8,0,0"
                      AutomationProperties.Name="Dibujar línea de firma" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
