<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
                    xmlns:qsl="clr-namespace:Nodisla.Cuaderno.Ui.Qsl"
                    xmlns:controles="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Controles"
                    xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos">

    <!--
        LO COMÚN A LOS EDITORES DE QSL Y DE DIPLOMAS.

        El campo de texto elegido se edita igual en la tarjeta y en el diploma: es el mismo
        CampoEditable sobre el mismo CampoDeQsl, así que la plantilla vive aquí y los dos paneles
        la cargan. Las listas (tipografías, alineaciones) salen de CatalogosDelEditor, estáticas,
        para no depender de qué pantalla la muestra.
    -->

    <BooleanToVisibilityConverter x:Key="VisibleSiMarcado" />

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <DataTemplate DataType="{x:Type vistamodelos:CampoEditable}">
        <StackPanel>
            <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Editor.NombreDelCampo}" />

            <TextBlock Text="{loc:Texto Qsl.Editor.TextoConVariables}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="2" MaxLines="5" VerticalContentAlignment="Top"
                     TextWrapping="Wrap" AutomationProperties.Name="{loc:Texto Qsl.Editor.TextoDelCampo}" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="X mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding XMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,0,8,0"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.PosicionX}" />
                <TextBlock Grid.Column="2" Text="Y mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding YMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.PosicionY}" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding AnchoMaximoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         ToolTip="{loc:Texto Qsl.Editor.AnchoMaximoAyuda}"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.AnchoMaximoNombre}" />
                <TextBlock Text="{loc:Texto Qsl.Editor.AnchoMaximo}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,4,0" />
            </DockPanel>

            <TextBlock Text="{loc:Texto Qsl.Editor.Letra}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.Fuentes}" SelectedItem="{Binding Fuente}"
                      AutomationProperties.Name="{loc:Texto Qsl.Editor.TipoDeLetra}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Texto Qsl.Editor.TamanoPt}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Grid.Column="1" Text="{Binding TamanoPt, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.TamanoPtNombre}" />
                <WrapPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <CheckBox Content="{loc:Texto Qsl.Editor.Negrita}" IsChecked="{Binding Negrita}" Margin="0,0,8,0" />
                    <CheckBox Content="{loc:Texto Qsl.Editor.Cursiva}" IsChecked="{Binding Cursiva}" />
                </WrapPanel>
            </Grid>

            <TextBlock Text="{loc:Texto Qsl.Editor.Alineacion}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDeAlineacion}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding Alineacion}"
                      AutomationProperties.Name="{loc:Texto Qsl.Editor.AlineacionNombre}" />

            <!-- Los colores se eligen en la paleta, no escribiendo códigos. -->
            <TextBlock Text="{loc:Texto Qsl.Editor.ColorDelTexto}" Style="{StaticResource Rotulo}" />
            <controles:SelectorDeColor Color="{Binding Color}" Titulo="{loc:Texto Qsl.Editor.ColorDelTexto}" AdmiteOpacidad="True" />

            <TextBlock Text="{loc:Texto Qsl.Editor.RecuadroDetras}" Style="{StaticResource Rotulo}" />
            <controles:SelectorDeColor Color="{Binding ColorDeRecuadro}" Titulo="{loc:Texto Qsl.Editor.RecuadroDetrasDelTexto}" AdmiteOpacidad="True"
                                       AdmiteVacio="True" TextoSiVacio="{loc:Texto Qsl.Editor.SinRecuadro}"
                                       ToolTip="{loc:Texto Qsl.Editor.RecuadroAyuda}" />

            <CheckBox Content="{loc:Texto Qsl.Editor.DatoDelContacto}" IsChecked="{Binding EsDelContacto}" Margin="0,8,0,0"
                      ToolTip="{loc:Texto Qsl.Editor.DatoDelContactoAyuda}"
                      AutomationProperties.Name="{loc:Texto Qsl.Editor.DatoDelContactoNombre}" />
        </StackPanel>
    </DataTemplate>

    <!-- Logo, firma o adorno del diploma. -->
    <DataTemplate DataType="{x:Type vistamodelos:ImagenEditable}">
        <StackPanel>
            <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Editor.NombreDeLaImagen}" />

            <TextBlock Text="{loc:Texto Qsl.Editor.Uso}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDeUso}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding Uso}"
                      AutomationProperties.Name="{loc:Texto Qsl.Editor.UsoDeLaImagen}" />

            <TextBlock Text="{Binding TextoDelFichero}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="X mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding XMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,0,8,0"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.ImagenX}" />
                <TextBlock Grid.Column="2" Text="Y mm " VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding YMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.ImagenY}" />
                <TextBlock Grid.Row="1" Text="{loc:Texto Qsl.Editor.Ancho}" VerticalAlignment="Center" Margin="0,4,4,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnchoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,8,0"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.ImagenAncho}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Texto Qsl.Editor.Alto}" VerticalAlignment="Center" Margin="0,4,4,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AltoMm, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,0,0"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.ImagenAlto}" />
            </Grid>

            <DockPanel Margin="0,6,0,0">
                <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding Opacidad, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"
                         ToolTip="{loc:Texto Qsl.Editor.OpacidadAyuda}"
                         AutomationProperties.Name="{loc:Texto Qsl.Editor.OpacidadNombre}" />
                <TextBlock Text="{loc:Texto Qsl.Editor.Opacidad01}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,4,0" />
            </DockPanel>

            <CheckBox Content="{loc:Texto Qsl.Editor.LineaDeFirma}" IsChecked="{Binding LineaDeFirma}" Margin="0,8,0,0"
                      AutomationProperties.Name="{loc:Texto Qsl.Editor.LineaDeFirmaNombre}" />
            <StackPanel Visibility="{Binding LineaDeFirma, Converter={StaticResource VisibleSiMarcado}}">
                <TextBlock Text="{loc:Texto Qsl.Editor.ColorLineaDeFirma}" Style="{StaticResource Rotulo}" />
                <controles:SelectorDeColor Color="{Binding ColorDeLinea}" Titulo="{loc:Texto Qsl.Editor.ColorLineaDeFirma}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
