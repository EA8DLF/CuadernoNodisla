<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.Qsl.DisenadorDeDiplomas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:qsl="clr-namespace:Nodisla.Cuaderno.Ui.Qsl"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:controles="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Controles"
             controles:SelectorDeColor.OrigenDeColores="{Binding}"
             Foreground="{DynamicResource Texto}"
             Loaded="AlCargar">

    <!--
        EL DISEÑADOR DE DIPLOMAS. La misma filosofía que el editor de la tarjeta QSL:

        Izquierda: la plantilla (papel, fondo, orla, numeración) y sus elementos.
        Centro: el diploma tal cual saldrá, con los textos, imágenes y tabla que se arrastran.
        Derecha: a quién va, el elemento elegido, el correo y el historial de emitidos.

        El diploma del centro ES la imagen de verdad: la misma rutina lo dibuja para el PNG y para
        el PDF. Las asas son rectángulos transparentes encima, dentro de un Viewbox medido en
        milímetros: arrastrar mueve en milímetros sin conversiones.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EditorDeElementos.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
            <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

            <Style x:Key="Boton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Padding" Value="8,3" />
            </Style>

            <Style x:Key="Etiqueta" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="86" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <!-- El asa de un elemento sobre el diploma: invisible hasta pasar por encima o elegirlo. -->
            <ControlTemplate x:Key="Asa" TargetType="Thumb">
                <Grid Background="#01FFFFFF">
                    <Rectangle x:Name="Marco" Stroke="#9900A0FF" StrokeThickness="0.4" StrokeDashArray="3 2" Opacity="0.0" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Marco" Property="Opacity" Value="1" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Elegido}" Value="True">
                        <Setter TargetName="Marco" Property="Opacity" Value="1" />
                        <Setter TargetName="Marco" Property="Stroke" Value="#FFFF8C00" />
                        <Setter TargetName="Marco" Property="StrokeThickness" Value="0.6" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- El asa de la tabla: su contexto es el diseñador, que no tiene «Elegido». -->
            <ControlTemplate x:Key="AsaDeTabla" TargetType="Thumb">
                <Grid Background="#01FFFFFF">
                    <Rectangle x:Name="Marco" Stroke="#9900A0FF" StrokeThickness="0.4" StrokeDashArray="3 2" Opacity="0.0" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Marco" Property="Opacity" Value="1" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="240" MaxWidth="330" />
            <ColumnDefinition Width="3*" MinWidth="360" />
            <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="370" />
        </Grid.ColumnDefinitions>

        <!-- ══ Plantilla y elementos ══ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Texto Qsl.Disenador.Plantilla}" Style="{StaticResource TituloDeSeccion}" />
                    <ComboBox ItemsSource="{Binding Disenos}" SelectedItem="{Binding Diseno}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.Plantilla}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{loc:Texto Comun.Guardar}" Command="{Binding GuardarCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Editor.GuardarLaPlantilla}" />
                        <Button Content="{loc:Texto Qsl.Editor.Deshacer}" Command="{Binding DescartarCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Editor.DeshacerCambios}" />
                        <Button Content="{loc:Texto Qsl.Editor.Nueva}" Command="{Binding NuevaPlantillaCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Editor.PlantillaNueva}" />
                        <Button Content="{loc:Texto Qsl.Editor.Duplicar}" Command="{Binding DuplicarPlantillaCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Editor.DuplicarLaPlantilla}" />
                        <Button Content="{loc:Texto Comun.Borrar}" Command="{Binding BorrarPlantillaCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Disenador.BorrarAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Editor.BorrarLaPlantilla}" />
                        <Button Content="{loc:Texto Qsl.Editor.UsarPorOmision}" Command="{Binding PonerPorOmisionCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Editor.UsarEstaPorOmision}" />
                        <Button Content="{loc:Texto Qsl.Disenador.Exportar}" Command="{Binding ExportarPlantillaCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Disenador.ExportarAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ExportarNombre}" />
                        <Button Content="{loc:Texto Qsl.Disenador.Importar}" Command="{Binding ImportarPlantillaCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ImportarNombre}" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Texto Qsl.Editor.EsLaDeOmision}" Style="{StaticResource TextoTenueEstilo}"
                               Visibility="{Binding EsLaDeOmision, Converter={StaticResource BooleanoAVisible}}" />
                    <TextBlock Text="{loc:Texto Qsl.Editor.CambiosSinGuardar}" Foreground="{DynamicResource AvisoTexto}" FontWeight="SemiBold"
                               Visibility="{Binding HayCambios, Converter={StaticResource BooleanoAVisible}}" />

                    <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding NombreDelDiseno, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Editor.NombreDeLaPlantilla}" />

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Papel}" Style="{StaticResource Etiqueta}" />
                        <CheckBox DockPanel.Dock="Right" Content="{loc:Texto Qsl.Disenador.Vertical}" IsChecked="{Binding Vertical}" VerticalAlignment="Center" Margin="8,0,0,0"
                                  AutomationProperties.Name="{loc:Texto Qsl.Disenador.VerticalNombre}" />
                        <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDePapel}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding Papel}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TamanoDePapel}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Editor.Fondo}" Style="{StaticResource Rotulo}" />
                    <WrapPanel>
                        <Button Content="{loc:Texto Qsl.Editor.ElegirImagen}" Command="{Binding ElegirFondoCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Disenador.FondoAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Editor.ElegirImagenDeFondo}" />
                        <Button Content="{loc:Texto Qsl.Editor.Quitar}" Command="{Binding QuitarFondoCommand}" Style="{StaticResource Boton}"
                                Visibility="{Binding TieneFondo, Converter={StaticResource BooleanoAVisible}}" AutomationProperties.Name="{loc:Texto Qsl.Editor.QuitarImagenDeFondo}" />
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Texto Qsl.Editor.Ajuste}" Style="{StaticResource Etiqueta}" />
                        <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDeAjuste}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding Ajuste}" AutomationProperties.Name="{loc:Texto Qsl.Editor.ComoSeAjusta}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Editor.Color}" Style="{StaticResource Etiqueta}" />
                        <controles:SelectorDeColor Color="{Binding ColorDeFondo}" Titulo="{loc:Texto Qsl.Disenador.ColorDelPapel}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Disenador.Orla}" Style="{StaticResource Rotulo}" />
                    <DockPanel>
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Estilo}" Style="{StaticResource Etiqueta}" />
                        <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDeOrla}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding EstiloDeMarco}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.EstiloDeLaOrla}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Editor.Color}" Style="{StaticResource Etiqueta}" />
                        <controles:SelectorDeColor Color="{Binding ColorDelMarco}" Titulo="{loc:Texto Qsl.Disenador.ColorDeLaOrla}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Adorno}" Style="{StaticResource Etiqueta}" />
                        <controles:SelectorDeColor Color="{Binding ColorSecundarioDelMarco}" Titulo="{loc:Texto Qsl.Disenador.ColorDelAdorno}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.MargenMm}" Style="{StaticResource Etiqueta}" />
                        <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding GrosorDelMarco, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.GrosorNombre}" />
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Texto Qsl.Disenador.Grosor}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <TextBox Text="{Binding MargenDelMarco, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.MargenNombre}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Disenador.NumeracionYFirma}" Style="{StaticResource Rotulo}" />
                    <DockPanel>
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Serie}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Serie, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{loc:Texto Qsl.Disenador.SerieAyuda}"
                                 AutomationProperties.Name="{loc:Texto Qsl.Disenador.SerieNombre}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Prefijo}" Style="{StaticResource Etiqueta}" />
                        <TextBox DockPanel.Dock="Right" Width="40" Text="{Binding CifrasDelNumero, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.CifrasNombre}" />
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Texto Qsl.Disenador.Cifras}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <TextBox Text="{Binding PrefijoDeNumero, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Texto Qsl.Disenador.PrefijoAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.PrefijoNombre}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Gestor}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding NombreDelGestor, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Texto Qsl.Disenador.GestorAyuda, Valor={Binding Tag, RelativeSource={RelativeSource Self}}}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.GestorNombre}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Disenador.Textos}" Style="{StaticResource TituloDeSeccion}" Margin="0,12,0,4" />
                    <ListBox ItemsSource="{Binding Campos}" SelectedItem="{Binding ElementoElegido}" MaxHeight="220" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TextosDelDiploma}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Visible}" Margin="0,0,6,0" ToolTip="{loc:Texto Qsl.Disenador.SeVe}" AutomationProperties.Name="{Binding Nombre}" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{loc:Texto Qsl.Editor.AnadirTexto}" Command="{Binding AnadirTextoCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AnadirTextoNombre}" />
                        <Button Content="{loc:Texto Qsl.Editor.Duplicar}" Command="{Binding DuplicarElementoCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.DuplicarElemento}" />
                        <Button Content="{loc:Texto Qsl.Editor.Quitar}" Command="{Binding QuitarElementoCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.QuitarElemento}" />
                    </WrapPanel>

                    <TextBlock Text="{loc:Texto Qsl.Disenador.Imagenes}" Style="{StaticResource TituloDeSeccion}" Margin="0,8,0,4" />
                    <ListBox ItemsSource="{Binding Imagenes}" SelectedItem="{Binding ElementoElegido}" MaxHeight="140" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ImagenesDelDiploma}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Visible}" Margin="0,0,6,0" ToolTip="{loc:Texto Qsl.Disenador.SeVe}" AutomationProperties.Name="{Binding Nombre}" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{loc:Texto Qsl.Disenador.AnadirImagen}" Command="{Binding AnadirImagenCommand}" Style="{StaticResource Boton}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AnadirImagenNombre}" />
                        <Button Content="{loc:Texto Qsl.Editor.ElegirImagen}" Command="{Binding ElegirImagenDelElementoCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Disenador.ElegirImagenAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ElegirImagenNombre}" />
                    </WrapPanel>

                    <Expander Header="{loc:Texto Qsl.Disenador.Tabla}" Margin="0,8,0,0" IsExpanded="False">
                        <StackPanel Margin="0,4,0,0">
                            <CheckBox Content="{loc:Texto Qsl.Disenador.PonerTabla}" IsChecked="{Binding TablaVisible}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.PonerTabla}" />
                            <CheckBox Content="{loc:Texto Qsl.Disenador.Anexo}" IsChecked="{Binding AnexoDeLaTabla}" Margin="0,4,0,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AnexoNombre}" />
                            <TextBlock Text="{loc:Texto Qsl.Disenador.Titulo}" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding TituloDeLaTabla, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TituloDeLaTabla}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="X mm " VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding XDeLaTabla, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,0,6,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaX}" />
                                <TextBlock Grid.Column="2" Text="Y mm " VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding YDeLaTabla, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaY}" />
                                <TextBlock Grid.Row="1" Text="{loc:Texto Qsl.Editor.Ancho}" VerticalAlignment="Center" Margin="0,4,4,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnchoDeLaTabla, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,6,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaAncho}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Texto Qsl.Editor.Alto}" VerticalAlignment="Center" Margin="0,4,4,0" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AltoDeLaTabla, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,0,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaAlto}" />
                                <TextBlock Grid.Row="2" Text="{loc:Texto Qsl.Disenador.Bloques}" VerticalAlignment="Center" Margin="0,4,4,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BloquesDeLaTabla, UpdateSourceTrigger=LostFocus}" Margin="0,4,6,0"
                                         ToolTip="{loc:Texto Qsl.Disenador.BloquesAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.BloquesNombre}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="pt " VerticalAlignment="Center" Margin="0,4,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding TamanoDeLaTabla, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" Margin="0,4,0,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaTamano}" />
                            </Grid>
                            <TextBlock Text="{loc:Texto Qsl.Editor.Letra}" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.Fuentes}" SelectedItem="{Binding FuenteDeLaTabla}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaLetra}" />
                            <TextBlock Text="{loc:Texto Qsl.Disenador.Colores}" Style="{StaticResource Rotulo}" />
                            <DockPanel>
                                <TextBlock Text="{loc:Texto Qsl.Disenador.Cabecera}" Style="{StaticResource Etiqueta}" />
                                <controles:SelectorDeColor Color="{Binding ColorDeCabeceraDeLaTabla}" Titulo="{loc:Texto Qsl.Disenador.ColorCabecera}" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="{loc:Texto Qsl.Editor.Texto}" Style="{StaticResource Etiqueta}" />
                                <controles:SelectorDeColor Color="{Binding ColorDelTextoDeLaTabla}" Titulo="{loc:Texto Qsl.Disenador.ColorTextoTabla}" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="{loc:Texto Qsl.Disenador.Lineas}" Style="{StaticResource Etiqueta}" />
                                <controles:SelectorDeColor Color="{Binding ColorDeLineasDeLaTabla}" Titulo="{loc:Texto Qsl.Disenador.ColorLineas}" />
                            </DockPanel>
                            <TextBlock Text="{loc:Texto Qsl.Disenador.Columnas}" Style="{StaticResource Rotulo}" />
                            <ItemsControl ItemsSource="{Binding Columnas}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.QuitarColumnaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Texto Qsl.Disenador.QuitarColumna}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.QuitarColumna}" />
                                            <TextBox DockPanel.Dock="Right" Width="34" Text="{Binding Ancho, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AnchoColumna}" />
                                            <UniformGrid Columns="2">
                                                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.CabeceraColumna}" />
                                                <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ContenidoColumna}" />
                                            </UniformGrid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Texto Qsl.Disenador.AnadirColumna}" Command="{Binding AnadirColumnaCommand}" Style="{StaticResource Boton}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AnadirColumnaNombre}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ El diploma ══ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefrescarCommand}" Padding="8,2" Margin="6,0,0,0"
                            ToolTip="{loc:Texto Qsl.Disenador.ReleerAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ReleerNombre}" />
                    <WrapPanel VerticalAlignment="Center">
                    <RadioButton Content="{loc:Texto Qsl.Disenador.EmitirAOtra}" IsChecked="{Binding EsParaOtraEstacion}" GroupName="UsoDelDisenador" Foreground="{DynamicResource Texto}" Margin="0,0,14,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Texto Qsl.Disenador.EmitirAOtraNombre}" />
                    <RadioButton Content="{loc:Texto Qsl.Disenador.Certificado}" IsChecked="{Binding EsCertificadoPropio}" GroupName="UsoDelDisenador" Foreground="{DynamicResource Texto}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Texto Qsl.Disenador.CertificadoNombre}" />
                    </WrapPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource FondoCampo}" Padding="10">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding AnchoMm}" Height="{Binding AltoMm}">
                            <Image Source="{Binding VistaPrevia}" Stretch="Fill" />

                            <!-- La tabla -->
                            <Canvas>
                                <Thumb Canvas.Left="{Binding TablaX}" Canvas.Top="{Binding TablaY}" Width="{Binding TablaAncho}" Height="{Binding TablaAlto}"
                                       Cursor="SizeAll" ToolTip="{loc:Texto Qsl.Disenador.TablaDeReferencias}" DragDelta="AlArrastrarLaTabla"
                                       Template="{StaticResource AsaDeTabla}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TablaDeReferencias}" />
                            </Canvas>

                            <!-- Logo, firma, adornos -->
                            <ItemsControl ItemsSource="{Binding Imagenes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding XMm}" />
                                        <Setter Property="Canvas.Top" Value="{Binding YMm}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Thumb Width="{Binding AnchoMm}" Height="{Binding AltoMm}" Cursor="SizeAll" ToolTip="{Binding Nombre}"
                                               DragStarted="AlEmpezarAArrastrar" DragDelta="AlArrastrar"
                                               Template="{StaticResource Asa}" AutomationProperties.Name="{Binding Nombre}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Textos -->
                            <ItemsControl ItemsSource="{Binding Campos}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CajaX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CajaY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Thumb Width="{Binding CajaAncho}" Height="{Binding CajaAlto}" Cursor="SizeAll" ToolTip="{Binding Nombre}"
                                               DragStarted="AlEmpezarAArrastrar" DragDelta="AlArrastrar"
                                               Template="{StaticResource Asa}" AutomationProperties.Name="{Binding Nombre}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="{loc:Texto Qsl.Disenador.EmitirYEnviar}" Command="{Binding EmitirYEnviarCommand}" Style="{StaticResource BotonPrincipal}"
                                Margin="0,0,6,6" Padding="10,4" AutomationProperties.Name="{loc:Texto Qsl.Disenador.EmitirYEnviarNombre}" />
                        <Button Content="{loc:Texto Qsl.Disenador.EmitirYGuardar}" Command="{Binding EmitirYGuardarPdfCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Disenador.EmitirYGuardarNombre}" />
                        <Button Content="{loc:Texto Qsl.Disenador.PdfDePrueba}" Command="{Binding PdfDePruebaCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Disenador.PdfDePruebaAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.PdfDePruebaNombre}" />
                        <Button Content="{loc:Texto Qsl.Disenador.GuardarPng}" Command="{Binding GuardarPngCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Disenador.GuardarPngNombre}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding TextoDelNumero}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TextoDeHojas}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ A quién, elemento elegido, correo e historial ══ -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Texto Qsl.Disenador.Diploma}" Style="{StaticResource TituloDeSeccion}" />

                    <!-- Emitir a otra estación -->
                    <StackPanel Visibility="{Binding EsParaOtraEstacion, Converter={StaticResource BooleanoAVisible}}">
                        <DockPanel>
                            <TextBlock Text="{loc:Texto Comun.Indicativo}" Style="{StaticResource Etiqueta}" />
                            <Button DockPanel.Dock="Right" Content="{loc:Texto Qsl.Disenador.BuscarQsos}" Command="{Binding BuscarContactosCommand}" Padding="6,1" Margin="6,0,0,0"
                                    ToolTip="{loc:Texto Qsl.Disenador.BuscarQsosAyuda}"
                                    AutomationProperties.Name="{loc:Texto Qsl.Disenador.BuscarQsosNombre}" />
                            <TextBox Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" AutomationProperties.Name="{loc:Texto Qsl.Disenador.IndicativoNombre}" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Contactos}" MaxHeight="150" Margin="0,6,0,0" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ContactosNombre}"
                                 Visibility="{Binding HayContactos, Converter={StaticResource BooleanoAVisible}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Elegido}" Content="{Binding Texto}" AutomationProperties.Name="{Binding Texto}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Certificado de un diploma conseguido -->
                    <StackPanel Visibility="{Binding EsCertificadoPropio, Converter={StaticResource BooleanoAVisible}}">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Conseguido}" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Conseguidos}" SelectedItem="{Binding Conseguido}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ConseguidoNombre}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Texto}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Texto Qsl.Disenador.ConseguidoAyuda}"
                                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="{loc:Texto Comun.Indicativo}" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" AutomationProperties.Name="{loc:Texto Qsl.Disenador.MiIndicativoNombre}" />
                        </DockPanel>
                    </StackPanel>

                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.NombreNombre}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Diploma}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding NombreDelDiploma, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.NombreDelDiploma}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Disenador.Categoria}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.CategoriaNombre}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Comun.Fecha}" Style="{StaticResource Etiqueta}" />
                        <DatePicker SelectedDate="{Binding FechaDeEmision}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.FechaNombre}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Editor.Correo}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.CorreoNombre}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Disenador.ElementoElegido}" Style="{StaticResource TituloDeSeccion}" Margin="0,12,0,0" />
                    <TextBlock Text="{loc:Texto Qsl.Disenador.ElijaElemento}"
                               Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap"
                               Visibility="{Binding HayElementoElegido, Converter={StaticResource VisibleSiEsFalso}}" />
                    <ContentControl Content="{Binding ElementoElegido}" Focusable="False" />

                    <Expander Header="{loc:Texto Qsl.Disenador.CorreoDelDiploma}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Texto Qsl.Editor.Asunto}" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Asunto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.AsuntoNombre}" />
                            <TextBlock Text="{loc:Texto Qsl.Editor.Texto}" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding TextoDelCorreo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="4" MaxLines="10"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="{loc:Texto Qsl.Disenador.TextoCorreoNombre}" />
                            <TextBlock Text="{loc:Texto Qsl.Disenador.CorreoAyuda}"
                                       Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Texto Qsl.Disenador.Historial}" Margin="0,8,0,0" IsExpanded="True">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Historial}" SelectedItem="{Binding HistorialElegido}" MaxHeight="220" Margin="0,4,0,0"
                                     AutomationProperties.Name="{loc:Texto Qsl.Disenador.HistorialNombre}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1">
                                            <TextBlock>
                                                <Run Text="{Binding Numero, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Emitido.Indicativo, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Fecha, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Diploma}" Style="{StaticResource TextoTenueEstilo}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Envio}" Style="{StaticResource TextoTenueEstilo}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:Texto Qsl.Disenador.HistorialVacio}" Style="{StaticResource TextoTenueEstilo}"
                                       Visibility="{Binding HistorialVacio, Converter={StaticResource BooleanoAVisible}}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{loc:Texto Qsl.Disenador.Reimprimir}" Command="{Binding ReimprimirCommand}" Style="{StaticResource Boton}"
                                        ToolTip="{loc:Texto Qsl.Disenador.ReimprimirAyuda}" AutomationProperties.Name="{loc:Texto Qsl.Disenador.ReimprimirNombre}" />
                                <Button Content="{loc:Texto Qsl.Disenador.Reenviar}" Command="{Binding ReenviarCommand}" Style="{StaticResource Boton}"
                                        AutomationProperties.Name="{loc:Texto Qsl.Disenador.ReenviarNombre}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Texto Qsl.Editor.Variables}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding AyudaDeVariables}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
