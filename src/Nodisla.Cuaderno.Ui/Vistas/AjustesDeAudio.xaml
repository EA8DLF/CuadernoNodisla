<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDeAudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesAudio}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        AUDIO Y MODOS DIGITALES.

        Dos decisiones viven aquí: por dónde entra y sale el sonido, y QUIÉN DECODIFICA.

        El codec USB del FT-710 aparece en Windows como un dispositivo de sonido más entre
        veintitantos. No se pide adivinarlo por el nombre: sale marcado «el equipo» y el
        primero de la lista, porque se empareja por el identificador de contenedor del USB.
        Equivocarse aquí se paga decodificando el escritorio o transmitiendo por los altavoces.

        ABRIR LA ENTRADA ES UNA ACCIÓN, NO UN EFECTO SECUNDARIO. Esta pantalla no toca la
        tarjeta de sonido al abrirse; sólo cuando se pulsa «Probar el nivel», y la suelta al
        parar o al salir.

        Y EL MEDIDOR AVISA, no sólo pinta: el nivel de esta estación llegaba a 0,91–0,99, al
        borde de recortar. Un codec saturado no decodifica mejor por ir más fuerte: decodifica
        peor, porque el recorte se reparte por todo el ancho de banda y tapa a las débiles.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="FilaDeDispositivo">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8"
                        Padding="6,0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CorrectoFondo}"
                        BorderBrush="{DynamicResource CorrectoBorde}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsDelEquipo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="EL EQUIPO"
                               Foreground="{DynamicResource CorrectoTexto}"
                               FontSize="10"
                               FontWeight="Bold"
                               TextTrimming="None" />
                </Border>
                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Audio y modos digitales" Style="{StaticResource TituloDeSeccion}" />
        <TextBlock Text="Por dónde entra y sale el sonido del equipo, y quién decodifica FT8 y FT4."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Text="No hay módulo de audio en esta sesión, así que no hay nada que configurar aquí. Cierre el programa y vuelva a abrirlo sin CUADERNO_SIMULADO."
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HayAudio, Converter={StaticResource VisibleSiEsFalso}}" />

        <!-- ══ Los dispositivos ══ -->
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Entrada (del equipo)" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Entradas}"
                      SelectedItem="{Binding EntradaElegida}"
                      ItemTemplate="{StaticResource FilaDeDispositivo}"
                      AutomationProperties.Name="Dispositivo de entrada de audio"
                      ToolTip="De dónde sale el audio recibido. En el FT-710 es su codec USB." />
        </DockPanel>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Salida (al equipo)" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Salidas}"
                      SelectedItem="{Binding SalidaElegida}"
                      ItemTemplate="{StaticResource FilaDeDispositivo}"
                      AutomationProperties.Name="Dispositivo de salida de audio"
                      ToolTip="Por dónde se le manda el audio al equipo al transmitir." />
        </DockPanel>

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                Background="{DynamicResource ErrorFondo}"
                BorderBrush="{DynamicResource ErrorBorde}"
                BorderThickness="1"
                Visibility="{Binding AvisoDeDiscrepancia, Converter={StaticResource NoEsVacio}}">
            <TextBlock Text="{Binding AvisoDeDiscrepancia}"
                       Foreground="{DynamicResource ErrorTexto}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
        </Border>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Muestras por segundo" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Frecuencias}"
                      SelectedItem="{Binding FrecuenciaDeMuestreo}"
                      HorizontalAlignment="Left"
                      Width="120"
                      AutomationProperties.Name="Muestras por segundo"
                      ToolTip="48.000 es lo que da el codec del FT-710 y lo que esperan FT8 y FT4." />
        </DockPanel>

        <!-- ══ El medidor ══ -->
        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Probar el nivel"
                                Command="{Binding ProbarElNivelCommand}"
                                Margin="0,0,6,0"
                                Visibility="{Binding Probando, Converter={StaticResource VisibleSiEsFalso}}"
                                ToolTip="Abre la entrada elegida y enseña el nivel. Es lo único de esta pantalla que toca la tarjeta de sonido." />
                        <Button Content="Parar la prueba"
                                Command="{Binding PararLaPruebaCommand}"
                                Margin="0,0,6,0"
                                Visibility="{Binding Probando, Converter={StaticResource BooleanoAVisible}}" />
                        <Button Content="Volver a buscar dispositivos" Command="{Binding RefrescarCommand}" />
                    </StackPanel>

                    <TextBlock Text="Nivel de entrada" Style="{StaticResource EtiquetaDeCampo}" VerticalAlignment="Center" />
                </DockPanel>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Height="16"
                             Value="{Binding NivelPorCiento, Mode=OneWay}"
                             AutomationProperties.Name="Nivel de entrada de audio">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding NivelTexto}" TextWrapping="Wrap" Margin="0,4,0,0" TextTrimming="None">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoTenueEstilo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Lo bueno está entre 0,20 y 0,60. Por encima de 0,90 el codec recorta y las señales débiles se pierden; por debajo de 0,03 no llega nada."
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ══ Transmitir y apuntar ══ -->
        <TextBlock Text="Transmitir y apuntar" Style="{StaticResource Rotulo}" Margin="0,4,0,4" />
        <StackPanel Margin="0,0,0,12">
            <CheckBox Content="Preguntar antes de transmitir con el módem"
                      IsChecked="{Binding PedirConfirmacionAlTransmitir}"
                      Margin="0,0,0,6"
                      ToolTip="Es lo que apaga «No volver a preguntar». El vigilante de PTT, el reloj y la salida se exigen siempre." />
            <CheckBox Content="Recordar «Permitir transmitir» entre sesiones"
                      IsChecked="{Binding RecordarPermisoDeTransmitir}"
                      Margin="0,0,0,6"
                      ToolTip="El pestillo de la pestaña Digital arranca abierto. De fábrica arranca cerrado en cada sesión." />
            <CheckBox Content="Guardar solo en el cuaderno el contacto completo"
                      IsChecked="{Binding RegistrarAlCompletar}"
                      ToolTip="Al recibir RR73/RRR/73 del corresponsal, o al salir el RR73 propio tras su R+informe, el contacto se apunta sin pulsar «Guardar en el cuaderno»." />
        </StackPanel>

        <!-- ══ Guardar ══ -->
        <WrapPanel Margin="0,0,0,6">
            <Button Content="Guardar"
                    Command="{Binding GuardarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,8,0" />
            <Button Content="Descartar" Command="{Binding DescartarCommand}" />
        </WrapPanel>

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding Parte, Converter={StaticResource NoEsVacio}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fallo}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" TextTrimming="None" />
        </Border>
    </StackPanel>
</UserControl>
