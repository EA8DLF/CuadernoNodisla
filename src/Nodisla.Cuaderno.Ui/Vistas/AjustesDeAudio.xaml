<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDeAudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloAjustesAudio}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        AUDIO Y MODOS DIGITALES.

        Dos decisiones viven aquí: por dónde entra y sale el sonido, y QUIÉN DECODIFICA.

        El codec USB del FT-710 aparece en Windows como un dispositivo de sonido más entre
        veintitantos. No se pide adivinarlo por el nombre: sale marcado «el equipo» y el
        primero de la lista, porque se empareja por el identificador de contenedor del USB.
        Equivocarse aquí se paga decodificando el escritorio o transmitiendo por los altavoces.

        ABRIR LA ENTRADA ES UNA ACCIÓN, NO UN EFECTO SECUNDARIO. Esta pantalla no toca la
        tarjeta de sonido al abrirse; sólo cuando se pulsa «Probar el nivel», y la suelta al
        parar o al salir.

        Y EL MEDIDOR AVISA, no sólo pinta: el nivel de esta estación llegaba a 0,91–0,99, al
        borde de recortar. Un codec saturado no decodifica mejor por ir más fuerte: decodifica
        peor, porque el recorte se reparte por todo el ancho de banda y tapa a las débiles.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- En otros idiomas el rótulo puede no caber en una línea: se parte, no se corta. -->
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="FilaDeDispositivo">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8"
                        Padding="6,0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CorrectoFondo}"
                        BorderBrush="{DynamicResource CorrectoBorde}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsDelEquipo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Texto Ajustes.Audio.ElEquipo}"
                               Foreground="{DynamicResource CorrectoTexto}"
                               FontSize="10"
                               FontWeight="Bold"
                               TextTrimming="None" />
                </Border>
                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{loc:Texto Ajustes.Audio.Titulo}" Style="{StaticResource TituloDeSeccion}" />
        <TextBlock Text="{loc:Texto Ajustes.Audio.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Text="{loc:Texto Ajustes.Audio.SinModulo}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HayAudio, Converter={StaticResource VisibleSiEsFalso}}" />

        <!-- ══ Los dispositivos ══ -->
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Texto Ajustes.Audio.Entrada}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Entradas}"
                      SelectedItem="{Binding EntradaElegida}"
                      ItemTemplate="{StaticResource FilaDeDispositivo}"
                      AutomationProperties.Name="{loc:Texto Ajustes.Audio.Entrada.Accesible}"
                      ToolTip="{loc:Texto Ajustes.Audio.Entrada.Ayuda}" />
        </DockPanel>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Texto Ajustes.Audio.Salida}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Salidas}"
                      SelectedItem="{Binding SalidaElegida}"
                      ItemTemplate="{StaticResource FilaDeDispositivo}"
                      AutomationProperties.Name="{loc:Texto Ajustes.Audio.Salida.Accesible}"
                      ToolTip="{loc:Texto Ajustes.Audio.Salida.Ayuda}" />
        </DockPanel>

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                Background="{DynamicResource ErrorFondo}"
                BorderBrush="{DynamicResource ErrorBorde}"
                BorderThickness="1"
                Visibility="{Binding AvisoDeDiscrepancia, Converter={StaticResource NoEsVacio}}">
            <TextBlock Text="{Binding AvisoDeDiscrepancia}"
                       Foreground="{DynamicResource ErrorTexto}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
        </Border>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="{loc:Texto Ajustes.Audio.Muestras}" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Frecuencias}"
                      SelectedItem="{Binding FrecuenciaDeMuestreo}"
                      HorizontalAlignment="Left"
                      Width="120"
                      AutomationProperties.Name="{loc:Texto Ajustes.Audio.Muestras}"
                      ToolTip="{loc:Texto Ajustes.Audio.Muestras.Ayuda}" />
        </DockPanel>

        <!-- ══ El medidor ══ -->
        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:Texto Ajustes.Audio.ProbarNivel}"
                                Command="{Binding ProbarElNivelCommand}"
                                Margin="0,0,6,0"
                                Visibility="{Binding Probando, Converter={StaticResource VisibleSiEsFalso}}"
                                ToolTip="{loc:Texto Ajustes.Audio.ProbarNivel.Ayuda}" />
                        <Button Content="{loc:Texto Ajustes.Audio.PararPrueba}"
                                Command="{Binding PararLaPruebaCommand}"
                                Margin="0,0,6,0"
                                Visibility="{Binding Probando, Converter={StaticResource BooleanoAVisible}}" />
                        <Button Content="{loc:Texto Ajustes.VolverABuscarDispositivos}" Command="{Binding RefrescarCommand}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Texto Ajustes.Audio.NivelDeEntrada}" Style="{StaticResource EtiquetaDeCampo}" VerticalAlignment="Center" />
                </DockPanel>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Height="16"
                             Value="{Binding NivelPorCiento, Mode=OneWay}"
                             AutomationProperties.Name="{loc:Texto Ajustes.Audio.NivelDeEntrada.Accesible}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding NivelTexto}" TextWrapping="Wrap" Margin="0,4,0,0" TextTrimming="None">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoTenueEstilo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{loc:Texto Ajustes.Audio.NivelBueno}"
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ══ Transmitir y apuntar ══ -->
        <TextBlock Text="{loc:Texto Ajustes.Audio.TransmitirYApuntar}" Style="{StaticResource Rotulo}" Width="Auto" Margin="0,4,0,4" />
        <StackPanel Margin="0,0,0,12">
            <CheckBox Content="{loc:Texto Ajustes.Audio.PreguntarAntes}"
                      IsChecked="{Binding PedirConfirmacionAlTransmitir}"
                      Margin="0,0,0,6"
                      ToolTip="{loc:Texto Ajustes.Audio.PreguntarAntes.Ayuda}" />
            <CheckBox Content="{loc:Texto Ajustes.Audio.RecordarPermiso}"
                      IsChecked="{Binding RecordarPermisoDeTransmitir}"
                      Margin="0,0,0,6"
                      ToolTip="{loc:Texto Ajustes.Audio.RecordarPermiso.Ayuda}" />
            <CheckBox Content="{loc:Texto Ajustes.Audio.RegistrarAlCompletar}"
                      IsChecked="{Binding RegistrarAlCompletar}"
                      ToolTip="{loc:Texto Ajustes.Audio.RegistrarAlCompletar.Ayuda}" />
        </StackPanel>

        <!-- ══ Telegrafía (CW): el decodificador de la cabina ══ -->
        <TextBlock Text="{loc:Texto Ajustes.Cw.Titulo}" Style="{StaticResource Rotulo}" Width="Auto" Margin="0,4,0,2" />
        <TextBlock Text="{loc:Texto Ajustes.Cw.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <StackPanel x:Name="AjustesDeCw" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Texto Ajustes.Cw.Tono}" Style="{StaticResource Rotulo}" />
                <TextBlock DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding CwTonoHz, StringFormat={}{0} Hz}" />
                <Slider Minimum="300" Maximum="1200" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding CwTonoHz}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Cw.Tono}"
                        ToolTip="{loc:Texto Ajustes.Cw.Tono.Ayuda}" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Texto Ajustes.Cw.Ancho}" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding AnchosDeFiltroCw}"
                          SelectedItem="{Binding CwAnchoHz}"
                          ItemStringFormat="{}{0} Hz"
                          HorizontalAlignment="Left"
                          Width="120"
                          AutomationProperties.Name="{loc:Texto Ajustes.Cw.Ancho}"
                          ToolTip="{loc:Texto Ajustes.Cw.Ancho.Ayuda}" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Texto Ajustes.Cw.Sensibilidad}" Style="{StaticResource Rotulo}" />
                <TextBlock DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding CwSensibilidad}" />
                <Slider Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CwSensibilidad}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Cw.Sensibilidad}"
                        ToolTip="{loc:Texto Ajustes.Cw.Sensibilidad.Ayuda}" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Texto Ajustes.Cw.Velocidad}" Style="{StaticResource Rotulo}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding CwWpmMinima, UpdateSourceTrigger=PropertyChanged}" Width="48"
                             AutomationProperties.Name="{loc:Texto Ajustes.Cw.WpmMinima}"
                             ToolTip="{loc:Texto Ajustes.Cw.Velocidad.Ayuda}" />
                    <TextBlock Text="{loc:Texto Ajustes.Cw.Hasta}" VerticalAlignment="Center" Margin="6,0" />
                    <TextBox Text="{Binding CwWpmMaxima, UpdateSourceTrigger=PropertyChanged}" Width="48"
                             AutomationProperties.Name="{loc:Texto Ajustes.Cw.WpmMaxima}"
                             ToolTip="{loc:Texto Ajustes.Cw.Velocidad.Ayuda}" />
                    <TextBlock Text="WPM" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{loc:Texto Ajustes.Cw.Senales}" Style="{StaticResource Rotulo}" />
                <TextBlock DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding CwSenales}" />
                <Slider Minimum="1" Maximum="8" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CwSenales}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Cw.Senales}"
                        ToolTip="{loc:Texto Ajustes.Cw.Senales.Ayuda}" />
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="{loc:Texto Ajustes.Cw.SinSenal}" Style="{StaticResource Rotulo}" />
                <TextBlock DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding CwSinSenal, StringFormat={}{0} s}" />
                <Slider Minimum="1" Maximum="60" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CwSinSenal}"
                        AutomationProperties.Name="{loc:Texto Ajustes.Cw.SinSenal}"
                        ToolTip="{loc:Texto Ajustes.Cw.SinSenal.Ayuda}" />
            </DockPanel>
        </StackPanel>

        <!-- ══ Guardar ══ -->
        <WrapPanel Margin="0,0,0,6">
            <Button Content="{loc:Texto Comun.Guardar}"
                    Command="{Binding GuardarCommand}"
                    Style="{StaticResource BotonPrincipal}"
                    Margin="0,0,8,0" />
            <Button Content="{loc:Texto Ajustes.Descartar}" Command="{Binding DescartarCommand}" />
        </WrapPanel>

        <Border Padding="8,6"
                CornerRadius="4"
                Margin="0,0,0,8"
                BorderThickness="1"
                Visibility="{Binding Parte, Converter={StaticResource NoEsVacio}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fallo}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Parte}" TextWrapping="Wrap" TextTrimming="None" />
        </Border>
    </StackPanel>
</UserControl>
