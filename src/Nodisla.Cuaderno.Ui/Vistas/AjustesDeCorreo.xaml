<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDeCorreo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        EL CORREO CON EL QUE SE MANDAN LAS QSL.

        Servidor, puerto, cifrado, usuario y remitente se guardan al momento en
        qsl\correo.json. La contraseña va al almacén cifrado con «Guardar» y no se vuelve a
        enseñar. «Probar» conecta y se identifica, pero NO manda ningún correo.
    -->

    <UserControl.Resources>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{loc:Texto Ajustes.Apartado.Correo}" Style="{StaticResource TituloDeSeccion}" Margin="0,12,0,4" />
        <TextBlock Text="{loc:Texto Ajustes.Correo.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,4" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="80" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{loc:Texto Ajustes.Correo.Servidor}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Servidor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                         AutomationProperties.Name="{loc:Texto Ajustes.Correo.Servidor.Accesible}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{loc:Texto Ajustes.Correo.Puerto}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Puerto, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                         AutomationProperties.Name="{loc:Texto Ajustes.Correo.Puerto.Accesible}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{loc:Texto Ajustes.Correo.Cifrado}" Style="{StaticResource Rotulo}" />
        <ComboBox ItemsSource="{Binding Seguridades}" SelectedItem="{Binding Seguridad}"
                  AutomationProperties.Name="{loc:Texto Ajustes.Correo.Cifrado.Accesible}">
            <!-- El cifrado es un valor del programa; se enseña con su nombre en el idioma en uso. -->
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="StartTls">
                                        <Setter Property="Text" Value="{loc:Texto Ajustes.Correo.Seguridad.StartTls}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="SslDirecto">
                                        <Setter Property="Text" Value="{loc:Texto Ajustes.Correo.Seguridad.SslDirecto}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Ninguna">
                                        <Setter Property="Text" Value="{loc:Texto Ajustes.Correo.Seguridad.Ninguna}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Texto Ajustes.Correo.Cifrado.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Texto Ajustes.Correo.Usuario}" TextWrapping="Wrap" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Usuario, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                 AutomationProperties.Name="{loc:Texto Ajustes.Correo.Usuario.Accesible}" />

        <TextBlock Text="{loc:Texto Ajustes.Correo.Contrasena}" Style="{StaticResource Rotulo}" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding EstadoDeLaContrasena}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource TextoTenueEstilo}" />
            <Button DockPanel.Dock="Right" Content="{loc:Texto Comun.Borrar}" Command="{Binding BorrarLaContrasenaCommand}" Margin="5,0,0,0" Padding="8,2"
                    AutomationProperties.Name="{loc:Texto Ajustes.Correo.Contrasena.Borrar.Accesible}" />
            <Button DockPanel.Dock="Right" Content="{loc:Texto Comun.Guardar}" Command="{Binding GuardarLaContrasenaCommand}" Margin="5,0,0,0" Padding="8,2"
                    AutomationProperties.Name="{loc:Texto Ajustes.Correo.Contrasena.Guardar.Accesible}" />
            <PasswordBox x:Name="CasillaDeLaContrasena"
                         PasswordChanged="AlEscribirLaContrasena"
                         Padding="6,3"
                         Background="{DynamicResource FondoCampo}"
                         Foreground="{DynamicResource Texto}"
                         BorderBrush="{DynamicResource Borde}"
                         BorderThickness="1"
                         AutomationProperties.Name="{loc:Texto Ajustes.Correo.Contrasena.Accesible}" />
        </DockPanel>
        <TextBlock Text="{loc:Texto Ajustes.Correo.Contrasena.Explicacion}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Texto Ajustes.Correo.Remitente}" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Remitente, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                 AutomationProperties.Name="{loc:Texto Ajustes.Correo.Remitente.Accesible}" />
        <TextBlock Text="{loc:Texto Ajustes.Correo.NombreDelRemitente}" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding NombreDelRemitente, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                 AutomationProperties.Name="{loc:Texto Ajustes.Correo.NombreDelRemitente.Accesible}" />

        <TextBlock Text="{loc:Texto Ajustes.Correo.Asunto}" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Asunto, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                 AutomationProperties.Name="{loc:Texto Ajustes.Correo.Asunto.Accesible}" />
        <TextBlock Text="{loc:Texto Ajustes.Correo.Texto}" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Texto, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinLines="4" MaxLines="10" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{loc:Texto Ajustes.Correo.Texto.Accesible}" />
        <TextBlock Text="{loc:Texto Ajustes.Correo.Variables, Valor={Binding Source=''}}"
                   Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />

        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="{loc:Texto Ajustes.Correo.TarjetaAdjunta}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Formatos}" SelectedItem="{Binding Formato}" Width="80" HorizontalAlignment="Left"
                      AutomationProperties.Name="{loc:Texto Ajustes.Correo.TarjetaAdjunta.Accesible}" />
        </DockPanel>

        <WrapPanel Margin="0,8,0,0">
            <Button Content="{loc:Texto Ajustes.Tarjeta.ProbarLaConexion}" Command="{Binding ProbarCommand}" Padding="8,3" Margin="0,0,6,0"
                    AutomationProperties.Name="{loc:Texto Ajustes.Correo.Probar.Accesible}" />
            <Button Content="{loc:Texto Ajustes.Correo.TextoDeOmision}" Command="{Binding TextoPorOmisionCommand}" Padding="8,3"
                    AutomationProperties.Name="{loc:Texto Ajustes.Correo.TextoDeOmision.Accesible}" />
        </WrapPanel>
        <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
