<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDelModem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloModemPropio}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        EL MÓDEM PROPIO, CON TODA LA OPERACIÓN.

        Los modos digitales los hace esta aplicación. No hay puente con WSJT-X ni con JTDX:
        aquí están la cascada, la lista, el reloj y —a la derecha— lo que hace falta para
        operar como se opera en esos programas: DX Call y DX Grid con distancia y acimut, los
        seis mensajes, la secuencia automática, las frecuencias de Rx y Tx, el tipo de
        operación (normal, hound, concursos), las frecuencias de trabajo por banda y modo, los
        mandos de la cascada, PSK Reporter y los ficheros.

        TRES COSAS QUE MANDAN SOBRE EL ASPECTO:

        · EL RELOJ VA ARRIBA. Es lo primero que hay que mirar cuando no se decodifica nada.

        · LOS COLORES DICEN QUÉ ES NUEVO: entidad, banda, cuadrícula, indicativo, y en gris lo
          ya trabajado. Salen del retrato del indicativo, no de un cálculo aparte.

        · TRANSMITIR CUESTA ABRIR UN PESTILLO. La secuencia automática no lo salta: sin
          pestillo y sin salida abierta, «Tx habilitado» no se enciende.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        </Style>

        <Style x:Key="CampoCorto" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaDeCampo}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </UserControl.Resources>

    <!--
        Si el hueco es más bajo que lo mínimo para operar, el panel entero se desplaza en vez
        de recortar por abajo (antes se perdían el pestillo y «Cortar y soltar PTT»). Con
        hueco de sobra, el contenido mide justo el hueco y no hay barra.
    -->
    <ScrollViewer x:Name="Desplazador" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="AlCambiarElHueco">
    <Grid x:Name="Contenido" Height="{x:Static vistas:PanelDelModem.AltoMinimo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Cabecera: qué es esto, el modo y los dos botones ══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    Interruptor deslizante y no casilla: lo pidió el operador (feedback directo,
                    2026-10-06) tras probar la 0.2.11 — la casilla con letras, abajo junto a
                    Emitir/Cortar PTT/Permitir transmitir, quedaba "escondida y liosa". Aquí
                    arriba, junto al modo y a Escuchar/Parar, es lo primero que se ve al abrir la
                    pestaña y además descongestiona la barra de transmisión de abajo.
                -->
                <Border Style="{StaticResource TarjetaDeApagado}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Texto Digital.Modem.ApagarModo}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ToggleButton Style="{StaticResource InterruptorDeslizante}"
                                      IsChecked="{Binding ModoApagado}"
                                      VerticalAlignment="Center"
                                      ToolTip="{loc:Texto Digital.Modem.ApagarModo.Ayuda}"
                                      AutomationProperties.Name="{loc:Texto Digital.Modem.ApagarModo.Ayuda}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Texto Comun.Modo}" Style="{StaticResource Etiqueta}" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Modos}"
                          SelectedItem="{Binding ModoElegido}"
                          Width="120"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Texto Digital.Modem.Modo.Nombre}"
                          ToolTip="{loc:Texto Digital.Modem.Modo.Ayuda}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detalle}" Style="{StaticResource TextoTenueEstilo}" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="{loc:Texto Digital.Escuchar}"
                        Command="{Binding EscucharCommand}"
                        Style="{StaticResource BotonPrincipal}"
                        Visibility="{Binding Escuchando, Converter={StaticResource VisibleSiEsFalso}}"
                        ToolTip="{loc:Texto Digital.Modem.Escuchar.Ayuda}" />

                <Button Content="{loc:Texto Digital.Modem.Parar}"
                        Command="{Binding PararCommand}"
                        Visibility="{Binding Escuchando, Converter={StaticResource BooleanoAVisible}}"
                        ToolTip="{loc:Texto Digital.Modem.Parar.Ayuda}" />
            </StackPanel>

            <!-- En una línea: el alto es para la cascada y la lista. -->
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{loc:Texto Digital.Modem.Titulo}" Style="{StaticResource TituloDeSeccion}" Margin="0,0,10,0" VerticalAlignment="Center" />

                <!--
                    El aviso de split: SOLO sale si el equipo está de verdad en dos frecuencias
                    (VFO de Rx distinto del de Tx), nunca por MantenerTx -que es un detalle de
                    audio de la cascada, no esto-. Mismo estilo ámbar que «EL ORDENADOR NO DA
                    ABASTO», más abajo: es la misma familia de aviso, algo que hay que ver sin
                    tener que leer una frase.
                -->
                <Border DockPanel.Dock="Left"
                        CornerRadius="8"
                        Padding="7,1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AvisoFondo}"
                        BorderBrush="{DynamicResource AvisoBorde}"
                        BorderThickness="1"
                        Visibility="{Binding EnSplit, Converter={StaticResource BooleanoAVisible}}"
                        ToolTip="{Binding SplitTexto}">
                    <TextBlock Text="{loc:Texto Digital.Modem.Split}" Foreground="{DynamicResource AvisoTexto}" FontSize="10" FontWeight="Bold" TextTrimming="None" />
                </Border>

                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource TextoTenueEstilo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DockPanel>

        <!-- ══ Sin la tabla del corrector no se decodifica a nadie: hay que decirlo ══ -->
        <Border Grid.Row="1"
                Margin="0,0,0,6"
                Padding="10,7"
                CornerRadius="4"
                Background="{DynamicResource ErrorFondo}"
                BorderBrush="{DynamicResource ErrorBorde}"
                BorderThickness="1"
                Visibility="{Binding SinLaTablaDelCorrector, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel>
                <TextBlock Text="{loc:Texto Digital.Modem.CorrectorDePruebas.Titulo}"
                           Foreground="{DynamicResource ErrorTexto}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <TextBlock Text="{loc:Texto Digital.Modem.CorrectorDePruebas.Texto}"
                           Foreground="{DynamicResource ErrorTexto}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Margin="0,3,0,0" />
                <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,3,0,0">
                    <Run Text="{loc:Texto Digital.Modem.TablasCargadasDe}" />
                    <Run Text="{Binding ProcedenciaDeLasTablas, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ══ El reloj, antes de operar; y cuanto queda de la ventana en curso ══ -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <!--
                La cuenta atras, a la derecha del reloj: cuanto queda de la ventana en curso (el
                «TX 0/15» de JTDX). Vale para cualquier periodo —15 s en FT8, 7,5 s en FT4, 120 s
                en WSPR…—, no solo para FT8: lo decide el modo elegido, no esta tira.
            -->
            <Border DockPanel.Dock="Right"
                    Padding="8,3"
                    CornerRadius="4"
                    BorderThickness="1"
                    Background="{DynamicResource FondoAlterno}"
                    BorderBrush="{DynamicResource BordeSuave}"
                    Margin="6,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SegundosRestantesEnVentanaTexto}"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               AutomationProperties.Name="{loc:Texto Digital.Modem.Ventana.Nombre}"
                               ToolTip="{loc:Texto Digital.Modem.Ventana.Ayuda}" />
                    <ProgressBar Minimum="0"
                                 Maximum="1"
                                 Value="{Binding ProgresoDeVentana, Mode=OneWay}"
                                 Width="70"
                                 Height="6"
                                 Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <vistas:TiraDelReloj DataContext="{Binding Reloj}" />
        </DockPanel>

        <!-- ══ Cascada y lista a la izquierda; la operación a la derecha ══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Alto mínimo garantizado: la cascada y la lista no se pueden quedar en una tira. -->
                    <RowDefinition Height="2*" MinHeight="{x:Static vistas:PanelDelModem.AltoMinimoDeLaCascada}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="{x:Static vistas:PanelDelModem.AltoMinimoDeLaLista}" />
                </Grid.RowDefinitions>

                <vistas:Cascada Grid.Row="0"
                                Imagen="{Binding ImagenDeLaCascada}"
                                TonoHz="{Binding TonoDeTransmision, Mode=TwoWay}"
                                TonoRxHz="{Binding TonoDeRecepcion, Mode=TwoWay}"
                                MantenerTx="{Binding MantenerTx}"
                                TopeHz="{Binding AnchoVisibleHz}" />

                <!-- ══ Nivel de entrada, Rx y Tx ══ -->
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{loc:Texto Digital.Modem.Entrada}" Style="{StaticResource Etiqueta}" Margin="0,0,6,0" />

                    <ProgressBar Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="14"
                                 Value="{Binding NivelPorCiento, Mode=OneWay}"
                                 AutomationProperties.Name="{loc:Texto Digital.Modem.Entrada.Nombre}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Grid.Column="2"
                               Text="{Binding NivelTexto}"
                               VerticalAlignment="Center"
                               Margin="8,0,12,0"
                               ToolTip="{loc:Texto Digital.Modem.Nivel.Ayuda}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoTenueEstilo}">
                                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NivelSatura}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NivelCorto}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rx" Style="{StaticResource Etiqueta}" Margin="0,0,4,0" Foreground="#FF3DDC84" FontWeight="Bold" />
                        <TextBox Text="{Binding TonoDeRecepcion, UpdateSourceTrigger=PropertyChanged}"
                                 Width="62"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Texto Digital.Modem.FrecuenciaRx.Nombre}"
                                 ToolTip="{loc:Texto Digital.Modem.FrecuenciaRx.Ayuda}" />
                        <TextBlock Text="Tx" Style="{StaticResource Etiqueta}" Margin="0,0,4,0" Foreground="#FFFF4A3D" FontWeight="Bold" />
                        <TextBox Text="{Binding TonoDeTransmision, UpdateSourceTrigger=PropertyChanged}"
                                 Width="62"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Texto Digital.Modem.FrecuenciaTx.Nombre}"
                                 ToolTip="{loc:Texto Digital.Modem.FrecuenciaTx.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.MantenerTx}"
                                  IsChecked="{Binding MantenerTx}"
                                  VerticalAlignment="Center"
                                  ToolTip="{loc:Texto Digital.Modem.MantenerTx.Ayuda}" />

                        <!-- Las dos frecuencias del split, en letras, junto a los tonos de Rx y Tx. -->
                        <Border CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                                Visibility="{Binding EnSplit, Converter={StaticResource BooleanoAVisible}}"
                                ToolTip="{Binding SplitTexto}">
                            <TextBlock Text="{Binding SplitTexto}" Foreground="{DynamicResource AvisoTexto}" FontSize="10" FontWeight="Bold" TextTrimming="None" />
                        </Border>

                        <TextBlock Text="{loc:Texto Digital.Modem.NivelDeSalida}" Style="{StaticResource Etiqueta}" Margin="12,0,4,0" />
                        <Slider Value="{Binding NivelDeSalida}" Minimum="0.05" Maximum="1.0" TickFrequency="0.05" Width="90" VerticalAlignment="Center"
                                ToolTip="{loc:Texto Digital.Modem.NivelDeSalida.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.NivelDeSalida.Nombre}" />
                        <TextBlock Text="{Binding NivelDeSalida, StringFormat={}{0:0.00}}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ══ Las decodificaciones ══ -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <WrapPanel DockPanel.Dock="Right">
                            <CheckBox Content="{loc:Texto Digital.Modem.SoloCq}" IsChecked="{Binding SoloCq}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Modem.SoloCq.Ayuda}" />
                            <CheckBox Content="{loc:Texto Digital.Modem.SoloAMi}" IsChecked="{Binding SoloMeLlaman}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Modem.SoloAMi.Ayuda}" />
                            <CheckBox Content="{loc:Texto Digital.Modem.SoloNuevos}" IsChecked="{Binding SoloNuevos}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Modem.SoloNuevos.Ayuda}" />
                            <Button Content="{loc:Texto Digital.Vaciar}" Command="{Binding LimpiarCommand}" Margin="0,0,6,0" />
                            <Button Content="WAV…" Command="{Binding DecodificarFicheroCommand}" ToolTip="{loc:Texto Digital.Modem.Wav.Ayuda}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UltimaVentana}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                                    Visibility="{Binding LlegoTarde, Converter={StaticResource BooleanoAVisible}}"
                                    ToolTip="{loc:Texto Digital.Modem.LlegoTarde.Ayuda}">
                                <TextBlock Text="{loc:Texto Digital.Modem.LlegoTarde}" Foreground="{DynamicResource AvisoTexto}" FontSize="10" FontWeight="Bold" TextTrimming="None" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Decodificaciones}"
                             SelectedItem="{Binding DecodificacionElegida}"
                             HorizontalContentAlignment="Stretch"
                             x:Name="ListaDeDecodificaciones"
                             AutomationProperties.Name="{loc:Texto Digital.Modem.Lista.Nombre}"
                             ToolTip="{loc:Texto Digital.Modem.Lista.Ayuda}">
                        <!--
                            El doble clic va por el evento de cada fila y no por un MouseBinding
                            de la lista: la fila se come el clic (lo marca como atendido) y el
                            MouseBinding de la lista no llegaba a enterarse nunca.
                        -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="AlDobleClicEnUnaDecodificacion" />
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="ToolTip" Value="{Binding Aporta}" />
                                <Style.Triggers>
                                    <!-- El orden importa: el último que coincide gana, y lo más importante va al final. -->
                                    <DataTrigger Binding="{Binding TrabajadoAntes}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsCq}" Value="True">
                                        <Setter Property="Background" Value="#3300C853" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CuadriculaNueva}" Value="True">
                                        <Setter Property="Background" Value="#33FF80AB" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NuevaEnBanda}" Value="True">
                                        <Setter Property="Background" Value="#44FF9100" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EntidadNueva}" Value="True">
                                        <Setter Property="Background" Value="#55D500F9" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MeLlaman}" Value="True">
                                        <Setter Property="Background" Value="#55FF1744" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsTx}" Value="True">
                                        <Setter Property="Background" Value="#33FFD600" />
                                        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CercaDeRx}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF3DDC84" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <TextBlock Text="{Binding Hora}" Style="{StaticResource Mono}" Opacity="0.75" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Decibelios}" Style="{StaticResource Mono}" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Decibelios.Ayuda}" />
                                    <TextBlock Text="{Binding Desfase}" Style="{StaticResource Mono}" Opacity="0.75" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Modem.Desfase.Ayuda}" />
                                    <TextBlock Text="{Binding Tono}" Style="{StaticResource Mono}" Opacity="0.75" Margin="0,0,10,0" ToolTip="{loc:Texto Digital.Tono.Ayuda}" />
                                    <TextBlock Text="{Binding Texto}" Style="{StaticResource Mono}" Margin="0,0,10,0" TextTrimming="None" />

                                    <Border CornerRadius="8" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                                            ToolTip="{loc:Texto Digital.Modem.Rescatada.Ayuda}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsRescatada}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{loc:Texto Digital.Modem.Rescatada}" Foreground="{DynamicResource AvisoTexto}" FontSize="10" FontWeight="Bold" TextTrimming="None" />
                                    </Border>

                                    <Border CornerRadius="8" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                                            ToolTip="{loc:Texto Digital.Modem.PorPista.Ayuda}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsPorPista}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{loc:Texto Digital.Modem.PorPista}" Foreground="{DynamicResource AvisoTexto}" FontSize="10" FontWeight="Bold" TextTrimming="None" />
                                    </Border>

                                    <Border Padding="6,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource MarcaDeNovedad}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{loc:Texto Digital.Nuevo}" Foreground="{DynamicResource CorrectoTexto}" FontWeight="Bold" FontSize="10" TextTrimming="None" />
                                    </Border>

                                    <TextBlock Text="{Binding Novedad.Entidad}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoTenueEstilo}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EntidadNueva}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NuevaEnBanda}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- ══ La operación ══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,0,0,0">
                <StackPanel>

                    <!-- ── El DX ── -->
                    <TextBlock Text="{loc:Texto Digital.Modem.Contacto}" Style="{StaticResource EtiquetaDeCampo}" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="DX Call" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Corresponsal, UpdateSourceTrigger=PropertyChanged}" Width="96" Style="{StaticResource CampoCorto}" CharacterCasing="Upper" AutomationProperties.Name="{loc:Texto Digital.Modem.Corresponsal.Nombre}" />
                        <TextBlock Text="DX Grid" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding LocalizadorDelCorresponsal, UpdateSourceTrigger=PropertyChanged}" Width="64" Style="{StaticResource CampoCorto}" CharacterCasing="Upper" AutomationProperties.Name="{loc:Texto Digital.Modem.LocalizadorDelCorresponsal.Nombre}" />
                        <TextBlock Text="{Binding DistanciaYAcimut}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="{loc:Texto Digital.Modem.DistanciaYAcimut.Ayuda}" />
                        <TextBlock Text="{Binding NombreDelCorresponsal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   ToolTip="{loc:Texto Digital.Modem.NombreDelCorresponsal.Ayuda}"
                                   AutomationProperties.Name="{loc:Texto Digital.Modem.NombreDelCorresponsal.Nombre}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBlock Text="{loc:Texto Comun.Enviado}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding InformeEnviado, UpdateSourceTrigger=PropertyChanged}" Width="58" Style="{StaticResource CampoCorto}" AutomationProperties.Name="{loc:Texto Digital.Modem.InformeEnviado.Nombre}" />
                        <TextBlock Text="{loc:Texto Comun.Recibido}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding InformeRecibido, UpdateSourceTrigger=PropertyChanged}" Width="58" Style="{StaticResource CampoCorto}" AutomationProperties.Name="{loc:Texto Digital.Modem.InformeRecibido.Nombre}" />
                        <Button Content="{loc:Texto Digital.GuardarEnElCuaderno}" Command="{Binding RegistrarContactoCommand}" Margin="0,0,6,4"
                                ToolTip="{loc:Texto Digital.Modem.GuardarEnElCuaderno.Ayuda}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContactoCompleto}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Texto Digital.Modem.Olvidar}" Command="{Binding OlvidarContactoCommand}" Margin="0,0,0,4" />
                    </WrapPanel>

                    <!-- ── Los seis mensajes ── -->
                    <DockPanel Margin="0,4,0,2">
                        <Button DockPanel.Dock="Right" Content="{loc:Texto Digital.Modem.Generar}" Command="{Binding GenerarMensajesCommand}" ToolTip="{loc:Texto Digital.Modem.Generar.Ayuda}" />
                        <TextBlock Text="{loc:Texto Digital.Modem.Mensajes.Titulo}" Style="{StaticResource EtiquetaDeCampo}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Mensajes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Sin GroupName: la exclusión la lleva el modelo, que es quien sabe cuál toca. -->
                                    <RadioButton Grid.Column="0"
                                                 IsChecked="{Binding EsElSiguiente, Mode=OneWay}"
                                                 AutomationProperties.Name="{loc:Texto Digital.Modem.EsElSiguiente.Nombre, Valor={Binding Etiqueta}}"
                                                 Checked="AlMarcarElSiguiente"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 ToolTip="{loc:Texto Digital.Modem.MarcarSiguiente.Ayuda}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas, Cascadia Mono, Courier New"
                                             AutomationProperties.Name="{Binding Etiqueta}"
                                             MouseDoubleClick="AlDobleClicEnUnMensaje" />
                                    <TextBlock Grid.Column="2" Text="{Binding Etiqueta}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="6,0,6,0" />
                                    <Button Grid.Column="3"
                                            Content="{loc:Texto Digital.Modem.Enviar}"
                                            Padding="6,0"
                                            Command="{Binding DataContext.EnviarTxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Texto Digital.Modem.EnviarTx.Nombre, Valor={Binding Etiqueta}}"
                                            ToolTip="{loc:Texto Digital.Modem.Enviar.Ayuda}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── La secuencia ── -->
                    <WrapPanel Margin="0,6,0,2">
                        <Button Content="{loc:Texto Digital.Modem.LlamarCq}" Command="{Binding LlamarCqCommand}" Style="{StaticResource BotonPrincipal}" Margin="0,0,6,4" ToolTip="{loc:Texto Digital.Modem.LlamarCq.Ayuda}" />
                        <Button Content="{loc:Texto Digital.Modem.Detener}" Command="{Binding DetenerTxCommand}" Margin="0,0,6,4" ToolTip="{loc:Texto Digital.Modem.Detener.Ayuda}" />
                        <!--
                            Por orden y no enlazada a dos bandas: antes la casilla escribía
                            TxHabilitado a pelo, saltándose la pregunta de antes de transmitir,
                            y encendida sin secuencia no hacía nada.
                        -->
                        <CheckBox Content="{loc:Texto Digital.Modem.TxHabilitado}" IsChecked="{Binding TxHabilitado, Mode=OneWay}" Command="{Binding AlternarTxHabilitadoCommand}" IsEnabled="{Binding SePuedeEmitir}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,4"
                                  ToolTip="{loc:Texto Digital.Modem.TxHabilitado.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.SecuenciaAutomatica}" IsChecked="{Binding SecuenciaAutomatica}" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.SecuenciaAutomatica.Ayuda}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,2">
                        <CheckBox Content="{loc:Texto Digital.Modem.SaltarTx1}" IsChecked="{Binding SaltarTx1}" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.SaltarTx1.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.LlamarAlPrimero}" IsChecked="{Binding LlamarAlPrimero}" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.LlamarAlPrimero.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.AnsB4}" IsChecked="{Binding AnsB4}" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.AnsB4.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.UnSoloQso}" IsChecked="{Binding UnSoloQso}" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.UnSoloQso.Ayuda}" />
                        <CheckBox Content="{loc:Texto Digital.Modem.Tx4ConRrr}" IsChecked="{Binding Tx4ConRrr}" VerticalAlignment="Center" Margin="0,0,10,4" />
                        <TextBlock Text="{loc:Texto Digital.Modem.PararTras}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding CiclosSinRespuesta, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource CampoCorto}" Margin="0,0,4,4" AutomationProperties.Name="{loc:Texto Digital.Modem.CiclosSinRespuesta.Nombre}" />
                        <TextBlock Text="{loc:Texto Digital.Modem.CiclosSinRespuesta}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="CQ" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding CqDirigido, UpdateSourceTrigger=PropertyChanged}" Width="52" Style="{StaticResource CampoCorto}" CharacterCasing="Upper" ToolTip="{loc:Texto Digital.Modem.CqDirigido.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.CqDirigido.Nombre}" />
                        <TextBlock Text="{loc:Texto Digital.Modem.Operacion}" Style="{StaticResource Etiqueta}" />
                        <ComboBox ItemsSource="{Binding Operaciones}" SelectedItem="{Binding OperacionElegida}" DisplayMemberPath="Nombre" MinWidth="170" Margin="0,0,8,4" VerticalAlignment="Center" AutomationProperties.Name="{loc:Texto Digital.Modem.Operacion.Nombre}" />
                        <TextBlock Text="{loc:Texto Digital.Modem.Intercambio}" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding IntercambioDeConcurso, UpdateSourceTrigger=PropertyChanged}" Width="96" Style="{StaticResource CampoCorto}" CharacterCasing="Upper" ToolTip="{loc:Texto Digital.Modem.Intercambio.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.Intercambio.Nombre}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding EstadoDeLaSecuencia}" TextWrapping="Wrap" Margin="0,0,0,6"
                               ToolTip="{loc:Texto Digital.Modem.TxNoHabilitado.Ayuda}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoTenueEstilo}">
                                <Style.Triggers>
                                    <!--
                                        La secuencia en marcha sin Tx habilitado no se distingue de
                                        cualquier otra frase del estado si no se destaca: tras un
                                        reinicio los dos candados (el pestillo y este) empiezan
                                        cerrados a proposito, y el pestillo ya tiene su propio aviso
                                        vistoso; a este se le olvido (visto el 05-10-2026: mas de
                                        cinco minutos sin salir nada solo, creyendo que no emitia).
                                    -->
                                    <DataTrigger Binding="{Binding AvisoDeSecuenciaSinTx}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- ── Frecuencias de trabajo ── -->
                    <Expander Header="{loc:Texto Digital.Modem.FrecuenciasDeTrabajo.Titulo}" IsExpanded="False" Margin="0,2,0,2">
                        <StackPanel Margin="0,6,0,0">
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="{loc:Texto Digital.Modem.IrALaFrecuenciaDelModo}" Command="{Binding IrALaFrecuenciaDelModoCommand}" Style="{StaticResource BotonPrincipal}" Margin="0,0,6,4" ToolTip="{loc:Texto Digital.Modem.IrALaFrecuenciaDelModo.Ayuda}" />
                                <TextBlock Text="{Binding FrecuenciaDelModoTexto}" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="0,0,0,4" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding FrecuenciasDeTrabajo}"
                                      SelectedItem="{Binding FrecuenciaElegida}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      MaxHeight="220"
                                      AutomationProperties.Name="{loc:Texto Digital.Modem.FrecuenciasDeTrabajo.Nombre}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Texto Comun.Modo}" Binding="{Binding ModoTexto}" IsReadOnly="True" Width="Auto" MinWidth="64" />
                                    <DataGridTextColumn Header="{loc:Texto Comun.Banda}" Binding="{Binding Banda}" IsReadOnly="True" Width="Auto" MinWidth="60" />
                                    <DataGridTextColumn Header="MHz" Binding="{Binding Megahercios, StringFormat=0.000###}" Width="90" />
                                    <DataGridTextColumn Header="{loc:Texto Digital.Modem.Nota}" Binding="{Binding Nota}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{loc:Texto Digital.Modem.IrALaElegida}" Command="{Binding IrALaFrecuenciaElegidaCommand}" Margin="0,0,6,0" />
                                <Button Content="{loc:Texto Digital.Modem.Anadir}" Command="{Binding AnadirFrecuenciaCommand}" Margin="0,0,6,0" ToolTip="{loc:Texto Digital.Modem.Anadir.Ayuda}" />
                                <Button Content="{loc:Texto Digital.Modem.Quitar}" Command="{Binding QuitarFrecuenciaCommand}" Margin="0,0,6,0" />
                                <Button Content="{loc:Texto Digital.Modem.LasDeWsjtx}" Command="{Binding RestaurarFrecuenciasCommand}" ToolTip="{loc:Texto Digital.Modem.LasDeWsjtx.Ayuda}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ── La cascada ── -->
                    <Expander Header="{loc:Texto Digital.Modem.Cascada}" IsExpanded="False" Margin="0,2,0,2">
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{loc:Texto Digital.Modem.Ganancia}" Style="{StaticResource Etiqueta}" />
                            <Slider Value="{Binding GananciaDeLaCascada}" Minimum="-30" Maximum="30" Width="90" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.Ganancia.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.Ganancia.Nombre}" />
                            <TextBlock Text="{loc:Texto Digital.Modem.Cero}" Style="{StaticResource Etiqueta}" />
                            <Slider Value="{Binding CeroDeLaCascada}" Minimum="-30" Maximum="30" Width="90" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip="{loc:Texto Digital.Modem.Cero.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.Cero.Nombre}" />
                            <TextBlock Text="{loc:Texto Digital.Modem.Promedio}" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding PromedioDeColumnas, UpdateSourceTrigger=PropertyChanged}" Width="34" Style="{StaticResource CampoCorto}" ToolTip="{loc:Texto Digital.Modem.Promedio.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.Promedio.Nombre}" />
                            <TextBlock Text="{loc:Texto Digital.Modem.Paleta}" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding Paletas}" SelectedItem="{Binding PaletaElegida}" DisplayMemberPath="Nombre" MinWidth="90" Margin="0,0,10,4" VerticalAlignment="Center" AutomationProperties.Name="{loc:Texto Digital.Modem.Paleta}" />
                            <TextBlock Text="{loc:Texto Digital.Modem.Ancho}" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding AnchoVisibleHz, UpdateSourceTrigger=PropertyChanged}" Width="46" Style="{StaticResource CampoCorto}" Margin="0,0,4,4" ToolTip="{loc:Texto Digital.Modem.Ancho.Ayuda}" AutomationProperties.Name="{loc:Texto Digital.Modem.Ancho.Nombre}" />
                            <TextBlock Text="Hz" Style="{StaticResource TextoTenueEstilo}" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Expander>

                    <!-- ── Red y ficheros ── -->
                    <Expander Header="{loc:Texto Digital.Modem.PskYFicheros}" IsExpanded="False" Margin="0,2,0,6">
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox Content="{loc:Texto Digital.Modem.MandarAPsk}" IsChecked="{Binding PskReporterActivo}" Margin="0,0,0,2"
                                      ToolTip="{loc:Texto Digital.Modem.MandarAPsk.Ayuda}" />
                            <TextBlock Text="{Binding PskReporterTexto}" Style="{StaticResource TextoTenueEstilo}" Margin="20,0,0,6" />
                            <CheckBox Content="{loc:Texto Digital.Modem.GuardarWav}" IsChecked="{Binding GuardarWav}" Margin="0,0,0,2" />
                            <CheckBox Content="{loc:Texto Digital.Modem.GuardarDecodificaciones}" IsChecked="{Binding GuardarDecodificacionesEnTexto}" Margin="0,0,0,2" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ Aviso, mensaje libre y el pestillo ══ -->
        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <Border Margin="0,0,0,4" Padding="8,3" CornerRadius="4"
                    Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                    Visibility="{Binding Aviso, Converter={StaticResource NoEsVacio}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CerrarAvisoCommand}" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Texto Digital.Modem.CerrarAviso.Nombre}" ToolTip="{loc:Texto Digital.Modem.CerrarAviso.Ayuda}" />
                    <TextBlock Text="{Binding Aviso}" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Padding="8,3" CornerRadius="4" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PermitirTransmitir}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AvisoFondo}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AvisoBorde}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--
                    En UNA línea y con «Cortar y soltar PTT» anclado a la derecha: antes era un
                    WrapPanel que a 1366 puntos mandaba Emitir y Cortar a una segunda línea que
                    quedaba fuera de la pantalla. El motivo del pestillo cede (se recorta y va
                    entero en la nota emergente).
                -->
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Texto Digital.Modem.CortarYSoltarPtt}"
                            Command="{Binding AbortarEmisionCommand}"
                            Style="{StaticResource BotonDePanico}"
                            ToolTip="{loc:Texto Digital.Modem.CortarYSoltarPtt.Ayuda}" />

                    <Button DockPanel.Dock="Right"
                            Content="{loc:Texto Digital.Modem.Emitir}"
                            Command="{Binding EmitirCommand}"
                            Style="{StaticResource BotonQueTransmite}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Texto Digital.Modem.Emitir.Nombre}"
                            ToolTip="{loc:Texto Digital.Modem.Emitir.Ayuda}" />

                    <TextBox DockPanel.Dock="Right"
                             Text="{Binding MensajeAEmitir, UpdateSourceTrigger=PropertyChanged}"
                             Width="170"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             AutomationProperties.Name="{loc:Texto Digital.Modem.MensajeAEmitir.Nombre}" />
                    <TextBlock DockPanel.Dock="Right" Text="{loc:Texto Digital.Modem.MensajeLibre}" Style="{StaticResource EtiquetaDeCampo}" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <CheckBox DockPanel.Dock="Left"
                              Content="{loc:Texto Digital.Modem.PermitirTransmitir}"
                              IsChecked="{Binding PermitirTransmitir}"
                              FontWeight="Bold"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="{loc:Texto Digital.Modem.PermitirTransmitir.Ayuda}" />
                    <TextBlock Text="{Binding AvisoDeLaTransmision}"
                               ToolTip="{Binding AvisoDeLaTransmision}"
                               Style="{StaticResource TextoTenueEstilo}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
