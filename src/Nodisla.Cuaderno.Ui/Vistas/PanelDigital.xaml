<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDigital"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        Panel de modos digitales.

        Ningún botón de aquí falla al pulsarlo: antes se le pregunta al puente qué admite el
        programa que hay al otro lado. Y se distingue entre dos cosas que no son iguales:

          · Lo que esa instancia NO PODRÁ HACER NUNCA —JTDX no tiene el mensaje de resaltado;
            WSJT-X no deja mover el tono de transmisión desde fuera, porque su mensaje de
            configuración fija el de recepción— se ESCONDE. Un botón gris que no va a
            encenderse jamás es ruido permanente.
          · Lo que está gris porque falta hacer algo —elegir una decodificación— se queda a la
            vista, en gris, porque se enciende solo con dar ese paso.

        Para que esconder no sea ocultar, la línea de capacidades de arriba dice siempre qué
        admite y qué no la instancia elegida: así se entiende por qué en una sale un botón y en
        otra no.

        Y lo que sale al aire lo dice: «Llamar CQ — TRANSMITE» va en ámbar y aparte de los
        botones inocuos.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Escucha ══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="Escuchar"
                    Command="{Binding ArrancarCommand}"
                    Margin="8,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Escuchando}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button DockPanel.Dock="Right"
                    Content="Dejar de escuchar"
                    Command="{Binding PararCommand}"
                    Margin="8,0,0,0"
                    Visibility="{Binding Escuchando, Converter={StaticResource BooleanoAVisible}}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Modos digitales" FontWeight="Bold" />
                    <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource TextoTenueEstilo}" />
                </StackPanel>

                <ComboBox ItemsSource="{Binding Instancias}"
                          SelectedItem="{Binding InstanciaElegida}"
                          MinWidth="240"
                          VerticalAlignment="Center"
                          ToolTip="Instancias de WSJT-X o JTDX que están dando señales de vida">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="None">
                                <Run Text="{Binding DialectoTexto, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="·" />
                                <Run Text="{Binding Frecuencia, Mode=OneWay}" />
                                <Run Text="MHz" />
                                <Run Text="{Binding Modo, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding AvisoDeCapacidades}"
                   Style="{StaticResource TextoTenueEstilo}"
                   FontStyle="Italic"
                   Margin="0,0,0,6" />

        <!--
            ══ Botonera y filtro ══

            Un botón que la instancia elegida NO admite no se enseña gris: se esconde. El gris se
            reserva para lo que puede encenderse solo con hacer algo —elegir una decodificación,
            por ejemplo—; un gris que no va a cambiar nunca es ruido permanente. Qué admite y
            qué no queda dicho arriba, en la línea de capacidades, para que se entienda por qué
            en una instancia sale un botón y en otra no.
        -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <Button Content="Responder a esta llamada"
                    Command="{Binding ResponderCommand}"
                    Margin="0,0,8,6"
                    Visibility="{Binding AdmiteResponder, Converter={StaticResource BooleanoAVisible}}"
                    ToolTip="Le pide al programa que llame a la estación decodificada" />

            <Button Content="Resaltar indicativo"
                    Command="{Binding ResaltarCommand}"
                    Margin="0,0,8,6"
                    Visibility="{Binding AdmiteResaltar, Converter={StaticResource BooleanoAVisible}}"
                    ToolTip="Resalta el indicativo en la ventana del programa" />

            <!-- Esto sale al aire: va en ámbar y lo dice el rótulo. -->
            <Button Content="Llamar CQ — TRANSMITE"
                    Command="{Binding LlamarCqCommand}"
                    Style="{StaticResource BotonQueTransmite}"
                    Margin="0,0,8,6"
                    Visibility="{Binding AdmiteLlamarCq, Converter={StaticResource BooleanoAVisible}}"
                    AutomationProperties.Name="Lanzar una llamada general. Pone el equipo en antena."
                    ToolTip="Lanza una llamada general: el equipo SALE AL AIRE. Llama sin dirigir y respeta el periodo que el programa tiene puesto. El botón «SOLTAR PTT» la corta." />

            <CheckBox Content="Solo indicativos nuevos"
                      IsChecked="{Binding SoloNuevos}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,6" />
            <Button Content="Vaciar" Command="{Binding LimpiarDecodificacionesCommand}" Margin="0,0,0,6" />
        </WrapPanel>

        <!--
            Los ajustes del programa van plegados: cambiar el tono de transmisión en mitad de un
            periodo SE OYE EN EL AIRE y la estación de enfrente puede perder lo que queda de él.
            No pide confirmación, pero no es un control que deba rozarse sin querer.
        -->
        <Expander Grid.Row="3"
                  Header="Ajustes del programa"
                  IsExpanded="False"
                  Margin="0,0,0,6"
                  Visibility="{Binding HayAjustesDelPrograma, Converter={StaticResource BooleanoAVisible}}">
            <WrapPanel Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,16,6"
                            Visibility="{Binding AdmiteCambiarTono, Converter={StaticResource BooleanoAVisible}}">
                    <TextBlock Text="Tono de TX"
                               Style="{StaticResource EtiquetaDeCampo}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox Text="{Binding TonoDeTransmision, UpdateSourceTrigger=PropertyChanged}"
                             Width="66"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             AutomationProperties.Name="Tono de transmisión, en hercios"
                             ToolTip="Tono de transmisión, en hercios" />
                    <Button Content="Poner tono"
                            Command="{Binding PonerTonoTxCommand}"
                            ToolTip="Cambiarlo en mitad de una transmisión se oye en el aire: la estación de enfrente puede perder el resto del periodo." />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6"
                            Visibility="{Binding AdmiteCambiarConfiguracion, Converter={StaticResource BooleanoAVisible}}">
                    <TextBlock Text="Configuración"
                               Style="{StaticResource EtiquetaDeCampo}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox Text="{Binding Configuracion, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             AutomationProperties.Name="Nombre de la configuración del programa"
                             ToolTip="Nombre de la configuración del programa" />
                    <Button Content="Cambiar"
                            Command="{Binding CambiarConfiguracionCommand}"
                            ToolTip="Hace que el programa pase a esa configuración" />
                </StackPanel>
            </WrapPanel>
        </Expander>

        <!-- ══ Decodificaciones en vivo ══ -->
        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Decodificaciones}"
                 SelectedItem="{Binding DecodificacionElegida}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel>
                        <TextBlock Text="{Binding Hora}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Decibelios}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   Margin="0,0,10,0"
                                   ToolTip="Relación señal-ruido en decibelios" />
                        <TextBlock Text="{Binding Tono}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   Margin="0,0,10,0"
                                   ToolTip="Tono dentro del ancho de banda de audio, en hercios" />
                        <TextBlock Text="{Binding Texto}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   Margin="0,0,10,0"
                                   TextTrimming="None">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MeLlaman}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource Acento}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource CorrectoTexto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource MarcaDeNovedad}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Nuevo"
                                       Foreground="{DynamicResource CorrectoTexto}"
                                       FontWeight="Bold"
                                       TextTrimming="None" />
                        </Border>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ══ Contactos ya cerrados y ADIF ══ -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <Border Margin="0,0,0,8"
                    Padding="10,7"
                    CornerRadius="4"
                    Background="{DynamicResource AvisoFondo}"
                    BorderBrush="{DynamicResource AvisoBorde}"
                    BorderThickness="1"
                    Visibility="{Binding Aviso, Converter={StaticResource NoEsVacio}}">
                <TextBlock Text="{Binding Aviso}"
                           Foreground="{DynamicResource AvisoTexto}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
            </Border>

            <Expander Header="Contactos cerrados, listos para el cuaderno" IsExpanded="True">
                <StackPanel Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding Cerrados}"
                             SelectedItem="{Binding CerradoElegido}"
                             MaxHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <TextBlock Text="{Binding Hora}" Style="{StaticResource TextoTenueEstilo}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Indicativo}" FontWeight="Bold" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Banda}" Style="{StaticResource TextoTenueEstilo}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Modo}" Style="{StaticResource TextoTenueEstilo}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Localizador}" Style="{StaticResource TextoTenueEstilo}" />
                                </WrapPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Guardar en el cuaderno"
                            Command="{Binding GuardarCerradoCommand}"
                            Style="{StaticResource BotonPrincipal}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <Expander Header="ADIF que manda el programa" Margin="0,6,0,0">
                <Border Margin="0,8,0,0"
                        Background="{DynamicResource FondoCampo}"
                        BorderBrush="{DynamicResource Borde}"
                        BorderThickness="1"
                        CornerRadius="3"
                        MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <ItemsControl ItemsSource="{Binding Adif}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TextoDeConsola}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
