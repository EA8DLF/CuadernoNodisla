<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.BotoneraCb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas">

    <!--
        PANEL «CANALES CB», a la derecha del frontal: los 40 canales de 27 MHz en 8 columnas,
        el plan (11m · UK · CEPT · PL · USA, se recuerda) y el modo. Un canal lleva el VFO activo
        a su frecuencia; el canal en que está el dial se ve en azul. Nada transmite.
        DataContext = VistaModeloEquipo.
    -->

    <UserControl.Resources>
        <ResourceDictionary Source="EstilosDeLaBotonera.xaml" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelDeLaBotonera}" ToolTip="{Binding MotivoDeLaBotonera}" ToolTipService.ShowOnDisabled="True">
        <StackPanel Width="264">
            <DockPanel>
                <Button x:Name="BotonCambiar" DockPanel.Dock="Right" Content="◂ HAM" Style="{StaticResource PestanaDeLaBotonera}"
                        Visibility="Collapsed" Click="AlPedirCambio" VerticalAlignment="Center"
                        ToolTip="{loc:Texto Cabina.Botonera.VolverAyuda}"
                        AutomationProperties.Name="{loc:Texto Cabina.Botonera.Volver}" />
                <TextBlock Text="{loc:Texto Cabina.Botonera.CanalesCb}" Style="{StaticResource TituloDeLaBotonera}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding CanalesDeCb}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.Canales27}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TeclaDeLaBotonera}" Height="22"
                                Command="{Binding DataContext.IrAlCanalCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraCb}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Texto Cabina.Botonera.Plan}" Style="{StaticResource SubtituloDeLaBotonera}" />
            <ItemsControl ItemsSource="{Binding PlanesDeCb}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.PlanDeCanales}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TeclaDeLaBotonera}" Height="22"
                                Command="{Binding DataContext.ElegirPlanCbCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraCb}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Texto Comun.Modo}" Style="{StaticResource SubtituloDeLaBotonera}" />
            <ItemsControl ItemsSource="{Binding TeclasDeModo}" AutomationProperties.Name="{loc:Texto Cabina.Botonera.TeclasDeModo}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TeclaDeLaBotonera}" Height="22"
                                Command="{Binding DataContext.PonerModoDeTeclaCommand, RelativeSource={RelativeSource AncestorType=vistas:BotoneraCb}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
