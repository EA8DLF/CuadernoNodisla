<Window x:Class="Nodisla.Cuaderno.Ui.Vistas.VentanaDePrimerArranque"
        Icon="/Nodisla.Cuaderno.Ui;component/Recursos/CuadernoNodisla.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
        Title="{loc:Texto Dialogos.PrimerArranque.Titulo}"
        SizeToContent="Height"
        Width="600"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource FondoVentana}"
        Foreground="{DynamicResource Texto}"
        FontFamily="Segoe UI"
        FontSize="15"
        Loaded="AlCargar">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
    </Window.Resources>

    <Border Style="{StaticResource Tarjeta}" Margin="14">
        <StackPanel>
            <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.Bienvenida}" Style="{StaticResource TituloDeSeccion}" FontSize="19" />

            <TextBlock TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,16"
                       Text="{loc:Texto Dialogos.PrimerArranque.Explicacion}" />

            <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.Indicativo}" Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox x:Name="CampoIndicativo"
                     Style="{StaticResource CampoDeIndicativo}"
                     Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     ToolTip="{loc:Texto Dialogos.PrimerArranque.IndicativoEjemplo}" />

            <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.Localizador}"
                       Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox Text="{Binding Localizador, UpdateSourceTrigger=PropertyChanged}"
                     CharacterCasing="Upper"
                     Margin="0,0,0,12"
                     ToolTip="{loc:Texto Dialogos.PrimerArranque.LocalizadorEjemplo}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.NombreOperador}" Style="{StaticResource EtiquetaDeCampo}" />
                    <TextBox Text="{Binding NombreOperador, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.Localidad}" Style="{StaticResource EtiquetaDeCampo}" />
                    <TextBox Text="{Binding Localidad, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Texto Dialogos.PrimerArranque.NombrePerfil}" Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox Text="{Binding NombrePerfil, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     ToolTip="{loc:Texto Dialogos.PrimerArranque.NombrePerfilTooltip}" />

            <Border Padding="12,8" CornerRadius="4" BorderThickness="1" Margin="0,0,0,12"
                    Background="{DynamicResource ErrorFondo}"
                    BorderBrush="{DynamicResource ErrorBorde}"
                    Visibility="{Binding HayError, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" TextTrimming="None"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ErrorTexto}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Texto Dialogos.PrimerArranque.Salir}" IsCancel="True" Margin="0,0,10,0" Click="AlSalir" />
                <Button Content="{loc:Texto Dialogos.PrimerArranque.Crear}"
                        Style="{StaticResource BotonPrincipal}"
                        IsDefault="True"
                        Command="{Binding CrearCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
