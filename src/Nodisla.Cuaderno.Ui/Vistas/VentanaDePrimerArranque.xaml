<Window x:Class="Nodisla.Cuaderno.Ui.Vistas.VentanaDePrimerArranque"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuaderno NODISLA · primer arranque"
        SizeToContent="Height"
        Width="600"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource FondoVentana}"
        Foreground="{DynamicResource Texto}"
        FontFamily="Segoe UI"
        FontSize="15"
        Loaded="AlCargar">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
    </Window.Resources>

    <Border Style="{StaticResource Tarjeta}" Margin="14">
        <StackPanel>
            <TextBlock Text="Bienvenido al cuaderno" Style="{StaticResource TituloDeSeccion}" FontSize="19" />

            <TextBlock TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,16"
                       Text="Antes de registrar el primer contacto hace falta un perfil de estación: el indicativo con el que transmite y desde dónde opera. Sin esos datos el cuaderno no se puede exportar a ADIF ni sirve para pedir diplomas." />

            <TextBlock Text="Indicativo de la estación" Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox x:Name="CampoIndicativo"
                     Style="{StaticResource CampoDeIndicativo}"
                     Text="{Binding Indicativo, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     ToolTip="Por ejemplo EA8DLF" />

            <TextBlock Text="Localizador (opcional, pero hace falta para distancias y rumbos)"
                       Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox Text="{Binding Localizador, UpdateSourceTrigger=PropertyChanged}"
                     CharacterCasing="Upper"
                     Margin="0,0,0,12"
                     ToolTip="Por ejemplo IL18SN" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nombre del operador (opcional)" Style="{StaticResource EtiquetaDeCampo}" />
                    <TextBox Text="{Binding NombreOperador, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Localidad (opcional)" Style="{StaticResource EtiquetaDeCampo}" />
                    <TextBox Text="{Binding Localidad, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Nombre del perfil" Style="{StaticResource EtiquetaDeCampo}" />
            <TextBox Text="{Binding NombrePerfil, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     ToolTip="Para distinguirlo de otros perfiles: Casa, Portable, Concursos…" />

            <Border Padding="12,8" CornerRadius="4" BorderThickness="1" Margin="0,0,0,12"
                    Background="{DynamicResource ErrorFondo}"
                    BorderBrush="{DynamicResource ErrorBorde}"
                    Visibility="{Binding HayError, Converter={StaticResource BooleanoAVisible}}">
                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" TextTrimming="None"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ErrorTexto}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salir del programa" IsCancel="True" Margin="0,0,10,0" Click="AlSalir" />
                <Button Content="Crear el perfil y empezar"
                        Style="{StaticResource BotonPrincipal}"
                        IsDefault="True"
                        Command="{Binding CrearCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
