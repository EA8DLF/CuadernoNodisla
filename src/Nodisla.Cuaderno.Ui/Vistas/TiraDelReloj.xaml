<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.TiraDelReloj"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vistamodelos:VistaModeloRelojDigital}"
             mc:Ignorable="d"
             Foreground="{DynamicResource Texto}">

    <!--
        EL RELOJ, A LA VISTA Y ANTES DE OPERAR.

        FT8 va en ventanas de quince segundos alineadas al reloj universal. Un ordenador con el
        reloj un segundo desviado decodifica mal; con dos, no decodifica nada y además
        TRANSMITE FUERA DE VENTANA, que ya no es un problema propio sino de los demás: ocupa el
        período de otros y les ensucia las decodificaciones sin enterarse.

        Este reloj se fue de −870 ms a −1,29 s en tres días. Por eso esto no está escondido en
        Ajustes: está donde se mira antes de pulsar «Escuchar».

        LA REGLA DE CUÁNTOS MILISEGUNDOS SON DEMASIADOS NO ESTÁ AQUÍ. Vive en el reloj, que
        entrega el veredicto y el consejo ya escritos; esta tira sólo los pinta y les pone
        color. Cambiar el umbral no obliga a tocar ni una línea de la interfaz.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
    </UserControl.Resources>

    <Border Padding="8,3"
            CornerRadius="4"
            BorderThickness="1">
        <!-- El semáforo tiñe el marco entero: se ve de reojo sin leer nada. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource FondoAlterno}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BordeSuave}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelojBien}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelojRegular}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AvisoFondo}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AvisoBorde}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelojFueraDeVentana}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <DockPanel>
                <!-- ── Los botones, a la derecha ── -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Medir"
                            Command="{Binding MedirCommand}"
                            Margin="6,0,0,0"
                            ToolTip="Pregunta la hora a los servidores de hora y vuelve a calcular el desvío" />

                    <Button Content="Poner el reloj en hora"
                            Command="{Binding PonerEnHoraCommand}"
                            Style="{StaticResource BotonPrincipal}"
                            Margin="6,0,0,0"
                            Visibility="{Binding SePuedePonerEnHora, Converter={StaticResource BooleanoAVisible}}"
                            ToolTip="Mide y escribe la hora del sistema. Nunca se hace solo: es el reloj de su máquina." />

                    <Button Content="Configurar el servicio de hora"
                            Command="{Binding ConfigurarElServicioCommand}"
                            Margin="6,0,0,0"
                            Visibility="{Binding HaySincronizador, Converter={StaticResource BooleanoAVisible}}"
                            ToolTip="Deja el servicio de hora de Windows apuntando a un buen servidor. Arregla el problema para siempre, no sólo hoy." />
                </StackPanel>

                <!--
                    ── El punto del semáforo, el número y el veredicto ──

                    En DockPanel y no en pila horizontal: el veredicto es la única parte que
                    puede crecer, así que es la que tiene que ceder cuando la tira se estrecha.
                    En una pila se salía por la derecha y se cortaba a media palabra.
                -->
                <DockPanel VerticalAlignment="Center">
                    <Ellipse DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextoTenue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelojBien}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource CorrectoTexto}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelojRegular}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AvisoTexto}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelojFueraDeVentana}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorTexto}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock DockPanel.Dock="Left"
                               Text="Reloj del módem"
                               Style="{StaticResource EtiquetaDeCampo}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding DesvioTexto}"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               TextTrimming="None"
                               AutomationProperties.Name="Desvío del reloj del ordenador"
                               ToolTip="Cuánto adelanta o atrasa el reloj del ordenador frente a la hora de verdad" />

                    <TextBlock Text="{Binding Veredicto}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </DockPanel>

            <!--
                Con el reloj en verde, la tira es UNA línea: el consejo, el parte y las órdenes
                de w32tm se pliegan. Antes ocupaban cinco
                líneas con el reloj a 3 ms y le robaban el alto a la cascada.
            -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelojBien}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <!-- ── Qué hacer, cuando hay algo que hacer ── -->
            <TextBlock Text="{Binding Consejo}"
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Margin="19,4,0,0"
                       Visibility="{Binding HayConsejo, Converter={StaticResource BooleanoAVisible}}" />

            <!-- ── Cómo fue el último intento ── -->
            <TextBlock Text="{Binding Parte}"
                       Style="{StaticResource TextoTenueEstilo}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="19,4,0,0"
                       Visibility="{Binding Parte, Converter={StaticResource NoEsVacio}}" />

            <!-- Sin permisos no se falla con un «acceso denegado»: se dice qué teclear. -->
            <TextBlock Text="{Binding InstruccionesParaHacerloAMano}"
                       Style="{StaticResource TextoDeConsola}"
                       TextWrapping="Wrap"
                       Margin="19,4,0,0"
                       Visibility="{Binding InstruccionesParaHacerloAMano, Converter={StaticResource NoEsVacio}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
