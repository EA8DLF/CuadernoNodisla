<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AjustesDelAnalizadorDelEquipo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        AJUSTES DEL ANALIZADOR DE LA RADIO (apartado Equipo): spots encima, clic y rueda para
        sintonizar, suelo de ruido automático (AGC de la cascada), contraste, paleta, picos y
        desplazamiento al resintonizar. Espera como contexto VistaModeloAjustesAnalizador.
        Cada cambio se guarda y se ve en el analizador al momento. No toca nada de la radio.
    -->

    <Border Style="{StaticResource Tarjeta}" Padding="12,8" Margin="0,0,0,8">
        <StackPanel>
            <TextBlock Text="{loc:Texto Ajustes.Analizador.Titulo}" Style="{StaticResource TituloDeSeccion}" />
            <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{loc:Texto Ajustes.Analizador.Explicacion}" />

            <!-- ── Spots y sintonía ── -->
            <WrapPanel Margin="0,0,0,2">
                <CheckBox Content="{loc:Texto Ajustes.Analizador.SpotsEncima}" IsChecked="{Binding SpotsEncima}" Margin="0,0,16,6"
                          ToolTip="{loc:Texto Ajustes.Analizador.SpotsEncimaAyuda}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{loc:Texto Ajustes.Analizador.Carriles}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox MinWidth="50" ItemsSource="{Binding CarrilesPosibles}" SelectedItem="{Binding Carriles}"
                              IsEnabled="{Binding SpotsEncima}"
                              AutomationProperties.Name="{loc:Texto Ajustes.Analizador.Carriles}" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,2">
                <CheckBox Content="{loc:Texto Ajustes.Analizador.ClicParaSintonizar}" IsChecked="{Binding ClicParaSintonizar}" Margin="0,0,16,6"
                          ToolTip="{loc:Texto Ajustes.Analizador.ClicParaSintonizarAyuda}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{loc:Texto Ajustes.Analizador.Paso}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox MinWidth="120" ItemsSource="{Binding Pasos}" SelectedItem="{Binding Paso}" DisplayMemberPath="Nombre"
                              IsEnabled="{Binding ClicParaSintonizar}" ToolTip="{loc:Texto Ajustes.Analizador.PasoAyuda}"
                              AutomationProperties.Name="{loc:Texto Ajustes.Analizador.Paso}" />
                </StackPanel>
            </WrapPanel>

            <!-- ── Cascada ── -->
            <WrapPanel Margin="0,6,0,0">
                <CheckBox Content="{loc:Texto Ajustes.Analizador.SueloAutomatico}" IsChecked="{Binding SueloAutomatico}" Margin="0,0,16,6"
                          ToolTip="{loc:Texto Ajustes.Analizador.SueloAutomaticoAyuda}" />
                <CheckBox Content="{loc:Texto Ajustes.Analizador.Desplazar}" IsChecked="{Binding DesplazarCascada}" Margin="0,0,16,6"
                          ToolTip="{loc:Texto Ajustes.Analizador.DesplazarAyuda}" />
                <CheckBox Content="{loc:Texto Ajustes.Analizador.Picos}" IsChecked="{Binding MarcarPicos}" Margin="0,0,16,6"
                          ToolTip="{loc:Texto Ajustes.Analizador.PicosAyuda}" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <StackPanel MinWidth="200" Margin="0,0,16,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Analizador.Contraste}" />
                        <Run Text="{Binding Contraste, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="20" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Contraste}"
                            ToolTip="{loc:Texto Ajustes.Analizador.ContrasteAyuda}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Analizador.Contraste}" />
                </StackPanel>
                <StackPanel MinWidth="200" Margin="0,0,16,6">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Analizador.Brillo}" />
                        <Run Text="{Binding Brillo, StringFormat={}{0:+0;-0;0}, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brillo}"
                            ToolTip="{loc:Texto Ajustes.Analizador.BrilloAyuda}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Analizador.Brillo}" />
                </StackPanel>
                <StackPanel MinWidth="200" Margin="0,0,16,6" IsEnabled="{Binding NivelBajoManual}">
                    <TextBlock>
                        <Run Text="{loc:Texto Ajustes.Analizador.NivelBajo}" />
                        <Run Text="{Binding NivelBajo, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="250" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding NivelBajo}"
                            ToolTip="{loc:Texto Ajustes.Analizador.NivelBajoAyuda}"
                            AutomationProperties.Name="{loc:Texto Ajustes.Analizador.NivelBajo}" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{loc:Texto Ajustes.Analizador.Paleta}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox MinWidth="170" ItemsSource="{Binding Paletas}" SelectedItem="{Binding Paleta}" DisplayMemberPath="Nombre"
                              AutomationProperties.Name="{loc:Texto Ajustes.Analizador.Paleta}" />
                </StackPanel>
                <Button Content="{loc:Texto Ajustes.Analizador.DeFabrica}" Padding="8,2" Margin="0,0,16,6" VerticalAlignment="Center"
                        Command="{Binding DeFabricaCommand}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
