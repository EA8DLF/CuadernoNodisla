<Window x:Class="Nodisla.Cuaderno.Ui.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
        xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
        xmlns:vqsl="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Qsl"
        Title="Cuaderno NODISLA"
        Icon="/Nodisla.Cuaderno.Ui;component/Recursos/CuadernoNodisla.ico"
        Height="1000" Width="1460" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource FondoVentana}"
        Foreground="{DynamicResource Texto}"
        FontSize="{Binding TamanoDeLetra}"
        FontFamily="Segoe UI"
        Loaded="AlCargar"
        Closed="AlCerrar"
        SizeChanged="AlCambiarDeTamano"
        PreviewKeyDown="AlTeclearEnLaVentana">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:AnchoEnLetras x:Key="AnchoEnLetras" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Entrada.LimpiarCommand}" />
        <KeyBinding Key="F2" Command="{Binding Cuaderno.EditarSeleccionadoCommand}" />
        <KeyBinding Key="F5" Command="{Binding Cuaderno.RefrescarCommand}" />
        <KeyBinding Key="F7" Command="{Binding AlternarDatosAmpliadosCommand}" />
        <KeyBinding Key="F8" Command="{Binding Entrada.PonerHoraActualCommand}" />
        <KeyBinding Key="F9" Command="{Binding AlternarTemaCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding AumentarLetraCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding AumentarLetraCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ReducirLetraCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ReducirLetraCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding LetraNormalCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding LetraNormalCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding VerOperarCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding VerLoDigitalCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding VerElCuadernoCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding VerElMapaCommand}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding VerLosDiplomasCommand}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding VerLosAjustesCommand}" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding VerLosSatelitesCommand}" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding VerLaQslCommand}" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding VerLaRondaCommand}" />
        <KeyBinding Key="D5" Modifiers="Control+Shift" Command="{Binding VerElDisenadorDeDiplomasCommand}" />
        <KeyBinding Key="F1" Command="{Binding VerLaAyudaDeEstaPaginaCommand}" />
    </Window.InputBindings>

    <!--
        LA PANTALLA PRINCIPAL ES LA CABINA DE OPERACIÓN.

        En la Fase 1 el cuaderno ocupaba toda la ventana porque no había nada más. Ahora que
        hay equipo, cluster y modos digitales, el cuaderno se ha mudado a su propia pestaña y
        la principal es «Operar», que es donde se está mientras se trabaja.

        La cabecera —perfil, escala de letra, tema y reloj UTC— se queda fuera de las pestañas:
        vale para todas. Se pliega la primera cuando falta alto, porque lo suyo está repetido
        en la barra de estado.
    -->
    <Grid Margin="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Cabecera ══ -->
        <!--
            La cabecera es CROMO, no contenido: fondo casi negro, como la barra de estado. El
            contraste entre el marco oscuro y los paneles de dentro es lo primero que se ve de
            una cabina, y es lo que hacia que la nuestra pareciera mas pobre de lo que es.
        -->
        <Border x:Name="TarjetaDeCabecera" Grid.Row="0"
                Background="{DynamicResource FondoCromo}"
                BorderBrush="{DynamicResource BordeCromo}"
                BorderThickness="0,0,0,1"
                Padding="12,7"
                Margin="-12,-12,-12,8"
                TextElement.Foreground="{DynamicResource TextoCromo}"
                Visibility="{Binding CabeceraVisible, Converter={StaticResource BooleanoAVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- La marca de la casa, la misma del icono del programa. -->
                    <Image Source="{StaticResource MarcaDelCuaderno}"
                           Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=2.6}"
                           Height="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=2.6}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Marca de Cuaderno NODISLA" />
                    <StackPanel Style="{StaticResource BloqueDeCampo}" VerticalAlignment="Center">
                        <TextBlock Text="Cuaderno NODISLA"
                                   FontWeight="Bold"
                                   FontSize="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=1.35}"
                                   Foreground="{DynamicResource Acento}" />
                        <TextBlock Text="Cuaderno de guardia de EA8DLF" Style="{StaticResource TextoTenueEstilo}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource BloqueDeCampo}"
                                Width="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=17}">
                        <TextBlock Text="Perfil de estación" Style="{StaticResource EtiquetaDeCampo}" />
                        <ComboBox ItemsSource="{Binding Estaciones}"
                                  SelectedItem="{Binding EstacionActiva}"
                                  ToolTip="{Binding AvisoDelPerfil}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombrePerfil}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!--
                        La escala de letra ya no se repite aquí: su mando está en la barra de
                        estado, que no se pliega nunca (y con Ctrl+ / Ctrl−). Dos mandos para lo
                        mismo era parte del desorden.
                    -->

                    <StackPanel Style="{StaticResource BloqueDeCampo}" VerticalAlignment="Bottom">
                        <CheckBox Content="Tema oscuro (F9)" IsChecked="{Binding TemaOscuro}" />
                    </StackPanel>
                </WrapPanel>

                <!-- El reloj y, debajo, la franja solar: lo que se mira de reojo. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Border Background="{DynamicResource FondoCabecera}"
                        BorderBrush="{DynamicResource Borde}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="16,8"
                        VerticalAlignment="Center">
                    <!-- UTC y hora local lado a lado: UTC para el cuaderno, local para la vida. -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{Binding HoraUtc}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=1.7}"
                                       Foreground="{DynamicResource Acento}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TextoTenueEstilo}">
                                <Run Text="{Binding FechaUtc, Mode=OneWay}" />
                                <Run Text="UTC" />
                            </TextBlock>
                        </StackPanel>
                        <Border Width="1" Margin="14,2" Background="{DynamicResource BordeSuave}" />
                        <StackPanel>
                            <TextBlock Text="{Binding HoraLocal}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="{Binding TamanoDeLetra, Converter={StaticResource AnchoEnLetras}, ConverterParameter=1.7}"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TextoTenueEstilo}"
                                       Text="{Binding FechaLocal}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <vistas:FranjaSolar DataContext="{Binding Solar}" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ La barra de navegación ══ -->
        <!--
            CUATRO ENTRADAS AGRUPADAS POR USO, Y LA CONFIGURACIÓN A LA DERECHA DEL TODO.

            Antes eran nueve pestañas en fila —Operar, Digital, Cuaderno, Mapa, Diplomas,
            Ajustes, Satélites, Imprimir y Ronda— con los ajustes metidos en medio. Ahora:

              Operar     Cabina · Digital · Satélites · Ronda de control
              Libro      Contactos · Mapa
              QSL        Tarjeta QSL · Etiquetas
              Diplomas
                                                          Ayuda · Configuración

            Las páginas del grupo elegido salen en la MISMA barra, a continuación y más
            discretas: una segunda fila le quitaba alto a la cabina, que es donde falta.

            Cada botón lleva en el Tag las páginas que le tocan; el estilo lo enciende cuando
            la página que se ve está entre ellas. Los índices son los de siempre (se guardan al
            cerrar y van detrás de Ctrl 1…Ctrl 9), así que nada de lo guardado se descoloca.
        -->
        <Border Grid.Row="1"
                Background="{DynamicResource FondoCabecera}"
                BorderBrush="{DynamicResource Borde}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,8">
            <DockPanel>
                <!--
                    A la derecha del todo, Configuración; justo antes, la Ayuda (F1 abre el
                    capítulo de la página en la que se esté).
                -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="EntradaDeAyuda"
                            Style="{StaticResource EntradaDeNavegacion}"
                            Tag="11"
                            Command="{Binding VerLaAyudaCommand}"
                            ToolTip="Ayuda: capítulos, primer uso, reportar un fallo, buscar actualizaciones y acerca de (F1 abre la de la página en la que está)"
                            AutomationProperties.Name="Ayuda">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoAyuda}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Ayuda" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EntradaDeNavegacion}"
                            Tag="5"
                            Command="{Binding VerLosAjustesCommand}"
                            ToolTip="Configuración: cuentas, equipo, audio, cluster, correo… (Ctrl 6)"
                            AutomationProperties.Name="Configuración">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoAjustes}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Configuración" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource EntradaDeNavegacion}"
                            Tag="0,1,6,8"
                            Command="{Binding VerElGrupoCommand}"
                            CommandParameter="Operar"
                            ToolTip="Operar: cabina (Ctrl 1), digital (Ctrl 2), satélites (Ctrl 7) y ronda de control (Ctrl 9)"
                            AutomationProperties.Name="Operar">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoOperar}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Operar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EntradaDeNavegacion}"
                            Tag="2,3"
                            Command="{Binding VerElGrupoCommand}"
                            CommandParameter="Libro"
                            ToolTip="Libro: los contactos (Ctrl 3) y su mapa (Ctrl 4)"
                            AutomationProperties.Name="Libro">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoCuaderno}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Libro" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EntradaDeNavegacion}"
                            Tag="7,9,10"
                            Command="{Binding VerElGrupoCommand}"
                            CommandParameter="QSL"
                            ToolTip="QSL: la tarjeta y su envío por correo (Ctrl 8), las etiquetas del buró y el diseñador de diplomas (Ctrl Mayús 5)"
                            AutomationProperties.Name="QSL">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoQsl}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="QSL" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EntradaDeNavegacion}"
                            Tag="4"
                            Command="{Binding VerElGrupoCommand}"
                            CommandParameter="Diplomas"
                            ToolTip="Diplomas (Ctrl 5)"
                            AutomationProperties.Name="Diplomas">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoDiplomas}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Diplomas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ── Las páginas del grupo elegido ── -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,8,0"
                                Visibility="{Binding EnElGrupoOperar, Converter={StaticResource BooleanoAVisible}}">
                        <Border Width="1" Height="18" Margin="0,0,10,0" Background="{DynamicResource Borde}" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="0" Content="Cabina"
                                Command="{Binding VerOperarCommand}" ToolTip="La cabina: equipo, entrada, cluster y bandmap (Ctrl 1)" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="1" Content="Digital"
                                Command="{Binding VerLoDigitalCommand}" ToolTip="Modos digitales: FT8, FT4… (Ctrl 2)" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="6" Content="Satélites"
                                Command="{Binding VerLosSatelitesCommand}" ToolTip="Pasos y Doppler de los satélites (Ctrl 7)" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="8" Content="Ronda de control"
                                Command="{Binding VerLaRondaCommand}" ToolTip="Ronda de control de una red (Ctrl 9)" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,8,0"
                                Visibility="{Binding EnElGrupoLibro, Converter={StaticResource BooleanoAVisible}}">
                        <Border Width="1" Height="18" Margin="0,0,10,0" Background="{DynamicResource Borde}" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="2" Content="Contactos"
                                Command="{Binding VerElCuadernoCommand}" ToolTip="Los contactos del cuaderno (Ctrl 3, F3 para buscar)" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="3" Content="Mapa"
                                Command="{Binding VerElMapaCommand}" ToolTip="El mapa de contactos, anuncios y línea gris (Ctrl 4)" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,8,0"
                                Visibility="{Binding EnElGrupoQsl, Converter={StaticResource BooleanoAVisible}}">
                        <Border Width="1" Height="18" Margin="0,0,10,0" Background="{DynamicResource Borde}" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="7" Content="Tarjeta QSL"
                                Command="{Binding VerLaQslCommand}" ToolTip="Diseñar la tarjeta y mandarla por correo (Ctrl 8)" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="9" Content="Etiquetas"
                                Command="{Binding VerLasEtiquetasCommand}" ToolTip="Etiquetas de las QSL para el buró" />
                        <Button Style="{StaticResource SubentradaDeNavegacion}" Tag="10" Content="Diplomas"
                                Command="{Binding VerElDisenadorDeDiplomasCommand}" ToolTip="Diseñar y emitir diplomas propios y certificados (Ctrl Mayús 5)" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ══ El aviso de versión nueva (solo se ve si la hay) ══ -->
        <vistas:AvisoDeVersion Grid.Row="2" DataContext="{Binding Actualizaciones}" />

        <!-- ══ Las páginas ══ -->
        <!-- El orden de las TabItem es el índice de siempre: no reordenar (ver Pestanas). -->
        <TabControl Grid.Row="3"
                    Style="{StaticResource PaginasSinCabecera}"
                    SelectedIndex="{Binding IndiceDeLaPestana}"
                    Margin="0,0,0,8">
            <!-- 0 · Operar → Cabina -->
            <TabItem Header="Cabina">
                <vistas:PanelOperar x:Name="Operar" />
            </TabItem>

            <!-- 1 · Operar → Digital -->
            <TabItem Header="Digital">
                <vistas:PestanaDigital />
            </TabItem>

            <!-- 2 · Libro → Contactos -->
            <TabItem Header="Contactos">
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <vistas:PanelDelCuaderno x:Name="Cuaderno" Fallo="AlFallarElCuaderno" />
                </Border>
            </TabItem>

            <!-- 3 · Libro → Mapa -->
            <TabItem Header="Mapa">
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <vistas:PanelDeMapa DataContext="{Binding Mapa}" />
                </Border>
            </TabItem>

            <!-- 4 · Diplomas -->
            <TabItem Header="Diplomas">
                <vistas:PanelDeDiplomas DataContext="{Binding Diplomas}" />
            </TabItem>

            <!-- 5 · Configuración -->
            <TabItem Header="Configuración">
                <vistas:PanelDeAjustes DataContext="{Binding Configuracion}" />
            </TabItem>

            <!-- 6 · Operar → Satélites -->
            <TabItem Header="Satélites">
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <vistas:PanelDeSatelites DataContext="{Binding Satelites}" />
                </Border>
            </TabItem>

            <!-- 7 · QSL → Tarjeta QSL (su diseño y el envío por correo) -->
            <TabItem Header="Tarjeta QSL">
                <vistas:PanelDeQsl DataContext="{Binding Impresion.Qsl}" />
            </TabItem>

            <!-- 8 · Operar → Ronda de control -->
            <TabItem Header="Ronda de control">
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <vistas:PestanaRonda DataContext="{Binding Ronda}" />
                </Border>
            </TabItem>

            <!-- 9 · QSL → Etiquetas del buró -->
            <TabItem Header="Etiquetas">
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <vistas:PanelDeImpresion DataContext="{Binding Impresion}" />
                </Border>
            </TabItem>

            <!-- 10 · QSL → Diplomas (el diseñador de diplomas propios y certificados) -->
            <TabItem Header="Diseñador de diplomas">
                <vqsl:DisenadorDeDiplomas DataContext="{Binding DisenadorDeDiplomas}" />
            </TabItem>

            <!-- 11 · Ayuda -->
            <TabItem Header="Ayuda">
                <vistas:PanelDeAyuda x:Name="PaginaDeAyuda" DataContext="{Binding Ayuda}" />
            </TabItem>
        </TabControl>

        <!-- ══ Barra de estado ══ -->
        <Border Grid.Row="4"
                Background="{DynamicResource FondoCromo}"
                BorderBrush="{DynamicResource BordeCromo}"
                BorderThickness="0,1,0,0"
                Padding="12,5"
                Margin="-12,0,-12,0"
                TextElement.Foreground="{DynamicResource TextoCromo}">
            <DockPanel>

                <!--
                    EL MANDO DE LA ESCALA DE LETRA, SIEMPRE ALCANZABLE CON EL RATÓN.

                    Esto no es un adorno: es la salida de emergencia. La escala se guarda de una
                    sesión a la siguiente, así que si el único sitio donde se puede bajar es la
                    cabecera y la cabecera se pliega al 200 %, la aplicación se queda atascada en
                    grande para siempre y no hay manera de volver con el ratón. Un ajuste que se
                    puede poner y no se puede quitar es una trampa.

                    Por eso vive aquí, en la barra de estado, que no se pliega nunca; va anclado
                    a la derecha, de modo que es lo primero que se reserva y lo último que se
                    recorta; y lleva TAMAÑO DE LETRA FIJO, sin seguir a la escala, para que al
                    200 % siga ocupando lo mismo que al 100 %.

                    Los atajos (Ctrl+, Ctrl− y Ctrl+0) siguen estando, pero un atajo que no se
                    ve no existe.
                -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            TextElement.FontSize="12"
                            AutomationProperties.Name="Tamaño de la letra de la ventana">
                    <TextBlock Text="Letra"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextoTenue}" />

                    <Button Content="−"
                            Command="{Binding ReducirLetraCommand}"
                            FontSize="12"
                            Padding="8,1"
                            MinWidth="26"
                            ToolTip="Letra más pequeña (Ctrl −)"
                            AutomationProperties.Name="Reducir el tamaño de la letra" />

                    <TextBlock Text="{Binding EscalaDeLetraTexto}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               MinWidth="44"
                               TextTrimming="None" />

                    <Button Content="+"
                            Command="{Binding AumentarLetraCommand}"
                            FontSize="12"
                            Padding="8,1"
                            MinWidth="26"
                            ToolTip="Letra más grande (Ctrl +)"
                            AutomationProperties.Name="Aumentar el tamaño de la letra" />

                    <Button Content="100 %"
                            Command="{Binding LetraNormalCommand}"
                            FontSize="12"
                            Padding="8,1"
                            Margin="6,0,0,0"
                            ToolTip="Vuelve al tamaño normal (Ctrl 0)"
                            AutomationProperties.Name="Volver al tamaño de letra normal" />
                </StackPanel>

                <WrapPanel>
                <!--
                    Con los puertos simulados detras, se dice y se dice FUERTE: el cuaderno es
                    de relleno y se pierde al cerrar, la radio no existe y los anuncios son
                    inventados. Creer que esto son datos de verdad sería el peor malentendido.
                -->
                <Border Padding="8,1"
                        CornerRadius="8"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AvisoFondo}"
                        BorderBrush="{DynamicResource AvisoBorde}"
                        BorderThickness="1"
                        ToolTip="Los datos son inventados: el cuaderno no se guarda, la radio no existe y los anuncios del cluster son de mentira."
                        AutomationProperties.Name="Modo de pruebas: los datos son inventados y no se guardan"
                        Visibility="{Binding Source={x:Static vistas:VentanaPrincipal.EnPruebas}, Converter={StaticResource BooleanoAVisible}}">
                    <TextBlock Text="DATOS DE PRUEBA"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource AvisoTexto}"
                               TextTrimming="None" />
                </Border>

                <!-- Los testigos de los servicios, lo primero de la barra. -->
                <vistas:PastillasDeServicio Margin="0,0,16,0" />

                <TextBlock Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="Estación:" Foreground="{DynamicResource TextoTenue}" />
                    <Run Text="{Binding PerfilActivo, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Margin="0,0,20,0">
                    <Run Text="Hora UTC:" Foreground="{DynamicResource TextoTenue}" />
                    <Run Text="{Binding HoraUtc, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Margin="0,0,20,0">
                    <Run Text="Contactos en el cuaderno:" Foreground="{DynamicResource TextoTenue}" />
                    <Run Text="{Binding TotalDeQsosTexto, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Style="{StaticResource TextoTenueEstilo}"
                           Visibility="{Binding LeyendaVisible, Converter={StaticResource BooleanoAVisible}}"
                           ToolTip="Atajos de teclado"
                           Text="F1 ayuda · Intro registra · Esc limpia · F2 modifica · F3 buscar · F4 indicativo · F5 refresca · F7 más datos · F8 hora · F9 tema · Supr borra · Ctrl1…Ctrl9 páginas (ver la barra) · Ctrl+ y Ctrl− escala" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
