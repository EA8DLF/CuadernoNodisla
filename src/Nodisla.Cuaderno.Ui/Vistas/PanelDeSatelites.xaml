<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeSatelites"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        LA PESTAÑA DE SATÉLITES.

        Izquierda, el catálogo con el próximo paso de cada uno, avisando de los rasantes y de
        los elementos viejos. Derecha, el satélite elegido: az/el en vivo, su transpondedor y
        el panel de Doppler sobre el equipo. El subpunto NO se dibuja aquí: es una marca más
        del mismo mapa de siempre (pestaña Mapa), puesta por el modelo de vista mientras hay
        un satélite elegido.

        NADA SE DESCARGA SOLO. El botón «Actualizar elementos orbitales» es la única puerta a
        la red, y el seguimiento Doppler solo empieza cuando el operador pulsa «Seguir».
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:Negacion x:Key="Negacion" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" MinWidth="340" />
            <ColumnDefinition Width="1*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ══ Catálogo con el próximo paso ══ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Satélites" Style="{StaticResource TituloDeSeccion}" />

                <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,8">
                    <Button Content="Actualizar elementos orbitales…"
                            Command="{Binding ActualizarElementosCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="Descargar los elementos orbitales de las fuentes conocidas" />
                    <Button Content="Actualizar pasos"
                            Command="{Binding RefrescarPasosCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="Recalcular el próximo paso de todos los satélites" />
                </WrapPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding AvisoElementos}"
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding Satelites}"
                         SelectedItem="{Binding SateliteSeleccionado}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="8,6"
                                    CornerRadius="4"
                                    Background="{DynamicResource FondoAlterno}"
                                    BorderBrush="{DynamicResource BordeSuave}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding EstadoTexto}"
                                                   Style="{StaticResource TextoTenueEstilo}" />
                                        <TextBlock FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Abreviatura, Mode=OneWay}" />
                                            <Run Text=" · " Foreground="{DynamicResource TextoTenue}" />
                                            <Run Text="{Binding Nombre, Mode=OneWay}" Foreground="{DynamicResource TextoTenue}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <TextBlock Text="{Binding ProximoPasoTexto}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cargado}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EsRasante}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementosViejos}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ El satélite elegido: en vivo y Doppler ══ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0" Padding="8,6">
            <Grid>
            <TextBlock Text="Elija un satélite de la lista para ver su próximo paso en vivo y seguir su Doppler."
                       Style="{StaticResource TextoTenueEstilo}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HaySateliteSeleccionado, Converter={StaticResource VisibleSiEsFalso}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HaySateliteSeleccionado, Converter={StaticResource BooleanoAVisible}}">
                <StackPanel>
                    <TextBlock Text="{Binding NombreDelSateliteElegido}" Style="{StaticResource TituloDeSeccion}" />

                    <StackPanel Style="{StaticResource BloqueDeCampo}" Margin="0,0,0,8">
                        <TextBlock Text="Transpondedor" Style="{StaticResource EtiquetaDeCampo}" />
                        <ComboBox ItemsSource="{Binding Transpondedores}"
                                  SelectedItem="{Binding TranspondedorSeleccionado}"
                                  ToolTip="Transpondedor con el que se trabaja">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreDelTranspondedor}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- ── En vivo ── -->
                    <TextBlock Text="En vivo" Style="{StaticResource TituloDeSeccion}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="Azimut" Style="{StaticResource EtiquetaDeCampo}" />
                            <TextBlock Text="{Binding AzEnVivoTexto}" FontWeight="Bold" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="Elevación" Style="{StaticResource EtiquetaDeCampo}" />
                            <TextBlock Text="{Binding ElEnVivoTexto}" FontWeight="Bold" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="Distancia" Style="{StaticResource EtiquetaDeCampo}" />
                            <TextBlock Text="{Binding DistanciaTexto}" FontWeight="Bold" FontSize="16" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="6,4"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Background="{DynamicResource AvisoFondo}"
                            BorderBrush="{DynamicResource AvisoBorde}"
                            BorderThickness="1"
                            Visibility="{Binding AvisoDePosicion, Converter={StaticResource NoEsVacio}}">
                        <TextBlock Text="{Binding AvisoDePosicion}"
                                   Foreground="{DynamicResource AvisoTexto}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Doppler ── -->
                    <TextBlock Text="Doppler" Style="{StaticResource TituloDeSeccion}" />

                    <Border Padding="6,4"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Background="{DynamicResource ErrorFondo}"
                            BorderBrush="{DynamicResource ErrorBorde}"
                            BorderThickness="1"
                            Visibility="{Binding HayEquipoConDosVfos, Converter={StaticResource VisibleSiEsFalso}}">
                        <TextBlock Text="El equipo conectado no informa de sus dos VFO: no se puede seguir el Doppler."
                                   Foreground="{DynamicResource ErrorTexto}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="VFO de subida" Style="{StaticResource EtiquetaDeCampo}" />
                            <ComboBox ItemsSource="{Binding VfosDisponibles}"
                                      SelectedItem="{Binding VfoDeSubida}"
                                      IsEnabled="{Binding SiguiendoDoppler, Converter={StaticResource Negacion}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="VFO de bajada" Style="{StaticResource EtiquetaDeCampo}" />
                            <ComboBox ItemsSource="{Binding VfosDisponibles}"
                                      SelectedItem="{Binding VfoDeBajada}"
                                      IsEnabled="{Binding SiguiendoDoppler, Converter={StaticResource Negacion}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding RepartoDeVfosTexto}"
                               Style="{StaticResource TextoTenueEstilo}"
                               Margin="0,0,0,8" />

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Seguir"
                                Command="{Binding SeguirDopplerCommand}"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="Empezar a seguir el Doppler de este transpondedor" />
                        <Button Content="Soltar"
                                Command="{Binding SoltarDopplerCommand}"
                                AutomationProperties.Name="Dejar de seguir el Doppler" />
                    </WrapPanel>

                    <Grid Visibility="{Binding SiguiendoDoppler, Converter={StaticResource BooleanoAVisible}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="Desplazamiento de subida" Style="{StaticResource EtiquetaDeCampo}" />
                            <TextBlock Text="{Binding DesplazamientoSubidaTexto}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource BloqueDeCampo}">
                            <TextBlock Text="Desplazamiento de bajada" Style="{StaticResource EtiquetaDeCampo}" />
                            <TextBlock Text="{Binding DesplazamientoBajadaTexto}" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AvisoDoppler}"
                               Style="{StaticResource TextoTenueEstilo}"
                               TextWrapping="Wrap"
                               Visibility="{Binding AvisoDoppler, Converter={StaticResource NoEsVacio}}" />

                    <TextBlock Text="El subpunto del satélite se ve en la pestaña Mapa."
                               Style="{StaticResource TextoTenueEstilo}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
