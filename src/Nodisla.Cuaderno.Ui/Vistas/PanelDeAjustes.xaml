<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeAjustes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        LA CONFIGURACIÓN.

        Lo que se toca una vez y se olvida, y lo que hace falta para diagnosticar cuando algo no
        va. Lo que se mira mientras se opera —el estado de las conexiones— se queda en Operar.

        Antes era una sola pantalla con dos columnas que había que bajar y bajar: ocho casillas
        de contraseña seguidas, los usuarios de cada servicio mucho más abajo y, en la otra
        columna, el equipo, el audio, la fonía y el cluster uno detrás de otro. Ahora va por
        apartados, con la lista a la izquierda, y los servicios en TARJETAS: cada una con su
        usuario, sus contraseñas, su estado y, si la tiene, su prueba.

        LAS CREDENCIALES SE GUARDAN CIFRADAS Y NO SE VUELVEN A ENSEÑAR. El almacén usa la
        protección de datos del usuario de Windows, así que el fichero solo lo puede descifrar
        la cuenta que lo escribió, y solo sabe decir si hay algo guardado, no qué. El campo sale
        siempre vacío: un secreto repintado en pantalla es un secreto que alguien lee por encima
        del hombro.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />
        <conversores:AnchoEnLetras x:Key="AnchoEnLetras" />

        <!--
            Cada apartado se pinta por el TIPO de su modelo. Con el modelo nulo (puertos
            simulados) no se pinta nada: una plantilla puesta a mano se monta igual con el
            contexto nulo, y cada enlace suyo contaba como roto.
        -->
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloAjustesCat}">
            <vistas:AjustesDelEquipo />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloAjustesAudio}">
            <vistas:AjustesDeAudio />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloAjustesFonia}">
            <vistas:AjustesDeFonia />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloAjustesCluster}">
            <vistas:ConexionDelCluster />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloSubidas}">
            <vistas:AjustesDeSubidas />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloCorreoQsl}">
            <vistas:AjustesDeCorreo />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloActualizaciones}">
            <vistas:AjustesDeActualizaciones />
        </DataTemplate>

        <!-- La pastilla del estado: verde configurado, ámbar a medias, gris sin nada. -->
        <Style x:Key="PastillaDeEstado" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
        </Style>

        <!-- Un secreto dentro de su tarjeta: rótulo y estado, y debajo la casilla y sus botones. -->
        <DataTemplate x:Key="FilaDeSecreto" DataType="{x:Type vistamodelos:SecretoDeServicio}">
            <StackPanel Margin="0,6,0,0">
                <DockPanel Margin="0,0,0,2">
                    <Border DockPanel.Dock="Right">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PastillaDeEstado}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Guardado}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Estado}" FontSize="10" TextTrimming="None" />
                    </Border>
                    <TextBlock Text="{Binding Titulo}"
                               ToolTip="{Binding Explicacion}"
                               Style="{StaticResource EtiquetaDeCampo}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Texto Comun.Borrar}"
                            Command="{Binding BorrarCommand}"
                            Margin="5,0,0,0"
                            Padding="8,2"
                            AutomationProperties.Name="{loc:Texto Ajustes.Secreto.Borrar.Accesible}" />
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Texto Comun.Guardar}"
                            Command="{Binding GuardarCommand}"
                            Margin="5,0,0,0"
                            Padding="8,2"
                            AutomationProperties.Name="{loc:Texto Ajustes.Secreto.Guardar.Accesible}" />
                    <PasswordBox x:Name="Campo"
                                 PasswordChanged="AlEscribirElSecreto"
                                 Loaded="AlMontarLaCasillaDelSecreto"
                                 Unloaded="AlDesmontarLaCasillaDelSecreto"
                                 Padding="6,3"
                                 Background="{DynamicResource FondoCampo}"
                                 Foreground="{DynamicResource Texto}"
                                 BorderBrush="{DynamicResource Borde}"
                                 BorderThickness="1"
                                 ToolTip="{Binding Explicacion}"
                                 AutomationProperties.Name="{Binding Titulo}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Un dato de la cuenta que no es secreto: el usuario, el apodo… -->
        <DataTemplate x:Key="FilaDeCampo" DataType="{x:Type vistamodelos:CampoDeCuenta}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource EtiquetaDeCampo}" Margin="0,0,0,2" />
                <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,3"
                         ToolTip="{Binding Nota}"
                         AutomationProperties.Name="{Binding Rotulo}" />
            </StackPanel>
        </DataTemplate>

        <!-- ══ La tarjeta de un servicio ══ -->
        <DataTemplate x:Key="TarjetaDeUnServicio" DataType="{x:Type vistamodelos:TarjetaDeServicio}">
            <Border Margin="0,0,10,10"
                    Padding="12,10"
                    CornerRadius="6"
                    Background="{DynamicResource FondoAlterno}"
                    BorderBrush="{DynamicResource BordeSuave}"
                    BorderThickness="1">
                <StackPanel>
                    <!-- Cabecera: chapa con la inicial, nombre, para qué sirve y estado -->
                    <DockPanel>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PastillaDeEstado}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="Configurado">
                                            <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="AMedias">
                                            <Setter Property="Background" Value="{DynamicResource AvisoFondo}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AvisoBorde}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11" TextTrimming="None" />
                        </Border>

                        <Border DockPanel.Dock="Left"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource FondoCabecera}"
                                BorderBrush="{DynamicResource Acento}"
                                BorderThickness="1.5">
                            <TextBlock Text="{Binding Inicial}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Acento}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Descripcion}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <!-- El aviso vivo: por qué no se puede subir, a qué nodo se entra… -->
                    <TextBlock Text="{Binding Aviso}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource TextoTenueEstilo}"
                               Visibility="{Binding Aviso, Converter={StaticResource NoEsVacio}}" />

                    <!-- La nota que se lee ANTES de escribir (la frase de paso de TQSL) -->
                    <!--
                        Plegada para no alargar la tarjeta, pero con el rótulo en ámbar y a la vista
                        ANTES de la casilla: quien vaya a escribir la frase sabe que hay algo que leer.
                    -->
                    <Border Padding="8,3"
                            CornerRadius="4"
                            Margin="0,8,0,0"
                            Background="{DynamicResource AvisoFondo}"
                            BorderBrush="{DynamicResource AvisoBorde}"
                            BorderThickness="1"
                            Visibility="{Binding Nota, Converter={StaticResource NoEsVacio}}">
                        <Expander Foreground="{DynamicResource AvisoTexto}">
                            <Expander.Header>
                                <TextBlock Text="{loc:Texto Ajustes.Tarjeta.LeaAntes}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AvisoTexto}"
                                           FontWeight="SemiBold" />
                            </Expander.Header>
                            <TextBlock Text="{Binding Nota}" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,2" />
                        </Expander>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Campos}" ItemTemplate="{StaticResource FilaDeCampo}" Focusable="False" />
                    <ItemsControl ItemsSource="{Binding Secretos}" ItemTemplate="{StaticResource FilaDeSecreto}" Focusable="False" />

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{loc:Texto Ajustes.Tarjeta.GuardarCuenta}"
                                Command="{Binding GuardarCuenta}"
                                Margin="0,0,6,0"
                                Padding="10,2"
                                ToolTip="{loc:Texto Ajustes.Tarjeta.GuardarCuenta.Ayuda}"
                                Visibility="{Binding SePuedeGuardarLaCuenta, Converter={StaticResource BooleanoAVisible}}"
                                AutomationProperties.Name="{loc:Texto Ajustes.Tarjeta.GuardarCuenta.Accesible}" />
                        <Button Content="{Binding TextoDeProbar}"
                                Command="{Binding Probar}"
                                Margin="0,0,6,0"
                                Padding="10,2"
                                Visibility="{Binding HayPrueba, Converter={StaticResource BooleanoAVisible}}" />
                        <Button Content="{loc:Texto Ajustes.Tarjeta.Configurar}"
                                Command="{Binding Configurar}"
                                Padding="10,2"
                                Visibility="{Binding HayConfigurar, Converter={StaticResource BooleanoAVisible}}"
                                AutomationProperties.Name="{loc:Texto Ajustes.Tarjeta.Configurar.Accesible}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- El cuerpo de cada apartado: la tarjeta de siempre con su barra de desplazamiento. -->
        <Style x:Key="CuerpoDelApartado" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="Apartados"
                Style="{StaticResource ApartadosLaterales}"
                SelectedIndex="{Binding IndiceDelApartado}">

        <!-- ══ 0 · Cuentas y servicios ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Cuentas}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Texto Ajustes.Apartado.Cuentas}" Style="{StaticResource TituloDeSeccion}" />
                        <TextBlock Text="{loc:Texto Ajustes.Cuentas.Explicacion}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Tarjetas}"
                                      ItemTemplate="{StaticResource TarjetaDeUnServicio}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource Self}, Converter={StaticResource AnchoEnLetras}, ConverterParameter=32}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 1 · Subidas y QRZ ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Subidas}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <!-- Subida automática a LoTW, eQSL, Club Log y QRZ, y la ficha de QRZ.com. -->
                        <ContentControl Content="{Binding Subidas}" Focusable="False" />
                        <TextBlock Text="{loc:Texto Ajustes.Subidas.NoMontada}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HaySubidas, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 2 · Equipo (CAT) ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Equipo}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <!-- Cómo está el equipo ahora mismo, en una línea -->
                        <Border Padding="8,5"
                                CornerRadius="4"
                                Margin="0,0,0,8"
                                Background="{DynamicResource FondoAlterno}"
                                BorderBrush="{DynamicResource BordeSuave}"
                                BorderThickness="1"
                                DataContext="{Binding DataContext.Equipo, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                                <Run Text="{loc:Texto Ajustes.Equipo.EnUnaLinea}" />
                                <Run Text="{Binding NombreDelEquipo, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding ViaTexto, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding EstadoTexto, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <!--
                            Se monta SOLO si hay modelo detrás (plantilla por tipo, en los
                            recursos): antes se montaba siempre, oculto y con el contexto nulo, y
                            cada uno de sus enlaces contaba como roto con los simulados.
                        -->
                        <ContentControl Content="{Binding Cat}"
                                        Focusable="False"
                                        Visibility="{Binding HayCat, Converter={StaticResource BooleanoAVisible}}" />

                        <TextBlock Text="{loc:Texto Ajustes.Equipo.Simulado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HayCat, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 3 · Audio y digitales ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Audio}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <ContentControl Content="{Binding Audio}"
                                        Focusable="False"
                                        Visibility="{Binding HayAudio, Converter={StaticResource BooleanoAVisible}}" />
                        <TextBlock Text="{loc:Texto Ajustes.Audio.NoMontado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HayAudio, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 4 · Fonía ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Fonia}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <!-- La fonía por el PC: altavoces, micrófono y PTT de fonía -->
                        <ContentControl Content="{Binding Fonia}" Focusable="False" />
                        <TextBlock Text="{loc:Texto Ajustes.Fonia.NoMontada}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HayFonia, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 5 · Cluster: la conexión y su consola ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Cluster}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <ContentControl Content="{Binding Cluster}"
                                        Focusable="False"
                                        Visibility="{Binding HayCluster, Converter={StaticResource BooleanoAVisible}}" />

                        <TextBlock Text="{loc:Texto Ajustes.Cluster.Simulado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HayCluster, Converter={StaticResource VisibleSiEsFalso}}" />

                        <!-- La consola cruda del nodo: para diagnosticar -->
                        <vistas:AjustesDelCluster DataContext="{Binding DataContext.Cluster, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="260" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 6 · Correo de las QSL ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Correo}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <!-- El correo con el que se mandan las QSL (QSL → Tarjeta QSL). -->
                        <ContentControl Content="{Binding CorreoQsl}" Focusable="False" />
                        <TextBlock Text="{loc:Texto Ajustes.Correo.NoMontado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HayCorreo, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 7 · Libro (ADIF) ══ -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Libro}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Texto Ajustes.Libro.Titulo}" Style="{StaticResource TituloDeSeccion}" />
                        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                            <Run Text="{loc:Texto Ajustes.Libro.Contactos}" />
                            <Run Text="{Binding ContactosDelCuaderno, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>

                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="{loc:Texto Ajustes.Libro.Importar}"
                                    Command="{Binding ImportarAdifCommand}"
                                    Margin="0,0,6,6"
                                    AutomationProperties.Name="{loc:Texto Ajustes.Libro.Importar.Accesible}" />
                            <Button Content="{loc:Texto Ajustes.Libro.Exportar}"
                                    Command="{Binding ExportarAdifCommand}"
                                    Margin="0,0,6,6"
                                    AutomationProperties.Name="{loc:Texto Ajustes.Libro.Exportar.Accesible}" />
                        </WrapPanel>

                        <TextBlock Text="{loc:Texto Ajustes.Libro.SinEscritor}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding SePuedeExportar, Converter={StaticResource VisibleSiEsFalso}}" />

                        <!--
                            El parte de la importación, entero. La cifra de confirmaciones
                            rescatadas es la que justifica fundir las copias en vez de saltarlas:
                            cada una es un diploma que no se pierde.
                        -->
                        <Border Padding="8,6"
                                CornerRadius="4"
                                Margin="0,0,0,8"
                                Background="{DynamicResource FondoAlterno}"
                                BorderBrush="{DynamicResource BordeSuave}"
                                BorderThickness="1"
                                Visibility="{Binding ParteDeLaImportacion, Converter={StaticResource NoEsVacio}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ParteDeLaImportacion}" TextWrapping="Wrap" />

                                <Expander Header="{loc:Texto Ajustes.Libro.Choques}"
                                          Margin="0,6,0,0"
                                          Visibility="{Binding HayChoques, Converter={StaticResource BooleanoAVisible}}">
                                    <ItemsControl ItemsSource="{Binding Choques}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Style="{StaticResource TextoDeConsola}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>

        <!-- ══ 8 · Actualizaciones ══ -->
        <!-- El MISMO VistaModeloActualizaciones que la barra del aviso (ver VistaModeloAjustes). -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Actualizaciones}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <ContentControl Content="{Binding Actualizaciones}" Focusable="False" />
                        <TextBlock Text="{loc:Texto Ajustes.Actualizaciones.NoMontado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HayActualizaciones, Converter={StaticResource VisibleSiEsFalso}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>
        <!-- ══ 9 · Idioma ══ -->
        <!-- Se cambia al momento, sin reiniciar: todos los textos son enlaces (ver Idiomas\Texto.cs). -->
        <TabItem Header="{loc:Texto Ajustes.Apartado.Idioma}">
            <Border Style="{StaticResource CuerpoDelApartado}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding Idioma}">
                        <TextBlock Text="{loc:Texto Ajustes.Idioma.Titulo}" Style="{StaticResource TituloDeSeccion}" />
                        <ComboBox ItemsSource="{Binding Opciones}"
                                  SelectedItem="{Binding Elegida}"
                                  DisplayMemberPath="Nombre"
                                  MinWidth="260"
                                  HorizontalAlignment="Left"
                                  Margin="0,6,0,10"
                                  AutomationProperties.Name="{loc:Texto Ajustes.Idioma.Titulo}" />
                        <TextBlock Text="{loc:Texto Ajustes.Idioma.Explicacion}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Texto Ajustes.Idioma.Ayuda}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
