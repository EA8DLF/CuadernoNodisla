<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeAjustes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        LA PANTALLA DE AJUSTES.

        Lo que se toca una vez y se olvida, y lo que hace falta para diagnosticar cuando algo no
        va. Lo que se mira mientras se opera —el estado de las conexiones— se queda en Operar.

        LAS CREDENCIALES SE GUARDAN CIFRADAS Y NO SE VUELVEN A ENSEÑAR. El almacén usa la
        protección de datos del usuario de Windows, así que el fichero solo lo puede descifrar
        la cuenta que lo escribió, y solo sabe decir si hay algo guardado, no qué. El campo sale
        siempre vacío: un secreto repintado en pantalla es un secreto que alguien lee por encima
        del hombro.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="280" />
            <ColumnDefinition Width="1*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- ══ Credenciales y LoTW ══ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Servicios y credenciales" Style="{StaticResource TituloDeSeccion}" />
                    <TextBlock Text="Se guardan cifradas con la protección de datos de su cuenta de Windows. Una vez escritas no se vuelven a mostrar: solo se dice si están guardadas."
                               Style="{StaticResource TextoTenueEstilo}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Secretos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="8,6"
                                        CornerRadius="4"
                                        Background="{DynamicResource FondoAlterno}"
                                        BorderBrush="{DynamicResource BordeSuave}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right"
                                                    CornerRadius="8"
                                                    Padding="7,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Guardado}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" FontSize="10" TextTrimming="None" />
                                            </Border>

                                            <TextBlock Text="{Binding Titulo}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Explicacion}"
                                                   Style="{StaticResource TextoTenueEstilo}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,4" />

                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Borrar"
                                                    Command="{Binding BorrarCommand}"
                                                    Margin="5,0,0,0"
                                                    Padding="8,2"
                                                    AutomationProperties.Name="Borrar la credencial guardada" />
                                            <Button DockPanel.Dock="Right"
                                                    Content="Guardar"
                                                    Command="{Binding GuardarCommand}"
                                                    Margin="5,0,0,0"
                                                    Padding="8,2"
                                                    AutomationProperties.Name="Guardar la credencial cifrada" />
                                            <PasswordBox x:Name="Campo"
                                                         PasswordChanged="AlEscribirElSecreto"
                                                         Padding="6,3"
                                                         Background="{DynamicResource FondoCampo}"
                                                         Foreground="{DynamicResource Texto}"
                                                         BorderBrush="{DynamicResource Borde}"
                                                         BorderThickness="1"
                                                         AutomationProperties.Name="{Binding Titulo}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        El aviso de la frase de paso, ANTES de pedirla. TQSL solo la acepta por
                        línea de órdenes, donde queda visible en la lista de procesos mientras
                        dura la subida. No podemos cerrar esa ventana; sí podemos decirlo antes.
                    -->
                    <Border Padding="8,6"
                            CornerRadius="4"
                            Margin="0,2,0,8"
                            Background="{DynamicResource AvisoFondo}"
                            BorderBrush="{DynamicResource AvisoBorde}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Antes de escribir la frase de paso del certificado"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AvisoTexto}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AvisoDeLaFraseDePaso}"
                                       Foreground="{DynamicResource AvisoTexto}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Por qué no se puede subir a LoTW, en vez de un botón gris sin motivo. -->
                    <TextBlock Text="Subida a LoTW" Style="{StaticResource TituloDeSeccion}" />

                    <Border Padding="8,6"
                            CornerRadius="4"
                            Background="{DynamicResource ErrorFondo}"
                            BorderBrush="{DynamicResource ErrorBorde}"
                            BorderThickness="1"
                            Visibility="{Binding SePuedeSubirALotw, Converter={StaticResource VisibleSiEsFalso}}">
                        <TextBlock Text="{Binding MotivoDeNoPoderSubirALotw}"
                                   Foreground="{DynamicResource ErrorTexto}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Todo listo: se puede firmar y subir a LoTW desde este equipo."
                               Style="{StaticResource TextoTenueEstilo}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SePuedeSubirALotw, Converter={StaticResource BooleanoAVisible}}" />

                    <Button Content="Volver a comprobar"
                            Command="{Binding RefrescarCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            AutomationProperties.Name="Volver a comprobar si se puede subir a LoTW" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Cuaderno, equipo y cluster ══ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- ── El cuaderno y el ADIF ── -->
                    <TextBlock Text="Cuaderno" Style="{StaticResource TituloDeSeccion}" />
                    <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                        <Run Text="Contactos:" />
                        <Run Text="{Binding ContactosDelCuaderno, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>

                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Importar ADIF…"
                                Click="AlPedirImportar"
                                Margin="0,0,6,6"
                                AutomationProperties.Name="Importar un fichero ADIF en el cuaderno" />
                        <Button Content="Exportar ADIF…"
                                Click="AlPedirExportar"
                                Margin="0,0,6,6"
                                AutomationProperties.Name="Exportar el cuaderno a un fichero ADIF" />
                    </WrapPanel>

                    <!--
                        El parte de la importación, entero. La cifra de confirmaciones
                        rescatadas es la que justifica fundir las copias en vez de saltarlas:
                        cada una es un diploma que no se pierde.
                    -->
                    <Border Padding="8,6"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Background="{DynamicResource FondoAlterno}"
                            BorderBrush="{DynamicResource BordeSuave}"
                            BorderThickness="1"
                            Visibility="{Binding ParteDeLaImportacion, Converter={StaticResource NoEsVacio}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ParteDeLaImportacion}" TextWrapping="Wrap" />

                            <Expander Header="Datos que no cuadraban entre copias"
                                      Margin="0,6,0,0"
                                      Visibility="{Binding HayChoques, Converter={StaticResource BooleanoAVisible}}">
                                <ItemsControl ItemsSource="{Binding Choques}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource TextoDeConsola}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- ── El equipo ── -->
                    <TextBlock Text="Equipo" Style="{StaticResource TituloDeSeccion}" />
                    <StackPanel DataContext="{Binding DataContext.Equipo, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                            <Run Text="Equipo:" />
                            <Run Text="{Binding NombreDelEquipo, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                            <Run Text="Vía de control:" />
                            <Run Text="{Binding ViaTexto, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap">
                            <Run Text="Estado:" />
                            <Run Text="{Binding EstadoTexto, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Text="El puerto, la velocidad y los tiempos del vigilante de PTT se configuran cuando llegue el control CAT de verdad; hoy el equipo es el simulado."
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                    </StackPanel>

                    <!-- ── El cluster, con su consola ── -->
                    <vistas:AjustesDelCluster DataContext="{Binding DataContext.Cluster, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Height="320" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
