<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.AnalizadorDelEquipo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             AutomationProperties.Name="{loc:Texto Cabina.Analizador.Nombre}">

    <!--
        EL ANALIZADOR DE ESPECTRO DE LA PROPIA RADIO, no el del audio: la traza y la cascada que
        el FT-710 manda por su puente USB FT4222 (docs\14-espectro-ft710.md). Se ve en cualquier
        modo. Colores de la pantalla del equipo: traza blanca azulada sobre negro con rejilla
        gris, cascada en rojos (u otra paleta de Configuración → Equipo) y la marca roja del VFO.

        Lo único que manda a la radio es la sintonía (clic, rueda y clic en un spot), siempre
        al VFO activo y nunca transmitiendo. Como la radio: en cascada (W/F), la traza arriba y la cascada debajo, que
        corre según SPEED; en 3DSS, las últimas pasadas en perspectiva ocupando todo el hueco.
        EXPAND lo hace el visor (le da más alto a este control). MULTI (manual de operación del
        FT-710, pág. 23): el analizador arriba y, debajo, el osciloscopio y el AF-FFT del audio
        de recepción; aquí salen del audio del codec USB que ya lee el módem.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisibleDelAnalizador" />
    </UserControl.Resources>

    <Grid x:Name="Lienzo" Background="Black" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FilaMultiple" Height="0" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="VistaDeCascada">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding ImagenDeLaTraza}" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="Linear" />
            <Image Grid.Row="1" Source="{Binding ImagenDeLaCascada}" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="LowQuality" />
        </Grid>
        <Image Grid.Row="0" x:Name="VistaTresD" Source="{Binding ImagenTresD}" Stretch="Fill"
               RenderOptions.BitmapScalingMode="Linear" Visibility="Collapsed"
               AutomationProperties.Name="{loc:Texto Cabina.Analizador.Vista3dss}" />

        <!-- La marca del VFO: triángulo rojo arriba y línea roja fina, como en la radio. -->
        <Canvas Grid.Row="0" x:Name="CapaDelVfo" IsHitTestVisible="False"
                Visibility="{Binding VfoVisible, Converter={StaticResource BooleanoAVisibleDelAnalizador}}">
            <Path x:Name="TrianguloDelVfo" Fill="#FFE2352B" Data="M 0,0 L 7,0 L 3.5,5 Z" />
            <Rectangle x:Name="LineaDelVfo" Width="1" Fill="#FFE2352B" Opacity="0.75" />
        </Canvas>

        <!--
            EL ANALIZADOR COMO MANDO (docs\19-analisis-thetis.md, A2 y A3). Clic en el espectro:
            sintoniza el VFO activo ahí, ajustado al paso; rueda: mueve el VFO por pasos (Mayús,
            paso fino). Encima, los spots del cluster en carriles, con el color de su novedad;
            clic en un spot = el doble clic de la lista. Todo lo pinta el código de detrás con
            piezas reutilizadas: nada se crea por pasada.
        -->
        <Border Grid.Row="0" x:Name="ZonaDelEspectro" Background="Transparent"
                AutomationProperties.Name="{loc:Texto Cabina.Analizador.ZonaDeSintonia}" />
        <Canvas Grid.Row="0" x:Name="CapaDePicos" IsHitTestVisible="False" ClipToBounds="True" />
        <Canvas Grid.Row="0" x:Name="CapaDelRaton" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle x:Name="LineaDelRaton" Width="1" Fill="#FFFFFFFF" Opacity="0.55" />
            <Border x:Name="CajaDelRaton" Background="#D805070A" BorderBrush="#FF6CC3FF" BorderThickness="1"
                    CornerRadius="2" Padding="3,0">
                <TextBlock x:Name="FrecuenciaDelRaton" Foreground="#FF6CC3FF" FontFamily="Consolas" FontSize="11"
                           FontWeight="Bold" TextTrimming="None" />
            </Border>
        </Canvas>
        <Canvas Grid.Row="0" x:Name="CapaDeSpots" ClipToBounds="True" />

        <!-- ══ MULTI: osciloscopio (izquierda, cian, 10 ms/div) y AF-FFT (derecha, 0-4 kHz) ══ -->
        <Grid Grid.Row="1" x:Name="VistaMultiple" Visibility="Collapsed" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#FF2A333D" BorderThickness="0,1,1,0"
                    ToolTip="{loc:Texto Cabina.Analizador.OsciloscopioAyuda}">
                <Grid>
                    <Image Source="{Binding ImagenDelOsciloscopio}" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"
                           AutomationProperties.Name="{loc:Texto Cabina.Analizador.Osciloscopio}" />
                    <TextBlock Text="OSCILLOSCOPE" Foreground="#FF6CC3FF" Background="#B805070A" Padding="2,0" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0" TextTrimming="None" />
                    <TextBlock Text="10ms/Div" Foreground="#FF6CC3FF" Background="#B805070A" Padding="2,0" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" TextTrimming="None" />
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#FF2A333D" BorderThickness="0,1,0,0"
                    ToolTip="{loc:Texto Cabina.Analizador.AfFftAyuda}">
                <Grid>
                    <Image Source="{Binding ImagenDelAfFft}" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"
                           AutomationProperties.Name="{loc:Texto Cabina.Analizador.AfFft}" />
                    <TextBlock Text="AF-FFT" Foreground="#FF6CC3FF" Background="#B805070A" Padding="2,0" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0" TextTrimming="None" />
                    <TextBlock Text="0–4 kHz" Foreground="#FF6CC3FF" Background="#B805070A" Padding="2,0" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" TextTrimming="None" />
                </Grid>
            </Border>

            <!-- Con el audio cerrado no se dejan dos huecos negros: se dice y se ofrece abrirlo. -->
            <StackPanel Grid.ColumnSpan="2" x:Name="AvisoDeAudio" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Orientation="Horizontal" Background="#CC05070A">
                <TextBlock Text="{loc:Texto Cabina.Analizador.AudioCerrado}" Foreground="#FFF29A2E" FontSize="12"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,6,0" TextTrimming="None" />
                <Button Content="{loc:Texto Cabina.Analizador.AbrirAudio}" FontSize="12" Padding="6,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.Modem.EscucharCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{loc:Texto Cabina.Visor.AbrirAudioAyuda}"
                        AutomationProperties.Name="{loc:Texto Cabina.Analizador.AbrirAudioMulti}" />
            </StackPanel>
        </Grid>

        <!-- Sin trazas no se deja un hueco negro: se dice por qué. -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="8,0" x:Name="Aviso">
            <TextBlock Text="{Binding TituloDelAviso}" Foreground="#FFF29A2E" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" TextTrimming="None" />
            <TextBlock Text="{Binding TextoDelAviso}" Foreground="#FF9BA6B2" FontSize="13"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="400" Margin="0,1,0,0" TextTrimming="None" />
        </StackPanel>
    </Grid>
</UserControl>
