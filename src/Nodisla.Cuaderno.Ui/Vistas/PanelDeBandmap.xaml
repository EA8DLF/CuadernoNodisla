<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeBandmap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        EL BANDMAP: EL CLUSTER POR FRECUENCIA.

        Una regla vertical con la banda entera, de su borde inferior al superior, y los anuncios
        colocados a la altura que les toca. Una lista ordenada por hora dice quién ha salido;
        esto dice DÓNDE ESTÁ LLENA LA BANDA Y DÓNDE HAY HUECO, que es lo que decide hacia dónde
        se gira el dial.

        La línea roja es el dial. Si el equipo está fuera de las bandas de aficionado —pasa: el
        de Jose estaba en 27.555 MHz— no hay banda que dibujar y se dice, en vez de enseñar una
        regla vacía que parezca rota.

        Tres filtros, los mismos que pide un operador: solo lo que aporta, solo el modo que
        tiene puesto, y sin las escuchas automáticas.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Titulo}"
                   Style="{StaticResource TituloDeSeccion}"
                   Margin="0,0,0,3" />

        <!-- ── Los filtros ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
            <CheckBox Content="{loc:Texto Principal.Bandmap.SoloLoQueAporta}"
                      IsChecked="{Binding SoloLoNuevo}"
                      FontSize="11"
                      ToolTip="{loc:Texto Principal.Bandmap.SoloLoQueAportaConsejo}"
                      AutomationProperties.Name="{loc:Texto Principal.Bandmap.SoloLoQueAportaNombre}" />
            <CheckBox Content="{loc:Texto Principal.Bandmap.SoloMiModo}"
                      IsChecked="{Binding SoloElModo}"
                      FontSize="11"
                      ToolTip="{loc:Texto Principal.Bandmap.SoloMiModoConsejo}"
                      AutomationProperties.Name="{loc:Texto Principal.Bandmap.SoloMiModoNombre}" />
            <CheckBox Content="{loc:Texto Principal.Bandmap.SinSkimmers}"
                      IsChecked="{Binding SinEscuchaAutomatica}"
                      FontSize="11"
                      ToolTip="{loc:Texto Principal.Bandmap.SinSkimmersConsejo}"
                      AutomationProperties.Name="{loc:Texto Principal.Bandmap.SinSkimmersNombre}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Resumen}"
                   Style="{StaticResource TextoTenueEstilo}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding Resumen, Converter={StaticResource NoEsVacio}}" />

        <!-- ── La escala ── -->
        <!--
            La escala mide lo que hay de alto, no un tamaño fijo: con uno fijo, media banda se
            quedaba fuera y había que desplazarse para ver si había hueco arriba, que es justo
            lo que el bandmap viene a evitar. El modelo necesita el alto porque es quien calcula
            dónde cae cada anuncio.
        -->
        <ScrollViewer x:Name="Desplazamiento"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="AlCambiarElAlto"
                      Visibility="{Binding SinBanda, Converter={StaticResource VisibleSiEsFalso}}">
            <Grid Height="{Binding AltoDeLaEscala}" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- La regla, con sus rayas rotuladas -->
                <Canvas Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Rayas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding Altura}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Texto}"
                                           FontSize="9"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Foreground="{DynamicResource TextoTenue}"
                                           Margin="0,-6,0,0"
                                           TextTrimming="None" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- El canal y los anuncios -->
                <Grid Grid.Column="1">
                    <!-- La línea de la escala -->
                    <Border Width="2"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Borde}" />

                    <!-- El dial -->
                    <Canvas Visibility="{Binding DialALaVista, Converter={StaticResource BooleanoAVisible}}">
                        <Border Canvas.Left="-6"
                                Canvas.Top="{Binding AlturaDelDial}"
                                Width="120"
                                Height="2"
                                Background="{DynamicResource ErrorBorde}"
                                ToolTip="{loc:Texto Principal.Bandmap.Dial}"
                                AutomationProperties.Name="{loc:Texto Principal.Bandmap.DialNombre}" />
                    </Canvas>

                    <!-- Los anuncios -->
                    <ItemsControl ItemsSource="{Binding Marcas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding Altura}" />
                                <Setter Property="Canvas.Left" Value="6" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.IrAlSpotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,-8,0,0"
                                        Padding="0"
                                        ToolTip="{Binding Detalle}"
                                        AutomationProperties.Name="{Binding Detalle}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pastilla"
                                                    CornerRadius="2"
                                                    Padding="4,0"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource FondoPanel}"
                                                    BorderBrush="{DynamicResource BordeSuave}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pastilla" Property="Background"
                                                            Value="{DynamicResource SeleccionFondo}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                            El indicativo en verde cuando aporta algo, y en gris
                                            cuando lo anuncia una escucha automatica. El color
                                            no va solo: el detalle completo esta en la ayuda.
                                        -->
                                        <TextBlock Text="{Binding Indicativo}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                   TextTrimming="None">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsDeEscuchaAutomatica}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EsInteresante}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource CorrectoTexto}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Modo}"
                                                   FontSize="9"
                                                   Margin="5,0,0,0"
                                                   Foreground="{DynamicResource TextoTenue}"
                                                   TextTrimming="None" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
