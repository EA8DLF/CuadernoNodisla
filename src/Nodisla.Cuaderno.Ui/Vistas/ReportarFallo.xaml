<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.ReportarFallo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Texto}">

    <!--
        REPORTAR UN FALLO. DataContext: VistaModeloReportarFallo.

        A la izquierda lo que cuenta el operador y lo que se adjunta (editable); a la derecha la
        vista previa EXACTA de lo que va a salir. Enviar abre GitHub en el navegador con todo
        rellenado; el operador lo manda con su cuenta.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CampoLargo" TargetType="TextBox" BasedOn="{StaticResource Campo}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="160" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Reportar un fallo" Style="{StaticResource TituloDeSeccion}" />
                <TextBlock Style="{StaticResource TextoTenueEstilo}"
                           Text="El informe se abre en GitHub, donde es público. Antes de enviar se quitan contraseñas, claves de las direcciones, correos, locator y coordenadas; aun así, revise la vista previa. Hace falta una cuenta de GitHub para enviarlo." />

                <TextBlock Text="Título" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}"
                         AutomationProperties.Name="Título del fallo" />

                <TextBlock Text="¿Qué pasó?" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QuePaso, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="Qué pasó" />

                <TextBlock Text="¿Qué esperaba que pasara?" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QueEsperaba, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="Qué esperaba que pasara" />

                <TextBlock Text="Pasos para reproducirlo" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Pasos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="Pasos para reproducir el fallo" />

                <TextBlock Text="Se adjunta (puede editarlo)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Entorno, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         FontFamily="Consolas"
                         AutomationProperties.Name="Datos del entorno que se adjuntan" />

                <CheckBox IsChecked="{Binding IncluirRegistro}" Margin="0,8,0,2"
                          Content="Adjuntar las últimas líneas del registro"
                          AutomationProperties.Name="Adjuntar las últimas líneas del registro" />
                <TextBox Text="{Binding Registro, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         FontFamily="Consolas" MaxHeight="220"
                         Visibility="{Binding IncluirRegistro, Converter={StaticResource BooleanoAVisible}}"
                         AutomationProperties.Name="Líneas del registro que se adjuntan" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Abrir en GitHub para enviar"
                            Command="{Binding EnviarCommand}"
                            Style="{StaticResource BotonPrincipal}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="Abrir el informe en GitHub para enviarlo" />
                    <Button Content="Volver a rellenar lo adjunto"
                            Command="{Binding RecargarAdjuntosCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="Volver a rellenar lo adjunto" />
                    <Button Content="Vaciar"
                            Command="{Binding VaciarCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="Vaciar el formulario" />
                </WrapPanel>
                <TextBlock Text="{Binding Estado}" Style="{StaticResource TextoTenueEstilo}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Vista previa: esto es exactamente lo que se enviará"
                       Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
            <TextBox Text="{Binding VistaPrevia, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Style="{StaticResource Campo}"
                     AutomationProperties.Name="Vista previa del informe" />
        </DockPanel>
    </Grid>
</UserControl>
