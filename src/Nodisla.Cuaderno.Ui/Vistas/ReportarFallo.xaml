<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.ReportarFallo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        REPORTAR UN FALLO. DataContext: VistaModeloReportarFallo.

        A la izquierda lo que cuenta el operador y lo que se adjunta (editable); a la derecha la
        vista previa EXACTA de lo que va a salir. Enviar abre GitHub en el navegador con todo
        rellenado; el operador lo manda con su cuenta.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CampoLargo" TargetType="TextBox" BasedOn="{StaticResource Campo}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="160" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Texto Ayuda.ReportarUnFallo}" Style="{StaticResource TituloDeSeccion}" />
                <TextBlock Style="{StaticResource TextoTenueEstilo}"
                           Text="{loc:Texto Ayuda.Fallo.Explicacion}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Texto Ayuda.Fallo.Titulo}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.TituloNombre}" />

                <TextBlock Text="{loc:Texto Ayuda.Fallo.QuePaso}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QuePaso, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.QuePasoNombre}" />

                <TextBlock Text="{loc:Texto Ayuda.Fallo.QueEsperaba}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QueEsperaba, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.QueEsperabaNombre}" />

                <TextBlock Text="{loc:Texto Ayuda.Fallo.Pasos}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Pasos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.PasosNombre}" />

                <TextBlock Text="{loc:Texto Ayuda.Fallo.SeAdjunta}" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Entorno, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         FontFamily="Consolas"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.EntornoNombre}" />

                <CheckBox IsChecked="{Binding IncluirRegistro}" Margin="0,8,0,2"
                          Content="{loc:Texto Ayuda.Fallo.AdjuntarRegistro}"
                          AutomationProperties.Name="{loc:Texto Ayuda.Fallo.AdjuntarRegistro}" />
                <TextBox Text="{Binding Registro, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoLargo}"
                         FontFamily="Consolas" MaxHeight="220"
                         Visibility="{Binding IncluirRegistro, Converter={StaticResource BooleanoAVisible}}"
                         AutomationProperties.Name="{loc:Texto Ayuda.Fallo.RegistroNombre}" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="{loc:Texto Ayuda.Fallo.AbrirEnGitHub}"
                            Command="{Binding EnviarCommand}"
                            Style="{StaticResource BotonPrincipal}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="{loc:Texto Ayuda.Fallo.AbrirEnGitHubNombre}" />
                    <Button Content="{loc:Texto Ayuda.Fallo.Recargar}"
                            Command="{Binding RecargarAdjuntosCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="{loc:Texto Ayuda.Fallo.Recargar}" />
                    <Button Content="{loc:Texto Ayuda.Fallo.Vaciar}"
                            Command="{Binding VaciarCommand}"
                            Margin="0,0,6,4"
                            AutomationProperties.Name="{loc:Texto Ayuda.Fallo.VaciarNombre}" />
                </WrapPanel>
                <TextBlock Text="{Binding Estado}" Style="{StaticResource TextoTenueEstilo}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Texto Ayuda.Fallo.VistaPrevia}" TextWrapping="Wrap"
                       Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
            <TextBox Text="{Binding VistaPrevia, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Style="{StaticResource Campo}"
                     AutomationProperties.Name="{loc:Texto Ayuda.Fallo.VistaPreviaNombre}" />
        </DockPanel>
    </Grid>
</UserControl>
