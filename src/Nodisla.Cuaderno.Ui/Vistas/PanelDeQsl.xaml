<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeQsl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:qsl="clr-namespace:Nodisla.Cuaderno.Ui.Qsl"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             xmlns:controles="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Controles"
             controles:SelectorDeColor.OrigenDeColores="{Binding}"
             Foreground="{DynamicResource Texto}"
             Loaded="AlCargar">

    <!--
        EL EDITOR DE LA TARJETA QSL.

        Izquierda: la plantilla (nombre, orientación, fondo) y la lista de campos.
        Centro: la tarjeta tal cual saldrá, con los campos que se arrastran encima.
        Derecha: letra, tamaño, color y texto del campo elegido.

        LA TARJETA DEL CENTRO ES LA IMAGEN DE VERDAD: la misma rutina la dibuja para el correo
        (200 ppp) y para el PDF (300 ppp). Las asas de los campos son rectángulos transparentes
        encima; la tarjeta va dentro de un Viewbox con la rejilla medida en milímetros, así que
        arrastrar un asa mueve el campo en milímetros sin conversiones.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Estilos y plantilla del campo de texto, compartidos con el diseñador de diplomas. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Qsl/EditorDeElementos.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
            <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />

            <Style x:Key="Boton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Padding" Value="8,3" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="230" MaxWidth="330" />
            <ColumnDefinition Width="3*" MinWidth="360" />
            <ColumnDefinition Width="1*" MinWidth="240" MaxWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ══ Plantilla y campos ══ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Texto Qsl.Editor.Plantilla}" Style="{StaticResource TituloDeSeccion}" />
                    <ComboBox ItemsSource="{Binding Disenos}" SelectedItem="{Binding Diseno}"
                              AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.PlantillaDeTarjeta}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{loc:Texto Comun.Guardar}" Command="{Binding GuardarCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.GuardarLaPlantilla}" />
                        <Button Content="{loc:Texto Qsl.Editor.Deshacer}" Command="{Binding DescartarCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.DeshacerCambios}" />
                        <Button Content="{loc:Texto Qsl.Editor.Nueva}" Command="{Binding NuevaPlantillaCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.PlantillaNueva}" />
                        <Button Content="{loc:Texto Qsl.Editor.Duplicar}" Command="{Binding DuplicarPlantillaCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.DuplicarLaPlantilla}" />
                        <Button Content="{loc:Texto Comun.Borrar}" Command="{Binding BorrarPlantillaCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.BorrarLaPlantilla}" />
                        <Button Content="{loc:Texto Qsl.Editor.UsarPorOmision}" Command="{Binding PonerPorOmisionCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.UsarEstaPorOmision}" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Texto Qsl.Editor.EsLaDeOmision}" Style="{StaticResource TextoTenueEstilo}"
                               Visibility="{Binding EsLaDeOmision, Converter={StaticResource BooleanoAVisible}}" />
                    <TextBlock Text="{loc:Texto Qsl.Editor.CambiosSinGuardar}" Foreground="{DynamicResource AvisoTexto}" FontWeight="SemiBold"
                               Visibility="{Binding HayCambios, Converter={StaticResource BooleanoAVisible}}" />

                    <TextBlock Text="{loc:Texto Comun.Nombre}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding NombreDelDiseno, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Texto Qsl.Editor.NombreDeLaPlantilla}" />

                    <CheckBox Content="{loc:Texto Qsl.Tarjeta.Vertical}" IsChecked="{Binding Vertical}" Margin="0,8,0,0"
                              AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.TarjetaVertical}" />
                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.TamanoInternacional}" Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />

                    <TextBlock Text="{loc:Texto Qsl.Editor.Fondo}" Style="{StaticResource Rotulo}" />
                    <WrapPanel>
                        <Button Content="{loc:Texto Qsl.Editor.ElegirImagen}" Command="{Binding ElegirFondoCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.ElegirImagenDeFondo}" />
                        <Button Content="{loc:Texto Qsl.Editor.Quitar}" Command="{Binding QuitarFondoCommand}" Style="{StaticResource Boton}"
                                Visibility="{Binding TieneFondo, Converter={StaticResource BooleanoAVisible}}"
                                AutomationProperties.Name="{loc:Texto Qsl.Editor.QuitarImagenDeFondo}" />
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Texto Qsl.Editor.Ajuste}" VerticalAlignment="Center" MinWidth="64" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{x:Static qsl:CatalogosDelEditor.OpcionesDeAjuste}" DisplayMemberPath="Nombre" SelectedValuePath="Valor" SelectedValue="{Binding Ajuste}"
                                  AutomationProperties.Name="{loc:Texto Qsl.Editor.ComoSeAjusta}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{loc:Texto Qsl.Editor.Color}" VerticalAlignment="Center" MinWidth="64" Margin="0,0,6,0" />
                        <controles:SelectorDeColor Color="{Binding ColorDeFondo}" Titulo="{loc:Texto Qsl.Tarjeta.ColorDeFondo}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.Campos}" Style="{StaticResource TituloDeSeccion}" Margin="0,12,0,4" />
                    <ListBox ItemsSource="{Binding Campos}" SelectedItem="{Binding CampoElegido}" MaxHeight="260"
                             AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.CamposDeLaTarjeta}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Visible}" Margin="0,0,6,0" ToolTip="{loc:Texto Qsl.Tarjeta.SeVe}"
                                              AutomationProperties.Name="{Binding Nombre}" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{loc:Texto Qsl.Editor.AnadirTexto}" Command="{Binding AnadirCampoCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.AnadirCampo}" />
                        <Button Content="{loc:Texto Qsl.Editor.Duplicar}" Command="{Binding DuplicarCampoCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.DuplicarCampo}" />
                        <Button Content="{loc:Texto Qsl.Editor.Quitar}" Command="{Binding QuitarCampoCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.QuitarCampo}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ La tarjeta ══ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.VistaPreviaCon}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefrescarCommand}" Padding="8,2" Margin="6,0,0,0"
                            ToolTip="{loc:Texto Qsl.Tarjeta.ReleerContactosAyuda}"
                            AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.ReleerContactos}" />
                    <ComboBox ItemsSource="{Binding Contactos}" SelectedItem="{Binding Contacto}"
                              AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.ContactoDeVistaPrevia}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Texto}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource FondoCampo}" Padding="10">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="Lienzo" Width="{Binding AnchoMm}" Height="{Binding AltoMm}">
                            <Image Source="{Binding VistaPrevia}" Stretch="Fill" />
                            <ItemsControl ItemsSource="{Binding Campos}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CajaX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CajaY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Thumb Width="{Binding CajaAncho}" Height="{Binding CajaAlto}"
                                               Cursor="SizeAll"
                                               ToolTip="{Binding Nombre}"
                                               DragStarted="AlEmpezarAArrastrar"
                                               DragDelta="AlArrastrar"
                                               AutomationProperties.Name="{Binding Nombre}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="#01FFFFFF">
                                                        <Rectangle x:Name="Marco" Stroke="#9900A0FF" StrokeThickness="0.25"
                                                                   StrokeDashArray="3 2" Opacity="0.0" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Marco" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Elegido}" Value="True">
                                                            <Setter TargetName="Marco" Property="Opacity" Value="1" />
                                                            <Setter TargetName="Marco" Property="Stroke" Value="#FFFF8C00" />
                                                            <Setter TargetName="Marco" Property="StrokeThickness" Value="0.4" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="{loc:Texto Qsl.Tarjeta.EnviarPorCorreo}" Command="{Binding EnviarMuestraCommand}" Style="{StaticResource BotonPrincipal}"
                                Margin="0,0,6,6" Padding="10,4"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.EnviarAyuda}" />
                        <Button Content="{loc:Texto Qsl.Tarjeta.GuardarImagen}" Command="{Binding ExportarImagenCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.GuardarImagenAyuda}" />
                        <Button Content="PDF…" Command="{Binding ExportarPdfCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.PdfAyuda}" />
                        <Button Content="{loc:Texto Qsl.Tarjeta.DisenoParaEqsl}" Command="{Binding ExportarParaEqslCommand}" Style="{StaticResource Boton}"
                                ToolTip="{loc:Texto Qsl.Tarjeta.DisenoParaEqslAyuda}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.DisenoParaEqslNombre}" />
                        <Button Content="{loc:Texto Qsl.Tarjeta.AbrirEqsl}" Command="{Binding AbrirEqslCommand}" Style="{StaticResource Boton}"
                                AutomationProperties.Name="{loc:Texto Qsl.Tarjeta.AbrirEqslAyuda}" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.Instrucciones}"
                               Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ El campo elegido ══ -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.Campo}" Style="{StaticResource TituloDeSeccion}" />
                    <TextBlock Text="{loc:Texto Qsl.Tarjeta.ElijaUnCampo}"
                               Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap"
                               Visibility="{Binding HayCampoElegido, Converter={StaticResource VisibleSiEsFalso}}" />

                    <ContentControl Content="{Binding CampoElegido}" Focusable="False" />

                    <Expander Header="{loc:Texto Qsl.Editor.Variables}" Margin="0,12,0,0">
                        <TextBlock Text="{Binding AyudaDeVariables}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
