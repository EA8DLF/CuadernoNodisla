<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.FranjaSolar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas">

    <!--
        LA FRANJA SOLAR.

        Estado del Sol y del campo magnético en una línea, verde sobre negro, como los paneles
        de los observatorios: se lee de reojo sin apartar la vista del dial. Son los números que
        más mira un operador antes de decidir en qué banda llamar, y el programa ya los tenía
        calculados sin enseñarlos en ninguna parte.

        Los colores van FIJOS y no siguen al tema: es un visor, no un panel, y tiene que
        leerse igual con el tema claro y con el oscuro.

        SI LOS DATOS SON VIEJOS SE DICE. El flujo solar se publica una vez al día y el índice K
        cada tres horas; si lo que hay es la copia guardada en disco, el rótulo se pone ámbar y
        la ayuda emergente cuenta de cuándo son y de dónde salen. Enseñar índices de otro día
        como si fueran de ahora lleva a llamar en la banda equivocada.
    -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="FondoDelVisor" Color="#FF05070A" />
        <SolidColorBrush x:Key="VerdeDelVisor" Color="#FF4CE07A" />
        <SolidColorBrush x:Key="VerdeTenue" Color="#FF2E8C4E" />
        <SolidColorBrush x:Key="AmbarDelVisor" Color="#FFF2B33E" />
        <SolidColorBrush x:Key="RojoDelVisor" Color="#FFF2564B" />

        <Style x:Key="RotuloSolar" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VerdeTenue}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="ValorSolar" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VerdeDelVisor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource FondoDelVisor}"
            BorderBrush="#FF1E2A22"
            BorderThickness="1"
            CornerRadius="3"
            Padding="9,3"
            ToolTip="{Binding Procedencia}"
            AutomationProperties.Name="{loc:Texto Principal.Solar.Nombre}"
            AutomationProperties.HelpText="{Binding Procedencia}">
        <WrapPanel>
            <TextBlock Text="Kp" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding IndiceK}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValorSolar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tormenta}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource RojoDelVisor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="A" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding IndiceA}" Style="{StaticResource ValorSolar}" />

            <TextBlock Text="{loc:Texto Principal.Solar.Flujo}" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding FlujoSolar}" Style="{StaticResource ValorSolar}" />

            <TextBlock Text="{loc:Texto Principal.Solar.Manchas}" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding Manchas}" Style="{StaticResource ValorSolar}" />

            <TextBlock Text="{loc:Texto Principal.Solar.Orto}" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding Orto}" Style="{StaticResource ValorSolar}" />

            <TextBlock Text="{loc:Texto Principal.Solar.Ocaso}" Style="{StaticResource RotuloSolar}" />
            <TextBlock Text="{Binding Ocaso}" Style="{StaticResource ValorSolar}" Margin="0" />

            <!-- El aviso de datos viejos: ocupa cero cuando los datos son de ahora. -->
            <TextBlock Text="{loc:Texto Principal.Solar.CopiaGuardada}"
                       Foreground="{StaticResource AmbarDelVisor}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       TextTrimming="None"
                       AutomationProperties.Name="{loc:Texto Principal.Solar.CopiaGuardadaNombre}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DatosViejos}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{loc:Texto Principal.Solar.Trayendo}"
                       Foreground="{StaticResource VerdeTenue}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       TextTrimming="None">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Trayendo}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </WrapPanel>
    </Border>
</UserControl>
