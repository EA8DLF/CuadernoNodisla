<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelOperar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             SizeChanged="AlCambiarDeTamano"
             Foreground="{DynamicResource Texto}">

    <!--
        LA CABINA DE OPERACIÓN.

        Disposición elegida por el propietario: el equipo arriba, la entrada de contacto y el
        cluster, y los decodificados de FT8 en la franja inferior.

        El equipo se dibuja a su PROPORCIÓN REAL —239 × 80 mm de frente, casi tres a uno—, así
        que ocupa un bloque ancho pero no toda la franja: el resto de la cabina se reparte el
        ancho sobrante a su derecha. Estirarlo a lo ancho de la ventana lo dejaría aplastado y
        no se parecería a la radio.

        El frontal es un dibujo vectorial y no se repliega: cuando la ventana se estrecha o la
        letra crece, cede el sitio a la lista de mandos, que sí se repliega. El operador no
        puede quedarse sin poder tocar la radio por tener la letra grande.

        El botón de pánico —soltar el PTT— va arriba del todo y siempre visible.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:AltoDeFila x:Key="AltoDeFila" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="230" />

            <!--
                Estas dos filas se quedan en cero cuando su bloque se pliega. Si no, la fila
                seguiria reservando su sitio y el pliegue dejaria un hueco del mismo tamano.
            -->
            <RowDefinition Height="{Binding CabinaCompleta, Converter={StaticResource AltoDeFila}, ConverterParameter=2}" />
            <RowDefinition Height="{Binding CabinaCompleta, Converter={StaticResource AltoDeFila}, ConverterParameter=2}" />
        </Grid.RowDefinitions>

        <!-- ══ Barra del equipo: estado, conexión y botón de pánico ══ -->
        <Border Grid.Row="0"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,8"
                Padding="12,7"
                DataContext="{Binding Equipo}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="SOLTAR PTT"
                        Command="{Binding SoltarPttCommand}"
                        Style="{StaticResource BotonDePanico}"
                        Margin="8,0,0,0"
                        ToolTip="Suelta el PTT ahora mismo, pase lo que pase. No pide confirmación."
                        AutomationProperties.Name="Soltar el PTT ahora mismo" />

                <Button DockPanel.Dock="Right"
                        Content="{Binding TextoDelBotonDeConexion}"
                        Margin="8,0,0,0"
                        ToolTip="Abre o cierra la comunicación con el equipo">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Command" Value="{Binding ConectarCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Conectado}" Value="True">
                                    <Setter Property="Command" Value="{Binding DesconectarCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border DockPanel.Dock="Right"
                        CornerRadius="3"
                        Padding="10,3"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource FondoResalte}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Conectado}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding EstadoTexto}" FontWeight="Bold" TextTrimming="None" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreDelEquipo}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Aviso}"
                               Style="{StaticResource TextoTenueEstilo}"
                               Foreground="{DynamicResource AvisoTexto}"
                               Visibility="{Binding Aviso, Converter={StaticResource NoEsVacio}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Equipo a la izquierda; entrada y cluster se reparten el ancho sobrante ══ -->
        <UniformGrid Grid.Row="1" Columns="{Binding ColumnasDeLaCabina}">

            <!-- El equipo: frontal dibujado, o lista de mandos cuando aquél no cabe. -->
            <Border Style="{StaticResource Tarjeta}"
                    Margin="0,0,8,8"
                    Padding="8">
                <Grid DataContext="{Binding Equipo}">
                    <vistas:FrontalFt710 x:Name="Frontal"
                                         VerticalAlignment="Top"
                                         Visibility="{Binding DataContext.FrontalDibujadoVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanoAVisible}}" />

                    <!--
                        El relevo cuando el dibujo no cabe: los dos VFO enteros, y los mandos
                        debajo en la lista, que sí se repliega.
                    -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DataContext.FrontalEnListaVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanoAVisible}}">
                        <StackPanel>
                            <vistas:VisorDeVfos />

                            <TextBlock Text="Con este tamaño el frontal dibujado no cabe entero. Los mandos se accionan aquí, en la lista, que sí se pliega."
                                       Style="{StaticResource TextoTenueEstilo}"
                                       Margin="0,6,0,4" />

                            <Expander Header="Todos los mandos" IsExpanded="True">
                                <vistas:ListaDeMandos Margin="0,6,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <vistas:PanelDeEntrada x:Name="Entrada" />
                </ScrollViewer>
            </Border>

        </UniformGrid>

        <!--
            El cluster va en la misma franja que la entrada cuando hay ancho; cuando no lo hay,
            se pliega entero y se dice, en vez de estrujarlo hasta que no se lea.
        -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,0,0,8"
                Visibility="{Binding CabinaCompleta, Converter={StaticResource BooleanoAVisible}}">
            <vistas:PanelDeCluster DataContext="{Binding Cluster}" />
        </Border>

        <!-- ══ Franja inferior: los decodificados de FT8 ══ -->
        <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Margin="0"
                Visibility="{Binding CabinaCompleta, Converter={StaticResource BooleanoAVisible}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <vistas:PanelDigital DataContext="{Binding Digital}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
