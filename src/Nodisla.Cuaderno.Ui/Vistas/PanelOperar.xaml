<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelOperar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        LA CABINA DE OPERACIÓN.

            ┌──────────────────────────────────────────────┐
            │ HAM │ FRONTAL DEL FT-710 │ CB │ fonía        │
            ├──────────────┬───────────────────────────────┤
            │ Contacto     │  Cluster de DX                │
            │ nuevo (1/3)  │  (2/3)                        │
            └──────────────┴───────────────────────────────┘

        EL FRONTAL ES VECTORIAL y vive dentro de un «Viewbox»: cuando falta sitio se ENCOGE, no
        se recorta. Contacto + cluster tienen un alto mínimo garantizado; el frontal se queda con
        lo que sobre y solo se pliega solo si ni encogido cabe legible. Ese plegado automático no
        toca la preferencia del operador: cuando vuelve a haber sitio, vuelve.

        El contacto nuevo se lleva un tercio y el cluster dos: en el formulario se escribe un
        indicativo y poco más, mientras que en el cluster hay información que LEER —indicativo,
        frecuencia, banda, modo, país, referencias— y cuanto más ancho, menos líneas partidas.

        Los modos digitales tienen pestaña propia de primer nivel, con el mismo frontal arriba.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:VisibleSiEsFalso x:Key="VisibleSiEsFalso" />
    </UserControl.Resources>

    <Grid x:Name="Raiz" SizeChanged="AlCambiarElReparto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Barra del equipo: la misma que en Digital ══ -->
        <Border Grid.Row="0"
                x:Name="TarjetaDeLaBarra"
                SizeChanged="AlCambiarElReparto"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="8,4">
            <DockPanel>
                <!-- El decodificador de telegrafía, a mano: sale solo con el equipo en CW. -->
                <ToggleButton DockPanel.Dock="Right"
                              x:Name="BotonCw"
                              Content="CW"
                              Padding="8,1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding Cw.MostrarAMano}"
                              Visibility="{Binding HayCw, Converter={StaticResource BooleanoAVisible}}"
                              ToolTip="{loc:Texto Cabina.Cw.MostrarAyuda}"
                              AutomationProperties.Name="{loc:Texto Cabina.Cw.MostrarNombre}" />
                <vistas:BarraDelEquipo />
            </DockPanel>
        </Border>

        <!--
            ══ El frontal del equipo, a todo el ancho ══

            REPARTO DEL ALTO (como en Digital): abajo, contacto + cluster tienen un alto mínimo
            garantizado (PanelOperar.AltoMinimoDeAbajo). El frontal y la fonía se quedan con lo
            que sobre, hasta su tope, escalando hacia abajo. Si lo que sobra no llega a un
            frontal legible, se pliega solo —sin tocar la preferencia guardada— y queda la
            línea «Equipo plegado — Mostrar equipo».
        -->
        <Grid Grid.Row="1" x:Name="HuecoDelFrontal">
        <Border Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="5"
                DataContext="{Binding Equipo}"
                Visibility="{Binding DataContext.FrontalDibujadoVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanoAVisible}}">

            <!--
                El tope de alto es lo único que limita al dibujo: sin él, a mil quinientos
                puntos de ancho el frontal se llevaría media pantalla. Con él crece hasta ese
                alto y luego se queda quieto y centrado, como una radio encima de la mesa.
            -->
            <!--
                Botonera HAM a la izquierda y canales CB a la derecha del frontal; la fonía, en
                columna a la derecha del todo: el frontal va con tope de alto y a su lado sobra
                ancho, así que nada de esto quita alto al contacto ni al cluster.
            -->
            <vistas:FrontalConBotonera x:Name="CajaDelFrontal" AltoMaximoDelFrontal="370">
                <vistas:FrontalConBotonera.Lateral>
                    <Border Padding="8,0,0,0"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource BordeSuave}"
                            VerticalAlignment="Top">
                        <!-- Escala con el frontal cuando falta alto; nunca crece. -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                            <vistas:PanelDeFonia Vertical="True"
                                                 DataContext="{Binding DataContext.Fonia, RelativeSource={RelativeSource AncestorType=vistas:PanelOperar}}" />
                        </Viewbox>
                    </Border>
                </vistas:FrontalConBotonera.Lateral>
            </vistas:FrontalConBotonera>
        </Border>
        </Grid>

        <!--
            Plegado AUTOMÁTICO: el operador quiere el equipo a la vista, pero a este alto de
            ventana no cabe sin aplastar el cluster. «Mostrar equipo» lo enseña igualmente, a su
            tamaño mínimo, hasta que vuelva a haber sitio.
        -->
        <Border Grid.Row="1"
                x:Name="LineaDePlegadoAutomatico"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="10,4"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{loc:Texto Principal.Operar.MostrarEquipo}"
                        Click="AlForzarElFrontal"
                        Padding="8,1"
                        AutomationProperties.Name="{loc:Texto Principal.Operar.MostrarFrontal}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{loc:Texto Principal.Operar.EquipoPlegado}" FontWeight="Bold" />
                    <Run Text="{loc:Texto Principal.Operar.PlegadoPorTamano}" Foreground="{DynamicResource TextoTenue}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!--
            Sin equipo que hable CAT no hay frontal que dibujar, y un hueco mudo parecería un
            fallo. Se dice qué pasa y qué hacer, que es elegir la vía de control en Ajustes y
            pulsar «Conectar». Conectar nunca lo hace el programa solo.
        -->
        <Border Grid.Row="1"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="14,10"
                Visibility="{Binding SinEquipoAvanzado, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel>
                <TextBlock Text="{loc:Texto Principal.Operar.SinEquipo}"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{loc:Texto Principal.Operar.SinEquipoExplicacion}"
                           Style="{StaticResource TextoTenueEstilo}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!--
            Equipo conectado y frontal plegado: una línea, no el cartel de «no hay equipo».
            Plegar es para dejar sitio, así que no se ocupa más que esto.
        -->
        <Border Grid.Row="1"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="10,4"
                Visibility="{Binding FrontalPlegado, Converter={StaticResource BooleanoAVisible}}">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right"
                              Content="{loc:Texto Principal.Operar.MostrarEquipo}"
                              IsChecked="{Binding FrontalDesplegado}"
                              Padding="8,1"
                              AutomationProperties.Name="{loc:Texto Principal.Operar.MostrarFrontal}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{loc:Texto Principal.Operar.EquipoPlegado}" FontWeight="Bold" />
                    <Run Text="{loc:Texto Principal.Operar.PlegadoPorSitio}" Foreground="{DynamicResource TextoTenue}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ══ La vista complementaria de todos los mandos ══ -->
        <Border Grid.Row="2"
                x:Name="TarjetaDeLosMandos"
                SizeChanged="AlCambiarElReparto"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="8,6"
                DataContext="{Binding Equipo}"
                Visibility="{Binding DataContext.ListaDeMandosVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanoAVisible}}">
            <StackPanel>
                <TextBlock Text="{loc:Texto Principal.Operar.TodosLosMandos}"
                           Style="{StaticResource TituloDeSeccion}" />
                <TextBlock Text="{loc:Texto Principal.Operar.TodosLosMandosExplicacion}"
                           Style="{StaticResource TextoTenueEstilo}"
                           Margin="0,0,0,4" />
                <vistas:ListaDeMandos />
            </StackPanel>
        </Border>

        <!-- ══ Fonía por el PC: una franja con el PTT, bajo el frontal ══ -->
        <Border Grid.Row="3"
                x:Name="FranjaDeFonia"
                Margin="0,0,0,5"
                Padding="8,4">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fonia}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Con el frontal a la vista, la fonía va en columna a su lado. -->
                        <DataTrigger Binding="{Binding FrontalDibujadoVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <vistas:PanelDeFonia DataContext="{Binding Fonia}" />
        </Border>

        <!-- ══ Telegrafía: con el equipo en CW o pedida con el botón «CW» de la barra ══ -->
        <Border Grid.Row="4"
                x:Name="TarjetaCw"
                SizeChanged="AlCambiarElReparto"
                Style="{StaticResource Tarjeta}"
                Margin="0,0,0,5"
                Padding="8,4"
                Visibility="{Binding Cw.Visible, Converter={StaticResource BooleanoAVisible}, FallbackValue=Collapsed}">
            <vistas:PanelCw DataContext="{Binding Cw}" />
        </Border>

        <!-- ══ Contacto nuevo a la izquierda; cluster a la derecha ══ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="230" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,5,0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Pegado arriba: si se deja estirar, el formulario reparte su alto entre
                        las filas y deja un claro en blanco enorme debajo del comentario que no
                        sirve para nada.
                    -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <vistas:PanelDeEntrada x:Name="Entrada" VerticalAlignment="Top" />
                    </ScrollViewer>

                    <!--
                        El retrato del indicativo va ANCLADO ABAJO, fuera del desplazamiento:
                        mientras se teclea tiene que estar a la vista, porque es lo que dice si
                        merece la pena llamar. Si se desplazara con el formulario, el dato
                        llegaria tarde. Son numeros que el cuaderno ya tenia y que no se
                        ensenaban en ninguna parte.
                    -->
                    <StackPanel Grid.Row="1">
                        <Separator Margin="0,5" Background="{DynamicResource BordeSuave}" />
                        <vistas:PanelDeRetrato DataContext="{Binding Retrato}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                El cluster y el bandmap: los mismos anuncios por lista y por frecuencia. La
                lista dice quién ha salido; el bandmap dice dónde está llena la banda y dónde
                hay hueco, que es lo que decide hacia dónde se gira el dial.
            -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0" Padding="4">
                <TabControl SelectedIndex="{Binding IndiceDeLaListaDeSpots}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconoDigital}" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Texto Principal.Operar.Cluster}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <vistas:PanelDeCluster DataContext="{Binding Cluster}" Margin="4" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconoBandmap}" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Texto Principal.Operar.Bandmap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <vistas:PanelDeBandmap DataContext="{Binding Bandmap}" Margin="4" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
