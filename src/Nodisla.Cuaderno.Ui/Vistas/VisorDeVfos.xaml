<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.VisorDeVfos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores"
             Foreground="{DynamicResource Texto}">

    <!--
        EL VISOR. Ocupa en el frontal dibujado el hueco de la pantalla táctil del equipo.

        No la imita: la radio ya enseña lo suyo en su pantalla. Aquí va lo que hace falta para
        operar desde el ordenador, y va GRANDE, porque es lo único que el operador mira
        mientras teclea un indicativo.

        De cada VFO hay que poder decir de un vistazo tres cosas: en qué frecuencia está, en
        qué modo, y si por él se TRANSMITE o se RECIBE. Confundir las dos últimas es transmitir
        donde no se debía; por eso la marca de TX va en rojo y con el fondo teñido, no en un
        texto pequeño más.

        Debajo de cada VFO, cuando la hay, la estación que el cluster está anunciando en esa
        misma frecuencia, con su país y si sería entidad nueva: es el dato que decide si merece
        la pena llamar.

        El aviso del plan de bandas AVISA; no impide. El dial de Jose estaba en 27.555 MHz el
        día que se capturó el CAT de su equipo, y ese contacto se registra igual.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:FraccionDeAncho x:Key="FraccionDeAncho" />

        <Style x:Key="FilaDeVfo" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsElActivo}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AcentoSuave}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Transmite}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MarcaDePapel" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Background" Value="{DynamicResource FondoResalte}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Transmite}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorBorde}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PlantillaDeVfo">
            <Border Style="{StaticResource FilaDeVfo}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Etiqueta}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Width="50"
                                   Foreground="{DynamicResource TextoTenue}" />

                        <Border DockPanel.Dock="Left" Style="{StaticResource MarcaDePapel}">
                            <TextBlock Text="{Binding Papel}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextTrimming="None">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Transmite}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextoSobreAcento}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Modo}"
                                       FontWeight="Bold"
                                       FontSize="17"
                                       Margin="10,0,0,0"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding Banda}"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       TextTrimming="None">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FueraDeBanda}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AvisoTexto}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AnchoDeFiltro}"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextoTenue}"
                                       ToolTip="Ancho del filtro de recepción"
                                       TextTrimming="None" />
                        </StackPanel>

                        <!-- La frecuencia: lo más grande del visor. Siempre con punto decimal. -->
                        <TextBlock Text="{Binding Frecuencia}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   FontWeight="Bold"
                                   FontSize="32"
                                   Margin="4,0,0,0"
                                   TextTrimming="None"
                                   Foreground="{DynamicResource Acento}"
                                   ToolTip="Frecuencia en megahercios" />
                    </DockPanel>

                    <TextBlock Text="{Binding AvisoDelBandplan}"
                               Style="{StaticResource TextoTenueEstilo}"
                               Foreground="{DynamicResource AvisoTexto}"
                               FontSize="11"
                               Margin="50,1,0,0"
                               Visibility="{Binding AvisoDelBandplan, Converter={StaticResource NoEsVacio}}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="50,1,0,0"
                                Visibility="{Binding HayAnuncio, Converter={StaticResource BooleanoAVisible}}">
                        <TextBlock Text="En esta frecuencia:"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   FontSize="11"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Anunciado}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextTrimming="None">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnuncioEsNuevo}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CorrectoTexto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Una barra de medidor, con su rótulo y su lectura. -->
        <Style x:Key="CanalDelMedidor" TargetType="Border">
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource FondoResalte}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding A}" ContentTemplate="{StaticResource PlantillaDeVfo}" />
        <ContentControl Grid.Row="1" Content="{Binding B}" ContentTemplate="{StaticResource PlantillaDeVfo}" />

        <!-- ══ Medidores: señal en recepción, potencia en transmisión ══ -->
        <Grid Grid.Row="2" Margin="4,6,4,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="S"
                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextoTenue}" />
            <Border x:Name="CanalDeSenal" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CanalDelMedidor}"
                    AutomationProperties.Name="Medidor de señal">
                <Border HorizontalAlignment="Left"
                        CornerRadius="4"
                        Background="{DynamicResource Acento}"
                        Width="{Binding NivelDeSenal, Converter={StaticResource FraccionDeAncho}, ConverterParameter=310}" />
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MedidorS}"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       FontWeight="Bold" FontSize="11" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="None" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="PO"
                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextoTenue}" />
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource CanalDelMedidor}"
                    Margin="0,4,0,0"
                    AutomationProperties.Name="Medidor de potencia de salida">
                <Border HorizontalAlignment="Left"
                        CornerRadius="4"
                        Background="{DynamicResource ErrorBorde}"
                        Width="{Binding NivelDePotencia, Converter={StaticResource FraccionDeAncho}, ConverterParameter=310}" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MedidorPotencia}"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       FontWeight="Bold" FontSize="11" Margin="8,4,0,0"
                       VerticalAlignment="Center" TextTrimming="None" />
        </Grid>

        <!-- ══ Memorias del equipo ══ -->
        <DockPanel Grid.Row="3" Margin="4,8,4,0"
                   Visibility="{Binding EsAvanzado, Converter={StaticResource BooleanoAVisible}}">
            <TextBlock DockPanel.Dock="Left" Text="MEM"
                       FontWeight="Bold" FontSize="12" Width="30"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextoTenue}" />
            <Button DockPanel.Dock="Right"
                    Content="Ir"
                    Command="{Binding IrALaMemoriaCommand}"
                    Padding="10,2"
                    FontSize="11"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Llevar el equipo a la memoria elegida"
                    ToolTip="Lleva el equipo a la memoria elegida" />
            <ComboBox ItemsSource="{Binding Memorias}"
                      SelectedItem="{Binding MemoriaElegida}"
                      FontSize="11"
                      AutomationProperties.Name="Memorias del equipo"
                      ToolTip="Memorias guardadas en el equipo">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="None">
                            <Run Text="{Binding Numero, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="·" />
                            <Run Text="{Binding Etiqueta, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- ══ Estado: split, RIT, XIT, ROE y de dónde sale la sintonía ══ -->
        <WrapPanel Grid.Row="5" Margin="4,4,0,0">
            <Border Style="{StaticResource MarcaDeNovedad}"
                    Background="{DynamicResource AvisoFondo}"
                    BorderBrush="{DynamicResource AvisoBorde}"
                    Visibility="{Binding TextoDeSplit, Converter={StaticResource NoEsVacio}}">
                <TextBlock Text="{Binding TextoDeSplit}"
                           FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource AvisoTexto}"
                           TextTrimming="None" />
            </Border>

            <TextBlock Text="{Binding TextoDeRit}"
                       Style="{StaticResource TextoTenueEstilo}"
                       FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                       Visibility="{Binding TextoDeRit, Converter={StaticResource NoEsVacio}}" />

            <TextBlock Text="{Binding TextoDeXit}"
                       Style="{StaticResource TextoTenueEstilo}"
                       FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                       Visibility="{Binding TextoDeXit, Converter={StaticResource NoEsVacio}}" />

            <TextBlock Style="{StaticResource TextoTenueEstilo}" FontSize="11"
                       Margin="0,0,10,0" VerticalAlignment="Center"
                       ToolTip="Relación de onda estacionaria">
                <Run Text="ROE" />
                <Run Text="{Binding MedidorRoe, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>

            <TextBlock Style="{StaticResource TextoTenueEstilo}" FontSize="11"
                       Margin="0,0,10,0" VerticalAlignment="Center"
                       ToolTip="Tensión de alimentación">
                <Run Text="{Binding MedidorTension, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>

            <TextBlock Text="{Binding OrigenDeLaFrecuencia}"
                       Style="{StaticResource TextoTenueEstilo}"
                       FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
        </WrapPanel>
    </Grid>
</UserControl>
