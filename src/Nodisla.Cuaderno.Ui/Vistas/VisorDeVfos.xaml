<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.VisorDeVfos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversores="clr-namespace:Nodisla.Cuaderno.Ui.Conversores">

    <!--
        LA PANTALLA DEL EQUIPO.

        Dibujada de cero en vector siguiendo `docs\05-frontal-ft710-referencia.md`, que describe
        la fotografía que envió Jose. Fondo negro, y los colores del equipo: la frecuencia del
        VFO-A en blanco grande con puntos de millar, su modo en recuadro azul, el VFO-B en
        amarillo con la frecuencia en gris más pequeña, los indicadores de recepción en naranja,
        y la aguja del medidor en rojo.

        Los colores de aquí son FIJOS y no siguen el tema del programa: esto es el dibujo de una
        radio negra, y una radio negra es negra con el tema claro y con el oscuro.

        Donde el equipo pone el analizador de espectro va, de momento, lo útil del cuaderno:
        quién está anunciado en esa frecuencia, el aviso del plan de bandas y el estado de la
        operación. En la Fase 4 ahí irá la cascada de verdad del módem propio.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />
        <conversores:NoEsVacio x:Key="NoEsVacio" />
        <conversores:AnguloDeAguja x:Key="AnguloDeAguja" />

        <!-- ── Colores del equipo ────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Pantalla" Color="#FF07090C" />
        <SolidColorBrush x:Key="PantallaBorde" Color="#FF2B3138" />
        <SolidColorBrush x:Key="Blanco" Color="#FFF2F6FA" />
        <SolidColorBrush x:Key="GrisDelVisor" Color="#FF9BA6B2" />
        <SolidColorBrush x:Key="AzulDelVisor" Color="#FF1E7FE0" />
        <SolidColorBrush x:Key="NaranjaDelVisor" Color="#FFF29A2E" />
        <SolidColorBrush x:Key="AmarilloDelVisor" Color="#FFF2D94E" />
        <SolidColorBrush x:Key="RojoDelVisor" Color="#FFE2352B" />
        <SolidColorBrush x:Key="VerdeDelVisor" Color="#FF3FBF6A" />

        <Style x:Key="RotuloDelVisor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NaranjaDelVisor}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValorDelVisor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Margin" Value="3,0,10,0" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Botonera táctil de la franja inferior. -->
        <Style x:Key="TeclaDelVisor" TargetType="Border">
            <Setter Property="Background" Value="#FF161B21" />
            <Setter Property="BorderBrush" Value="#FF2B3138" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Pantalla}"
            BorderBrush="{StaticResource PantallaBorde}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="6,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ Franja superior: medidor de arco y los dos VFO ══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- El medidor: dos escalas y una aguja roja, como el del equipo. -->
                <Grid Grid.Column="0" Width="150" Height="58">
                    <TextBlock Text="S  1  3  5  7  9  +20 +40 +60 dB"
                               Foreground="{StaticResource Blanco}"
                               FontSize="7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               TextTrimming="None" />
                    <TextBlock Text="PO 0  10  50  100 150 W"
                               Foreground="{StaticResource GrisDelVisor}"
                               FontSize="7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,9,0,0"
                               TextTrimming="None" />

                    <!-- El arco sobre el que barre la aguja. -->
                    <Path Stroke="{StaticResource PantallaBorde}"
                          StrokeThickness="1"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,6"
                          Data="M 10,28 A 62,62 0 0 1 140,28" />

                    <!-- La aguja. Gira sobre su punta de abajo. -->
                    <Rectangle Width="1.6"
                               Height="30"
                               Fill="{StaticResource RojoDelVisor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="{Binding NivelDeSenal, Converter={StaticResource AnguloDeAguja}, ConverterParameter=52}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <TextBlock Text="{Binding MedidorS}"
                               Foreground="{StaticResource Blanco}"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               FontSize="8"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding MedidorPotencia}"
                               Foreground="{StaticResource GrisDelVisor}"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               FontSize="8"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               TextTrimming="None" />
                </Grid>

                <!-- Los dos VFO. -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <!-- VFO A: el que manda. Frecuencia en blanco y grande. -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding A.Etiqueta}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Width="34"
                                   TextTrimming="None" />

                        <Border DockPanel.Dock="Left"
                                Background="{StaticResource AzulDelVisor}"
                                CornerRadius="2"
                                Padding="5,0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding A.Modo}"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       TextTrimming="None" />
                        </Border>

                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource RojoDelVisor}"
                                CornerRadius="2"
                                Padding="4,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding A.Transmite, Converter={StaticResource BooleanoAVisible}}">
                            <TextBlock Text="TX"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       TextTrimming="None" />
                        </Border>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding A.Banda}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Bottom"
                                   TextTrimming="None" />

                        <!-- La frecuencia, con puntos de millar como en el equipo. -->
                        <TextBlock Text="{Binding A.FrecuenciaDelVisor}"
                                   Foreground="{StaticResource Blanco}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   TextTrimming="None" />
                    </DockPanel>

                    <!-- VFO B: modo en amarillo y frecuencia más pequeña, en gris. -->
                    <DockPanel Margin="0,1,0,0">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding B.Etiqueta}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Width="34"
                                   TextTrimming="None" />

                        <Border DockPanel.Dock="Left"
                                Background="#FF2A2410"
                                BorderBrush="{StaticResource AmarilloDelVisor}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="4,0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding B.Modo}"
                                       Foreground="{StaticResource AmarilloDelVisor}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       TextTrimming="None" />
                        </Border>

                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource RojoDelVisor}"
                                CornerRadius="2"
                                Padding="4,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding B.Transmite, Converter={StaticResource BooleanoAVisible}}">
                            <TextBlock Text="TX"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       TextTrimming="None" />
                        </Border>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding B.Banda}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="None" />

                        <TextBlock Text="{Binding B.FrecuenciaDelVisor}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   TextTrimming="None" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- ══ Indicadores de recepción, en naranja, y el estado en azul ══ -->
            <DockPanel Grid.Row="1" Margin="0,3,0,2">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding EstadoDelEspectro}"
                           Foreground="{StaticResource AzulDelVisor}"
                           FontSize="8"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="None" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ATT" Style="{StaticResource RotuloDelVisor}" />
                    <TextBlock Text="{Binding Atenuador}" Style="{StaticResource ValorDelVisor}" />
                    <TextBlock Text="IPO" Style="{StaticResource RotuloDelVisor}" />
                    <TextBlock Text="{Binding Preamplificador}" Style="{StaticResource ValorDelVisor}" />
                    <TextBlock Text="DNF" Style="{StaticResource RotuloDelVisor}" />
                    <TextBlock Text="{Binding MuescaAutomatica}" Style="{StaticResource ValorDelVisor}" />
                    <TextBlock Text="AGC" Style="{StaticResource RotuloDelVisor}" />
                    <TextBlock Text="{Binding Agc}" Style="{StaticResource ValorDelVisor}" />
                </StackPanel>
            </DockPanel>

            <!-- ══ Donde el equipo pone el espectro, va lo útil del cuaderno ══ -->
            <Border Grid.Row="2"
                    Background="#FF0C1016"
                    BorderBrush="{StaticResource PantallaBorde}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="6,3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Marca de la frecuencia sintonizada, como el triángulo rojo del equipo. -->
                    <Path Grid.Row="0"
                          Fill="{StaticResource RojoDelVisor}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Data="M 0,0 L 10,0 L 5,7 Z" />

                    <StackPanel Grid.Row="0" Margin="0,8,0,0">
                        <!-- Quién está anunciado en la frecuencia del VFO que recibe. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding A.HayAnuncio, Converter={StaticResource BooleanoAVisible}}">
                            <TextBlock Text="EN ESTA FRECUENCIA"
                                       Foreground="{StaticResource NaranjaDelVisor}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Margin="0,0,6,0"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding A.Anunciado}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       TextTrimming="None">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding A.AnuncioEsNuevo}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource VerdeDelVisor}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- El plan de bandas: avisa, no impide. -->
                        <TextBlock Text="{Binding A.AvisoDelBandplan}"
                                   Foreground="{StaticResource NaranjaDelVisor}"
                                   FontSize="9"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,1,0,0"
                                   Visibility="{Binding A.AvisoDelBandplan, Converter={StaticResource NoEsVacio}}" />

                        <TextBlock Text="{Binding A.TramoDelBandplan}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   TextAlignment="Center"
                                   TextTrimming="None"
                                   Visibility="{Binding A.TramoDelBandplan, Converter={StaticResource NoEsVacio}}" />
                    </StackPanel>

                    <!--
                        Donde el equipo dibuja el analizador de espectro va, de momento, quién
                        está anunciado en la banda ahora mismo. Un hueco negro no dice nada;
                        esta lista corta, ordenada por frecuencia, es lo que se mira antes de
                        girar el dial. En la fase cuatro aquí va la cascada de verdad.
                    -->
                    <DockPanel Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding TituloDeLaBanda}"
                                   Foreground="{StaticResource NaranjaDelVisor}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2"
                                   TextTrimming="None" />

                        <TextBlock DockPanel.Dock="Top"
                                   Text="Nadie anunciado en esta banda ahora mismo."
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   FontStyle="Italic"
                                   TextTrimming="None"
                                   Visibility="{Binding BandaVacia, Converter={StaticResource BooleanoAVisible}}" />

                        <ItemsControl ItemsSource="{Binding EnLaBanda}" DockPanel.Dock="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,1">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Frecuencia}"
                                                   Foreground="{StaticResource GrisDelVisor}"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                   FontSize="9"
                                                   Width="64"
                                                   TextTrimming="None" />

                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Indicativo}"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Width="66"
                                                   TextTrimming="None">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsInteresante}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource VerdeDelVisor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Modo}"
                                                   Foreground="{StaticResource AzulDelVisor}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Width="36"
                                                   TextTrimming="None" />

                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding QuienesLoOyen}"
                                                   Foreground="{StaticResource GrisDelVisor}"
                                                   FontSize="8"
                                                   Margin="6,0,0,0"
                                                   TextTrimming="None"
                                                   Visibility="{Binding LaOyenVarios, Converter={StaticResource BooleanoAVisible}}" />

                                        <TextBlock Text="{Binding Pais}"
                                                   Foreground="{StaticResource GrisDelVisor}"
                                                   FontSize="8"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- Estado de la operación, abajo del todo. -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding OrigenDeLaFrecuencia}"
                                   Foreground="{StaticResource GrisDelVisor}"
                                   FontSize="8"
                                   FontStyle="Italic"
                                   TextTrimming="None" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TextoDeSplit}"
                                       Foreground="{StaticResource AmarilloDelVisor}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding TextoDeRit}"
                                       Foreground="{StaticResource GrisDelVisor}"
                                       FontSize="8"
                                       Margin="0,0,8,0"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding TextoDeXit}"
                                       Foreground="{StaticResource GrisDelVisor}"
                                       FontSize="8"
                                       Margin="0,0,8,0"
                                       TextTrimming="None" />
                            <TextBlock Foreground="{StaticResource GrisDelVisor}" FontSize="8" TextTrimming="None">
                                <Run Text="ROE" />
                                <Run Text="{Binding MedidorRoe, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding MedidorTension, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding A.AnchoDeFiltro, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>


            <!-- ══ Botonera táctil de la franja inferior ══ -->
            <UniformGrid Grid.Row="3" Columns="6" Margin="0,3,0,0" Height="14">
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="MEM" Foreground="{StaticResource GrisDelVisor}" FontSize="7"
                               HorizontalAlignment="Center" TextTrimming="None" />
                </Border>
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="{Binding MemoriaElegida.Etiqueta}" Foreground="{StaticResource Blanco}"
                               FontSize="7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="CLUSTER" Foreground="{StaticResource GrisDelVisor}" FontSize="7"
                               HorizontalAlignment="Center" TextTrimming="None" />
                </Border>
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="{Binding ResumenDeSpots}" Foreground="{StaticResource AzulDelVisor}"
                               FontSize="7" HorizontalAlignment="Center" TextTrimming="None" />
                </Border>
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="VFO" Foreground="{StaticResource GrisDelVisor}" FontSize="7"
                               HorizontalAlignment="Center" TextTrimming="None" />
                </Border>
                <Border Style="{StaticResource TeclaDelVisor}">
                    <TextBlock Text="{Binding Vfo}" Foreground="{StaticResource Blanco}" FontSize="7"
                               HorizontalAlignment="Center" TextTrimming="None" />
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
