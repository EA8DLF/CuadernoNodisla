<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.Controles.SelectorDeColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:qsl="clr-namespace:Nodisla.Cuaderno.Ui.Qsl"
             xmlns:controles="clr-namespace:Nodisla.Cuaderno.Ui.Vistas.Controles"
             x:Name="Raiz"
             Focusable="False">

    <!--
        EL SELECTOR DE COLOR de los editores de la tarjeta QSL y de diplomas.

        Un botón con la muestra y el NOMBRE del color; al pulsarlo se despliega, dentro de la
        misma ventana, la paleta de muestras, los colores que ya usa el diseño, los últimos
        usados, la opacidad (si el campo la admite), un selector libre de tono, saturación y
        brillo y, plegado en «Avanzado», el código. El código es un dato secundario: el color se
        elige mirando, no escribiendo.

        Lo que se guarda en la plantilla sigue siendo el texto de siempre (#RRGGBB o #AARRGGBB).
    -->

    <UserControl.Resources>
        <controles:EsElColorActual x:Key="EsElColorActual" />

        <!-- Damero bajo las muestras: así se ve la transparencia. -->
        <DrawingBrush x:Key="Damero" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FFC8C8C8" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="RotuloDelDesplegable" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Una muestra clicable: Intro o espacio la eligen, las flechas pasan a la de al lado. -->
        <Style x:Key="BotonDeMuestra" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Nombre}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Nombre}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="Click" Handler="AlPulsarMuestra" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{StaticResource Damero}" CornerRadius="3" />
                            <Border Background="{Binding Pincel}" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="3" />
                            <Path Data="M5,11 L9,15 L17,6" Stroke="{Binding Tinta}" StrokeThickness="2.2" StrokeEndLineCap="Round" StrokeStartLineCap="Round">
                                <Path.Visibility>
                                    <MultiBinding Converter="{StaticResource EsElColorActual}">
                                        <Binding />
                                        <Binding Path="(controles:SelectorDeColor.ColorActual)" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Path.Visibility>
                            </Path>
                            <Border x:Name="aro" Margin="-3" BorderBrush="{DynamicResource Acento}" BorderThickness="2" CornerRadius="5" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="aro" Property="Visibility" Value="Visible" />
                                <Setter TargetName="aro" Property="BorderBrush" Value="{DynamicResource AcentoSuave}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="aro" Property="Visibility" Value="Visible" />
                                <Setter TargetName="aro" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlantillaDeMuestra" DataType="{x:Type qsl:MuestraDeColor}">
            <Button Style="{StaticResource BotonDeMuestra}" />
        </DataTemplate>

        <Style x:Key="FilaDeMuestras" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource PlantillaDeMuestra}" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Width="260" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabecera plegable: «▸ Color exacto», «▸ Avanzado». -->
        <Style x:Key="Plegable" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="marco" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="2,1">
                            <DockPanel>
                                <TextBlock x:Name="flecha" DockPanel.Dock="Left" Text="&#x25B8;" Width="14" Foreground="{DynamicResource TextoTenue}" />
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="flecha" Property="Text" Value="&#x25BE;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="marco" Property="Background" Value="{DynamicResource FondoResalte}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Superficies de arrastre (tono, saturación y brillo, opacidad): se ve el foco. -->
        <Style x:Key="Superficie" TargetType="Grid">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="boton"
                      IsChecked="{Binding IsOpen, ElementName=desplegable, Mode=TwoWay}"
                      KeyDown="AlTeclearEnElBoton"
                      Foreground="{DynamicResource Texto}"
                      Cursor="Hand"
                      FocusVisualStyle="{x:Null}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="marco" Background="{DynamicResource FondoCampo}" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="3" Padding="4,3,8,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource AcentoSuave}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            <Setter TargetName="marco" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource Acento}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0">
                    <Border Background="{StaticResource Damero}" CornerRadius="3" />
                    <Border x:Name="muestraDelBoton" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="3" />
                    <Line x:Name="rayaDelBoton" X1="3" Y1="17" X2="17" Y2="3" Stroke="#FFD62828" StrokeThickness="1.6" />
                </Grid>
                <TextBlock DockPanel.Dock="Right" Text="&#x25BE;" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextoTenue}" />
                <TextBlock x:Name="nombreDelBoton" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </ToggleButton>

        <Popup x:Name="desplegable"
               PlacementTarget="{Binding ElementName=boton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="AlAbrir"
               Closed="AlCerrar">
            <Border x:Name="contenido"
                    Background="{DynamicResource FondoPanel}"
                    BorderBrush="{DynamicResource Borde}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,2,8,8"
                    TextElement.Foreground="{DynamicResource Texto}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    PreviewKeyDown="AlTeclearEnElDesplegable">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.35" />
                </Border.Effect>
                <StackPanel Width="260">
                    <!-- El color elegido, con su nombre. -->
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0">
                            <Border Background="{StaticResource Damero}" CornerRadius="4" />
                            <Border x:Name="muestraGrande" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="4" />
                            <Line x:Name="rayaGrande" X1="4" Y1="26" X2="26" Y2="4" Stroke="#FFD62828" StrokeThickness="2" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="tituloDelDesplegable" Foreground="{DynamicResource TextoTenue}" FontSize="11" />
                            <TextBlock x:Name="nombreGrande" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <Button x:Name="botonVacio" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,3" Click="AlPulsarVacio" />

                    <TextBlock Text="{loc:Texto Qsl.Color.Paleta}" Style="{StaticResource RotuloDelDesplegable}" />
                    <ItemsControl x:Name="listaBasica" Style="{StaticResource FilaDeMuestras}"
                                  ItemsSource="{x:Static qsl:PaletaDeColores.Basica}"
                                  AutomationProperties.Name="{loc:Texto Qsl.Color.PaletaDeColores}" />

                    <StackPanel x:Name="bloqueDelDiseno">
                        <TextBlock Text="{loc:Texto Qsl.Color.DelDiseno}" Style="{StaticResource RotuloDelDesplegable}" />
                        <ItemsControl x:Name="listaDelDiseno" Style="{StaticResource FilaDeMuestras}"
                                      AutomationProperties.Name="{loc:Texto Qsl.Color.DelDisenoNombre}" />
                    </StackPanel>

                    <StackPanel x:Name="bloqueDeRecientes">
                        <TextBlock Text="{loc:Texto Qsl.Color.Recientes}" Style="{StaticResource RotuloDelDesplegable}" />
                        <ItemsControl x:Name="listaDeRecientes" Style="{StaticResource FilaDeMuestras}"
                                      AutomationProperties.Name="{loc:Texto Qsl.Color.RecientesNombre}" />
                    </StackPanel>

                    <StackPanel x:Name="bloqueDeOpacidad">
                        <DockPanel Margin="0,8,0,3">
                            <TextBlock x:Name="textoDeOpacidad" DockPanel.Dock="Right" Foreground="{DynamicResource TextoTenue}" />
                            <TextBlock Text="{loc:Texto Qsl.Color.Opacidad}" FontWeight="SemiBold" Foreground="{DynamicResource TextoTenue}" />
                        </DockPanel>
                        <Grid x:Name="barraDeOpacidad" Style="{StaticResource Superficie}" Height="16"
                              ToolTip="{loc:Texto Qsl.Color.OpacidadAyuda}"
                              AutomationProperties.Name="{loc:Texto Qsl.Color.Opacidad}"
                              MouseLeftButtonDown="AlPulsarSuperficie" MouseMove="AlMoverSobreSuperficie" MouseLeftButtonUp="AlSoltarSuperficie"
                              KeyDown="AlTeclearEnSuperficie" SizeChanged="AlCambiarDeTamano"
                              GotKeyboardFocus="AlCambiarElFoco" LostKeyboardFocus="AlCambiarElFoco">
                            <Border Background="{StaticResource Damero}" CornerRadius="3" />
                            <Border x:Name="degradadoDeOpacidad" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="3" />
                            <Canvas>
                                <Border x:Name="marcaDeOpacidad" Width="6" Height="20" Canvas.Top="-2" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" />
                            </Canvas>
                        </Grid>
                    </StackPanel>

                    <ToggleButton x:Name="plegarExacto" Style="{StaticResource Plegable}" Content="{loc:Texto Qsl.Color.Exacto}"
                                  AutomationProperties.Name="{loc:Texto Qsl.Color.ExactoNombre}" Checked="AlPlegarODesplegar" Unchecked="AlPlegarODesplegar" />
                    <StackPanel x:Name="bloqueExacto" Visibility="Collapsed">
                        <Grid x:Name="superficieSv" Style="{StaticResource Superficie}" Height="130" Margin="0,6,0,0"
                              ToolTip="{loc:Texto Qsl.Color.SvAyuda}"
                              AutomationProperties.Name="{loc:Texto Qsl.Color.SvNombre}"
                              MouseLeftButtonDown="AlPulsarSuperficie" MouseMove="AlMoverSobreSuperficie" MouseLeftButtonUp="AlSoltarSuperficie"
                              KeyDown="AlTeclearEnSuperficie" SizeChanged="AlCambiarDeTamano"
                              GotKeyboardFocus="AlCambiarElFoco" LostKeyboardFocus="AlCambiarElFoco">
                            <Border x:Name="fondoDelTono" CornerRadius="3" />
                            <Border CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="bordeDelCuadro" CornerRadius="3" BorderBrush="{DynamicResource Borde}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas>
                                <Ellipse x:Name="marcaSv" Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                                <Ellipse x:Name="marcaSvSombra" Width="16" Height="16" Stroke="Black" StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                        <Grid x:Name="barraDeTono" Style="{StaticResource Superficie}" Height="16" Margin="0,8,0,0"
                              ToolTip="{loc:Texto Qsl.Color.TonoAyuda}"
                              AutomationProperties.Name="{loc:Texto Qsl.Color.Tono}"
                              MouseLeftButtonDown="AlPulsarSuperficie" MouseMove="AlMoverSobreSuperficie" MouseLeftButtonUp="AlSoltarSuperficie"
                              KeyDown="AlTeclearEnSuperficie" SizeChanged="AlCambiarDeTamano"
                              GotKeyboardFocus="AlCambiarElFoco" LostKeyboardFocus="AlCambiarElFoco">
                            <Border x:Name="bordeDelTono" CornerRadius="3" BorderBrush="{DynamicResource Borde}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas>
                                <Border x:Name="marcaDeTono" Width="6" Height="20" Canvas.Top="-2" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2" />
                            </Canvas>
                        </Grid>
                    </StackPanel>

                    <ToggleButton x:Name="plegarAvanzado" Style="{StaticResource Plegable}" Content="{loc:Texto Qsl.Color.Avanzado}"
                                  AutomationProperties.Name="{loc:Texto Qsl.Color.AvanzadoNombre}" Checked="AlPlegarODesplegar" Unchecked="AlPlegarODesplegar" />
                    <StackPanel x:Name="bloqueAvanzado" Visibility="Collapsed">
                        <TextBlock Text="{loc:Texto Qsl.Color.Codigo}" TextWrapping="Wrap" Margin="0,6,0,2" Foreground="{DynamicResource TextoTenue}" />
                        <TextBox x:Name="codigo" KeyDown="AlTeclearElCodigo" LostKeyboardFocus="AlSalirDelCodigo"
                                 ToolTip="{loc:Texto Qsl.Color.CodigoAyuda}"
                                 AutomationProperties.Name="{loc:Texto Qsl.Color.CodigoNombre}" />
                        <TextBlock x:Name="errorDelCodigo" Text="{loc:Texto Qsl.Color.NoEsUnColor}" Visibility="Collapsed"
                                   Foreground="{DynamicResource ErrorTexto}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
