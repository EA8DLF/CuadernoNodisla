<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.FrontalFt710"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:puertos="clr-namespace:Nodisla.Cuaderno.Aplicacion.Puertos;assembly=Nodisla.Cuaderno.Aplicacion">

    <!--
        EL FRONTAL DEL EQUIPO, DIBUJADO EN VECTOR A PARTIR DE LAS FOTOS DE LA RADIO DEL OPERADOR
        (docs\capturas\referencia-ft710-frontal.jpg y referencia-ft710-botonera.jpg).

        Cada pieza está en el sitio y al tamaño que tiene en la foto: se midió sobre ella y se
        pasó a un lienzo de 1040 × 335 (el cuerpo; el altavoz de la derecha, 160 más, ya no se
        dibuja). Por eso es un Canvas con coordenadas y no una rejilla:
        una rejilla reparte el sitio a su manera y el dibujo deja de parecerse.

          · Izquierda, en columna: LOCK con su piloto azul, TUNE, VOX/MOX, PHONES y MIC.
          · La pantalla, con la marca arriba a la izquierda y el modelo en dorado a la derecha.
          · Fila de arriba, en el canto: MODE · ZIN/SPOT · SPLIT · CLAR · NB.
          · Segunda fila, en su canal: M▶V · V/M (W) · A/B · BAND · QMB.
          · Tercera: DNR · piloto BUSY/TX · NAR.
          · FUNC y STEP/MCH-DSP a la izquierda del dial, RF GAIN/SQL y AF GAIN a la derecha,
            los cuatro dobles y concéntricos; el dial grande con los dos arcos azules; DSP RESET
            y FINE/FAST abajo.
          · Sin la rejilla del altavoz (29-09-2026): su sitio es para la botonera de bandas y
            los canales CB (FrontalConBotonera).

        Se dibuja, no se pega la foto. Es vectorial y va dentro de un Viewbox: se ENCOGE con la
        ventana y respeta el tope de alto que le ponen PanelOperar y PestanaDigital.

        Cada tecla y cada mando conserva su orden (revisado en docs\09-revision-operar.md).
    -->

    <UserControl.Resources>
        <!-- ── Colores del equipo, fijos: la radio es negra con cualquier tema ── -->
        <SolidColorBrush x:Key="Serigrafia" Color="#FFC4CBD3" />
        <SolidColorBrush x:Key="TeclaTexto" Color="#FFE8ECF0" />
        <SolidColorBrush x:Key="TeclaApagada" Color="#FF8A929B" />
        <SolidColorBrush x:Key="AnilloAzul" Color="#FF2E8BFF" />
        <SolidColorBrush x:Key="PilotoApagado" Color="#FF25292E" />
        <SolidColorBrush x:Key="RojoTx" Color="#FFE2352B" />
        <SolidColorBrush x:Key="Dorado" Color="#FFD9AE4E" />

        <!-- El cuerpo: chapa negra mate con la luz cayendo desde arriba. -->
        <LinearGradientBrush x:Key="Cuerpo" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF26292D" />
            <GradientStop Offset="0.08" Color="#FF1B1D20" />
            <GradientStop Offset="0.9" Color="#FF121416" />
            <GradientStop Offset="1" Color="#FF0B0C0E" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CuerpoBorde" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF4E555D" />
            <GradientStop Offset="1" Color="#FF0A0B0D" />
        </LinearGradientBrush>

        <!-- Una tecla: goma gris muy oscura, bisel claro arriba, sombra abajo. -->
        <LinearGradientBrush x:Key="Tecla" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF3E434A" />
            <GradientStop Offset="0.45" Color="#FF2A2E33" />
            <GradientStop Offset="1" Color="#FF16181B" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TeclaPulsada" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF16181B" />
            <GradientStop Offset="1" Color="#FF383D43" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TeclaBorde" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF626A73" />
            <GradientStop Offset="1" Color="#FF08090B" />
        </LinearGradientBrush>

        <!-- Conectores y ranuras: huecos, así que la luz va al revés. -->
        <LinearGradientBrush x:Key="Hueco" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF050607" />
            <GradientStop Offset="1" Color="#FF1E2227" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CantoMetalico" StartPoint="0.15,0" EndPoint="0.85,1">
            <GradientStop Offset="0" Color="#FFB5BDC6" />
            <GradientStop Offset="0.35" Color="#FF59616A" />
            <GradientStop Offset="0.7" Color="#FF1C1F23" />
            <GradientStop Offset="1" Color="#FF6C747E" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CaraDelDial" GradientOrigin="0.32,0.24" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Offset="0" Color="#FF4C535B" />
            <GradientStop Offset="0.3" Color="#FF1A1D21" />
            <GradientStop Offset="1" Color="#FF040506" />
        </RadialGradientBrush>

        <Style x:Key="TeclaDelFrontal" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Foreground" Value="{StaticResource TeclaTexto}" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- La tecla apagada dice POR QUE lo esta: sin esto el rotulo no salia nunca. -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- La sombra que la tecla proyecta sobre el cuerpo. -->
                            <Border Background="#88000000" CornerRadius="4" Margin="0.5,2,-0.5,-2" />

                            <Border x:Name="cuerpo"
                                    Background="{StaticResource Tecla}"
                                    BorderBrush="{StaticResource TeclaBorde}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- El brillo del bisel superior. -->
                            <Border x:Name="brillo"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="4,4,0,0"
                                    Margin="3,1,3,0"
                                    VerticalAlignment="Top"
                                    Height="4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cuerpo" Property="Background" Value="#FF464C54" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cuerpo" Property="Background" Value="{StaticResource TeclaPulsada}" />
                                <Setter TargetName="brillo" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TeclaApagada}" />
                                <Setter TargetName="brillo" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!--
                Tecla ENCENDIDA (su función está puesta en la radio): el rótulo en ámbar, como el
                piloto de la tecla del equipo. Se enlaza en Tag; lo que se cambie en la propia radio
                llega por el sondeo del frontal y se ve aquí.
            -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFB23F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rótulo serigrafiado en el cuerpo. -->
        <Style x:Key="Serigrafiado" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Serigrafia}" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <!--
            Los dos arcos azules que flanquean el dial: son el indicador de VFO.
            Azul vivo el VFO que manda y azul apagado el otro, como en la radio; naranja el VFO
            por el que sale la emisión mientras se transmite (el rojo es solo del piloto BUSY/TX).
        -->
        <Style x:Key="ArcoDeVfo" TargetType="Path">
            <Setter Property="StrokeThickness" Value="6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="#FF1C3D66" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsElActivo}" Value="True">
                    <Setter Property="Stroke" Value="#FF4FA8FF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF2E8BFF" BlurRadius="14" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Transmite}" Value="True" />
                        <Condition Binding="{Binding DataContext.Transmitiendo, RelativeSource={RelativeSource AncestorType=vistas:FrontalFt710}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Stroke" Value="#FFF29A2E" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFF29A2E" BlurRadius="14" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Canvas Width="1040" Height="335">

            <!-- ══ El cuerpo ══ -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="1040" Height="335"
                    Background="{StaticResource Cuerpo}"
                    BorderBrush="{StaticResource CuerpoBorde}"
                    BorderThickness="1.5"
                    CornerRadius="12" />

            <!-- El bloque de mandos sobresale un poco del de la pantalla: su canto. -->
            <Border Canvas.Left="566" Canvas.Top="4" Width="470" Height="327"
                    CornerRadius="10"
                    BorderThickness="1.2"
                    BorderBrush="#FF3A4047"
                    Background="#08FFFFFF" />

            <!-- ══ ①–⑥ Columna izquierda ══ -->
            <!--
                ⏻LOCK como en la radio: pulsación corta = bloqueo del dial; pulsación larga (1 s) =
                encender o apagar. Sin Command: el botón tiene que poder pulsarse con la radio
                apagada para encenderla, y lo gobierna el código de detrás (AlPulsarLock…).
            -->
            <Button x:Name="TeclaLock" Canvas.Left="8" Canvas.Top="20" Width="74" Height="30"
                    Style="{StaticResource TeclaDelFrontal}"
                    IsEnabled="{Binding LockDisponible}"
                    PreviewMouseLeftButtonDown="AlPulsarLock"
                    PreviewMouseLeftButtonUp="AlSoltarLock"
                    MouseLeave="AlSalirDeLock"
                    Tag="{Binding Pilotos[Bloqueo].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.LockNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.LockAyuda}">
                <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Normal" /><Run Text="LOCK" /></TextBlock>
            </Button>

            <!-- El piloto azul de debajo de LOCK: el equipo está encendido y hablando. -->
            <Border Canvas.Left="37" Canvas.Top="57" Width="16" Height="5" CornerRadius="2"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.Piloto}"
                    ToolTip="{loc:Texto Cabina.Ft710.PilotoAyuda}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PilotoApagado}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Conectado}" Value="True">
                                <Setter Property="Background" Value="#FF3F9BFF" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF2E8BFF" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Button Canvas.Left="8" Canvas.Top="72" Width="74" Height="30"
                    Style="{StaticResource TeclaDelFrontal}"
                    Content="TUNE"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.Sintonizador}"
                    Tag="{Binding Frontal[Sintonizador].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.TuneNombre}"
                    AutomationProperties.HelpText="{loc:Texto Cabina.Ft710.TuneDescripcion}"
                    ToolTip="{loc:Texto Cabina.Ft710.TuneAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding SintonizarAcopladorCommand}" />
                </Button.InputBindings>
            </Button>

            <!-- El piloto del acoplador, debajo de TUNE: encendido con el acoplador en línea. -->
            <Border Canvas.Left="40" Canvas.Top="108" Width="10" Height="4" CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Hueco}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Frontal[Sintonizador].Encendido, FallbackValue=False, TargetNullValue=False}" Value="True">
                                <Setter Property="Background" Value="#FFFFB23F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Button Canvas.Left="8" Canvas.Top="118" Width="74" Height="30"
                    Style="{StaticResource TeclaDelFrontal}"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.Vox}"
                    Tag="{Binding Frontal[Vox].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.VoxNombre}"
                    AutomationProperties.HelpText="{loc:Texto Cabina.Ft710.VoxDescripcion}"
                    ToolTip="{loc:Texto Cabina.Ft710.VoxAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding MoxCommand}" />
                </Button.InputBindings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="VOX" VerticalAlignment="Center" />
                    <Border CornerRadius="1.5" Padding="1.5,0" Margin="1,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF9AA3AD" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnMox}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RojoTx}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="MOX" Foreground="#FF16181B" FontSize="12" />
                    </Border>
                </StackPanel>
            </Button>

            <TextBlock Canvas.Left="6" Canvas.Top="158" Width="80" Style="{StaticResource Serigrafiado}" FontSize="13">
                <Run Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" /><Run Text="PHONES" />
            </TextBlock>

            <!-- La toma de auriculares: tuerca y agujero. -->
            <Grid Canvas.Left="22" Canvas.Top="176" Width="50" Height="50"
                  AutomationProperties.Name="{loc:Texto Cabina.Ft710.PhonesNombre}"
                  ToolTip="{loc:Texto Cabina.Frontal.Phones}">
                <Ellipse Fill="{StaticResource Hueco}" Stroke="#FF0A0B0D" StrokeThickness="1" />
                <Ellipse Margin="6" Stroke="{StaticResource CantoMetalico}" StrokeThickness="4" Fill="#FF15171A" />
                <Ellipse Margin="16" Fill="#FF020203" Stroke="#FF3A4047" StrokeThickness="1" />
            </Grid>

            <TextBlock Canvas.Left="10" Canvas.Top="232" Style="{StaticResource Serigrafiado}" FontSize="13">
                <Run Text="◗" FontSize="11" /><Run Text=" MIC" />
            </TextBlock>

            <!-- El conector de micrófono. -->
            <Grid Canvas.Left="16" Canvas.Top="250" Width="62" Height="62"
                  AutomationProperties.Name="{loc:Texto Cabina.Ft710.MicNombre}"
                  ToolTip="{loc:Texto Cabina.Frontal.Mic}">
                <Ellipse Fill="{StaticResource Hueco}" />
                <Ellipse Margin="5" Stroke="{StaticResource CantoMetalico}" StrokeThickness="4" Fill="#FF0D0F11" />
                <Ellipse Margin="14" Fill="#FF050607" Stroke="#FF2E3339" StrokeThickness="1" />
                <UniformGrid Rows="2" Columns="4" Width="20" Height="10">
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                    <Ellipse Width="2.5" Height="2.5" Fill="#FF8C949D" />
                </UniformGrid>
            </Grid>

            <!-- ══ La pantalla, hundida en su marco ══ -->
            <TextBlock Canvas.Left="120" Canvas.Top="3" Text="YAESU"
                       Foreground="#FFB08A45" FontFamily="Arial Black, Arial" FontSize="17" FontStyle="Italic"
                       FontWeight="Black" TextTrimming="None" />
            <TextBlock Canvas.Left="326" Canvas.Top="9" Text="HF/50MHz TRANSCEIVER"
                       Foreground="#FF7E868F" FontFamily="Arial" FontSize="10" FontWeight="Bold"
                       FontStyle="Italic" TextTrimming="None" />
            <TextBlock Canvas.Left="470" Canvas.Top="2" Text="FT-710"
                       Foreground="{StaticResource Dorado}" FontFamily="Arial" FontSize="18" FontStyle="Italic"
                       FontWeight="Bold" TextTrimming="None" />

            <Border Canvas.Left="100" Canvas.Top="26" Width="458" Height="292"
                    CornerRadius="6"
                    Background="#FF08090A"
                    BorderBrush="#FF3A3F46"
                    BorderThickness="1.2" />

            <vistas:VisorDeVfos x:Name="Visor" Canvas.Left="114" Canvas.Top="40" Width="430" Height="244"
                                RotuloDelAnalizador="{Binding DataContext.Analizador.RotuloEnPantalla, RelativeSource={RelativeSource AncestorType=Window}}"
                                AnchoDelAnalizadorHz="{Binding DataContext.Analizador.SpanHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                InicioFijoDelAnalizadorHz="{Binding DataContext.Analizador.InicioFijoHz, RelativeSource={RelativeSource AncestorType=Window}}"
                                AnalizadorAmpliado="{Binding DataContext.Analizador.Ampliado, RelativeSource={RelativeSource AncestorType=Window}}">
                <!-- El analizador de la propia radio (docs/14-espectro-ft710.md), no el del audio. -->
                <vistas:VisorDeVfos.ContenidoDelAnalizador>
                    <vistas:AnalizadorDelEquipo DataContext="{Binding DataContext.Analizador, RelativeSource={RelativeSource AncestorType=Window}}" />
                </vistas:VisorDeVfos.ContenidoDelAnalizador>
            </vistas:VisorDeVfos>

            <!-- ══ ㉑–㉕ Fila de arriba, en el canto ══ -->
            <Border Canvas.Left="596" Canvas.Top="0" Width="376" Height="24"
                    CornerRadius="0,0,6,6" Background="#FF0C0D0F" />

            <Button Canvas.Left="604" Canvas.Top="2" Width="66" Height="19"
                    Style="{StaticResource TeclaDelFrontal}" Content="MODE" FontSize="12"
                    Command="{Binding SiguienteModoCommand}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.ModeNombre}"
                    ToolTip="{loc:Texto Cabina.Frontal.Mode}" />
            <Button Canvas.Left="676" Canvas.Top="2" Width="66" Height="19"
                    Style="{StaticResource TeclaDelFrontal}" FontSize="12"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.AjusteACero}"
                    Tag="{Binding Pilotos[TonoDeReferenciaCw].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.ZinNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.ZinAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding AlternarMandoCommand}" CommandParameter="{x:Static puertos:MandoDeEquipo.TonoDeReferenciaCw}" />
                </Button.InputBindings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ZIN" VerticalAlignment="Center" />
                    <Border Background="#FF7E8791" CornerRadius="1.5" Padding="1,0" Margin="1,0,0,0">
                        <TextBlock Text="SPOT" Foreground="#FF16181B" FontSize="11" />
                    </Border>
                </StackPanel>
            </Button>
            <Button Canvas.Left="748" Canvas.Top="2" Width="66" Height="19"
                    Style="{StaticResource TeclaDelFrontal}" Content="SPLIT" FontSize="12"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.Split}"
                    Tag="{Binding Frontal[Split].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.SplitNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.SplitAyuda}" />
            <Button x:Name="TeclaClar" Canvas.Left="820" Canvas.Top="2" Width="66" Height="19"
                    Style="{StaticResource TeclaDelFrontal}" Content="CLAR" FontSize="12"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.Rit}"
                    Tag="{Binding Frontal[Rit].Encendido, FallbackValue=False, TargetNullValue=False}"
                    MouseWheel="AlGirarSobreClar"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.ClarNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.ClarAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.BorrarClarificador}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="892" Canvas.Top="2" Width="66" Height="19"
                    Style="{StaticResource TeclaDelFrontal}" Content="NB" FontSize="12"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.SupresorDeRuido}"
                    Tag="{Binding Frontal[SupresorDeRuido].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.NbNombre}"
                    ToolTip="{loc:Texto Cabina.Frontal.Nb}" />

            <!-- ══ ⑫⑬⑭ Segunda fila, en su canal ══ -->
            <Border Canvas.Left="588" Canvas.Top="26" Width="426" Height="38"
                    CornerRadius="8" Background="#FF0A0B0D"
                    BorderBrush="#FF30353B" BorderThickness="1" />

            <Button Canvas.Left="596" Canvas.Top="30" Width="76" Height="29"
                    Style="{StaticResource TeclaDelFrontal}" Content="M▶V"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.MemoriaAVfo}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.MaVNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.MaVAyuda}" />
            <Button Canvas.Left="678" Canvas.Top="30" Width="76" Height="29"
                    Style="{StaticResource TeclaDelFrontal}"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.VfoOMemoria}"
                    Tag="{Binding EnMemoria}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.VMNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.VMAyuda}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="V/M" VerticalAlignment="Center" />
                    <Border Background="#FF9AA3AD" CornerRadius="3" Width="10" Height="10" Margin="2,0,0,0">
                        <TextBlock Text="W" Foreground="#FF16181B" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>
            <Button Canvas.Left="760" Canvas.Top="30" Width="76" Height="29"
                    Style="{StaticResource TeclaDelFrontal}" Content="A/B"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.AlternarVfo}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.ABNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.ABAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding IgualarVfosCommand}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="842" Canvas.Top="30" Width="76" Height="29"
                    Style="{StaticResource TeclaDelFrontal}" Content="BAND"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.BandaArriba}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.BandNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.BandAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.BandaAbajo}" />
                </Button.InputBindings>
            </Button>
            <Button Canvas.Left="924" Canvas.Top="30" Width="76" Height="29"
                    Style="{StaticResource TeclaDelFrontal}" Content="QMB"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.RecuperarMemoriaRapida}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.QmbNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.QmbAyuda}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding PulsarTeclaCommand}" CommandParameter="{x:Static puertos:TeclaDelEquipo.GuardarMemoriaRapida}" />
                </Button.InputBindings>
            </Button>

            <!-- ══ ⑪ DNR · ⑯ BUSY/TX · ⑰ NAR ══ -->
            <Button Canvas.Left="652" Canvas.Top="68" Width="96" Height="30"
                    Style="{StaticResource TeclaDelFrontal}" Content="DNR"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.ReductorDeRuido}"
                    Tag="{Binding Frontal[ReductorDeRuido].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.DnrNombre}"
                    ToolTip="{loc:Texto Cabina.Frontal.Dnr}" />

            <TextBlock Canvas.Left="769" Canvas.Top="68" Width="80" Text="BUSY/TX" Style="{StaticResource Serigrafiado}" FontSize="12" />
            <Border Canvas.Left="804" Canvas.Top="82" Width="10" Height="9" CornerRadius="1.5"
                    BorderBrush="#FF0A0B0D" BorderThickness="1"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.BusyNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.BusyAyuda}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF3A3F46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Transmitiendo}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RojoTx}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFE2352B" BlurRadius="12" ShadowDepth="0" Opacity="1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Button Canvas.Left="850" Canvas.Top="68" Width="96" Height="30"
                    Style="{StaticResource TeclaDelFrontal}" Content="NAR"
                    Command="{Binding AlternarMandoCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.FiltroEstrecho}"
                    Tag="{Binding Pilotos[FiltroEstrecho].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.NarNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.NarAyuda}" />

            <!-- ══ ⑨ FUNC · STEP/MCH-DSP ══ -->
            <TextBlock Canvas.Left="576" Canvas.Top="76" Width="72" Text="FUNC" Style="{StaticResource Serigrafiado}" />
            <vistas:MandoGiratorio Canvas.Left="570" Canvas.Top="92" Width="84" Height="84"
                                   Rotulo="FUNC"
                                   Explicacion="{loc:Texto Cabina.Explica.Func}"
                                   Mando="{Binding MandoDelFunc}"
                                   AlPulsar="{Binding CambiarFuncionCommand}" ParametroAlPulsar="FUNC+"
                                   AlPulsarDerecho="{Binding CambiarFuncionCommand}" ParametroAlPulsarDerecho="FUNC-" />
            <TextBlock Canvas.Left="562" Canvas.Top="178" Width="100" Text="{Binding RotuloDelFunc}"
                       Style="{StaticResource Serigrafiado}" FontSize="11" Foreground="#FFFFB23F"
                       ToolTip="{loc:Texto Cabina.Ft710.FuncAyuda}" />

            <TextBlock Canvas.Left="566" Canvas.Top="196" Width="84" Text="STEP/MCH" Style="{StaticResource Serigrafiado}" />
            <Border Canvas.Left="590" Canvas.Top="211" Width="36" Height="13" CornerRadius="2"
                    BorderBrush="{StaticResource Serigrafia}" BorderThickness="1">
                <TextBlock Text="DSP" Style="{StaticResource Serigrafiado}" FontSize="11" VerticalAlignment="Center" />
            </Border>
            <vistas:MandoGiratorio x:Name="MandoDePasos" Canvas.Left="570" Canvas.Top="240" Width="84" Height="84"
                                   Rotulo="STEP/MCH · DSP"
                                   Explicacion="{loc:Texto Cabina.Explica.StepDsp}"
                                   GiroLibre="True"
                                   Girado="AlGirarLosPasos"
                                   MandoInterior="{Binding MandoDelDsp}"
                                   AlPulsar="{Binding CambiarFuncionCommand}" ParametroAlPulsar="DSP+"
                                   AlPulsarDerecho="{Binding CambiarFuncionCommand}" ParametroAlPulsarDerecho="DSP-" />
            <TextBlock Canvas.Left="562" Canvas.Top="323" Width="100" Text="{Binding RotuloDelDsp}"
                       Style="{StaticResource Serigrafiado}" FontSize="11" Foreground="#FFFFB23F"
                       ToolTip="{loc:Texto Cabina.Ft710.DspAyuda}" />

            <!-- ══ ⑲ RF GAIN/SQL · ⑳ AF GAIN ══ -->
            <TextBlock Canvas.Left="948" Canvas.Top="77" Width="84" Text="RF GAIN/SQL" Style="{StaticResource Serigrafiado}" FontSize="11" FontStyle="Italic" />
            <vistas:MandoGiratorio Canvas.Left="946" Canvas.Top="92" Width="84" Height="84"
                                   Rotulo="RF GAIN/SQL"
                                   Explicacion="{loc:Texto Cabina.Explica.RfSql}"
                                   Mando="{Binding MandoDeGananciaRf}"
                                   MandoInterior="{Binding Frontal[Silenciador]}" />

            <TextBlock Canvas.Left="946" Canvas.Top="222" Width="84" Text="AF GAIN" Style="{StaticResource Serigrafiado}" />
            <vistas:MandoGiratorio Canvas.Left="946" Canvas.Top="240" Width="84" Height="84"
                                   Rotulo="AF GAIN"
                                   Explicacion="{loc:Texto Cabina.Explica.Volumen}"
                                   Mando="{Binding MandoDeVolumen}" />

            <!-- ══ ⑮ Los dos arcos azules del indicador de VFO ══ -->
            <Path DataContext="{Binding A}" Style="{StaticResource ArcoDeVfo}"
                  Data="M 684,152 A 140,140 0 0 0 684,272"
                  AutomationProperties.Name="{loc:Texto Cabina.Ft710.IndicadorVfoA}"
                  ToolTip="{loc:Texto Cabina.Ft710.IndicadorVfoA}" />
            <Path DataContext="{Binding B}" Style="{StaticResource ArcoDeVfo}"
                  Data="M 934,152 A 140,140 0 0 1 934,272"
                  AutomationProperties.Name="{loc:Texto Cabina.Ft710.IndicadorVfoB}"
                  ToolTip="{loc:Texto Cabina.Ft710.IndicadorVfoB}" />

            <!--
                ⑦ EL DIAL MANDA. En la radio es el mando más grande con diferencia y lo primero
                que se ve: aro metálico, canto estriado muy ancho y la cara negra de espejo con
                la hendidura para el dedo.
            -->
            <Grid Canvas.Left="696" Canvas.Top="100" Width="222" Height="222"
                  Background="Transparent" Focusable="True"
                  MouseWheel="AlGirarElDial" PreviewKeyDown="AlTeclearElDial"
                  ToolTip="{loc:Texto Cabina.Ft710.DialAyuda}"
                  AutomationProperties.Name="{loc:Texto Cabina.Frontal.DialPrincipal}">
                <Ellipse Fill="#90000000" Margin="3,6,-3,-6" />
                <Ellipse Fill="#FF0B0C0E" />
                <!-- El canto estriado, ancho, en diamante. -->
                <Ellipse Margin="3" Stroke="{StaticResource CantoMetalico}" StrokeThickness="26" Opacity="0.8" />
                <Ellipse Margin="3" Stroke="#FF08090A" StrokeThickness="26"
                         StrokeDashArray="0.07 0.07" Opacity="0.75" />
                <Ellipse Margin="10" Stroke="#FF08090A" StrokeThickness="12"
                         StrokeDashArray="0.14 0.14" StrokeDashOffset="0.07" Opacity="0.6" />
                <!-- El aro de metal pulido que separa el canto de la cara. -->
                <Ellipse Margin="29" Stroke="{StaticResource CantoMetalico}" StrokeThickness="3.5" />
                <!-- La cara, negra de espejo con el reflejo arriba a la izquierda. -->
                <Ellipse Margin="32" Fill="{StaticResource CaraDelDial}" />
                <Path Margin="40" Stretch="Fill" Opacity="0.35" Width="60" Height="80"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="M 30,0 C 10,10 0,40 8,80 C 12,40 20,20 60,5 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#90FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- La hendidura para el dedo, abajo a la derecha como en la foto. -->
                <Ellipse Width="52" Height="52" Margin="72,56,0,0"
                         Stroke="#FF020304" StrokeThickness="1.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.62,0.75" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Offset="0" Color="#FF30353B" />
                            <GradientStop Offset="1" Color="#FF030405" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ══ ⑩ DSP RESET · ⑱ FINE/FAST ══ -->
            <Button Canvas.Left="660" Canvas.Top="298" Width="62" Height="30"
                    Style="{StaticResource TeclaDelFrontal}" FontSize="12"
                    Command="{Binding PulsarTeclaCommand}"
                    CommandParameter="{x:Static puertos:TeclaDelEquipo.RestablecerDsp}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.DspResetNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.DspResetAyuda}">
                <TextBlock Text="DSP&#x0a;RESET" TextAlignment="Center" LineHeight="12" LineStackingStrategy="BlockLineHeight" />
            </Button>
            <Button Canvas.Left="880" Canvas.Top="298" Width="62" Height="30"
                    Style="{StaticResource TeclaDelFrontal}" FontSize="12"
                    Command="{Binding SiguientePosicionCommand}"
                    CommandParameter="{x:Static puertos:MandoDeEquipo.SintoniaFinaRapida}"
                    Tag="{Binding Pilotos[SintoniaFinaRapida].Encendido, FallbackValue=False, TargetNullValue=False}"
                    AutomationProperties.Name="{loc:Texto Cabina.Ft710.FineFastNombre}"
                    ToolTip="{loc:Texto Cabina.Ft710.FineFastAyuda}">
                <TextBlock Text="FINE&#x0a;/FAST" TextAlignment="Center" LineHeight="12" LineStackingStrategy="BlockLineHeight" />
            </Button>

        </Canvas>
    </Viewbox>
</UserControl>
