<UserControl x:Class="Nodisla.Cuaderno.Ui.Vistas.PanelDeAyuda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vistas="clr-namespace:Nodisla.Cuaderno.Ui.Vistas"
             xmlns:vistamodelos="clr-namespace:Nodisla.Cuaderno.Ui.VistaModelos"
             xmlns:loc="clr-namespace:Nodisla.Cuaderno.Ui.Idiomas"
             Foreground="{DynamicResource Texto}">

    <!--
        LA AYUDA. DataContext: VistaModeloAyuda.

        A la izquierda, el buscador y el índice de capítulos (los docs/ayuda/*.md, incrustados al
        compilar) y, debajo, lo que no es un capítulo: Reportar un fallo, Buscar actualizaciones
        y Acerca de. A la derecha, el capítulo abierto en un FlowDocument, con sus capturas.

        Ni navegador ni dependencias: el Markdown lo lee DocumentoMarkdown y lo pinta
        ConstructorDeLaAyuda.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisible" />

        <!-- Reportar un fallo se pinta por el TIPO: con el modelo nulo no se monta nada. -->
        <DataTemplate DataType="{x:Type vistamodelos:VistaModeloReportarFallo}">
            <vistas:ReportarFallo MinWidth="620" />
        </DataTemplate>

        <Style x:Key="BotonDeLaAyuda" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ Índice ══ -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:Texto Ayuda.BuscarEnLaAyuda}" Style="{StaticResource EtiquetaDeCampo}" />
                    <TextBox x:Name="CampoDeBusqueda"
                             Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="{loc:Texto Ayuda.BuscarTooltip}"
                             AutomationProperties.Name="{loc:Texto Ayuda.BuscarEnLaAyuda}" />
                    <TextBlock Text="{Binding ResultadoDeLaBusqueda}"
                               Style="{StaticResource TextoTenueEstilo}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{loc:Texto Ayuda.Capitulos}" Style="{StaticResource EtiquetaDeCampo}" Margin="0,10,0,2" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Border Height="1" Background="{DynamicResource BordeSuave}" Margin="0,0,0,10" />
                    <Button Style="{StaticResource BotonDeLaAyuda}"
                            Command="{Binding ReportarUnFalloCommand}"
                            Visibility="{Binding SePuedeReportar, Converter={StaticResource BooleanoAVisible}}"
                            ToolTip="{loc:Texto Ayuda.ReportarTooltip}"
                            AutomationProperties.Name="{loc:Texto Ayuda.ReportarUnFallo}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconoAyuda}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:Texto Ayuda.ReportarUnFallo}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Visibility="{Binding HayActualizaciones, Converter={StaticResource BooleanoAVisible}}">
                    <StackPanel DataContext="{Binding Actualizaciones}">
                        <Button Style="{StaticResource BotonDeLaAyuda}"
                                Command="{Binding BuscarActualizacionesCommand}"
                                ToolTip="{loc:Texto Ayuda.BuscarActualizacionesTooltip}"
                                AutomationProperties.Name="{loc:Texto Ayuda.BuscarActualizaciones}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconoAjustes}" Width="14" Height="14" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Texto Ayuda.BuscarActualizaciones}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Estado}"
                                   Style="{StaticResource TextoTenueEstilo}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,6" />
                    </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource BotonDeLaAyuda}"
                            Command="{Binding VerAcercaDeCommand}"
                            ToolTip="{loc:Texto Ayuda.AcercaDeTooltip}"
                            AutomationProperties.Name="{loc:Texto Ayuda.AcercaDeCuaderno}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource MarcaDelCuaderno}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:Texto Ayuda.AcercaDe}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox x:Name="Indice"
                         ItemsSource="{Binding CapitulosVisibles}"
                         SelectedItem="{Binding CapituloElegido}"
                         DisplayMemberPath="Titulo"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Texto}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Texto Ayuda.IndiceDeCapitulos}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,4" />
                            <Setter Property="ToolTip" Value="{Binding Titulo}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Lo que se lee ══ -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <Grid>
                <FlowDocumentScrollViewer x:Name="Lector"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          Focusable="True"
                                          Visibility="{Binding VerCapitulo, Converter={StaticResource BooleanoAVisible}}"
                                          AutomationProperties.Name="{loc:Texto Ayuda.CapituloDeLaAyuda}" />

                <DockPanel Visibility="{Binding VerReporte, Converter={StaticResource BooleanoAVisible}}" Margin="14,10">
                    <Button DockPanel.Dock="Top"
                            HorizontalAlignment="Right"
                            Content="{loc:Texto Ayuda.VolverALaAyuda}"
                            Command="{Binding VolverAlCapituloCommand}"
                            Padding="10,3"
                            Margin="0,0,0,2" />
                    <!-- Sin desplazamiento horizontal: con él, el formulario crecía sin fin y no partía las líneas. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding ReporteDeFallo}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>

                <ScrollViewer Visibility="{Binding VerAcerca, Converter={StaticResource BooleanoAVisible}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="{StaticResource MarcaDelCuaderno}" Width="56" Height="56" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Texto Comun.NombreDelPrograma}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Acento}" />
                                <TextBlock Style="{StaticResource TextoTenueEstilo}">
                                    <Run Text="{loc:Texto Ayuda.Version}" />
                                    <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{loc:Texto Ayuda.Descripcion}" />

                        <TextBlock Text="{loc:Texto Ayuda.Licencia}" Style="{StaticResource EtiquetaDeCampo}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="{Binding TextoDeLicencia, Mode=OneWay}" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="{loc:Texto Ayuda.SoftwareLibre}" />
                        </TextBlock>

                        <TextBlock Text="{loc:Texto Ayuda.CodigoFuente}" Style="{StaticResource EtiquetaDeCampo}" />
                        <TextBlock Margin="0,0,0,10">
                            <Hyperlink Command="{Binding AbrirElRepositorioCommand}" Foreground="{DynamicResource Acento}">
                                <Run Text="{Binding Repositorio, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="{loc:Texto Ayuda.Contacto}" Style="{StaticResource EtiquetaDeCampo}" />
                        <TextBlock Margin="0,0,0,10">
                            <Hyperlink Command="{Binding EscribirUnCorreoCommand}" Foreground="{DynamicResource Acento}">
                                <Run Text="{Binding Correo, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Style="{StaticResource TextoTenueEstilo}" TextWrapping="Wrap"
                                   Text="{loc:Texto Ayuda.MejorReportar}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
