<Application x:Class="Nodisla.Cuaderno.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- El primer diccionario es el tema; se sustituye entero al cambiar de tema. -->
                <ResourceDictionary Source="Recursos/Tema.Claro.xaml" />
                <ResourceDictionary Source="Recursos/Estilos.xaml" />
                <ResourceDictionary Source="Recursos/Estilos.Operacion.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
