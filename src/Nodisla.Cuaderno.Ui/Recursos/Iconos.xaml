<!--
    LOS ICONOS DEL CUADERNO, DIBUJADOS DE CERO.

    Son trazados vectoriales propios: ni los de Log4OM, ni los de ninguna biblioteca de la que
    haya que leerse la licencia. Se dibujan sobre una rejilla de 24 × 24 y cada uno lleva su
    color, porque un icono en color se distingue de reojo y una silueta gris no: en una fila de
    seis siluetas grises hay que leer el rótulo, y entonces el icono no ha servido de nada.

    Los colores son FIJOS y no siguen al tema. Un icono que cambia de color con el tema deja de
    ser reconocible, que es lo único que un icono tiene que hacer.

    La paleta es corta a propósito —seis tonos— y cada uno significa algo:
      · azul       el equipo y la radio
      · verde      lo que está en el aire ahora: el cluster, los anuncios
      · naranja    lo que se registra: el cuaderno, los contactos
      · violeta    el mundo: mapa, entidades, trayectos
      · dorado     los diplomas, que es lo que se gana
      · gris azul  las herramientas: ajustes, buscar
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── La paleta ─────────────────────────────────────────────────────── -->
    <Color x:Key="IconoAzulColor">#FF4AA3F0</Color>
    <Color x:Key="IconoVerdeColor">#FF4CC98A</Color>
    <Color x:Key="IconoNaranjaColor">#FFF0964A</Color>
    <Color x:Key="IconoVioletaColor">#FFA98BF0</Color>
    <Color x:Key="IconoDoradoColor">#FFE8C24A</Color>
    <Color x:Key="IconoGrisColor">#FF8FA3B8</Color>

    <SolidColorBrush x:Key="IconoAzul" Color="{StaticResource IconoAzulColor}" />
    <SolidColorBrush x:Key="IconoVerde" Color="{StaticResource IconoVerdeColor}" />
    <SolidColorBrush x:Key="IconoNaranja" Color="{StaticResource IconoNaranjaColor}" />
    <SolidColorBrush x:Key="IconoVioleta" Color="{StaticResource IconoVioletaColor}" />
    <SolidColorBrush x:Key="IconoDorado" Color="{StaticResource IconoDoradoColor}" />
    <SolidColorBrush x:Key="IconoGris" Color="{StaticResource IconoGrisColor}" />

    <!--
        ══ OPERAR: un equipo de radio ══
        Caja con su visor, su dial a la derecha y dos teclas. Es el frontal que ya dibujamos,
        reducido a lo que se reconoce a dieciséis puntos.
    -->
    <DrawingImage x:Key="IconoOperar">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- El cuerpo -->
                <DrawingGroup Opacity="0.28"><GeometryDrawing Brush="{StaticResource IconoAzul}"
                                 Geometry="M 2,6 L 22,6 A 1.5,1.5 0 0 1 23.5,7.5 L 23.5,17.5 A 1.5,1.5 0 0 1 22,19 L 2,19 A 1.5,1.5 0 0 1 0.5,17.5 L 0.5,7.5 A 1.5,1.5 0 0 1 2,6 Z" /></DrawingGroup>
                <GeometryDrawing Geometry="M 2,6 L 22,6 A 1.5,1.5 0 0 1 23.5,7.5 L 23.5,17.5 A 1.5,1.5 0 0 1 22,19 L 2,19 A 1.5,1.5 0 0 1 0.5,17.5 L 0.5,7.5 A 1.5,1.5 0 0 1 2,6 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoAzul}" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- El visor -->
                <GeometryDrawing Brush="{StaticResource IconoAzul}" Geometry="M 3,8.5 L 13,8.5 L 13,13 L 3,13 Z" />
                <!-- El dial -->
                <GeometryDrawing Geometry="M 18.5,12.5 m -3.2,0 a 3.2,3.2 0 1 0 6.4,0 a 3.2,3.2 0 1 0 -6.4,0">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoAzul}" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Dos teclas -->
                <GeometryDrawing Brush="{StaticResource IconoAzul}" Geometry="M 3,15 L 6.5,15 L 6.5,16.6 L 3,16.6 Z" />
                <GeometryDrawing Brush="{StaticResource IconoAzul}" Geometry="M 8,15 L 11.5,15 L 11.5,16.6 L 8,16.6 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ DIGITAL: una onda con sus tonos ══
        Tres barras de distinta altura y una onda encima: es lo que se ve en una cascada.
    -->
    <DrawingImage x:Key="IconoDigital">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 3,14 L 6,14 L 6,20 L 3,20 Z" />
                <DrawingGroup Opacity="0.75"><GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 8,9 L 11,9 L 11,20 L 8,20 Z" /></DrawingGroup>
                <DrawingGroup Opacity="0.55"><GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 13,12 L 16,12 L 16,20 L 13,20 Z" /></DrawingGroup>
                <GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 18,6 L 21,6 L 21,20 L 18,20 Z" />
                <GeometryDrawing Geometry="M 2,4.5 C 6,1.5 8,7 12,4 C 16,1 18,6.5 22,3.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoVerde}" Thickness="1.5" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ CUADERNO: un libro abierto con su renglón ══
    -->
    <DrawingImage x:Key="IconoCuaderno">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup Opacity="0.25"><GeometryDrawing Brush="{StaticResource IconoNaranja}"
                                 Geometry="M 2,4 L 11,4 L 11,20 L 2,20 Z" /></DrawingGroup>
                <DrawingGroup Opacity="0.25"><GeometryDrawing Brush="{StaticResource IconoNaranja}"
                                 Geometry="M 13,4 L 22,4 L 22,20 L 13,20 Z" /></DrawingGroup>
                <GeometryDrawing Geometry="M 2,4 L 11,4 L 11,20 L 2,20 Z M 13,4 L 22,4 L 22,20 L 13,20 Z M 12,4.5 L 12,20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoNaranja}" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Los renglones -->
                <GeometryDrawing Brush="{StaticResource IconoNaranja}" Geometry="M 4,7.5 L 9,7.5 L 9,8.7 L 4,8.7 Z" />
                <GeometryDrawing Brush="{StaticResource IconoNaranja}" Geometry="M 4,11 L 9,11 L 9,12.2 L 4,12.2 Z" />
                <GeometryDrawing Brush="{StaticResource IconoNaranja}" Geometry="M 15,7.5 L 20,7.5 L 20,8.7 L 15,8.7 Z" />
                <GeometryDrawing Brush="{StaticResource IconoNaranja}" Geometry="M 15,11 L 20,11 L 20,12.2 L 15,12.2 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ MAPA: el globo con sus meridianos ══
    -->
    <DrawingImage x:Key="IconoMapa">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup Opacity="0.22"><GeometryDrawing Brush="{StaticResource IconoVioleta}"
                                 Geometry="M 12,12 m -9.5,0 a 9.5,9.5 0 1 0 19,0 a 9.5,9.5 0 1 0 -19,0" /></DrawingGroup>
                <GeometryDrawing Geometry="M 12,12 m -9.5,0 a 9.5,9.5 0 1 0 19,0 a 9.5,9.5 0 1 0 -19,0 M 2.5,12 L 21.5,12 M 12,2.5 C 7,6 7,18 12,21.5 M 12,2.5 C 17,6 17,18 12,21.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoVioleta}" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ DIPLOMAS: una copa ══
    -->
    <DrawingImage x:Key="IconoDiplomas">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup Opacity="0.35"><GeometryDrawing Brush="{StaticResource IconoDorado}"
                                 Geometry="M 7,3 L 17,3 L 17,9 A 5,5 0 0 1 7,9 Z" /></DrawingGroup>
                <GeometryDrawing Geometry="M 7,3 L 17,3 L 17,9 A 5,5 0 0 1 7,9 Z M 7,4.5 L 4,4.5 L 4,7 A 3,3 0 0 0 7,10 M 17,4.5 L 20,4.5 L 20,7 A 3,3 0 0 1 17,10 M 12,14 L 12,17 M 8.5,20.5 L 15.5,20.5 M 9.5,17.5 L 14.5,17.5 L 15.5,20.5 L 8.5,20.5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoDorado}" Thickness="1.4" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ AJUSTES: una rueda dentada ══
    -->
    <DrawingImage x:Key="IconoAjustes">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup Opacity="0.3"><GeometryDrawing Brush="{StaticResource IconoGris}"
                                 Geometry="M 10.6,2 L 13.4,2 L 13.9,4.6 L 16.2,5.6 L 18.4,4.1 L 20.4,6.1 L 18.9,8.3 L 19.9,10.6 L 22.5,11.1 L 22.5,13.9 L 19.9,14.4 L 18.9,16.7 L 20.4,18.9 L 18.4,20.9 L 16.2,19.4 L 13.9,20.4 L 13.4,23 L 10.6,23 L 10.1,20.4 L 7.8,19.4 L 5.6,20.9 L 3.6,18.9 L 5.1,16.7 L 4.1,14.4 L 1.5,13.9 L 1.5,11.1 L 4.1,10.6 L 5.1,8.3 L 3.6,6.1 L 5.6,4.1 L 7.8,5.6 L 10.1,4.6 Z" /></DrawingGroup>
                <GeometryDrawing Geometry="M 10.6,2 L 13.4,2 L 13.9,4.6 L 16.2,5.6 L 18.4,4.1 L 20.4,6.1 L 18.9,8.3 L 19.9,10.6 L 22.5,11.1 L 22.5,13.9 L 19.9,14.4 L 18.9,16.7 L 20.4,18.9 L 18.4,20.9 L 16.2,19.4 L 13.9,20.4 L 13.4,23 L 10.6,23 L 10.1,20.4 L 7.8,19.4 L 5.6,20.9 L 3.6,18.9 L 5.1,16.7 L 4.1,14.4 L 1.5,13.9 L 1.5,11.1 L 4.1,10.6 L 5.1,8.3 L 3.6,6.1 L 5.6,4.1 L 7.8,5.6 L 10.1,4.6 Z M 12,12 m -3.2,0 a 3.2,3.2 0 1 0 6.4,0 a 3.2,3.2 0 1 0 -6.4,0">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoGris}" Thickness="1.3" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ══ BANDMAP: la escala de frecuencia con sus anuncios ══
        Una regla vertical con sus marcas y tres puntos a distinta altura.
    -->
    <DrawingImage x:Key="IconoBandmap">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 7,2.5 L 7,21.5 M 7,5 L 11,5 M 7,9 L 10,9 M 7,13 L 11,13 M 7,17 L 10,17 M 7,21 L 11,21">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconoVerde}" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 14,4.2 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0" />
                <GeometryDrawing Brush="{StaticResource IconoNaranja}" Geometry="M 17,11 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0" />
                <DrawingGroup Opacity="0.6"><GeometryDrawing Brush="{StaticResource IconoVerde}" Geometry="M 13,18 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0" /></DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
