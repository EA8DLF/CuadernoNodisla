<!-- Paleta del tema claro. El tema oscuro define exactamente las mismas claves. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- El cromo del tema claro: gris suave, no negro. Mismas claves que el oscuro. -->
    <SolidColorBrush x:Key="FondoCromo" Color="#FFE4E9F0" />
    <SolidColorBrush x:Key="TextoCromo" Color="#FF1B2430" />
    <SolidColorBrush x:Key="BordeCromo" Color="#FFC3CCD8" />

    <SolidColorBrush x:Key="FondoVentana" Color="#FFF4F5F7" />
    <SolidColorBrush x:Key="FondoPanel" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FondoCampo" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FondoCabecera" Color="#FFE7EAF0" />
    <SolidColorBrush x:Key="FondoAlterno" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="FondoResalte" Color="#FFDDE3EC" />

    <SolidColorBrush x:Key="Texto" Color="#FF16202E" />
    <SolidColorBrush x:Key="TextoTenue" Color="#FF5B6878" />
    <SolidColorBrush x:Key="TextoSobreAcento" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Borde" Color="#FFC4CCD8" />
    <SolidColorBrush x:Key="BordeSuave" Color="#FFE1E6ED" />

    <SolidColorBrush x:Key="Acento" Color="#FF0F5FA8" />
    <SolidColorBrush x:Key="AcentoSuave" Color="#FF3B82C4" />

    <SolidColorBrush x:Key="SeleccionFondo" Color="#FFCFE3F7" />
    <SolidColorBrush x:Key="SeleccionTexto" Color="#FF0B2540" />

    <SolidColorBrush x:Key="AvisoFondo" Color="#FFFFF3CD" />
    <SolidColorBrush x:Key="AvisoBorde" Color="#FFE0B44A" />
    <SolidColorBrush x:Key="AvisoTexto" Color="#FF6B4D06" />

    <SolidColorBrush x:Key="ErrorFondo" Color="#FFFBE0E0" />
    <SolidColorBrush x:Key="ErrorBorde" Color="#FFD26060" />
    <SolidColorBrush x:Key="ErrorTexto" Color="#FF8A1A1A" />

    <SolidColorBrush x:Key="CorrectoFondo" Color="#FFDFF3E4" />
    <SolidColorBrush x:Key="CorrectoBorde" Color="#FF5AAE73" />
    <SolidColorBrush x:Key="CorrectoTexto" Color="#FF14562A" />

    <!--
        ── El libro de contactos ──────────────────────────────────────────────
        Igual en los DOS temas, como en Log4OM: el cromo puede ser oscuro, pero el contenido
        que se lee renglon a renglon va CLARO —blanco roto con una alternancia de dos puntos—,
        con texto oscuro de peso normal y cabecera gris medio. La rejilla oscura con letra
        clara en negrita cansaba la vista: la pidio cambiar el operador (2026-09-27).
    -->
    <SolidColorBrush x:Key="RejillaFondo" Color="#FFFBFBF9" />
    <SolidColorBrush x:Key="RejillaAlterna" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="RejillaLinea" Color="#FFDDE1E6" />
    <SolidColorBrush x:Key="RejillaCabecera" Color="#FFB9BFC7" />
    <SolidColorBrush x:Key="RejillaCabeceraResalte" Color="#FFC9CED5" />
    <SolidColorBrush x:Key="RejillaCabeceraTexto" Color="#FF1E252E" />
    <SolidColorBrush x:Key="RejillaTexto" Color="#FF1E252E" />
    <SolidColorBrush x:Key="RejillaTextoTenue" Color="#FF56616F" />
    <SolidColorBrush x:Key="FilaElegida" Color="#FFCFE0F3" />
    <SolidColorBrush x:Key="FilaElegidaTexto" Color="#FF0B2540" />
    <SolidColorBrush x:Key="FilaElegidaBarra" Color="#FF0F5FA8" />
    <SolidColorBrush x:Key="FilaBajoElRaton" Color="#FFE7EDF4" />
    <!-- Color con significado: cada via de confirmacion tiene el suyo y nada mas lo lleva. -->
    <SolidColorBrush x:Key="QslLotwTinta" Color="#FF1B6E3F" />
    <SolidColorBrush x:Key="QslLotwFondo" Color="#402E9E60" />
    <SolidColorBrush x:Key="QslEqslTinta" Color="#FF14618F" />
    <SolidColorBrush x:Key="QslEqslFondo" Color="#402E8CC8" />
    <SolidColorBrush x:Key="QslPapelTinta" Color="#FF8A5B0A" />
    <SolidColorBrush x:Key="QslPapelFondo" Color="#40D9A441" />
    <SolidColorBrush x:Key="QslQrzTinta" Color="#FF5B3899" />
    <SolidColorBrush x:Key="QslQrzFondo" Color="#409B72D8" />
</ResourceDictionary>
