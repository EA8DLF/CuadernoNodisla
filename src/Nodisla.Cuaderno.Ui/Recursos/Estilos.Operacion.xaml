<!--
    Estilos de los paneles de operación: equipo, cluster, digital y mapa.

    Van en un diccionario aparte del general porque son los controles que solo usan estos
    paneles —pestañas, listas, deslizadores— y así el fichero de estilos del cuaderno no crece
    con cosas que allí no se usan. Las reglas son las mismas: ningún color fijo, todo con
    DynamicResource para que el tema cambie al vuelo, y ningún tamaño en píxeles que no crezca
    con la letra.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Pestañas de los paneles de operación ──────────────────────────── -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource FondoCabecera}"
                                BorderBrush="{DynamicResource Borde}"
                                BorderThickness="0,0,0,1">
                            <UniformGrid Rows="1" IsItemsHost="True" />
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,8,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="borde"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            <Setter TargetName="borde" Property="Background" Value="{DynamicResource FondoPanel}" />
                            <Setter Property="Foreground" Value="{DynamicResource Acento}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{DynamicResource FondoResalte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Listas ────────────────────────────────────────────────────────── -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource FondoCampo}" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BordeSuave}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{DynamicResource FondoResalte}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{DynamicResource SeleccionFondo}" />
                            <Setter Property="Foreground" Value="{DynamicResource SeleccionTexto}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Deslizadores de los mandos del equipo ─────────────────────────── -->

    <Style x:Key="PulgarDeDeslizador" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Acento}"
                            BorderBrush="{DynamicResource FondoPanel}"
                            BorderThickness="2"
                            CornerRadius="9"
                            Width="18"
                            Height="18" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource Borde}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PulgarDeDeslizador}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Bloques que se pliegan ────────────────────────────────────────── -->

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ── Consola cruda del cluster y ADIF de los digitales ─────────────── -->

    <Style x:Key="TextoDeConsola" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ── Lecturas grandes: la frecuencia y el modo del equipo ──────────── -->

    <Style x:Key="LecturaGrande" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Acento}" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="MedidorDelEquipo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!--
        Botón de pánico. Va en rojo y con el borde grueso porque es el único botón de este
        programa cuyo retraso quema hardware: un PTT pegado destroza la etapa final.
    -->
    <Style x:Key="BotonDePanico" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource ErrorFondo}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorde}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Marca de «esto sería nuevo en el cuaderno». -->
    <Style x:Key="MarcaDeNovedad" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CorrectoFondo}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CorrectoBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
