<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SERVIDOR PARA OTROS PROGRAMAS: rigctld compatible (TCP) y TCI (WebSocket).

    Otros programas (WSJT-X, JTDX, GridTracker, loggers...) usan la radio A TRAVES del Cuaderno,
    que sigue siendo el dueño del equipo: todo PTT pasa por el vigilante y sus salvaguardas.
    El WebSocket lo pone Kestrel (el servidor de .NET), no uno hecho a mano.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodisla.Cuaderno.Radio\Nodisla.Cuaderno.Radio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nodisla.Cuaderno.Servidores.Pruebas" />
  </ItemGroup>

</Project>
