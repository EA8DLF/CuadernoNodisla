<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Se referencia Aplicacion y no solo Dominio porque el seguimiento Doppler escribe en el
         puerto IEquipoConDosVfos, que vive alli. Aplicacion no conoce a Satelites, asi que no
         hay ciclo. -->
    <ProjectReference Include="..\Nodisla.Cuaderno.Aplicacion\Nodisla.Cuaderno.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- El catalogo de satelites de aficionado viaja dentro del ensamblado, comprimido, igual
       que el de diplomas. Asi el modulo no depende en ejecucion de ningun fichero de Log4OM
       ni de nada suelto en disco. Se genera con recursos\satelites\generar-satelites.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Catalogo\Recursos\catalogo-satelites.tsv.gz" />
  </ItemGroup>

</Project>
