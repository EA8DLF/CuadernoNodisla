<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nodisla.Cuaderno.Aplicacion\Nodisla.Cuaderno.Aplicacion.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nodisla.Cuaderno.Radio.Pruebas" />
  </ItemGroup>

  <!-- Mapa del menu interno del FT-710, sacado del equipo de EA8DLF. Va incrustado para que
       viaje con el programa y se pueda versionar como la tabla de paises. -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\menu-ft710.json" />
  </ItemGroup>

  <!-- Biblioteca oficial de FTDI para el puente FT4222 del FT-710 (analizador de espectro).
       Se descarga de ftdichip.com y se guarda en lib/ftdi con su licencia; viaja junto al
       ejecutable y entra en el instalador. Si no esta, el analizador lo dice en pantalla. -->
  <ItemGroup>
    <Content Include="..\..\lib\ftdi\LibFT4222-64.dll" Condition="Exists('..\..\lib\ftdi\LibFT4222-64.dll')">
      <Link>LibFT4222-64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\lib\ftdi\LICENCIA-FTDI.txt" Condition="Exists('..\..\lib\ftdi\LICENCIA-FTDI.txt')">
      <Link>licencias\LICENCIA-FTDI.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

