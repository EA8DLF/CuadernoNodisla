<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodisla.Cuaderno.Aplicacion\Nodisla.Cuaderno.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- El catalogo de diplomas NO se publica (sus referencias no traen licencia para
       redistribuirlas). Se genera con recursos\diplomas\generar-diplomas.py y se deja en
       %AppData%\CuadernoNodisla\diplomas\. Si ademas esta aqui al compilar, viaja incrustado. -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\catalogo-diplomas.tsv.gz" Condition="Exists('Recursos\catalogo-diplomas.tsv.gz')" />
  </ItemGroup>

</Project>
